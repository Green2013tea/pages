iteration":"fīhā","verse_key":"52:23"},{"pos":3,"ar":"كَأْسًۭا","en_gloss":"a cup","transliteration":"kasan","verse_key":"52:23"},{"pos":4,"ar":"لَّا","en_gloss":"no","transliteration":"lā","verse_key":"52:23"},{"pos":5,"ar":"لَغْوٌۭ","en_gloss":"ill speech","transliteration":"laghwun","verse_key":"52:23"},{"pos":6,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"52:23"},{"pos":7,"ar":"وَلَا","en_gloss":"and no","transliteration":"walā","verse_key":"52:23"},{"pos":8,"ar":"تَأْثِيمٌۭ","en_gloss":"sin","transliteration":"tathīmun","verse_key":"52:23"},{"pos":9,"ar":"٢٣","en_gloss":"(23)","transliteration":"","verse_key":"52:23"}]},{"verse_key":"52:24","surah":52,"ayah":24,"ar_uthmani":"۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَّكْنُونٌ","en_translation_id":85,"en":"Devoted youths like hidden pearls wait on them.","words":[{"pos":1,"ar":"۞ وَيَطُوفُ","en_gloss":"And will circulate","transliteration":"wayaṭūfu","verse_key":"52:24"},{"pos":2,"ar":"عَلَيْهِمْ","en_gloss":"among them","transliteration":"ʿalayhim","verse_key":"52:24"},{"pos":3,"ar":"غِلْمَانٌۭ","en_gloss":"boys","transliteration":"ghil'mānun","verse_key":"52:24"},{"pos":4,"ar":"لَّهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"52:24"},{"pos":5,"ar":"كَأَنَّهُمْ","en_gloss":"as if they (were)","transliteration":"ka-annahum","verse_key":"52:24"},{"pos":6,"ar":"لُؤْلُؤٌۭ","en_gloss":"pearls","transliteration":"lu'lu-on","verse_key":"52:24"},{"pos":7,"ar":"مَّكْنُونٌۭ","en_gloss":"well-protected","transliteration":"maknūnun","verse_key":"52:24"},{"pos":8,"ar":"٢٤","en_gloss":"(24)","transliteration":"","verse_key":"52:24"}]},{"verse_key":"52:25","surah":52,"ayah":25,"ar_uthmani":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","en_translation_id":85,"en":"They turn to one another and say,","words":[{"pos":1,"ar":"وَأَقْبَلَ","en_gloss":"And will approach","transliteration":"wa-aqbala","verse_key":"52:25"},{"pos":2,"ar":"بَعْضُهُمْ","en_gloss