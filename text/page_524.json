ُهُمْ","en_gloss":"their Lord","transliteration":"rabbuhum","verse_key":"52:18"},{"pos":7,"ar":"عَذَابَ","en_gloss":"(from the) punishment","transliteration":"ʿadhāba","verse_key":"52:18"},{"pos":8,"ar":"ٱلْجَحِيمِ","en_gloss":"(of) Hellfire","transliteration":"l-jaḥīmi","verse_key":"52:18"},{"pos":9,"ar":"١٨","en_gloss":"(18)","transliteration":"","verse_key":"52:18"}]},{"verse_key":"52:19","surah":52,"ayah":19,"ar_uthmani":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","en_translation_id":85,"en":"‘Eat and drink with healthy enjoyment as a reward for what you have done.’","words":[{"pos":1,"ar":"كُلُوا۟","en_gloss":"Eat","transliteration":"kulū","verse_key":"52:19"},{"pos":2,"ar":"وَٱشْرَبُوا۟","en_gloss":"and drink","transliteration":"wa-ish'rabū","verse_key":"52:19"},{"pos":3,"ar":"هَنِيٓـًٔۢا","en_gloss":"(in) satisfaction","transliteration":"hanīan","verse_key":"52:19"},{"pos":4,"ar":"بِمَا","en_gloss":"for what","transliteration":"bimā","verse_key":"52:19"},{"pos":5,"ar":"كُنتُمْ","en_gloss":"you used to","transliteration":"kuntum","verse_key":"52:19"},{"pos":6,"ar":"تَعْمَلُونَ","en_gloss":"do","transliteration":"taʿmalūna","verse_key":"52:19"},{"pos":7,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"52:19"}]},{"verse_key":"52:20","surah":52,"ayah":20,"ar_uthmani":"مُتَّكِـِٔينَ عَلَىٰ سُرُرٍ مَّصْفُوفَةٍ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ","en_translation_id":85,"en":"They are comfortably seated on couches arranged in rows; We pair them with beautiful-eyed maidens;","words":[{"pos":1,"ar":"مُتَّكِـِٔينَ","en_gloss":"Reclining","transliteration":"muttakiīna","verse_key":"52:20"},{"pos":2,"ar":"عَلَىٰ","en_gloss":"on","transliteration":"ʿalā","verse_key":"52:20"},{"pos":3,"ar":"سُرُرٍۢ","en_gloss":"thrones","transliteration":"sururin","verse_key":"52:20"},{"pos":4,"ar":"مَّصْفُوفَةٍۢ ۖ","en_gloss":"lined up","transliteration":"maṣfūfatin","verse_key":"52:20"},{"pos":5,"ar":"وَزَوَّجْنَـٰهُم","en_gloss":"and We will marry them","trans