ni":"ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ وَأَنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ","en_translation_id":85,"en":"Know too that God is severe in punishment yet most forgiving and merciful.","words":[{"pos":1,"ar":"ٱعْلَمُوٓا۟","en_gloss":"Know","transliteration":"iʿ'lamū","verse_key":"5:98"},{"pos":2,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"5:98"},{"pos":3,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"5:98"},{"pos":4,"ar":"شَدِيدُ","en_gloss":"(is) severe","transliteration":"shadīdu","verse_key":"5:98"},{"pos":5,"ar":"ٱلْعِقَابِ","en_gloss":"(in) punishment","transliteration":"l-ʿiqābi","verse_key":"5:98"},{"pos":6,"ar":"وَأَنَّ","en_gloss":"and that","transliteration":"wa-anna","verse_key":"5:98"},{"pos":7,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"5:98"},{"pos":8,"ar":"غَفُورٌۭ","en_gloss":"(is) Oft-Forgiving","transliteration":"ghafūrun","verse_key":"5:98"},{"pos":9,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"5:98"},{"pos":10,"ar":"٩٨","en_gloss":"(98)","transliteration":"","verse_key":"5:98"}]},{"verse_key":"5:99","surah":5,"ayah":99,"ar_uthmani":"مَّا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَـٰغُ ۗ وَٱللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ","en_translation_id":85,"en":"The Messenger’s duty is only to deliver the message: God knows what you reveal and what you conceal.","words":[{"pos":1,"ar":"مَّا","en_gloss":"Not","transliteration":"mā","verse_key":"5:99"},{"pos":2,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"5:99"},{"pos":3,"ar":"ٱلرَّسُولِ","en_gloss":"the Messenger","transliteration":"l-rasūli","verse_key":"5:99"},{"pos":4,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"5:99"},{"pos":5,"ar":"ٱلْبَلَـٰغُ ۗ","en_gloss":"the conveyance","transliteration":"l-balāghu","verse_key":"5:99"},{"pos":6,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"5:99"},{"pos":7,