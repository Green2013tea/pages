َآ ۚ أُو۟لَـٰٓئِكَ مَا كَانَ لَهُمْ أَن يَدْخُلُوهَآ إِلَّا خَآئِفِينَ ۚ لَهُمْ فِى ٱلدُّنْيَا خِزْىٌ وَلَهُمْ فِى ٱلْـَٔاخِرَةِ عَذَابٌ عَظِيمٌ","en_translation_id":85,"en":"Who could be more wicked than those who prohibit the mention of God’s name in His places of worship and strive to have them deserted? Such people should not enter them without fear: there is disgrace for them in this world and painful punishment in the Hereafter.","words":[{"pos":1,"ar":"وَمَنْ","en_gloss":"And who","transliteration":"waman","verse_key":"2:114"},{"pos":2,"ar":"أَظْلَمُ","en_gloss":"(is) more unjust","transliteration":"aẓlamu","verse_key":"2:114"},{"pos":3,"ar":"مِمَّن","en_gloss":"than (one) who","transliteration":"mimman","verse_key":"2:114"},{"pos":4,"ar":"مَّنَعَ","en_gloss":"prevents","transliteration":"manaʿa","verse_key":"2:114"},{"pos":5,"ar":"مَسَـٰجِدَ","en_gloss":"(the) masajid","transliteration":"masājida","verse_key":"2:114"},{"pos":6,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"2:114"},{"pos":7,"ar":"أَن","en_gloss":"to","transliteration":"an","verse_key":"2:114"},{"pos":8,"ar":"يُذْكَرَ","en_gloss":"be mentioned","transliteration":"yudh'kara","verse_key":"2:114"},{"pos":9,"ar":"فِيهَا","en_gloss":"in them","transliteration":"fīhā","verse_key":"2:114"},{"pos":10,"ar":"ٱسْمُهُۥ","en_gloss":"His name","transliteration":"us'muhu","verse_key":"2:114"},{"pos":11,"ar":"وَسَعَىٰ","en_gloss":"and strives","transliteration":"wasaʿā","verse_key":"2:114"},{"pos":12,"ar":"فِى","en_gloss":"for","transliteration":"fī","verse_key":"2:114"},{"pos":13,"ar":"خَرَابِهَآ ۚ","en_gloss":"their destruction","transliteration":"kharābihā","verse_key":"2:114"},{"pos":14,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those","transliteration":"ulāika","verse_key":"2:114"},{"pos":15,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"2:114"},{"pos":16,"ar":"كَانَ","en_gloss":"it is","transliteration":"kāna","verse_key":"2:114"},{"pos":17,"ar":"لَهُمْ","en_gl