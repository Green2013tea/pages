{"page":302,"verses":[{"verse_key":"18:75","surah":18,"ayah":75,"ar_uthmani":"۞ قَالَ أَلَمْ أَقُل لَّكَ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا","en_translation_id":85,"en":"He replied, ‘Did I not tell you that you would never be able to bear with me patiently?’","words":[{"pos":1,"ar":"۞ قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"18:75"},{"pos":2,"ar":"أَلَمْ","en_gloss":"Did not","transliteration":"alam","verse_key":"18:75"},{"pos":3,"ar":"أَقُل","en_gloss":"I say","transliteration":"aqul","verse_key":"18:75"},{"pos":4,"ar":"لَّكَ","en_gloss":"to you","transliteration":"laka","verse_key":"18:75"},{"pos":5,"ar":"إِنَّكَ","en_gloss":"that you","transliteration":"innaka","verse_key":"18:75"},{"pos":6,"ar":"لَن","en_gloss":"never","transliteration":"lan","verse_key":"18:75"},{"pos":7,"ar":"تَسْتَطِيعَ","en_gloss":"will be able","transliteration":"tastaṭīʿa","verse_key":"18:75"},{"pos":8,"ar":"مَعِىَ","en_gloss":"with me","transliteration":"maʿiya","verse_key":"18:75"},{"pos":9,"ar":"صَبْرًۭا","en_gloss":"(to have) patience","transliteration":"ṣabran","verse_key":"18:75"},{"pos":10,"ar":"٧٥","en_gloss":"(75)","transliteration":"","verse_key":"18:75"}]},{"verse_key":"18:76","surah":18,"ayah":76,"ar_uthmani":"قَالَ إِن سَأَلْتُكَ عَن شَىْءٍۭ بَعْدَهَا فَلَا تُصَـٰحِبْنِى ۖ قَدْ بَلَغْتَ مِن لَّدُنِّى عُذْرًا","en_translation_id":85,"en":"Moses said, ‘From now on, if I query anything you do, banish me from your company- you have put up with enough from me.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"18:76"},{"pos":2,"ar":"إِن","en_gloss":"If","transliteration":"in","verse_key":"18:76"},{"pos":3,"ar":"سَأَلْتُكَ","en_gloss":"I ask you","transliteration":"sa-altuka","verse_key":"18:76"},{"pos":4,"ar":"عَن","en_gloss":"about","transliteration":"ʿan","verse_key":"18:76"},{"pos":5,"ar":"شَىْءٍۭ","en_gloss":"anything","transliteration":"shayin","verse_key":"18:76"},{"pos":6,"ar":"بَعْدَهَا","en_gloss":"after