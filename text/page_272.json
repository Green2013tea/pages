 مِن شَىْءٍ يَتَفَيَّؤُا۟ ظِلَـٰلُهُۥ عَنِ ٱلْيَمِينِ وَٱلشَّمَآئِلِ سُجَّدًا لِّلَّهِ وَهُمْ دَٰخِرُونَ","en_translation_id":85,"en":"Do the [disbelievers] not observe the things that God has created, casting their shadows right and left, submitting themselves to God obediently?","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Have not","transliteration":"awalam","verse_key":"16:48"},{"pos":2,"ar":"يَرَوْا۟","en_gloss":"they seen","transliteration":"yaraw","verse_key":"16:48"},{"pos":3,"ar":"إِلَىٰ","en_gloss":"[towards]","transliteration":"ilā","verse_key":"16:48"},{"pos":4,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"16:48"},{"pos":5,"ar":"خَلَقَ","en_gloss":"Allah has created","transliteration":"khalaqa","verse_key":"16:48"},{"pos":6,"ar":"ٱللَّهُ","en_gloss":"Allah has created","transliteration":"l-lahu","verse_key":"16:48"},{"pos":7,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"16:48"},{"pos":8,"ar":"شَىْءٍۢ","en_gloss":"a thing","transliteration":"shayin","verse_key":"16:48"},{"pos":9,"ar":"يَتَفَيَّؤُا۟","en_gloss":"Incline","transliteration":"yatafayya-u","verse_key":"16:48"},{"pos":10,"ar":"ظِلَـٰلُهُۥ","en_gloss":"their shadows","transliteration":"ẓilāluhu","verse_key":"16:48"},{"pos":11,"ar":"عَنِ","en_gloss":"to","transliteration":"ʿani","verse_key":"16:48"},{"pos":12,"ar":"ٱلْيَمِينِ","en_gloss":"the right","transliteration":"l-yamīni","verse_key":"16:48"},{"pos":13,"ar":"وَٱلشَّمَآئِلِ","en_gloss":"and to the left","transliteration":"wal-shamāili","verse_key":"16:48"},{"pos":14,"ar":"سُجَّدًۭا","en_gloss":"prostrating","transliteration":"sujjadan","verse_key":"16:48"},{"pos":15,"ar":"لِّلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"16:48"},{"pos":16,"ar":"وَهُمْ","en_gloss":"while they","transliteration":"wahum","verse_key":"16:48"},{"pos":17,"ar":"دَٰخِرُونَ","en_gloss":"(are) humble","transliteration":"dākhirūna","verse_key":"16:48"},{"pos":18,"ar":"٤٨","en_gloss":"(48)","transliteratio