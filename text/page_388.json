نِ ٱسْتَـْٔجَرْتَ ٱلْقَوِىُّ ٱلْأَمِينُ","en_translation_id":85,"en":"One of the women said, ‘Father, hire him: a strong, trustworthy man is the best to hire.’","words":[{"pos":1,"ar":"قَالَتْ","en_gloss":"Said","transliteration":"qālat","verse_key":"28:26"},{"pos":2,"ar":"إِحْدَىٰهُمَا","en_gloss":"one of them","transliteration":"iḥ'dāhumā","verse_key":"28:26"},{"pos":3,"ar":"يَـٰٓأَبَتِ","en_gloss":"O my father","transliteration":"yāabati","verse_key":"28:26"},{"pos":4,"ar":"ٱسْتَـْٔجِرْهُ ۖ","en_gloss":"Hire him","transliteration":"is'tajir'hu","verse_key":"28:26"},{"pos":5,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"28:26"},{"pos":6,"ar":"خَيْرَ","en_gloss":"(the) best","transliteration":"khayra","verse_key":"28:26"},{"pos":7,"ar":"مَنِ","en_gloss":"whom","transliteration":"mani","verse_key":"28:26"},{"pos":8,"ar":"ٱسْتَـْٔجَرْتَ","en_gloss":"you (can) hire","transliteration":"is'tajarta","verse_key":"28:26"},{"pos":9,"ar":"ٱلْقَوِىُّ","en_gloss":"(is) the strong","transliteration":"l-qawiyu","verse_key":"28:26"},{"pos":10,"ar":"ٱلْأَمِينُ","en_gloss":"the trustworthy","transliteration":"l-amīnu","verse_key":"28:26"},{"pos":11,"ar":"٢٦","en_gloss":"(26)","transliteration":"","verse_key":"28:26"}]},{"verse_key":"28:27","surah":28,"ayah":27,"ar_uthmani":"قَالَ إِنِّىٓ أُرِيدُ أَنْ أُنكِحَكَ إِحْدَى ٱبْنَتَىَّ هَـٰتَيْنِ عَلَىٰٓ أَن تَأْجُرَنِى ثَمَـٰنِىَ حِجَجٍ ۖ فَإِنْ أَتْمَمْتَ عَشْرًا فَمِنْ عِندِكَ ۖ وَمَآ أُرِيدُ أَنْ أَشُقَّ عَلَيْكَ ۚ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰلِحِينَ","en_translation_id":85,"en":"The father said, ‘I would like to marry you to one of these daughters of mine, on condition that you serve me for eight years: if you complete ten, it will be of your own free will. I do not intend to make things difficult for you: God willing, you will find I am a fair man.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"28:27"},{"pos":2,"ar":"إِنِّىٓ","en_gloss":"Indeed, I