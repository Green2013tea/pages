َحَـٰفِظُونَ","en_gloss":"(will) surely (be) guardians","transliteration":"laḥāfiẓūna","verse_key":"12:12"},{"pos":9,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"12:12"}]},{"verse_key":"12:13","surah":12,"ayah":13,"ar_uthmani":"قَالَ إِنِّى لَيَحْزُنُنِىٓ أَن تَذْهَبُوا۟ بِهِۦ وَأَخَافُ أَن يَأْكُلَهُ ٱلذِّئْبُ وَأَنتُمْ عَنْهُ غَـٰفِلُونَ","en_translation_id":85,"en":"He replied, ‘The thought of you taking him away with you worries me: I am afraid a wolf may eat him when you are not paying attention.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"12:13"},{"pos":2,"ar":"إِنِّى","en_gloss":"Indeed, [I]","transliteration":"innī","verse_key":"12:13"},{"pos":3,"ar":"لَيَحْزُنُنِىٓ","en_gloss":"it surely saddens me","transliteration":"layaḥzununī","verse_key":"12:13"},{"pos":4,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"12:13"},{"pos":5,"ar":"تَذْهَبُوا۟","en_gloss":"you should take him","transliteration":"tadhhabū","verse_key":"12:13"},{"pos":6,"ar":"بِهِۦ","en_gloss":"you should take him","transliteration":"bihi","verse_key":"12:13"},{"pos":7,"ar":"وَأَخَافُ","en_gloss":"and I fear","transliteration":"wa-akhāfu","verse_key":"12:13"},{"pos":8,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"12:13"},{"pos":9,"ar":"يَأْكُلَهُ","en_gloss":"would eat him","transliteration":"yakulahu","verse_key":"12:13"},{"pos":10,"ar":"ٱلذِّئْبُ","en_gloss":"a wolf","transliteration":"l-dhi'bu","verse_key":"12:13"},{"pos":11,"ar":"وَأَنتُمْ","en_gloss":"while you","transliteration":"wa-antum","verse_key":"12:13"},{"pos":12,"ar":"عَنْهُ","en_gloss":"of him","transliteration":"ʿanhu","verse_key":"12:13"},{"pos":13,"ar":"غَـٰفِلُونَ","en_gloss":"(are) unaware","transliteration":"ghāfilūna","verse_key":"12:13"},{"pos":14,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"12:13"}]},{"verse_key":"12:14","surah":12,"ayah":14,"ar_uthmani":"قَالُوا۟ لَئِنْ أَكَلَهُ ٱلذِّئْبُ وَنَحْنُ عُصْبَةٌ إِنَّآ إِذًا لَّخَـٰسِرُونَ","en_translation_id":85,"en":"They said, ‘If a wolf were to eat him when there are so many of us, we would truly be losers!’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"12:14"},{"pos":2,"ar":"لَئِنْ","en_gloss":"If","transliteration":"la-in","verse_key":"12:14"},{"pos":3,"ar":"أَكَلَهُ","en_gloss":"eats him","transliteration":"akalahu","verse_key":"12:14"},{"pos":4,"ar":"ٱلذِّئْبُ","en_gloss":"the wolf","transliteration":"l-dhi'bu","verse_key":"12:14"},{"pos":5,"ar":"وَنَحْنُ","en_gloss":"while we","transliteration":"wanaḥnu","verse_key":"12:14"},{"pos":6,"ar":"عُصْبَةٌ","en_gloss":"(are) a group","transliteration":"ʿuṣ'batun","verse_key":"12:14"},{"pos":7,"ar":"إِنَّآ","en_gloss":"indeed, we","transliteration":"innā","verse_key":"12:14"},{"pos":8,"ar":"إِذًۭا","en_gloss":"then","transliteration":"idhan","verse_key":"12:14"},{"pos":9,"ar":"لَّخَـٰسِرُونَ","en_gloss":"surely (would be) losers","transliteration":"lakhāsirūna","verse_key":"12:14"},{"pos":10,"ar":"١٤","en_gloss":"(14)","transliteration":"","verse_key":"12:14"}]}]}