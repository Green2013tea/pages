,{"verse_key":"12:8","surah":12,"ayah":8,"ar_uthmani":"إِذْ قَالُوا۟ لَيُوسُفُ وَأَخُوهُ أَحَبُّ إِلَىٰٓ أَبِينَا مِنَّا وَنَحْنُ عُصْبَةٌ إِنَّ أَبَانَا لَفِى ضَلَـٰلٍ مُّبِينٍ","en_translation_id":85,"en":"The brothers said [to each other], ‘Although we are many, Joseph and his brother are dearer to our father than we are–– our father is clearly in the wrong.’","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"12:8"},{"pos":2,"ar":"قَالُوا۟","en_gloss":"they said","transliteration":"qālū","verse_key":"12:8"},{"pos":3,"ar":"لَيُوسُفُ","en_gloss":"Surely Yusuf","transliteration":"layūsufu","verse_key":"12:8"},{"pos":4,"ar":"وَأَخُوهُ","en_gloss":"and his brother","transliteration":"wa-akhūhu","verse_key":"12:8"},{"pos":5,"ar":"أَحَبُّ","en_gloss":"(are) more beloved","transliteration":"aḥabbu","verse_key":"12:8"},{"pos":6,"ar":"إِلَىٰٓ","en_gloss":"to","transliteration":"ilā","verse_key":"12:8"},{"pos":7,"ar":"أَبِينَا","en_gloss":"our father","transliteration":"abīnā","verse_key":"12:8"},{"pos":8,"ar":"مِنَّا","en_gloss":"than we","transliteration":"minnā","verse_key":"12:8"},{"pos":9,"ar":"وَنَحْنُ","en_gloss":"while we","transliteration":"wanaḥnu","verse_key":"12:8"},{"pos":10,"ar":"عُصْبَةٌ","en_gloss":"(are) a group","transliteration":"ʿuṣ'batun","verse_key":"12:8"},{"pos":11,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"12:8"},{"pos":12,"ar":"أَبَانَا","en_gloss":"our father","transliteration":"abānā","verse_key":"12:8"},{"pos":13,"ar":"لَفِى","en_gloss":"(is) surely in","transliteration":"lafī","verse_key":"12:8"},{"pos":14,"ar":"ضَلَـٰلٍۢ","en_gloss":"an error","transliteration":"ḍalālin","verse_key":"12:8"},{"pos":15,"ar":"مُّبِينٍ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"12:8"},{"pos":16,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"12:8"}]},{"verse_key":"12:9","surah":12,"ayah":9,"ar_uthmani":"ٱقْتُلُوا۟ يُوسُفَ أَوِ ٱطْرَحُوهُ أَرْضًا يَخْلُ لَكُمْ وَجْهُ أَبِيك