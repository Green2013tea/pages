"surah":52,"ayah":34,"ar_uthmani":"فَلْيَأْتُوا۟ بِحَدِيثٍ مِّثْلِهِۦٓ إِن كَانُوا۟ صَـٰدِقِينَ","en_translation_id":85,"en":"let them produce one like it, if what they say is true.","words":[{"pos":1,"ar":"فَلْيَأْتُوا۟","en_gloss":"Then let them bring","transliteration":"falyatū","verse_key":"52:34"},{"pos":2,"ar":"بِحَدِيثٍۢ","en_gloss":"a statement","transliteration":"biḥadīthin","verse_key":"52:34"},{"pos":3,"ar":"مِّثْلِهِۦٓ","en_gloss":"like it","transliteration":"mith'lihi","verse_key":"52:34"},{"pos":4,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"52:34"},{"pos":5,"ar":"كَانُوا۟","en_gloss":"they are","transliteration":"kānū","verse_key":"52:34"},{"pos":6,"ar":"صَـٰدِقِينَ","en_gloss":"truthful","transliteration":"ṣādiqīna","verse_key":"52:34"},{"pos":7,"ar":"٣٤","en_gloss":"(34)","transliteration":"","verse_key":"52:34"}]},{"verse_key":"52:35","surah":52,"ayah":35,"ar_uthmani":"أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَـٰلِقُونَ","en_translation_id":85,"en":"Were they created without any agent? Were they the creators?","words":[{"pos":1,"ar":"أَمْ","en_gloss":"Or","transliteration":"am","verse_key":"52:35"},{"pos":2,"ar":"خُلِقُوا۟","en_gloss":"they were created","transliteration":"khuliqū","verse_key":"52:35"},{"pos":3,"ar":"مِنْ","en_gloss":"of","transliteration":"min","verse_key":"52:35"},{"pos":4,"ar":"غَيْرِ","en_gloss":"nothing","transliteration":"ghayri","verse_key":"52:35"},{"pos":5,"ar":"شَىْءٍ","en_gloss":"nothing","transliteration":"shayin","verse_key":"52:35"},{"pos":6,"ar":"أَمْ","en_gloss":"or","transliteration":"am","verse_key":"52:35"},{"pos":7,"ar":"هُمُ","en_gloss":"(are) they","transliteration":"humu","verse_key":"52:35"},{"pos":8,"ar":"ٱلْخَـٰلِقُونَ","en_gloss":"the creators","transliteration":"l-khāliqūna","verse_key":"52:35"},{"pos":9,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"52:35"}]},{"verse_key":"52:36","surah":52,"ayah":36,"ar_uthmani":"أَمْ خَلَقُوا۟ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لّ