et","transliteration":"faḥayyū","verse_key":"4:86"},{"pos":5,"ar":"بِأَحْسَنَ","en_gloss":"with better","transliteration":"bi-aḥsana","verse_key":"4:86"},{"pos":6,"ar":"مِنْهَآ","en_gloss":"than it","transliteration":"min'hā","verse_key":"4:86"},{"pos":7,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"4:86"},{"pos":8,"ar":"رُدُّوهَآ ۗ","en_gloss":"return it","transliteration":"ruddūhā","verse_key":"4:86"},{"pos":9,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"4:86"},{"pos":10,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"4:86"},{"pos":11,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"4:86"},{"pos":12,"ar":"عَلَىٰ","en_gloss":"of","transliteration":"ʿalā","verse_key":"4:86"},{"pos":13,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"4:86"},{"pos":14,"ar":"شَىْءٍ","en_gloss":"thing","transliteration":"shayin","verse_key":"4:86"},{"pos":15,"ar":"حَسِيبًا","en_gloss":"an Accountant","transliteration":"ḥasīban","verse_key":"4:86"},{"pos":16,"ar":"٨٦","en_gloss":"(86)","transliteration":"","verse_key":"4:86"}]}]}