ation":"ayna","verse_key":"19:31"},{"pos":4,"ar":"مَا","en_gloss":"wherever","transliteration":"mā","verse_key":"19:31"},{"pos":5,"ar":"كُنتُ","en_gloss":"I am","transliteration":"kuntu","verse_key":"19:31"},{"pos":6,"ar":"وَأَوْصَـٰنِى","en_gloss":"and has enjoined (on) me","transliteration":"wa-awṣānī","verse_key":"19:31"},{"pos":7,"ar":"بِٱلصَّلَوٰةِ","en_gloss":"[of] the prayer","transliteration":"bil-ṣalati","verse_key":"19:31"},{"pos":8,"ar":"وَٱلزَّكَوٰةِ","en_gloss":"and zakah","transliteration":"wal-zakati","verse_key":"19:31"},{"pos":9,"ar":"مَا","en_gloss":"as long as I am","transliteration":"mā","verse_key":"19:31"},{"pos":10,"ar":"دُمْتُ","en_gloss":"as long as I am","transliteration":"dum'tu","verse_key":"19:31"},{"pos":11,"ar":"حَيًّۭا","en_gloss":"alive","transliteration":"ḥayyan","verse_key":"19:31"},{"pos":12,"ar":"٣١","en_gloss":"(31)","transliteration":"","verse_key":"19:31"}]},{"verse_key":"19:32","surah":19,"ayah":32,"ar_uthmani":"وَبَرًّۢا بِوَٰلِدَتِى وَلَمْ يَجْعَلْنِى جَبَّارًا شَقِيًّا","en_translation_id":85,"en":"to cherish my mother. He did not make me domineering or graceless.","words":[{"pos":1,"ar":"وَبَرًّۢا","en_gloss":"And dutiful","transliteration":"wabarran","verse_key":"19:32"},{"pos":2,"ar":"بِوَٰلِدَتِى","en_gloss":"to my mother","transliteration":"biwālidatī","verse_key":"19:32"},{"pos":3,"ar":"وَلَمْ","en_gloss":"and not","transliteration":"walam","verse_key":"19:32"},{"pos":4,"ar":"يَجْعَلْنِى","en_gloss":"He (has) made me","transliteration":"yajʿalnī","verse_key":"19:32"},{"pos":5,"ar":"جَبَّارًۭا","en_gloss":"insolent","transliteration":"jabbāran","verse_key":"19:32"},{"pos":6,"ar":"شَقِيًّۭا","en_gloss":"unblessed","transliteration":"shaqiyyan","verse_key":"19:32"},{"pos":7,"ar":"٣٢","en_gloss":"(32)","transliteration":"","verse_key":"19:32"}]},{"verse_key":"19:33","surah":19,"ayah":33,"ar_uthmani":"وَٱلسَّلَـٰمُ عَلَىَّ يَوْمَ وُلِدتُّ وَيَوْمَ أَمُوتُ وَيَوْمَ أُبْعَثُ حَيًّا","en_translation_id":85,"en":"Peace was on me the day I was born, and will be on me the day I die and the day I am raised to life again.’","words":[{"pos":1,"ar":"وَٱلسَّلَـٰمُ","en_gloss":"And peace (be)","transliteration":"wal-salāmu","verse_key":"19:33"},{"pos":2,"ar":"عَلَىَّ","en_gloss":"on me","transliteration":"ʿalayya","verse_key":"19:33"},{"pos":3,"ar":"يَوْمَ","en_gloss":"(the) day","transliteration":"yawma","verse_key":"19:33"},{"pos":4,"ar":"وُلِدتُّ","en_gloss":"I was born","transliteration":"wulidttu","verse_key":"19:33"},{"pos":5,"ar":"وَيَوْمَ","en_gloss":"and (the) day","transliteration":"wayawma","verse_key":"19:33"},{"pos":6,"ar":"أَمُوتُ","en_gloss":"I will die","transliteration":"amūtu","verse_key":"19:33"},{"pos":7,"ar":"وَيَوْمَ","en_gloss":"and (the) Day","transliteration":"wayawma","verse_key":"19:33"},{"pos":8,"ar":"أُبْعَثُ","en_gloss":"I will be raised","transliteration":"ub'ʿathu","verse_key":"19:33"},{"pos":9,"ar":"حَيًّۭا","en_gloss":"alive","transliteration":"ḥayyan","verse_key":"19:33"},{"pos":10,"ar":"٣٣","en_gloss":"(33)","transliteration":"","verse_key":"19:33"}]},{"verse_key":"19:34","surah":19,"ayah":34,"ar_uthmani":"ذَٰلِكَ عِيسَى ٱبْنُ مَرْيَمَ ۚ قَوْلَ ٱلْحَقِّ ٱلَّذِى فِيهِ يَمْتَرُونَ","en_translation_id":85,"en":"Such was Jesus, son of Mary. [This is] a statement of the Truth about which they are in doubt:","words":[{"pos":1,"ar":"ذَٰلِكَ","en_gloss":"That","transliteration":"dhālika","verse_key":"19:34"},{"pos":2,"ar":"عِيسَى","en_gloss":"(was) Isa","transliteration":"ʿīsā","verse_key":"19:34"},{"pos":3,"ar":"ٱبْنُ","en_gloss":"(the) son","transliteration":"ub'nu","verse_key":"19:34"},{"pos":4,"ar":"مَرْيَمَ ۚ","en_gloss":"(of) Maryam","transliteration":"maryama","verse_key":"19:34"},{"pos":5,"ar":"قَوْلَ","en_gloss":"a statement","transliteration":"qawla","verse_key":"19:34"},{"pos":6,"ar":"ٱلْحَقِّ","en_gloss":"(of) truth","transliteration":"l-ḥaqi","verse_key":"19:34"},{"pos":7,"ar":"ٱلَّذِى","en_gloss":"that which","transliteration":"alladhī","verse_key":"19:34"},{"pos":8,"ar":"فِيهِ","en_gloss":"about it","transliteration":"fīhi","verse_key":"19:34"},{"pos":9,"ar":"يَمْتَرُونَ","en_gloss":"they dispute","transliteration":"yamtarūna","verse_key":"19:34"},{"pos":10,"ar":"٣٤","en_gloss":"(34)","transliteration":"","verse_key":"19:34"}]},{"verse_key":"19:35","surah":19,"ayah":35,"ar_uthmani":"مَا كَانَ لِلَّهِ أَن يَتَّخِذَ مِن وَلَدٍ ۖ سُبْحَـٰنَهُۥٓ ۚ إِذَا قَضَىٰٓ أَمْرًا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ","en_translation_id":85,"en":"it would not befit God to have a child. He is far above that: when He decrees something, He says only, ‘Be,’ and it is.","words":[{"pos":1,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"19:35"},{"pos":2,"ar":"كَانَ","en_gloss":"(it) is","transliteration":"kāna","verse_key":"19:35"},{"pos":3,"ar":"لِلَّهِ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"19:35"},{"pos":4,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"19:35"},{"pos":5,"ar":"يَتَّخِذَ","en_gloss":"He should take","transliteration":"yattakhidha","verse_key":"19:35"},{"pos":6,"ar":"مِن","en_gloss":"any son","transliteration":"min","verse_key":"19:35"},{"pos":7,"ar":"وَلَدٍۢ ۖ","en_gloss":"any son","transliteration":"waladin","verse_key":"19:35"},{"pos":8,"ar":"سُبْحَـٰنَهُۥٓ ۚ","en_gloss":"Glory be to Him","transliteration":"sub'ḥānahu","verse_key":"19:35"},{"pos":9,"ar":"إِذَا","en_gloss":"When","transliteration":"idhā","verse_key":"19:35"},{"pos":10,"ar":"قَضَىٰٓ","en_gloss":"He decrees","transliteration":"qaḍā","verse_key":"19:35"},{"pos":11,"ar":"أَمْرًۭا","en_gloss":"a matter","transliteration":"amran","verse_key":"19:35"},{"pos":12,"ar":"فَإِنَّمَا","en_gloss":"then only","transliteration":"fa-innamā","verse_key":"19:35"},{"pos":13,"ar":"يَقُولُ","en_gloss":"He says","transliteration":"yaqūlu","verse_key":"19:35"},{"pos":14,"ar":"لَهُۥ","en_gloss":"to it","transliteration":"lahu","verse_key":"19:35"},{"pos":15,"ar":"كُن","en_gloss":"Be","transliteration":"kun","verse_