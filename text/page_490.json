n_gloss":"(21)","transliteration":"","verse_key":"43:21"}]},{"verse_key":"43:22","surah":43,"ayah":22,"ar_uthmani":"بَلْ قَالُوٓا۟ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم مُّهْتَدُونَ","en_translation_id":85,"en":"No indeed! They say, ‘We saw our fathers following this tradition; we are guided by their footsteps.’","words":[{"pos":1,"ar":"بَلْ","en_gloss":"Nay","transliteration":"bal","verse_key":"43:22"},{"pos":2,"ar":"قَالُوٓا۟","en_gloss":"they say","transliteration":"qālū","verse_key":"43:22"},{"pos":3,"ar":"إِنَّا","en_gloss":"Indeed, we","transliteration":"innā","verse_key":"43:22"},{"pos":4,"ar":"وَجَدْنَآ","en_gloss":"[we] found","transliteration":"wajadnā","verse_key":"43:22"},{"pos":5,"ar":"ءَابَآءَنَا","en_gloss":"our forefathers","transliteration":"ābāanā","verse_key":"43:22"},{"pos":6,"ar":"عَلَىٰٓ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"43:22"},{"pos":7,"ar":"أُمَّةٍۢ","en_gloss":"a religion","transliteration":"ummatin","verse_key":"43:22"},{"pos":8,"ar":"وَإِنَّا","en_gloss":"and indeed, we","transliteration":"wa-innā","verse_key":"43:22"},{"pos":9,"ar":"عَلَىٰٓ","en_gloss":"on","transliteration":"ʿalā","verse_key":"43:22"},{"pos":10,"ar":"ءَاثَـٰرِهِم","en_gloss":"their footsteps","transliteration":"āthārihim","verse_key":"43:22"},{"pos":11,"ar":"مُّهْتَدُونَ","en_gloss":"(are) guided","transliteration":"muh'tadūna","verse_key":"43:22"},{"pos":12,"ar":"٢٢","en_gloss":"(22)","transliteration":"","verse_key":"43:22"}]}]}