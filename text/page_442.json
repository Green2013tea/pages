{"page":442,"verses":[{"verse_key":"36:28","surah":36,"ayah":28,"ar_uthmani":"۞ وَمَآ أَنزَلْنَا عَلَىٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندٍ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ","en_translation_id":85,"en":"After him We did not send any army from heaven against his people, nor were We about to:","words":[{"pos":1,"ar":"۞ وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"36:28"},{"pos":2,"ar":"أَنزَلْنَا","en_gloss":"We sent down","transliteration":"anzalnā","verse_key":"36:28"},{"pos":3,"ar":"عَلَىٰ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"36:28"},{"pos":4,"ar":"قَوْمِهِۦ","en_gloss":"his people","transliteration":"qawmihi","verse_key":"36:28"},{"pos":5,"ar":"مِنۢ","en_gloss":"after him","transliteration":"min","verse_key":"36:28"},{"pos":6,"ar":"بَعْدِهِۦ","en_gloss":"after him","transliteration":"baʿdihi","verse_key":"36:28"},{"pos":7,"ar":"مِن","en_gloss":"any","transliteration":"min","verse_key":"36:28"},{"pos":8,"ar":"جُندٍۢ","en_gloss":"host","transliteration":"jundin","verse_key":"36:28"},{"pos":9,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"36:28"},{"pos":10,"ar":"ٱلسَّمَآءِ","en_gloss":"the heaven","transliteration":"l-samāi","verse_key":"36:28"},{"pos":11,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"36:28"},{"pos":12,"ar":"كُنَّا","en_gloss":"were We","transliteration":"kunnā","verse_key":"36:28"},{"pos":13,"ar":"مُنزِلِينَ","en_gloss":"(to) send down","transliteration":"munzilīna","verse_key":"36:28"},{"pos":14,"ar":"٢٨","en_gloss":"(28)","transliteration":"","verse_key":"36:28"}]},{"verse_key":"36:29","surah":36,"ayah":29,"ar_uthmani":"إِن كَانَتْ إِلَّا صَيْحَةً وَٰحِدَةً فَإِذَا هُمْ خَـٰمِدُونَ","en_translation_id":85,"en":"there was just one blast, and they fell down lifeless.","words":[{"pos":1,"ar":"إِن","en_gloss":"Not","transliteration":"in","verse_key":"36:29"},{"pos":2,"ar":"كَانَتْ","en_gloss":"it was","transliteration":"kānat","verse_key":"36:29"},{"pos":3,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"36:29"},{"pos":4,"ar":"صَيْحَةًۭ","en_gloss":"a shout","transliteration":"ṣayḥatan","verse_key":"36:29"},{"pos":5,"ar":"وَٰحِدَةًۭ","en_gloss":"one","transliteration":"wāḥidatan","verse_key":"36:29"},{"pos":6,"ar":"فَإِذَا","en_gloss":"then behold","transliteration":"fa-idhā","verse_key":"36:29"},{"pos":7,"ar":"هُمْ","en_gloss":"They","transliteration":"hum","verse_key":"36:29"},{"pos":8,"ar":"خَـٰمِدُونَ","en_gloss":"(were) extinguished","transliteration":"khāmidūna","verse_key":"36:29"},{"pos":9,"ar":"٢٩","en_gloss":"(29)","transliteration":"","verse_key":"36:29"}]},{"verse_key":"36:30","surah":36,"ayah":30,"ar_uthmani":"يَـٰحَسْرَةً عَلَى ٱلْعِبَادِ ۚ مَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","en_translation_id":85,"en":"Alas for human beings! Whenever a messenger comes to them they ridicule him.","words":[{"pos":1,"ar":"يَـٰحَسْرَةً","en_gloss":"Alas","transliteration":"yāḥasratan","verse_key":"36:30"},{"pos":2,"ar":"عَلَى","en_gloss":"for","transliteration":"ʿalā","verse_key":"36:30"},{"pos":3,"ar":"ٱلْعِبَادِ ۚ","en_gloss":"the servants","transliteration":"l-ʿibādi","verse_key":"36:30"},{"pos":4,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"36:30"},{"pos":5,"ar":"يَأْتِيهِم","en_gloss":"came to them","transliteration":"yatīhim","verse_key":"36:30"},{"pos":6,"ar":"مِّن","en_gloss":"any","transliteration":"min","verse_key":"36:30"},{"pos":7,"ar":"رَّسُولٍ","en_gloss":"Messenger","transliteration":"rasūlin","verse_key":"36:30"},{"pos":8,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"36:30"},{"pos":9,"ar":"كَانُوا۟","en_gloss":"they did","transliteration":"kānū","verse_key":"36:30"},{"pos":10,"ar":"بِهِۦ","en_gloss":"mock at him","transliteration":"bihi","verse_key":"36:30"},{"pos":11,"ar":"يَسْتَهْزِءُونَ","en_gloss":"mock at him","transliteration":"yastahziūna","verse_key":"36:30"},{"pos":12,"ar":"٣٠","en_gloss":"(30)","transliteration":"","verse_key":"36:30"}]},{"verse_key":"36:31","surah":36,"ayah":31,"ar_uthmani":"أَلَمْ يَرَوْا۟ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ","en_translation_id":85,"en":"Do they not see how many generations We have destroyed before them, none of whom will ever come back to them?","words":[{"pos":1,"ar":"أَلَمْ","en_gloss":"Do not","transliteration":"alam","verse_key":"36:31"},{"pos":2,"ar":"يَرَوْا۟","en_gloss":"they see","transliteration":"yaraw","verse_key":"36:31"},{"pos":3,"ar":"كَمْ","en_gloss":"how many","transliteration":"kam","verse_key":"36:31"},{"pos":4,"ar":"أَهْلَكْنَا","en_gloss":"We destroyed","transliteration":"ahlaknā","verse_key":"36:31"},{"pos":5,"ar":"قَبْلَهُم","en_gloss":"before them","transliteration":"qablahum","verse_key":"36:31"},{"pos":6,"ar":"مِّنَ","en_gloss":"of","transliteration":"mina","verse_key":"36:31"},{"pos":7,"ar":"ٱلْقُرُونِ","en_gloss":"the generations","transliteration":"l-qurūni","verse_key":"36:31"},{"pos":8,"ar":"أَنَّهُمْ","en_gloss":"That they","transliteration":"annahum","verse_key":"36:31"},{"pos":9,"ar":"إِلَيْهِمْ","en_gloss":"to them","transliteration":"ilayhim","verse_key":"36:31"},{"pos":10,"ar":"لَا","en_gloss":"will not return","transliteration":"lā","verse_key":"36:31"},{"pos":11,"ar":"يَرْجِعُونَ","en_gloss":"will not return","transliteration":"yarjiʿūna","verse_key":"36:31"},{"pos":12,"ar":"٣١","en_gloss":"(31)","transliteration":"","verse_key":"36:31"}]},{"verse_key":"36:32","surah":36,"ayah":32,"ar_uthmani":"وَإِن كُلٌّ لَّمَّا جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ","en_translation_id":85,"en":"[Yet] all of them will be brought before Us.","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And surely","transliteration":"wa-in","verse_key":"36:32"},{"pos":2,"ar":"كُلٌّۭ","en_gloss":"all","transliteration":"kullun","verse_key":"36:32"},{"pos":3,"ar":"لَّمَّا","en_gloss":"then","transliteration":"lammā","verse_key":"36:32"},{"pos":4,"ar":"جَمِيعٌۭ","en_gloss":"together","transliteration":"jamīʿun","verse_key":"36:32"},{"pos":5,"ar":"لَّدَيْنَا","en_gloss":"before Us","transliteration":"ladaynā","verse_key":"36:32"},{"pos":6,"ar":"مُحْضَرُونَ","en_gloss":"(will be) brought","transliteration":"muḥ'ḍarūna","verse_key":"36:32"},{"pos":7,"ar":"٣٢","en_gloss":"(32)","transliteration":"","verse_key":"36:32"}]},{"verse_key":"36:33","surah":36,"ayah":33,"ar_uthmani":"وَءَايَةٌ لَّهُمُ ٱلْأَرْضُ ٱلْمَيْتَةُ أَحْيَيْنَـٰهَا وَأَخْرَجْنَا مِنْهَا حَبًّا فَمِنْهُ يَأْكُلُونَ","en_translation_id":85,"en":"There is a sign for them in the lifeless earth: We give it life and We produce grain from it for them to eat;","words":[{"pos":1,"ar":"وَءَايَةٌۭ","en_gloss":"And a Sign","transliteration":"waāyatun","verse_key":"36:33"},{"pos":2,"ar":"لَّهُمُ","en_gloss":"for them","transliteration":"lahumu","verse_key":"36:33"},{"pos":3,"ar":"ٱلْأَرْضُ","en_gloss":"(is) the earth","transliteration":"l-arḍu","verse_key":"36:33"},{"pos":4,"ar":"ٱلْمَيْتَةُ","en_gloss":"dead","transliteration":"l-maytatu","verse_key":"36:33"},{"pos":5,"ar":"أَحْيَيْنَـٰهَا","en_gloss":"We give it life","transliteration":"aḥyaynāhā","verse_key":"36:33"},{"pos":6,"ar":"وَأَخْرَجْنَا","en_gloss":"and We bring forth","transliteration":"wa-akhrajnā","verse_key":"36:33"},{"pos":7,"ar":"مِنْهَا","en_gloss":"from it","transliteration":"min'hā","verse_key":"36:33"},{"pos":8,"ar":"حَبًّۭا","en_gloss":"grain","transliteration":"ḥabban","verse_key":"36:33"},{"pos":9,"ar":"فَمِنْهُ","en_gloss":"and from it","transliteration":"famin'hu","verse_key":"36:33"},{"pos":10,"ar":"يَأْكُلُونَ","en_gloss":"they eat","transliteration":"yakulūna","verse_key":"36:33"},{"pos":11,"ar":"٣٣","en_gloss":"(33)","transliteration":"","verse_key":"36:33"}]},{"verse_key":"36:34","surah":36,"ayah":34,"ar_uthmani":"وَجَعَلْنَا فِيهَا جَنَّـٰتٍ مِّن نَّخِيلٍ وَأَعْنَـٰبٍ وَفَجَّرْنَا فِيهَا مِنَ ٱلْعُيُونِ","en_translation_id":85,"en":"We have put gardens of date palms and grapes in the earth, and We have made springs of water gush out of it","words":[{"pos":1,"ar":"وَجَعَلْنَا","en_gloss":"And We placed","transliteration":"wajaʿalnā","verse_key":"36:34"},{"pos":2,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"36:34"},{"pos":3,"ar":"جَنَّـٰتٍۢ","en_gloss":"gardens","transliteration":"jannātin","verse_key":"36:34"},{"pos":4,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"36:34"},{"pos":5,"ar":"نَّخِيلٍۢ","en_gloss":"date-palms","transliteration":"nakhīlin","verse_key":"36:34"},{"pos":6,"ar":"وَأَعْنَـٰبٍۢ","en_gloss":"and grapevines","transliteration":"wa-aʿnābin","verse_key":"36:34"},{"pos":7,"ar":"وَفَجَّرْنَا","en_gloss":"and We caused to gush forth","transliteration":"wafajjarnā","verse_key":"36:34"},{"pos":8,"ar":"فِيهَا","en_gloss":"in it","transliteration":"fīhā","verse_key":"36:34"},{"pos":9,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"36:34"},{"pos":10,"ar":"ٱلْعُيُونِ","en_gloss":"the springs","transliteration":"l-ʿuyūni","verse_key":"36:34"},{"pos":11,"ar":"٣٤","en_gloss":"(34)","transliteration":"","verse_key":"36:34"}]},{"verse_key":"36:35","surah":36,"ayah":35,"ar_uthmani":"لِيَأْكُلُوا۟ مِن ثَمَرِهِۦ وَمَا عَمِلَتْهُ أَيْدِيهِمْ ۖ أَفَلَا يَشْكُرُونَ","en_translation_id":85,"en":"so that they could eat its fruit. It was not their own hands that made all this. How can they not give thanks?","words":[{"pos":1,"ar":"لِيَأْكُلُوا۟","en_gloss":"That they may eat","transliteration":"liyakulū","verse_key":"36:35"},{"pos":2,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"36:35"},{"pos":3,"ar":"ثَمَرِهِۦ","en_gloss":"its fruit","transliteration":"thamarihi","verse_key":"36:35"},{"pos":4,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"36:35"},{"pos":5,"ar":"عَمِلَتْهُ","en_gloss":"made it","transliteration":"ʿamilathu","verse_key":"36:35"},{"pos":6,"ar":"أَيْدِيهِمْ ۖ","en_gloss":"their hands","transliteration":"aydīhim","verse_key":"36:35"},{"pos":7,"ar":"أَفَلَا","en_gloss":"So will not","transliteration":"afalā","verse_key":"36:35"},{"pos":8,"ar":"يَشْكُرُونَ","en_gloss":"they be grateful","transliteration":"yashkurūna","verse_key":"36:35"},{"pos":9,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"36:35"}]},{"verse_key":"36:36","surah":36,"ayah":36,"ar_uthmani":"سُبْحَـٰنَ ٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ","en_translation_id":85,"en":"Glory be to Him who created all the pairs of things that the earth produces, as well as themselves and other things they do not know about.","words":[{"pos":1,"ar":"سُبْحَـٰنَ","en_gloss":"Glory be","transliteration":"sub'ḥāna","verse_key":"36:36"},{"pos":2,"ar":"ٱلَّذِى","en_gloss":"(to) the One Who","transliteration":"alladhī","verse_key":"36:36"},{"pos":3,"ar":"خَلَقَ","en_gloss":"created","transliteration":"khalaqa","verse_key":"36:36"},{"pos":4,"ar":"ٱلْأَزْوَٰجَ","en_gloss":"(in) pairs","transliteration":"l-azwāja","verse_key":"36:36"},{"pos":5,"ar":"كُلَّهَا","en_gloss":"all","transliteration":"kullahā","verse_key":"36:36"},{"pos":6,"ar":"مِمَّا","en_gloss":"of what","transliteration":"mimmā","verse_key":"36:36"},{"pos":7,"ar":"تُنۢبِتُ","en_gloss":"grows","transliteration":"tunbitu","verse_key":"36:36"},{"pos":8,"ar":"ٱلْأَرْضُ","en_gloss":"the earth","transliteration":"l-arḍu","verse_key":"36:36"},{"pos":9,"ar":"وَمِنْ","en_gloss":"and of","transliteration":"wamin","verse_key":"36:36"},{"pos":10,"ar":"أَنفُسِهِمْ","en_gloss":"themselves","transliteration":"anfusihim","verse_key":"36:36"},{"pos":11,"ar":"وَمِمَّا","en_gloss":"and of what","transliteration":"wamimmā","verse_key":"36:36"},{"pos":12,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"36:36"},{"pos":13,"ar":"يَعْلَمُونَ","en_gloss":"they know","transliteration":"yaʿlamūna","verse_key":"36:36"},{"pos":14,"ar":"٣٦","en_gloss":"(36)","transliteration":"","verse_key":"36:36"}]},{"verse_key":"36:37","surah":36,"ayah":37,"ar_uthmani":"وَءَايَةٌ لَّهُمُ ٱلَّيْلُ نَسْلَخُ مِنْهُ ٱلنَّهَارَ فَإِذَا هُم مُّظْلِمُونَ","en_translation_id":85,"en":"The night is also a sign for them: We strip the daylight from it, and- lo and behold!- they are in darkness.","words":[{"pos":1,"ar":"وَءَايَةٌۭ","en_gloss":"And a Sign","transliteration":"waāyatun","verse_key":"36:37"},{"pos":2,"ar":"لَّهُمُ","en_gloss":"for them","transliteration":"lahumu","verse_key":"36:37"},{"pos":3,"ar":"ٱلَّيْلُ","en_gloss":"(is) the night","transliteration":"al-laylu","verse_key":"36:37"},{"pos":4,"ar":"نَسْلَخُ","en_gloss":"We withdraw","transliteration":"naslakhu","verse_key":"36:37"},{"pos":5,"ar":"مِنْهُ","en_gloss":"from it","transliteration":"min'hu","verse_key":"36:37"},{"pos":6,"ar":"ٱلنَّهَارَ","en_gloss":"the day","transliteration":"l-nahāra","verse_key":"36:37"},{"pos":7,"ar":"فَإِذَا","en_gloss":"Then behold","transliteration":"fa-idhā","verse_key":"36:37"},{"pos":8,"ar":"هُم","en_gloss":"They","transliteration":"hum","verse_key":"36:37"},{"pos":9,"ar":"مُّظْلِمُونَ","en_gloss":"(are) those in darkness","transliteration":"muẓ'limūna","verse_key":"36:37"},{"pos":10,"ar":"٣٧","en_gloss":"(37)","transliteration":"","verse_key":"36:37"}]},{"verse_key":"36:38","surah":36,"ayah":38,"ar_uthmani":"وَٱلشَّمْسُ تَجْرِى لِمُسْتَقَرٍّ لَّهَا ۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ","en_translation_id":85,"en":"The sun, too, runs its determined course laid down for it by the Almighty, the All Knowing.","words":[{"pos":1,"ar":"وَٱلشَّمْسُ","en_gloss":"And the sun","transliteration":"wal-shamsu","verse_key":"36:38"},{"pos":2,"ar":"تَجْرِى","en_gloss":"runs","transliteration":"tajrī","verse_key":"36:38"},{"pos":3,"ar":"لِمُسْتَقَرٍّۢ","en_gloss":"to a term appointed","transliteration":"limus'taqarrin","verse_key":"36:38"},{"pos":4,"ar":"لَّهَا ۚ","en_gloss":"for it","transliteration":"lahā","verse_key":"36:38"},{"pos":5,"ar":"ذَٰلِكَ","en_gloss":"That","transliteration":"dhālika","verse_key":"36:38"},{"pos":6,"ar":"تَقْدِيرُ","en_gloss":"(is the) Decree","transliteration":"taqdīru","verse_key":"36:38"},{"pos":7,"ar":"ٱلْعَزِيزِ","en_gloss":"(of) the All-Mighty","transliteration":"l-ʿazīzi","verse_key":"36:38"},{"pos":8,"ar":"ٱلْعَلِيمِ","en_gloss":"the All-Knowing","transliteration":"l-ʿalīmi","verse_key":"36:38"},{"pos":9,"ar":"٣٨","en_gloss":"(38)","transliteration":"","verse_key":"36:38"}]},{"verse_key":"36:39","surah":36,"ayah":39,"ar_uthmani":"وَٱلْقَمَرَ قَدَّرْنَـٰهُ مَنَازِلَ حَتَّىٰ عَادَ كَٱلْعُرْجُونِ ٱلْقَدِيمِ","en_translation_id":85,"en":"We have determined phases for the moon until finally it becomes like an old date-stalk.","words":[{"pos":1,"ar":"وَٱلْقَمَرَ","en_gloss":"And the moon ","transliteration":"wal-qamara","verse_key":"36:39"},{"pos":2,"ar":"قَدَّرْنَـٰهُ","en_gloss":"We have ordained for it","transliteration":"qaddarnāhu","verse_key":"36:39"},{"pos":3,"ar":"مَنَازِلَ","en_gloss":"phases","transliteration":"manāzila","verse_key":"36:39"},{"pos":4,"ar":"حَتَّىٰ","en_gloss":"until","transliteration":"ḥattā","verse_key":"36:39"},{"pos":5,"ar":"عَادَ","en_gloss":"it returns","transliteration":"ʿāda","verse_key":"36:39"},{"pos":6,"ar":"كَٱلْعُرْجُونِ","en_gloss":"like the date stalk","transliteration":"kal-ʿur'jūni","verse_key":"36:39"},{"pos":7,"ar":"ٱلْقَدِيمِ","en_gloss":"the old","transliteration":"l-qadīmi","verse_key":"36:39"},{"pos":8,"ar":"٣٩","en_gloss":"(39)","transliteration":"","verse_key":"36:39"}]},{"verse_key":"36:40","surah":36,"ayah":40,"ar_uthmani":"لَا ٱلشَّمْسُ يَنۢبَغِى لَهَآ أَن تُدْرِكَ ٱلْقَمَرَ وَلَا ٱلَّيْلُ سَابِقُ ٱلنَّهَارِ ۚ وَكُلٌّ فِى فَلَكٍ يَسْبَحُونَ","en_translation_id":85,"en":"The sun cannot overtake the moon, nor can the night outrun the day: each floats in [its own] orbit.","words":[{"pos":1,"ar":"لَا","en_gloss":"Not","transliteration":"lā","verse_key":"36:40"},{"pos":2,"ar":"ٱلشَّمْسُ","en_gloss":"the sun","transliteration":"l-shamsu","verse_key":"36:40"},{"pos":3,"ar":"يَنۢبَغِى","en_gloss":"is permitted","transliteration":"yanbaghī","verse_key":"36:40"},{"pos":4,"ar":"لَهَآ","en_gloss":"for it ","transliteration":"lahā","verse_key":"36:40"},{"pos":5,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"36:40"},{"pos":6,"ar":"تُدْرِكَ","en_gloss":"it overtakes","transliteration":"tud'rika","verse_key":"36:40"},{"pos":7,"ar":"ٱلْقَمَرَ","en_gloss":"the moon","transliteration":"l-qamara","verse_key":"36:40"},{"pos":8,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"36:40"},{"pos":9,"ar":"ٱلَّيْلُ","en_gloss":"the night","transliteration":"al-laylu","verse_key":"36:40"},{"pos":10,"ar":"سَابِقُ","en_gloss":"(can) outstrip","transliteration":"sābiqu","verse_key":"36:40"},{"pos":11,"ar":"ٱلنَّهَارِ ۚ","en_gloss":"the day","transliteration":"l-nahāri","verse_key":"36:40"},{"pos":12,"ar":"وَكُلٌّۭ","en_gloss":"but all","transliteration":"wakullun","verse_key":"36:40"},{"pos":13,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"36:40"},{"pos":14,"ar":"فَلَكٍۢ","en_gloss":"an orbit","transliteration":"falakin","verse_key":"36:40"},{"pos":15,"ar":"يَسْبَحُونَ","en_gloss":"they are floating","transliteration":"yasbaḥūna","verse_key":"36:40"},{"pos":16,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"36:40"}]}]}