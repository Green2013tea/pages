ater in number, will be of no use to you. God is with the believers.","words":[{"pos":1,"ar":"إِن","en_gloss":"If","transliteration":"in","verse_key":"8:19"},{"pos":2,"ar":"تَسْتَفْتِحُوا۟","en_gloss":"you ask for victory","transliteration":"tastaftiḥū","verse_key":"8:19"},{"pos":3,"ar":"فَقَدْ","en_gloss":"then certainly","transliteration":"faqad","verse_key":"8:19"},{"pos":4,"ar":"جَآءَكُمُ","en_gloss":"has come to you","transliteration":"jāakumu","verse_key":"8:19"},{"pos":5,"ar":"ٱلْفَتْحُ ۖ","en_gloss":"the victory","transliteration":"l-fatḥu","verse_key":"8:19"},{"pos":6,"ar":"وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"8:19"},{"pos":7,"ar":"تَنتَهُوا۟","en_gloss":"you desist","transliteration":"tantahū","verse_key":"8:19"},{"pos":8,"ar":"فَهُوَ","en_gloss":"then it (is)","transliteration":"fahuwa","verse_key":"8:19"},{"pos":9,"ar":"خَيْرٌۭ","en_gloss":"good","transliteration":"khayrun","verse_key":"8:19"},{"pos":10,"ar":"لَّكُمْ ۖ","en_gloss":"for you","transliteration":"lakum","verse_key":"8:19"},{"pos":11,"ar":"وَإِن","en_gloss":"but if","transliteration":"wa-in","verse_key":"8:19"},{"pos":12,"ar":"تَعُودُوا۟","en_gloss":"you return","transliteration":"taʿūdū","verse_key":"8:19"},{"pos":13,"ar":"نَعُدْ","en_gloss":"We will return (too)","transliteration":"naʿud","verse_key":"8:19"},{"pos":14,"ar":"وَلَن","en_gloss":"And never","transliteration":"walan","verse_key":"8:19"},{"pos":15,"ar":"تُغْنِىَ","en_gloss":"will avail","transliteration":"tugh'niya","verse_key":"8:19"},{"pos":16,"ar":"عَنكُمْ","en_gloss":"you","transliteration":"ʿankum","verse_key":"8:19"},{"pos":17,"ar":"فِئَتُكُمْ","en_gloss":"your forces","transliteration":"fi-atukum","verse_key":"8:19"},{"pos":18,"ar":"شَيْـًۭٔا","en_gloss":"anything","transliteration":"shayan","verse_key":"8:19"},{"pos":19,"ar":"وَلَوْ","en_gloss":"even if","transliteration":"walaw","verse_key":"8:19"},{"pos":20,"ar":"كَثُرَتْ","en_gloss":"(they are) numerous","transliteration":"kathurat","verse