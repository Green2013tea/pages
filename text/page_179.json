رَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ ۖ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَحُولُ بَيْنَ ٱلْمَرْءِ وَقَلْبِهِۦ وَأَنَّهُۥٓ إِلَيْهِ تُحْشَرُونَ","en_translation_id":85,"en":"Believers, respond to God and His Messenger when he calls you to that which gives you life. Know that God comes between a man and his heart, and that you will be gathered to Him.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"8:24"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"8:24"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"8:24"},{"pos":4,"ar":"ٱسْتَجِيبُوا۟","en_gloss":"Respond","transliteration":"is'tajībū","verse_key":"8:24"},{"pos":5,"ar":"لِلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"8:24"},{"pos":6,"ar":"وَلِلرَّسُولِ","en_gloss":"and His Messenger","transliteration":"walilrrasūli","verse_key":"8:24"},{"pos":7,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"8:24"},{"pos":8,"ar":"دَعَاكُمْ","en_gloss":"he calls you","transliteration":"daʿākum","verse_key":"8:24"},{"pos":9,"ar":"لِمَا","en_gloss":"to what","transliteration":"limā","verse_key":"8:24"},{"pos":10,"ar":"يُحْيِيكُمْ ۖ","en_gloss":"gives you life","transliteration":"yuḥ'yīkum","verse_key":"8:24"},{"pos":11,"ar":"وَٱعْلَمُوٓا۟","en_gloss":"And know","transliteration":"wa-iʿ'lamū","verse_key":"8:24"},{"pos":12,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"8:24"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:24"},{"pos":14,"ar":"يَحُولُ","en_gloss":"comes","transliteration":"yaḥūlu","verse_key":"8:24"},{"pos":15,"ar":"بَيْنَ","en_gloss":"(in) between","transliteration":"bayna","verse_key":"8:24"},{"pos":16,"ar":"ٱلْمَرْءِ","en_gloss":"a man","transliteration":"l-mari","verse_key":"8:24"},{"pos":17,"ar":"وَقَلْبِهِۦ","en_gloss":"and his heart","transliteration":"waqalbihi","verse_key":"8: