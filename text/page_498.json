pos":3,"ar":"مَا","en_gloss":"(is) what","transliteration":"mā","verse_key":"44:50"},{"pos":4,"ar":"كُنتُم","en_gloss":"you used to","transliteration":"kuntum","verse_key":"44:50"},{"pos":5,"ar":"بِهِۦ","en_gloss":"[about it]","transliteration":"bihi","verse_key":"44:50"},{"pos":6,"ar":"تَمْتَرُونَ","en_gloss":"doubt","transliteration":"tamtarūna","verse_key":"44:50"},{"pos":7,"ar":"٥٠","en_gloss":"(50)","transliteration":"","verse_key":"44:50"}]},{"verse_key":"44:51","surah":44,"ayah":51,"ar_uthmani":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ","en_translation_id":85,"en":"But those mindful of God will be in a safe place","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"44:51"},{"pos":2,"ar":"ٱلْمُتَّقِينَ","en_gloss":"the righteous","transliteration":"l-mutaqīna","verse_key":"44:51"},{"pos":3,"ar":"فِى","en_gloss":"(will be) in","transliteration":"fī","verse_key":"44:51"},{"pos":4,"ar":"مَقَامٍ","en_gloss":"a place","transliteration":"maqāmin","verse_key":"44:51"},{"pos":5,"ar":"أَمِينٍۢ","en_gloss":"secure","transliteration":"amīnin","verse_key":"44:51"},{"pos":6,"ar":"٥١","en_gloss":"(51)","transliteration":"","verse_key":"44:51"}]},{"verse_key":"44:52","surah":44,"ayah":52,"ar_uthmani":"فِى جَنَّـٰتٍ وَعُيُونٍ","en_translation_id":85,"en":"amid Gardens and springs,","words":[{"pos":1,"ar":"فِى","en_gloss":"In","transliteration":"fī","verse_key":"44:52"},{"pos":2,"ar":"جَنَّـٰتٍۢ","en_gloss":"gardens","transliteration":"jannātin","verse_key":"44:52"},{"pos":3,"ar":"وَعُيُونٍۢ","en_gloss":"and springs","transliteration":"waʿuyūnin","verse_key":"44:52"},{"pos":4,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"44:52"}]},{"verse_key":"44:53","surah":44,"ayah":53,"ar_uthmani":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ","en_translation_id":85,"en":"clothed in silk and fine brocade, facing one another:","words":[{"pos":1,"ar":"يَلْبَسُونَ","en_gloss":"Wearing garments","transliteration":"yalbasūna","verse_key":"44:53"},{"pos":2,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"44:53"},{"pos":3,"ar":"سُندُسٍۢ","en_gloss":"fine silk","transliteration":"sundusin","verse_key":"44:53"},{"pos":4,"ar":"وَإِسْتَبْرَقٍۢ","en_gloss":"and heavy silk","transliteration":"wa-is'tabraqin","verse_key":"44:53"},{"pos":5,"ar":"مُّتَقَـٰبِلِينَ","en_gloss":"facing each other","transliteration":"mutaqābilīna","verse_key":"44:53"},{"pos":6,"ar":"٥٣","en_gloss":"(53)","transliteration":"","verse_key":"44:53"}]},{"verse_key":"44:54","surah":44,"ayah":54,"ar_uthmani":"كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ","en_translation_id":85,"en":"so it will be. We shall wed them to maidens with large, dark eyes.","words":[{"pos":1,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"44:54"},{"pos":2,"ar":"وَزَوَّجْنَـٰهُم","en_gloss":"And We will marry them","transliteration":"wazawwajnāhum","verse_key":"44:54"},{"pos":3,"ar":"بِحُورٍ","en_gloss":"(to) companions with beautiful eyes","transliteration":"biḥūrin","verse_key":"44:54"},{"pos":4,"ar":"عِينٍۢ","en_gloss":"(to) companions with beautiful eyes","transliteration":"ʿīnin","verse_key":"44:54"},{"pos":5,"ar":"٥٤","en_gloss":"(54)","transliteration":"","verse_key":"44:54"}]},{"verse_key":"44:55","surah":44,"ayah":55,"ar_uthmani":"يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ","en_translation_id":85,"en":"Secure and contented, they will call for every kind of fruit.","words":[{"pos":1,"ar":"يَدْعُونَ","en_gloss":"They will call","transliteration":"yadʿūna","verse_key":"44:55"},{"pos":2,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"44:55"},{"pos":3,"ar":"بِكُلِّ","en_gloss":"for every (kind)","transliteration":"bikulli","verse_key":"44:55"},{"pos":4,"ar":"فَـٰكِهَةٍ","en_gloss":"(of) fruit","transliteration":"fākihatin","verse_key":"44:55"},{"pos":5,"ar":"ءَامِنِينَ","en_gloss":"secure","transliteration":"āminīna","verse_key":"44:55"},{"pos":6,"ar":"٥٥","en_gloss":"(55)","translite