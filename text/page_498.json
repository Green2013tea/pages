ُوَ","en_gloss":"it","transliteration":"huwa","verse_key":"44:57"},{"pos":6,"ar":"ٱلْفَوْزُ","en_gloss":"(will be) the success","transliteration":"l-fawzu","verse_key":"44:57"},{"pos":7,"ar":"ٱلْعَظِيمُ","en_gloss":"the great","transliteration":"l-ʿaẓīmu","verse_key":"44:57"},{"pos":8,"ar":"٥٧","en_gloss":"(57)","transliteration":"","verse_key":"44:57"}]},{"verse_key":"44:58","surah":44,"ayah":58,"ar_uthmani":"فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ","en_translation_id":85,"en":"We have made this Quran easy to understand- in your own language [Prophet]- so that they may take heed.","words":[{"pos":1,"ar":"فَإِنَّمَا","en_gloss":"Indeed","transliteration":"fa-innamā","verse_key":"44:58"},{"pos":2,"ar":"يَسَّرْنَـٰهُ","en_gloss":"We have made it easy","transliteration":"yassarnāhu","verse_key":"44:58"},{"pos":3,"ar":"بِلِسَانِكَ","en_gloss":"in your tongue","transliteration":"bilisānika","verse_key":"44:58"},{"pos":4,"ar":"لَعَلَّهُمْ","en_gloss":"so that they may","transliteration":"laʿallahum","verse_key":"44:58"},{"pos":5,"ar":"يَتَذَكَّرُونَ","en_gloss":"take heed","transliteration":"yatadhakkarūna","verse_key":"44:58"},{"pos":6,"ar":"٥٨","en_gloss":"(58)","transliteration":"","verse_key":"44:58"}]},{"verse_key":"44:59","surah":44,"ayah":59,"ar_uthmani":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ","en_translation_id":85,"en":"So wait; the disbelievers too are waiting.","words":[{"pos":1,"ar":"فَٱرْتَقِبْ","en_gloss":"So watch","transliteration":"fa-ir'taqib","verse_key":"44:59"},{"pos":2,"ar":"إِنَّهُم","en_gloss":"indeed, they","transliteration":"innahum","verse_key":"44:59"},{"pos":3,"ar":"مُّرْتَقِبُونَ","en_gloss":"(too are) watching","transliteration":"mur'taqibūna","verse_key":"44:59"},{"pos":4,"ar":"٥٩","en_gloss":"(59)","transliteration":"","verse_key":"44:59"}]}]}