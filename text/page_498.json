{"page":498,"verses":[{"verse_key":"44:40","surah":44,"ayah":40,"ar_uthmani":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ","en_translation_id":85,"en":"The Day of Decision is the time appointed for all;","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"44:40"},{"pos":2,"ar":"يَوْمَ","en_gloss":"(the) Day of Judgment","transliteration":"yawma","verse_key":"44:40"},{"pos":3,"ar":"ٱلْفَصْلِ","en_gloss":"(the) Day of Judgment","transliteration":"l-faṣli","verse_key":"44:40"},{"pos":4,"ar":"مِيقَـٰتُهُمْ","en_gloss":"(is) an appointed term for them","transliteration":"mīqātuhum","verse_key":"44:40"},{"pos":5,"ar":"أَجْمَعِينَ","en_gloss":"all","transliteration":"ajmaʿīna","verse_key":"44:40"},{"pos":6,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"44:40"}]},{"verse_key":"44:41","surah":44,"ayah":41,"ar_uthmani":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ","en_translation_id":85,"en":"a Day when no friend can take another’s place.","words":[{"pos":1,"ar":"يَوْمَ","en_gloss":"(The) Day","transliteration":"yawma","verse_key":"44:41"},{"pos":2,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"44:41"},{"pos":3,"ar":"يُغْنِى","en_gloss":"will avail","transliteration":"yugh'nī","verse_key":"44:41"},{"pos":4,"ar":"مَوْلًى","en_gloss":"a relation","transliteration":"mawlan","verse_key":"44:41"},{"pos":5,"ar":"عَن","en_gloss":"for","transliteration":"ʿan","verse_key":"44:41"},{"pos":6,"ar":"مَّوْلًۭى","en_gloss":"a relation","transliteration":"mawlan","verse_key":"44:41"},{"pos":7,"ar":"شَيْـًۭٔا","en_gloss":"anything","transliteration":"shayan","verse_key":"44:41"},{"pos":8,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"44:41"},{"pos":9,"ar":"هُمْ","en_gloss":"they","transliteration":"hum","verse_key":"44:41"},{"pos":10,"ar":"يُنصَرُونَ","en_gloss":"will be helped","transliteration":"yunṣarūna","verse_key":"44:41"},{"pos":11,"ar":"٤١","en_gloss":"(41)","t