uthmani":"إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَـٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا","en_translation_id":85,"en":"We have sent a messenger to you [people] to be your witness, just as We sent a messenger to Pharaoh,","words":[{"pos":1,"ar":"إِنَّآ","en_gloss":"Indeed, We","transliteration":"innā","verse_key":"73:15"},{"pos":2,"ar":"أَرْسَلْنَآ","en_gloss":"[We] have sent","transliteration":"arsalnā","verse_key":"73:15"},{"pos":3,"ar":"إِلَيْكُمْ","en_gloss":"to you","transliteration":"ilaykum","verse_key":"73:15"},{"pos":4,"ar":"رَسُولًۭا","en_gloss":"a Messenger","transliteration":"rasūlan","verse_key":"73:15"},{"pos":5,"ar":"شَـٰهِدًا","en_gloss":"(as) a witness","transliteration":"shāhidan","verse_key":"73:15"},{"pos":6,"ar":"عَلَيْكُمْ","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"73:15"},{"pos":7,"ar":"كَمَآ","en_gloss":"as","transliteration":"kamā","verse_key":"73:15"},{"pos":8,"ar":"أَرْسَلْنَآ","en_gloss":"We sent","transliteration":"arsalnā","verse_key":"73:15"},{"pos":9,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"73:15"},{"pos":10,"ar":"فِرْعَوْنَ","en_gloss":"Firaun","transliteration":"fir'ʿawna","verse_key":"73:15"},{"pos":11,"ar":"رَسُولًۭا","en_gloss":"a Messenger","transliteration":"rasūlan","verse_key":"73:15"},{"pos":12,"ar":"١٥","en_gloss":"(15)","transliteration":"","verse_key":"73:15"}]},{"verse_key":"73:16","surah":73,"ayah":16,"ar_uthmani":"فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَـٰهُ أَخْذًا وَبِيلًا","en_translation_id":85,"en":"but Pharaoh disobeyed the messenger and so We inflicted a heavy punishment on him.","words":[{"pos":1,"ar":"فَعَصَىٰ","en_gloss":"But disobeyed","transliteration":"faʿaṣā","verse_key":"73:16"},{"pos":2,"ar":"فِرْعَوْنُ","en_gloss":"Firaun","transliteration":"fir'ʿawnu","verse_key":"73:16"},{"pos":3,"ar":"ٱلرَّسُولَ","en_gloss":"the Messenger","transliteration":"l-rasūla","verse_key":"73:16"},{"pos":4,"ar":"فَأَخَذْنَـٰهُ","en_gloss":"so We seized him","transliteration":"fa-akhadhnāhu","verse_key":"73:16"},{"pos":5,"ar":"أَخْذًۭا","en_gloss":"(with) a seizure","transliteration":"akhdhan","verse_key":"73:16"},{"pos":6,"ar":"وَبِيلًۭا","en_gloss":"ruinous","transliteration":"wabīlan","verse_key":"73:16"},{"pos":7,"ar":"١٦","en_gloss":"(16)","transliteration":"","verse_key":"73:16"}]},{"verse_key":"73:17","surah":73,"ayah":17,"ar_uthmani":"فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا","en_translation_id":85,"en":"So if you disbelieve, how can you guard yourselves against a Day that will turn children’s hair grey,","words":[{"pos":1,"ar":"فَكَيْفَ","en_gloss":"Then how","transliteration":"fakayfa","verse_key":"73:17"},{"pos":2,"ar":"تَتَّقُونَ","en_gloss":"will you guard yourselves","transliteration":"tattaqūna","verse_key":"73:17"},{"pos":3,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"73:17"},{"pos":4,"ar":"كَفَرْتُمْ","en_gloss":"you disbelieve","transliteration":"kafartum","verse_key":"73:17"},{"pos":5,"ar":"يَوْمًۭا","en_gloss":"a Day","transliteration":"yawman","verse_key":"73:17"},{"pos":6,"ar":"يَجْعَلُ","en_gloss":"(that) will make","transliteration":"yajʿalu","verse_key":"73:17"},{"pos":7,"ar":"ٱلْوِلْدَٰنَ","en_gloss":"the children","transliteration":"l-wil'dāna","verse_key":"73:17"},{"pos":8,"ar":"شِيبًا","en_gloss":"gray-haired","transliteration":"shīban","verse_key":"73:17"},{"pos":9,"ar":"١٧","en_gloss":"(17)","transliteration":"","verse_key":"73:17"}]},{"verse_key":"73:18","surah":73,"ayah":18,"ar_uthmani":"ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦ ۚ كَانَ وَعْدُهُۥ مَفْعُولًا","en_translation_id":85,"en":"a Day when the sky will be torn apart? God’s promise will certainly be fulfilled.","words":[{"pos":1,"ar":"ٱلسَّمَآءُ","en_gloss":"The heaven","transliteration":"al-samāu","verse_key":"73:18"},{"pos":2,"ar":"مُنفَطِرٌۢ","en_gloss":"(will) break apart","transliteration":"munfaṭirun","verse_key":"73:18"},{"pos":3,"ar":"بِهِۦ ۚ","en_gloss":"therefrom","transliteration":"bihi","verse_key":"73:18"},{"pos":4,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"73:18"},{"pos":5,"ar":"وَعْدُهُۥ","en_gloss":"His Promise","transliteration":"waʿduhu","verse_key":"73:18"},{"pos":6,"ar":"مَفْعُولًا","en_gloss":"to be fulfilled","transliteration":"mafʿūlan","verse_key":"73:18"},{"pos":7,"ar":"١٨","en_gloss":"(18)","transliteration":"","verse_key":"73:18"}]},{"verse_key":"73:19","surah":73,"ayah":19,"ar_uthmani":"إِنَّ هَـٰذِهِۦ تَذْكِرَةٌ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","en_translation_id":85,"en":"This is a reminder. Let whoever wishes take the way to his Lord.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"73:19"},{"pos":2,"ar":"هَـٰذِهِۦ","en_gloss":"this","transliteration":"hādhihi","verse_key":"73:19"},{"pos":3,"ar":"تَذْكِرَةٌۭ ۖ","en_gloss":"(is) a Reminder","transliteration":"tadhkiratun","verse_key":"73:19"},{"pos":4,"ar":"فَمَن","en_gloss":"then whoever","transliteration":"faman","verse_key":"73:19"},{"pos":5,"ar":"شَآءَ","en_gloss":"wills","transliteration":"shāa","verse_key":"73:19"},{"pos":6,"ar":"ٱتَّخَذَ","en_gloss":"(let him) take","transliteration":"ittakhadha","verse_key":"73:19"},{"pos":7,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"73:19"},{"pos":8,"ar":"رَبِّهِۦ","en_gloss":"his Lord","transliteration":"rabbihi","verse_key":"73:19"},{"pos":9,"ar":"سَبِيلًا","en_gloss":"a way","transliteration":"sabīlan","verse_key":"73:19"},{"pos":10,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"73:19"}]}]}