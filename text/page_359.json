":14,"ar":"ٱلْمُلْكِ","en_gloss":"the dominion","transliteration":"l-mul'ki","verse_key":"25:2"},{"pos":15,"ar":"وَخَلَقَ","en_gloss":"and He (has) created","transliteration":"wakhalaqa","verse_key":"25:2"},{"pos":16,"ar":"كُلَّ","en_gloss":"every","transliteration":"kulla","verse_key":"25:2"},{"pos":17,"ar":"شَىْءٍۢ","en_gloss":"thing","transliteration":"shayin","verse_key":"25:2"},{"pos":18,"ar":"فَقَدَّرَهُۥ","en_gloss":"and determined it","transliteration":"faqaddarahu","verse_key":"25:2"},{"pos":19,"ar":"تَقْدِيرًۭا","en_gloss":"(with) determination","transliteration":"taqdīran","verse_key":"25:2"},{"pos":20,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"25:2"}]}]}