{"page":209,"verses":[{"verse_key":"10:7","surah":10,"ayah":7,"ar_uthmani":"إِنَّ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا وَرَضُوا۟ بِٱلْحَيَوٰةِ ٱلدُّنْيَا وَٱطْمَأَنُّوا۟ بِهَا وَٱلَّذِينَ هُمْ عَنْ ءَايَـٰتِنَا غَـٰفِلُونَ","en_translation_id":85,"en":"Those who do not expect to meet Us and are pleased with the life of this world, contenting themselves with it and paying no heed to Our signs,","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"10:7"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"10:7"},{"pos":3,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"10:7"},{"pos":4,"ar":"يَرْجُونَ","en_gloss":"expect","transliteration":"yarjūna","verse_key":"10:7"},{"pos":5,"ar":"لِقَآءَنَا","en_gloss":"the meeting with Us","transliteration":"liqāanā","verse_key":"10:7"},{"pos":6,"ar":"وَرَضُوا۟","en_gloss":"and are pleased","transliteration":"waraḍū","verse_key":"10:7"},{"pos":7,"ar":"بِٱلْحَيَوٰةِ","en_gloss":"with the life","transliteration":"bil-ḥayati","verse_key":"10:7"},{"pos":8,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"10:7"},{"pos":9,"ar":"وَٱطْمَأَنُّوا۟","en_gloss":"and feel satisfied","transliteration":"wa-iṭ'ma-annū","verse_key":"10:7"},{"pos":10,"ar":"بِهَا","en_gloss":"with it","transliteration":"bihā","verse_key":"10:7"},{"pos":11,"ar":"وَٱلَّذِينَ","en_gloss":"and those ","transliteration":"wa-alladhīna","verse_key":"10:7"},{"pos":12,"ar":"هُمْ","en_gloss":"they","transliteration":"hum","verse_key":"10:7"},{"pos":13,"ar":"عَنْ","en_gloss":"(are) of","transliteration":"ʿan","verse_key":"10:7"},{"pos":14,"ar":"ءَايَـٰتِنَا","en_gloss":"Our Signs","transliteration":"āyātinā","verse_key":"10:7"},{"pos":15,"ar":"غَـٰفِلُونَ","en_gloss":"heedless","transliteration":"ghāfilūna","verse_key":"10:7"},{"pos":16,"ar":"٧","en_gloss":"(7)","transliteration":"","verse_key":"10:7"}]},{"verse_key":"10:8","surah":10,"ayah":8,"ar_uthmani":"أُو۟لَـٰٓئِكَ مَأْوَىٰهُمُ ٱلنَّارُ بِمَا كَانُوا۟ يَكْسِبُونَ","en_translation_id":85,"en":"shall have the Fire for their home because of what they used to do.","words":[{"pos":1,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those ","transliteration":"ulāika","verse_key":"10:8"},{"pos":2,"ar":"مَأْوَىٰهُمُ","en_gloss":"their abode","transliteration":"mawāhumu","verse_key":"10:8"},{"pos":3,"ar":"ٱلنَّارُ","en_gloss":"(will be) the Fire","transliteration":"l-nāru","verse_key":"10:8"},{"pos":4,"ar":"بِمَا","en_gloss":"for what","transliteration":"bimā","verse_key":"10:8"},{"pos":5,"ar":"كَانُوا۟","en_gloss":"they used (to)","transliteration":"kānū","verse_key":"10:8"},{"pos":6,"ar":"يَكْسِبُونَ","en_gloss":"earn","transliteration":"yaksibūna","verse_key":"10:8"},{"pos":7,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"10:8"}]},{"verse_key":"10:9","surah":10,"ayah":9,"ar_uthmani":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ يَهْدِيهِمْ رَبُّهُم بِإِيمَـٰنِهِمْ ۖ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَـٰرُ فِى جَنَّـٰتِ ٱلنَّعِيمِ","en_translation_id":85,"en":"But as for those who believe and do good deeds, their Lord will guide them because of their faith. Streams will flow at their feet in the Gardens of Bliss.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"10:9"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"10:9"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believed","transliteration":"āmanū","verse_key":"10:9"},{"pos":4,"ar":"وَعَمِلُوا۟","en_gloss":"and did","transliteration":"waʿamilū","verse_key":"10:9"},{"pos":5,"ar":"ٱلصَّـٰلِحَـٰتِ","en_gloss":"good deeds","transliteration":"l-ṣāliḥāti","verse_key":"10:9"},{"pos":6,"ar":"يَهْدِيهِمْ","en_gloss":"(will) guide them","transliteration":"yahdīhim","verse_key":"10:9"},{"pos":7,"ar":"رَبُّهُم","en_gloss":"their Lord","transliteration":"rabbuhum","verse_key":"10:9"},{"pos":8,"ar":"بِإِيمَـٰنِهِمْ ۖ","en_gloss":"by their faith","transliteration":"biīmānihim","verse_key":"10:9"},{"pos":9,"ar":"تَجْرِى","en_gloss":"Will flow","transliteration":"tajrī","verse_key":"10:9"},{"pos":10,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"10:9"},{"pos":11,"ar":"تَحْتِهِمُ","en_gloss":"underneath them","transliteration":"taḥtihimu","verse_key":"10:9"},{"pos":12,"ar":"ٱلْأَنْهَـٰرُ","en_gloss":"the rivers","transliteration":"l-anhāru","verse_key":"10:9"},{"pos":13,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:9"},{"pos":14,"ar":"جَنَّـٰتِ","en_gloss":"Gardens","transliteration":"jannāti","verse_key":"10:9"},{"pos":15,"ar":"ٱلنَّعِيمِ","en_gloss":"(of) Delight","transliteration":"l-naʿīmi","verse_key":"10:9"},{"pos":16,"ar":"٩","en_gloss":"(9)","transliteration":"","verse_key":"10:9"}]},{"verse_key":"10:10","surah":10,"ayah":10,"ar_uthmani":"دَعْوَىٰهُمْ فِيهَا سُبْحَـٰنَكَ ٱللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا سَلَـٰمٌ ۚ وَءَاخِرُ دَعْوَىٰهُمْ أَنِ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","en_translation_id":85,"en":"Their prayer in them will be, ‘Glory be to You, God!’ their greeting, ‘Peace,’ and the last part of their prayer, ‘Praise be to God, Lord of the Worlds.’","words":[{"pos":1,"ar":"دَعْوَىٰهُمْ","en_gloss":"Their prayer","transliteration":"daʿwāhum","verse_key":"10:10"},{"pos":2,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"10:10"},{"pos":3,"ar":"سُبْحَـٰنَكَ","en_gloss":"(will be), \"Glory be to You","transliteration":"sub'ḥānaka","verse_key":"10:10"},{"pos":4,"ar":"ٱللَّهُمَّ","en_gloss":"O Allah","transliteration":"l-lahuma","verse_key":"10:10"},{"pos":5,"ar":"وَتَحِيَّتُهُمْ","en_gloss":"And their greeting","transliteration":"wataḥiyyatuhum","verse_key":"10:10"},{"pos":6,"ar":"فِيهَا","en_gloss":"therein (will be)","transliteration":"fīhā","verse_key":"10:10"},{"pos":7,"ar":"سَلَـٰمٌۭ ۚ","en_gloss":"Peace","transliteration":"salāmun","verse_key":"10:10"},{"pos":8,"ar":"وَءَاخِرُ","en_gloss":"And the last","transliteration":"waākhiru","verse_key":"10:10"},{"pos":9,"ar":"دَعْوَىٰهُمْ","en_gloss":"(of) their call","transliteration":"daʿwāhum","verse_key":"10:10"},{"pos":10,"ar":"أَنِ","en_gloss":"(will be) [that]","transliteration":"ani","verse_key":"10:10"},{"pos":11,"ar":"ٱلْحَمْدُ","en_gloss":"All the Praise be","transliteration":"l-ḥamdu","verse_key":"10:10"},{"pos":12,"ar":"لِلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"10:10"},{"pos":13,"ar":"رَبِّ","en_gloss":"Lord","transliteration":"rabbi","verse_key":"10:10"},{"pos":14,"ar":"ٱلْعَـٰلَمِينَ","en_gloss":"(of) the worlds","transliteration":"l-ʿālamīna","verse_key":"10:10"},{"pos":15,"ar":"١٠","en_gloss":"(10)","transliteration":"","verse_key":"10:10"}]},{"verse_key":"10:11","surah":10,"ayah":11,"ar_uthmani":"۞ وَلَوْ يُعَجِّلُ ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ ٱسْتِعْجَالَهُم بِٱلْخَيْرِ لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْ ۖ فَنَذَرُ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ","en_translation_id":85,"en":"If God were to hasten on for people the harm [they have earned] as they wish to hasten on the good, their time would already be up. But We leave those who do not expect to meet Us to wander blindly in their excesses.","words":[{"pos":1,"ar":"۞ وَلَوْ","en_gloss":"And if","transliteration":"walaw","verse_key":"10:11"},{"pos":2,"ar":"يُعَجِّلُ","en_gloss":"hastens","transliteration":"yuʿajjilu","verse_key":"10:11"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"(by) Allah","transliteration":"l-lahu","verse_key":"10:11"},{"pos":4,"ar":"لِلنَّاسِ","en_gloss":"for the mankind","transliteration":"lilnnāsi","verse_key":"10:11"},{"pos":5,"ar":"ٱلشَّرَّ","en_gloss":"the evil","transliteration":"l-shara","verse_key":"10:11"},{"pos":6,"ar":"ٱسْتِعْجَالَهُم","en_gloss":"(as) He hastens for them","transliteration":"is'tiʿ'jālahum","verse_key":"10:11"},{"pos":7,"ar":"بِٱلْخَيْرِ","en_gloss":"the good","transliteration":"bil-khayri","verse_key":"10:11"},{"pos":8,"ar":"لَقُضِىَ","en_gloss":"surely, would have been decreed","transliteration":"laquḍiya","verse_key":"10:11"},{"pos":9,"ar":"إِلَيْهِمْ","en_gloss":"for them","transliteration":"ilayhim","verse_key":"10:11"},{"pos":10,"ar":"أَجَلُهُمْ ۖ","en_gloss":"their term","transliteration":"ajaluhum","verse_key":"10:11"},{"pos":11,"ar":"فَنَذَرُ","en_gloss":"But We leave","transliteration":"fanadharu","verse_key":"10:11"},{"pos":12,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"10:11"},{"pos":13,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"10:11"},{"pos":14,"ar":"يَرْجُونَ","en_gloss":"expect","transliteration":"yarjūna","verse_key":"10:11"},{"pos":15,"ar":"لِقَآءَنَا","en_gloss":"the meeting with Us","transliteration":"liqāanā","verse_key":"10:11"},{"pos":16,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:11"},{"pos":17,"ar":"طُغْيَـٰنِهِمْ","en_gloss":"their transgression","transliteration":"ṭugh'yānihim","verse_key":"10:11"},{"pos":18,"ar":"يَعْمَهُونَ","en_gloss":"wandering blindly","transliteration":"yaʿmahūna","verse_key":"10:11"},{"pos":19,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"10:11"}]},{"verse_key":"10:12","surah":10,"ayah":12,"ar_uthmani":"وَإِذَا مَسَّ ٱلْإِنسَـٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوْ قَاعِدًا أَوْ قَآئِمًا فَلَمَّا كَشَفْنَا عَنْهُ ضُرَّهُۥ مَرَّ كَأَن لَّمْ يَدْعُنَآ إِلَىٰ ضُرٍّ مَّسَّهُۥ ۚ كَذَٰلِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُوا۟ يَعْمَلُونَ","en_translation_id":85,"en":"When trouble befalls man he cries out to Us, whether lying on his side, sitting, or standing, but as soon as We relieve him of his trouble he goes on his way as if he had never cried out to Us to remove his trouble. In this way the deeds of such heedless people are made attractive to them.","words":[{"pos":1,"ar":"وَإِذَا","en_gloss":"And when","transliteration":"wa-idhā","verse_key":"10:12"},{"pos":2,"ar":"مَسَّ","en_gloss":"touches","transliteration":"massa","verse_key":"10:12"},{"pos":3,"ar":"ٱلْإِنسَـٰنَ","en_gloss":"the man","transliteration":"l-insāna","verse_key":"10:12"},{"pos":4,"ar":"ٱلضُّرُّ","en_gloss":"the affliction","transliteration":"l-ḍuru","verse_key":"10:12"},{"pos":5,"ar":"دَعَانَا","en_gloss":"he calls Us","transliteration":"daʿānā","verse_key":"10:12"},{"pos":6,"ar":"لِجَنۢبِهِۦٓ","en_gloss":"(lying) on his side","transliteration":"lijanbihi","verse_key":"10:12"},{"pos":7,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"10:12"},{"pos":8,"ar":"قَاعِدًا","en_gloss":"sitting","transliteration":"qāʿidan","verse_key":"10:12"},{"pos":9,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"10:12"},{"pos":10,"ar":"قَآئِمًۭا","en_gloss":"standing","transliteration":"qāiman","verse_key":"10:12"},{"pos":11,"ar":"فَلَمَّا","en_gloss":"But when","transliteration":"falammā","verse_key":"10:12"},{"pos":12,"ar":"كَشَفْنَا","en_gloss":"We remove","transliteration":"kashafnā","verse_key":"10:12"},{"pos":13,"ar":"عَنْهُ","en_gloss":"from him","transliteration":"ʿanhu","verse_key":"10:12"},{"pos":14,"ar":"ضُرَّهُۥ","en_gloss":"his affliction","transliteration":"ḍurrahu","verse_key":"10:12"},{"pos":15,"ar":"مَرَّ","en_gloss":"he passes on","transliteration":"marra","verse_key":"10:12"},{"pos":16,"ar":"كَأَن","en_gloss":"as if he","transliteration":"ka-an","verse_key":"10:12"},{"pos":17,"ar":"لَّمْ","en_gloss":"(had) not","transliteration":"lam","verse_key":"10:12"},{"pos":18,"ar":"يَدْعُنَآ","en_gloss":"called Us","transliteration":"yadʿunā","verse_key":"10:12"},{"pos":19,"ar":"إِلَىٰ","en_gloss":"for","transliteration":"ilā","verse_key":"10:12"},{"pos":20,"ar":"ضُرٍّۢ","en_gloss":"(the) affliction","transliteration":"ḍurrin","verse_key":"10:12"},{"pos":21,"ar":"مَّسَّهُۥ ۚ","en_gloss":"(that) touched him","transliteration":"massahu","verse_key":"10:12"},{"pos":22,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"10:12"},{"pos":23,"ar":"زُيِّنَ","en_gloss":"(it) is made fair seeming","transliteration":"zuyyina","verse_key":"10:12"},{"pos":24,"ar":"لِلْمُسْرِفِينَ","en_gloss":"to the extravagant","transliteration":"lil'mus'rifīna","verse_key":"10:12"},{"pos":25,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"10:12"},{"pos":26,"ar":"كَانُوا۟","en_gloss":"they used (to)","transliteration":"kānū","verse_key":"10:12"},{"pos":27,"ar":"يَعْمَلُونَ","en_gloss":"do","transliteration":"yaʿmalūna","verse_key":"10:12"},{"pos":28,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"10:12"}]},{"verse_key":"10:13","surah":10,"ayah":13,"ar_uthmani":"وَلَقَدْ أَهْلَكْنَا ٱلْقُرُونَ مِن قَبْلِكُمْ لَمَّا ظَلَمُوا۟ ۙ وَجَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ وَمَا كَانُوا۟ لِيُؤْمِنُوا۟ ۚ كَذَٰلِكَ نَجْزِى ٱلْقَوْمَ ٱلْمُجْرِمِينَ","en_translation_id":85,"en":"Before you people, We destroyed whole generations when they did evil- their messengers brought them clear signs but they refused to believe. This is how We repay the guilty.","words":[{"pos":1,"ar":"وَلَقَدْ","en_gloss":"And verily","transliteration":"walaqad","verse_key":"10:13"},{"pos":2,"ar":"أَهْلَكْنَا","en_gloss":"We destroyed","transliteration":"ahlaknā","verse_key":"10:13"},{"pos":3,"ar":"ٱلْقُرُونَ","en_gloss":"the generations","transliteration":"l-qurūna","verse_key":"10:13"},{"pos":4,"ar":"مِن","en_gloss":"before you","transliteration":"min","verse_key":"10:13"},{"pos":5,"ar":"قَبْلِكُمْ","en_gloss":"before you","transliteration":"qablikum","verse_key":"10:13"},{"pos":6,"ar":"لَمَّا","en_gloss":"when","transliteration":"lammā","verse_key":"10:13"},{"pos":7,"ar":"ظَلَمُوا۟ ۙ","en_gloss":"they wronged","transliteration":"ẓalamū","verse_key":"10:13"},{"pos":8,"ar":"وَجَآءَتْهُمْ","en_gloss":"and came to them","transliteration":"wajāathum","verse_key":"10:13"},{"pos":9,"ar":"رُسُلُهُم","en_gloss":"their Messengers","transliteration":"rusuluhum","verse_key":"10:13"},{"pos":10,"ar":"بِٱلْبَيِّنَـٰتِ","en_gloss":"with clear proofs","transliteration":"bil-bayināti","verse_key":"10:13"},{"pos":11,"ar":"وَمَا","en_gloss":"but not","transliteration":"wamā","verse_key":"10:13"},{"pos":12,"ar":"كَانُوا۟","en_gloss":"they were","transliteration":"kānū","verse_key":"10:13"},{"pos":13,"ar":"لِيُؤْمِنُوا۟ ۚ","en_gloss":"to believe","transliteration":"liyu'minū","verse_key":"10:13"},{"pos":14,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"10:13"},{"pos":15,"ar":"نَجْزِى","en_gloss":"We recompense","transliteration":"najzī","verse_key":"10:13"},{"pos":16,"ar":"ٱلْقَوْمَ","en_gloss":"the people","transliteration":"l-qawma","verse_key":"10:13"},{"pos":17,"ar":"ٱلْمُجْرِمِينَ","en_gloss":"(who are) criminals","transliteration":"l-muj'rimīna","verse_key":"10:13"},{"pos":18,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"10:13"}]},{"verse_key":"10:14","surah":10,"ayah":14,"ar_uthmani":"ثُمَّ جَعَلْنَـٰكُمْ خَلَـٰٓئِفَ فِى ٱلْأَرْضِ مِنۢ بَعْدِهِمْ لِنَنظُرَ كَيْفَ تَعْمَلُونَ","en_translation_id":85,"en":"Later We made you their successors in the land, to see how you would behave.","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"10:14"},{"pos":2,"ar":"جَعَلْنَـٰكُمْ","en_gloss":"We made you","transliteration":"jaʿalnākum","verse_key":"10:14"},{"pos":3,"ar":"خَلَـٰٓئِفَ","en_gloss":"successors","transliteration":"khalāifa","verse_key":"10:14"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:14"},{"pos":5,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"10:14"},{"pos":6,"ar":"مِنۢ","en_gloss":"after them","transliteration":"min","verse_key":"10:14"},{"pos":7,"ar":"بَعْدِهِمْ","en_gloss":"after them","transliteration":"baʿdihim","verse_key":"10:14"},{"pos":8,"ar":"لِنَنظُرَ","en_gloss":"so that We may see","transliteration":"linanẓura","verse_key":"10:14"},{"pos":9,"ar":"كَيْفَ","en_gloss":"how","transliteration":"kayfa","verse_key":"10:14"},{"pos":10,"ar":"تَعْمَلُونَ","en_gloss":"you do","transliteration":"taʿmalūna","verse_key":"10:14"},{"pos":11,"ar":"١٤","en