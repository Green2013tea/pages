16"},{"pos":7,"ar":"ٱلْمُسْتَقِيمَ","en_gloss":"the straight","transliteration":"l-mus'taqīma","verse_key":"7:16"},{"pos":8,"ar":"١٦","en_gloss":"(16)","transliteration":"","verse_key":"7:16"}]},{"verse_key":"7:17","surah":7,"ayah":17,"ar_uthmani":"ثُمَّ لَـَٔاتِيَنَّهُم مِّنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْمَـٰنِهِمْ وَعَن شَمَآئِلِهِمْ ۖ وَلَا تَجِدُ أَكْثَرَهُمْ شَـٰكِرِينَ","en_translation_id":85,"en":"I will come at them- from their front and their back, from their right and their left- and You will find that most of them are ungrateful.’","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"7:17"},{"pos":2,"ar":"لَـَٔاتِيَنَّهُم","en_gloss":"surely, I will come to them","transliteration":"laātiyannahum","verse_key":"7:17"},{"pos":3,"ar":"مِّنۢ","en_gloss":"from","transliteration":"min","verse_key":"7:17"},{"pos":4,"ar":"بَيْنِ","en_gloss":"before","transliteration":"bayni","verse_key":"7:17"},{"pos":5,"ar":"أَيْدِيهِمْ","en_gloss":"them","transliteration":"aydīhim","verse_key":"7:17"},{"pos":6,"ar":"وَمِنْ","en_gloss":"and from","transliteration":"wamin","verse_key":"7:17"},{"pos":7,"ar":"خَلْفِهِمْ","en_gloss":"behind them","transliteration":"khalfihim","verse_key":"7:17"},{"pos":8,"ar":"وَعَنْ","en_gloss":"and from","transliteration":"waʿan","verse_key":"7:17"},{"pos":9,"ar":"أَيْمَـٰنِهِمْ","en_gloss":"their right","transliteration":"aymānihim","verse_key":"7:17"},{"pos":10,"ar":"وَعَن","en_gloss":"and from","transliteration":"waʿan","verse_key":"7:17"},{"pos":11,"ar":"شَمَآئِلِهِمْ ۖ","en_gloss":"their left","transliteration":"shamāilihim","verse_key":"7:17"},{"pos":12,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"7:17"},{"pos":13,"ar":"تَجِدُ","en_gloss":"You (will) find","transliteration":"tajidu","verse_key":"7:17"},{"pos":14,"ar":"أَكْثَرَهُمْ","en_gloss":"most of them","transliteration":"aktharahum","verse_key":"7:17"},{"pos":15,"ar":"شَـٰكِرِينَ","en_gloss":"grateful","t