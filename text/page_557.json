s":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"64:12"},{"pos":3,"ar":"وَأَطِيعُوا۟","en_gloss":"and obey","transliteration":"wa-aṭīʿū","verse_key":"64:12"},{"pos":4,"ar":"ٱلرَّسُولَ ۚ","en_gloss":"the Messenger","transliteration":"l-rasūla","verse_key":"64:12"},{"pos":5,"ar":"فَإِن","en_gloss":"but if","transliteration":"fa-in","verse_key":"64:12"},{"pos":6,"ar":"تَوَلَّيْتُمْ","en_gloss":"you turn away","transliteration":"tawallaytum","verse_key":"64:12"},{"pos":7,"ar":"فَإِنَّمَا","en_gloss":"then only","transliteration":"fa-innamā","verse_key":"64:12"},{"pos":8,"ar":"عَلَىٰ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"64:12"},{"pos":9,"ar":"رَسُولِنَا","en_gloss":"Our Messenger","transliteration":"rasūlinā","verse_key":"64:12"},{"pos":10,"ar":"ٱلْبَلَـٰغُ","en_gloss":"(is) the conveyance","transliteration":"l-balāghu","verse_key":"64:12"},{"pos":11,"ar":"ٱلْمُبِينُ","en_gloss":"clear","transliteration":"l-mubīnu","verse_key":"64:12"},{"pos":12,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"64:12"}]},{"verse_key":"64:13","surah":64,"ayah":13,"ar_uthmani":"ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ","en_translation_id":85,"en":"God! There is no god but Him, so let the faithful put their trust in Him.","words":[{"pos":1,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"al-lahu","verse_key":"64:13"},{"pos":2,"ar":"لَآ","en_gloss":"(there is) no","transliteration":"lā","verse_key":"64:13"},{"pos":3,"ar":"إِلَـٰهَ","en_gloss":"god","transliteration":"ilāha","verse_key":"64:13"},{"pos":4,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"64:13"},{"pos":5,"ar":"هُوَ ۚ","en_gloss":"Him","transliteration":"huwa","verse_key":"64:13"},{"pos":6,"ar":"وَعَلَى","en_gloss":"And upon","transliteration":"waʿalā","verse_key":"64:13"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"64:13"},{"pos":8,"ar":"فَلْيَتَوَكَّلِ","en_gloss":"let put (their) trust","transliteration":"falyatawakkali","verse_key":"64:13"},{"pos":9,"ar":"ٱلْمُؤْمِنُونَ","en_gloss":"the believers","transliteration":"l-mu'minūna","verse_key":"64:13"},{"pos":10,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"64:13"}]},{"verse_key":"64:14","surah":64,"ayah":14,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ مِنْ أَزْوَٰجِكُمْ وَأَوْلَـٰدِكُمْ عَدُوًّا لَّكُمْ فَٱحْذَرُوهُمْ ۚ وَإِن تَعْفُوا۟ وَتَصْفَحُوا۟ وَتَغْفِرُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ","en_translation_id":85,"en":"Believers, even among your spouses and your children you have some enemies- beware of them- but if you overlook their offences, forgive them, pardon them, then God is all forgiving, all merciful.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O","transliteration":"yāayyuhā","verse_key":"64:14"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"(you) who","transliteration":"alladhīna","verse_key":"64:14"},{"pos":3,"ar":"ءَامَنُوٓا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"64:14"},{"pos":4,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"64:14"},{"pos":5,"ar":"مِنْ","en_gloss":"from","transliteration":"min","verse_key":"64:14"},{"pos":6,"ar":"أَزْوَٰجِكُمْ","en_gloss":"your spouses","transliteration":"azwājikum","verse_key":"64:14"},{"pos":7,"ar":"وَأَوْلَـٰدِكُمْ","en_gloss":"and your children","transliteration":"wa-awlādikum","verse_key":"64:14"},{"pos":8,"ar":"عَدُوًّۭا","en_gloss":"(are) enemies","transliteration":"ʿaduwwan","verse_key":"64:14"},{"pos":9,"ar":"لَّكُمْ","en_gloss":"to you","transliteration":"lakum","verse_key":"64:14"},{"pos":10,"ar":"فَٱحْذَرُوهُمْ ۚ","en_gloss":"so beware of them","transliteration":"fa-iḥ'dharūhum","verse_key":"64:14"},{"pos":11,"ar":"وَإِن","en_gloss":"But if","transliteration":"wa-in","verse_key":"64:14"},{"pos":12,"ar":"تَعْفُوا۟","en_gloss":"you pardon","transliteration":"taʿfū","verse_key":"64:14"},{"pos":13,"ar":"وَتَصْفَحُوا۟","en_gloss":"and overlook","transliteration":"wataṣfaḥū","verse_key":"64:14"},{"pos":14,"ar":"وَتَغْفِرُوا۟","en_gloss":"and forgive","transliteration":"wataghfirū","verse_key":"64:14"},{"pos":15,"ar":"فَإِنَّ","en_gloss":"then indeed","transliteration":"fa-inna","verse_key":"64:14"},{"pos":16,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"64:14"},{"pos":17,"ar":"غَفُورٌۭ","en_gloss":"(is) Oft-Forgiving","transliteration":"ghafūrun","verse_key":"64:14"},{"pos":18,"ar":"رَّحِيمٌ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"64:14"},{"pos":19,"ar":"١٤","en_gloss":"(14)","transliteration":"","verse_key":"64:14"}]},{"verse_key":"64:15","surah":64,"ayah":15,"ar_uthmani":"إِنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ فِتْنَةٌ ۚ وَٱللَّهُ عِندَهُۥٓ أَجْرٌ عَظِيمٌ","en_translation_id":85,"en":"Your wealth and your children are only a test for you. There is great reward with God:","words":[{"pos":1,"ar":"إِنَّمَآ","en_gloss":"Only","transliteration":"innamā","verse_key":"64:15"},{"pos":2,"ar":"أَمْوَٰلُكُمْ","en_gloss":"your wealth","transliteration":"amwālukum","verse_key":"64:15"},{"pos":3,"ar":"وَأَوْلَـٰدُكُمْ","en_gloss":"and your children","transliteration":"wa-awlādukum","verse_key":"64:15"},{"pos":4,"ar":"فِتْنَةٌۭ ۚ","en_gloss":"(are) a trial","transliteration":"fit'natun","verse_key":"64:15"},{"pos":5,"ar":"وَٱللَّهُ","en_gloss":"and Allah ","transliteration":"wal-lahu","verse_key":"64:15"},{"pos":6,"ar":"عِندَهُۥٓ","en_gloss":"with Him","transliteration":"ʿindahu","verse_key":"64:15"},{"pos":7,"ar":"أَجْرٌ","en_gloss":"(is) a reward","transliteration":"ajrun","verse_key":"64:15"},{"pos":8,"ar":"عَظِيمٌۭ","en_gloss":"great","transliteration":"ʿaẓīmun","verse_key":"64:15"},{"pos":9,"ar":"١٥","en_gloss":"(15)","transliteration":"","verse_key":"64:15"}]},{"verse_key":"64:16","surah":64,"ayah":16,"ar_uthmani":"فَٱتَّقُوا۟ ٱللَّهَ مَا ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًا لِّأَنفُسِكُمْ ۗ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ","en_translation_id":85,"en":"be mindful of God as much as you can; hear and obey; be charitable- it is for your own good. Those who are saved from their own meanness will be the prosperous ones:","words":[{"pos":1,"ar":"فَٱتَّقُوا۟","en_gloss":"So fear","transliteration":"fa-ittaqū","verse_key":"64:16"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"64:16"},{"pos":3,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"64:16"},{"pos":4,"ar":"ٱسْتَطَعْتُمْ","en_gloss":"you are able","transliteration":"is'taṭaʿtum","verse_key":"64:16"},{"pos":5,"ar":"وَٱسْمَعُوا۟","en_gloss":"and listen","transliteration":"wa-is'maʿū","verse_key":"64:16"},{"pos":6,"ar":"وَأَطِيعُوا۟","en_gloss":"and obey","transliteration":"wa-aṭīʿū","verse_key":"64:16"},{"pos":7,"ar":"وَأَنفِقُوا۟","en_gloss":"and spend","transliteration":"wa-anfiqū","verse_key":"64:16"},{"pos":8,"ar":"خَيْرًۭا","en_gloss":"(it is) better","transliteration":"khayran","verse_key":"64:16"},{"pos":9,"ar":"لِّأَنفُسِكُمْ ۗ","en_gloss":"for yourselves","transliteration":"li-anfusikum","verse_key":"64:16"},{"pos":10,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"64:16"},{"pos":11,"ar":"يُوقَ","en_gloss":"is saved","transliteration":"yūqa","verse_key":"64:16"},{"pos":12,"ar":"شُحَّ","en_gloss":"(from the) greediness","transliteration":"shuḥḥa","verse_key":"64:16"},{"pos":13,"ar":"نَفْسِهِۦ","en_gloss":"(of) his soul","transliteration":"nafsihi","verse_key":"64:16"},{"pos":14,"ar":"فَأُو۟لَـٰٓئِكَ","en_gloss":"then those","transliteration":"fa-ulāika","verse_key":"64:16"},{"pos":15,"ar":"هُمُ","en_gloss":"[they]","transliteration":"humu","verse_key":"64:16"},{"pos":16,"ar":"ٱلْمُفْلِحُونَ","en_gloss":"(are) the successful ones","transliteration":"l-muf'liḥūna","verse_key":"64:16"},{"pos":17,"ar":"١٦","en_gloss":"(16)","transliteration":"","verse_key":"64:16"}]},{"verse_key":"64:17","surah":64,"ayah":17,"ar_uthmani":"