ِتَـٰبٌ عَزِيزٌ","en_translation_id":85,"en":"Those who reject the Quran when it comes to them- though it is an unassailable Scripture","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"41:41"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"41:41"},{"pos":3,"ar":"كَفَرُوا۟","en_gloss":"disbelieve","transliteration":"kafarū","verse_key":"41:41"},{"pos":4,"ar":"بِٱلذِّكْرِ","en_gloss":"in the Reminder","transliteration":"bil-dhik'ri","verse_key":"41:41"},{"pos":5,"ar":"لَمَّا","en_gloss":"when","transliteration":"lammā","verse_key":"41:41"},{"pos":6,"ar":"جَآءَهُمْ ۖ","en_gloss":"it comes to them","transliteration":"jāahum","verse_key":"41:41"},{"pos":7,"ar":"وَإِنَّهُۥ","en_gloss":"And indeed, it","transliteration":"wa-innahu","verse_key":"41:41"},{"pos":8,"ar":"لَكِتَـٰبٌ","en_gloss":"(is) surely a Book","transliteration":"lakitābun","verse_key":"41:41"},{"pos":9,"ar":"عَزِيزٌۭ","en_gloss":"mighty","transliteration":"ʿazīzun","verse_key":"41:41"},{"pos":10,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"41:41"}]},{"verse_key":"41:42","surah":41,"ayah":42,"ar_uthmani":"لَّا يَأْتِيهِ ٱلْبَـٰطِلُ مِنۢ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِۦ ۖ تَنزِيلٌ مِّنْ حَكِيمٍ حَمِيدٍ","en_translation_id":85,"en":"which falsehood cannot touch from any angle, a Revelation sent down from the Wise One, Worthy of All Praise-","words":[{"pos":1,"ar":"لَّا","en_gloss":"Not","transliteration":"lā","verse_key":"41:42"},{"pos":2,"ar":"يَأْتِيهِ","en_gloss":"comes to it","transliteration":"yatīhi","verse_key":"41:42"},{"pos":3,"ar":"ٱلْبَـٰطِلُ","en_gloss":"the falsehood","transliteration":"l-bāṭilu","verse_key":"41:42"},{"pos":4,"ar":"مِنۢ","en_gloss":"from","transliteration":"min","verse_key":"41:42"},{"pos":5,"ar":"بَيْنِ","en_gloss":"before it","transliteration":"bayni","verse_key":"41:42"},{"pos":6,"ar":"يَدَيْهِ","en_gloss":"before it","transliteration":"yadayhi","verse_key":"41:42"},{"pos