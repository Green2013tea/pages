مُوتُ ۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرٌۢ","en_translation_id":85,"en":"Knowledge of the Hour [of Resurrection] belongs to God; it is He who sends down the relieving rain and He who knows what is hidden in the womb. No soul knows what it will reap tomorrow, and no soul knows in what land it will die; it is God who is all knowing and all aware.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"31:34"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"31:34"},{"pos":3,"ar":"عِندَهُۥ","en_gloss":"with Him","transliteration":"ʿindahu","verse_key":"31:34"},{"pos":4,"ar":"عِلْمُ","en_gloss":"(is the) knowledge","transliteration":"ʿil'mu","verse_key":"31:34"},{"pos":5,"ar":"ٱلسَّاعَةِ","en_gloss":"(of) the Hour","transliteration":"l-sāʿati","verse_key":"31:34"},{"pos":6,"ar":"وَيُنَزِّلُ","en_gloss":"and He sends down","transliteration":"wayunazzilu","verse_key":"31:34"},{"pos":7,"ar":"ٱلْغَيْثَ","en_gloss":"the rain","transliteration":"l-ghaytha","verse_key":"31:34"},{"pos":8,"ar":"وَيَعْلَمُ","en_gloss":"and knows","transliteration":"wayaʿlamu","verse_key":"31:34"},{"pos":9,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"31:34"},{"pos":10,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"31:34"},{"pos":11,"ar":"ٱلْأَرْحَامِ ۖ","en_gloss":"the wombs","transliteration":"l-arḥāmi","verse_key":"31:34"},{"pos":12,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"31:34"},{"pos":13,"ar":"تَدْرِى","en_gloss":"knows","transliteration":"tadrī","verse_key":"31:34"},{"pos":14,"ar":"نَفْسٌۭ","en_gloss":"any soul","transliteration":"nafsun","verse_key":"31:34"},{"pos":15,"ar":"مَّاذَا","en_gloss":"what","transliteration":"mādhā","verse_key":"31:34"},{"pos":16,"ar":"تَكْسِبُ","en_gloss":"it will earn","transliteration":"taksibu","verse_key":"31:34"},{"pos":17,"ar":"غَدًۭا ۖ","en_gloss":"tomorrow","transliteration":"ghadan","verse_key":"31:34"},{"pos":18,"ar":"و