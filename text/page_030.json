y":"2:192"},{"pos":6,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"2:192"},{"pos":7,"ar":"١٩٢","en_gloss":"(192)","transliteration":"","verse_key":"2:192"}]},{"verse_key":"2:193","surah":2,"ayah":193,"ar_uthmani":"وَقَـٰتِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَةٌ وَيَكُونَ ٱلدِّينُ لِلَّهِ ۖ فَإِنِ ٱنتَهَوْا۟ فَلَا عُدْوَٰنَ إِلَّا عَلَى ٱلظَّـٰلِمِينَ","en_translation_id":85,"en":"Fight them until there is no more persecution, and worship is devoted to God. If they cease hostilities, there can be no [further] hostility, except towards aggressors.","words":[{"pos":1,"ar":"وَقَـٰتِلُوهُمْ","en_gloss":"And fight (against) them","transliteration":"waqātilūhum","verse_key":"2:193"},{"pos":2,"ar":"حَتَّىٰ","en_gloss":"until","transliteration":"ḥattā","verse_key":"2:193"},{"pos":3,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"2:193"},{"pos":4,"ar":"تَكُونَ","en_gloss":"(there) is","transliteration":"takūna","verse_key":"2:193"},{"pos":5,"ar":"فِتْنَةٌۭ","en_gloss":"oppression","transliteration":"fit'natun","verse_key":"2:193"},{"pos":6,"ar":"وَيَكُونَ","en_gloss":"and becomes","transliteration":"wayakūna","verse_key":"2:193"},{"pos":7,"ar":"ٱلدِّينُ","en_gloss":"the religion","transliteration":"l-dīnu","verse_key":"2:193"},{"pos":8,"ar":"لِلَّهِ ۖ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"2:193"},{"pos":9,"ar":"فَإِنِ","en_gloss":"Then if","transliteration":"fa-ini","verse_key":"2:193"},{"pos":10,"ar":"ٱنتَهَوْا۟","en_gloss":"they cease","transliteration":"intahaw","verse_key":"2:193"},{"pos":11,"ar":"فَلَا","en_gloss":"then (let there be) no","transliteration":"falā","verse_key":"2:193"},{"pos":12,"ar":"عُدْوَٰنَ","en_gloss":"hostility","transliteration":"ʿud'wāna","verse_key":"2:193"},{"pos":13,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"2:193"},{"pos":14,"ar":"عَلَى","en_gloss":"against","transliteration":"ʿalā","verse_key":"2:193"},{"pos":15,"ar":"ٱلظَّـٰلِمِينَ","en_gloss":"the oppressors","transliteration":"l-ẓālimīna","verse_key":"2:193"},{"pos":16,"ar":"١٩٣","en_gloss":"(193)","transliteration":"","verse_key":"2:193"}]},{"verse_key":"2:194","surah":2,"ayah":194,"ar_uthmani":"ٱلشَّهْرُ ٱلْحَرَامُ بِٱلشَّهْرِ ٱلْحَرَامِ وَٱلْحُرُمَـٰتُ قِصَاصٌ ۚ فَمَنِ ٱعْتَدَىٰ عَلَيْكُمْ فَٱعْتَدُوا۟ عَلَيْهِ بِمِثْلِ مَا ٱعْتَدَىٰ عَلَيْكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ","en_translation_id":85,"en":"A sacred month for a sacred month: violation of sanctity [calls for] fair retribution. So if anyone commits aggression against you, attack him as he attacked you, but be mindful of God, and know that He is with those who are mindful of Him.","words":[{"pos":1,"ar":"ٱلشَّهْرُ","en_gloss":"The month","transliteration":"al-shahru","verse_key":"2:194"},{"pos":2,"ar":"ٱلْحَرَامُ","en_gloss":"[the] sacred","transliteration":"l-ḥarāmu","verse_key":"2:194"},{"pos":3,"ar":"بِٱلشَّهْرِ","en_gloss":"(is) for the month","transliteration":"bil-shahri","verse_key":"2:194"},{"pos":4,"ar":"ٱلْحَرَامِ","en_gloss":"[the] sacred","transliteration":"l-ḥarāmi","verse_key":"2:194"},{"pos":5,"ar":"وَٱلْحُرُمَـٰتُ","en_gloss":"and for all the violations","transliteration":"wal-ḥurumātu","verse_key":"2:194"},{"pos":6,"ar":"قِصَاصٌۭ ۚ","en_gloss":"(is) legal retribution","transliteration":"qiṣāṣun","verse_key":"2:194"},{"pos":7,"ar":"فَمَنِ","en_gloss":"Then whoever","transliteration":"famani","verse_key":"2:194"},{"pos":8,"ar":"ٱعْتَدَىٰ","en_gloss":"transgressed","transliteration":"iʿ'tadā","verse_key":"2:194"},{"pos":9,"ar":"عَلَيْكُمْ","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"2:194"},{"pos":10,"ar":"فَٱعْتَدُوا۟","en_gloss":"then you transgress","transliteration":"fa-iʿ'tadū","verse_key":"2:194"},{"pos":11,"ar":"عَلَيْهِ","en_gloss":"on him","transliteration":"ʿalayhi","verse_key":"2:194"},{"pos":12,"ar":"بِمِثْلِ","en_gloss":"in (the) same manner","transliteration":"bimith'li","verse_key":"2:194"},{"pos":13,"ar":"مَا","en_gloss":"(as)","transliteration":"mā","verse_key":"2:194"},{"pos":14,"ar":"ٱعْتَدَىٰ","en_gloss":"he transgressed","transliteration":"iʿ'tadā","verse_key":"2:194"},{"pos":15,"ar":"عَلَيْكُمْ ۚ","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"2:194"},{"pos":16,"ar":"وَٱتَّقُوا۟","en_gloss":"And fear","transliteration":"wa-ittaqū","verse_key":"2:194"},{"pos":17,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"2:194"},{"pos":18,"ar":"وَٱعْلَمُوٓا۟","en_gloss":"and know","transliteration":"wa-iʿ'lamū","verse_key":"2:194"},{"pos":19,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"2:194"},{"pos":20,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"2:194"},{"pos":21,"ar":"مَعَ","en_gloss":"(is) with","transliteration":"maʿa","verse_key":"2:194"},{"pos":22,"ar":"ٱلْمُتَّقِينَ","en_gloss":"those who fear (Him)","transliteration":"l-mutaqīna","verse_key":"2:194"},{"pos":23,"ar":"١٩٤","en_gloss":"(194)","transliteration":"","verse_key":"2:194"}]},{"verse_key":"2:195","surah":2,"ayah":195,"ar_uthmani":"وَأَنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ وَلَا تُلْقُوا۟ بِأَيْدِيكُمْ إِلَى ٱلتَّهْلُكَةِ ۛ وَأَحْسِنُوٓا۟ ۛ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُحْسِنِينَ","en_translation_id":85,"en":"Spend in God’s cause: do not contribute to your destruction with your own hands, but do good, for God loves those who do good.","words":[{"pos":1,"ar":"وَأَنفِقُوا۟","en_gloss":"And spend","transliteration":"wa-anfiqū","verse_key":"2:195"},{"pos":2,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"2:195"},{"pos":3,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"2:195"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"2:195"},{"pos":5,"ar":"وَلَا","en_gloss":"and (do) not","transliteration":"walā","verse_key":"2:195"},{"pos":6,"ar":"تُلْقُوا۟","en_gloss":"throw (yourselves)","transliteration":"tul'qū","verse_key":"2:195"},{"pos":7,"ar":"بِأَيْدِيكُمْ","en_gloss":"[with your hands]","transliteration":"bi-aydīkum","verse_key":"2:195"},{"pos":8,"ar":"إِلَى","en_gloss":"into","transliteration":"ilā","verse_key":"2:195"},{"pos":9,"ar":"ٱلتَّهْلُكَةِ ۛ","en_gloss":"[the] destruction","transliteration":"l-tahlukati","verse_key":"2:195"},{"pos":10,"ar":"وَأَحْسِنُوٓا۟ ۛ","en_gloss":"And do good","transliteration":"wa-aḥsinū","verse_key":"2:195"},{"pos":11,"ar":"إِنَّ","en_gloss":"indeed","transliteration":"inna","verse_key":"2:195"},{"pos":12,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"2:195"},{"pos":13,"ar":"يُحِبُّ","en_gloss":"loves","transliteration":"yuḥibbu","verse_key":"2:195"},{"pos":14,"ar":"ٱلْمُحْسِنِينَ","en_gloss":"the good-doers","transliteration":"l-muḥ'sinīna","verse_key":"2:195"},{"pos":15,"ar":"١٩٥","en_gloss":"(195)","transliteration":"","verse_key":"2:195"}]},{"verse_key":"2:196","surah":2,"ayah":196,"ar_uthmani":"وَأَتِمُّوا۟ ٱلْحَجَّ وَٱلْعُمْرَةَ لِلَّهِ ۚ فَإِنْ أُحْصِرْتُمْ فَمَا ٱسْتَيْسَرَ مِنَ ٱلْهَدْىِ ۖ وَلَا تَحْلِقُوا۟ رُءُوسَكُمْ حَتَّىٰ يَبْلُغَ ٱلْهَدْىُ مَحِلَّهُۥ ۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوْ بِهِۦٓ أَذًى مِّن رَّأْسِهِۦ فَفِدْيَةٌ مِّن صِيَامٍ أَوْ صَدَقَةٍ أَوْ نُسُكٍ ۚ فَإِذَآ أَمِنتُمْ فَمَن تَمَتَّعَ بِٱلْعُمْرَةِ إِلَى ٱلْحَجِّ فَمَا ٱسْتَيْسَرَ مِنَ ٱلْهَدْىِ ۚ فَمَن لَّمْ يَجِدْ فَصِيَامُ ثَلَـٰثَةِ أَيَّامٍ فِى ٱلْحَجِّ وَسَبْعَةٍ إِذَا رَجَعْتُمْ ۗ تِلْكَ عَشَرَةٌ كَامِلَةٌ ۗ ذَٰلِكَ لِمَن لَّمْ يَكُنْ أَهْلُهُۥ حَاضِرِى ٱلْمَسْجِدِ ٱلْحَرَامِ ۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ","en_translation_id":85,"en":"Complete the pilgrimages, major and minor, for the sake of God. If you are prevented [from doing so], then [send] whatever offering for sacrifice you can afford, and do not shave your heads until the offering has reached the place of sacrifice. If any of you is ill, or has an ailment of the scalp, he should compensate by fasting, or feeding the poor, or offering sacrifice. When you are in safety, anyone wishing to take a break between the minor pilgrimage and the major one must make whatever offering he can afford. If he lacks the means, he should fast for three days during the pilgrimage, and seven days on his return, making ten days in all. This applies to those whose household is not near the Sacred Mosque. Always be mindful of God, and be aware that He is stern in His retribution.","words":[{"pos":1,"ar":"وَأَتِمُّوا۟","en_gloss":"And complete","transliteration":"wa-atimmū","verse_key":"2:196"},{"pos":2,"ar":"ٱلْحَجَّ","en_gloss":"the Hajj","transliteration":"l-ḥaja","verse_key":"2:196"},{"pos":3,"ar":"وَٱلْعُمْرَةَ","en_gloss":"and the Umrah","transliteration":"wal-ʿum'rata","verse_key":"2:196"},{"pos":4,"ar":"لِلَّهِ ۚ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"2:196"},{"pos":5,"ar":"فَإِنْ","en_gloss":"And if","transliteration":"fa-in","verse_key":"2:196"},{"pos":6,"ar":"أُحْصِرْتُمْ","en_gloss":"you are held back","transliteration":"uḥ'ṣir'tum","verse_key":"2:196"},{"pos":7,"ar":"فَمَا","en_gloss":"then (offer) whatever","transliteration":"famā","verse_key":"2:196"},{"pos":8,"ar":"ٱسْتَيْسَرَ","en_gloss":"(can be) obtained with ease","transliteration":"is'taysara","verse_key":"2:196"},{"pos":9,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"2:196"},{"pos":10,"ar":"ٱلْهَدْىِ ۖ","en_gloss":"the sacrificial animal","transliteration":"l-hadyi","verse_key":"2:196"},{"pos":11,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"2:196"},{"pos":12,"ar":"تَحْلِقُوا۟","en_gloss":"shave","transliteration":"taḥliqū","verse_key":"2:196"},{"pos":13,"ar":"رُءُوسَكُمْ","en_gloss":"your heads","transliteration":"ruūsakum","verse_key":"2:196"},{"pos":14,"ar":"حَتَّىٰ","en_gloss":"until","transliteration":"ḥattā","verse_key":"2:196"},{"pos":15,"ar":"يَبْلُغَ","en_gloss":"reaches","transliteration":"yablugha","verse_key":"2:196"},{"pos":16,"ar":"ٱلْهَدْىُ","en_gloss":"the sacrificial animal"