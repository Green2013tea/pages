iteration":"millata","verse_key":"6:161"},{"pos":11,"ar":"إِبْرَٰهِيمَ","en_gloss":"(of) Ibrahim ","transliteration":"ib'rāhīma","verse_key":"6:161"},{"pos":12,"ar":"حَنِيفًۭا ۚ","en_gloss":"a true monotheist","transliteration":"ḥanīfan","verse_key":"6:161"},{"pos":13,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"6:161"},{"pos":14,"ar":"كَانَ","en_gloss":"he was","transliteration":"kāna","verse_key":"6:161"},{"pos":15,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"6:161"},{"pos":16,"ar":"ٱلْمُشْرِكِينَ","en_gloss":"the polytheists","transliteration":"l-mush'rikīna","verse_key":"6:161"},{"pos":17,"ar":"١٦١","en_gloss":"(161)","transliteration":"","verse_key":"6:161"}]},{"verse_key":"6:162","surah":6,"ayah":162,"ar_uthmani":"قُلْ إِنَّ صَلَاتِى وَنُسُكِى وَمَحْيَاىَ وَمَمَاتِى لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","en_translation_id":85,"en":"Say, ‘My prayers and sacrifice, my life and death, are all for God, Lord of all the Worlds;","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"6:162"},{"pos":2,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"6:162"},{"pos":3,"ar":"صَلَاتِى","en_gloss":"my prayer","transliteration":"ṣalātī","verse_key":"6:162"},{"pos":4,"ar":"وَنُسُكِى","en_gloss":"and my rites of sacrifice","transliteration":"wanusukī","verse_key":"6:162"},{"pos":5,"ar":"وَمَحْيَاىَ","en_gloss":"and my living","transliteration":"wamaḥyāya","verse_key":"6:162"},{"pos":6,"ar":"وَمَمَاتِى","en_gloss":"and my dying","transliteration":"wamamātī","verse_key":"6:162"},{"pos":7,"ar":"لِلَّهِ","en_gloss":"(are) for Allah","transliteration":"lillahi","verse_key":"6:162"},{"pos":8,"ar":"رَبِّ","en_gloss":"Lord","transliteration":"rabbi","verse_key":"6:162"},{"pos":9,"ar":"ٱلْعَـٰلَمِينَ","en_gloss":"(of) the worlds","transliteration":"l-ʿālamīna","verse_key":"6:162"},{"pos":10,"ar":"١٦٢","en_gloss":"(162)","transliteration":"","verse_key":"6:162"}]},{"verse_key":"6:163","surah":6,"ayah":163,"ar_uthmani":"لَا شَرِيكَ لَهُۥ ۖ وَبِذَٰلِكَ أُمِرْتُ وَأَنَا۠ أَوَّلُ ٱلْمُسْلِمِينَ","en_translation_id":85,"en":"He has no partner. This is what I am commanded, and I am the first to devote myself to Him.’","words":[{"pos":1,"ar":"لَا","en_gloss":"No","transliteration":"lā","verse_key":"6:163"},{"pos":2,"ar":"شَرِيكَ","en_gloss":"partners","transliteration":"sharīka","verse_key":"6:163"},{"pos":3,"ar":"لَهُۥ ۖ","en_gloss":"for Him","transliteration":"lahu","verse_key":"6:163"},{"pos":4,"ar":"وَبِذَٰلِكَ","en_gloss":"and with that","transliteration":"wabidhālika","verse_key":"6:163"},{"pos":5,"ar":"أُمِرْتُ","en_gloss":"I have been commanded","transliteration":"umir'tu","verse_key":"6:163"},{"pos":6,"ar":"وَأَنَا۠","en_gloss":"And I am","transliteration":"wa-anā","verse_key":"6:163"},{"pos":7,"ar":"أَوَّلُ","en_gloss":"(the) first","transliteration":"awwalu","verse_key":"6:163"},{"pos":8,"ar":"ٱلْمُسْلِمِينَ","en_gloss":"(of) the ones who surrender (to Him)","transliteration":"l-mus'limīna","verse_key":"6:163"},{"pos":9,"ar":"١٦٣","en_gloss":"(163)","transliteration":"","verse_key":"6:163"}]},{"verse_key":"6:164","surah":6,"ayah":164,"ar_uthmani":"قُلْ أَغَيْرَ ٱللَّهِ أَبْغِى رَبًّا وَهُوَ رَبُّ كُلِّ شَىْءٍ ۚ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا ۚ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ ۚ ثُمَّ إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ فَيُنَبِّئُكُم بِمَا كُنتُمْ فِيهِ تَخْتَلِفُونَ","en_translation_id":85,"en":"Say, ‘Should I seek a Lord other than God, when He is the Lord of all things?’ Each soul is responsible for its own actions; no soul will bear the burden of another. You will all return to your Lord in the end, and He will tell you the truth about your differences.","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"6:164"},{"pos":2,"ar":"أَغَيْرَ","en_gloss":"Is (it) other than","transliteration":"aghayra","verse_key":"6:164"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"6:164"},{"pos":4,"ar":"أَبْغِى","en_gloss":"I (should) seek","transliteration":"abghī","verse_key":"6:164"},{"pos":5,"ar":"رَبًّۭا","en_gloss":"(as) a Lord","transliteration":"rabban","verse_key":"6:164"},{"pos":6,"ar":"وَهُوَ","en_gloss":"while He","transliteration":"wahuwa","verse_key":"6:164"},{"pos":7,"ar":"رَبُّ","en_gloss":"(is) the Lord","transliteration":"rabbu","verse_key":"6:164"},{"pos":8,"ar":"كُلِّ","en_gloss":"(of) every","transliteration":"kulli","verse_key":"6:164"},{"pos":9,"ar":"شَىْءٍۢ ۚ","en_gloss":"thing","transliteration":"shayin","verse_key":"6:164"},{"pos":10,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"6:164"},{"pos":11,"ar":"تَكْسِبُ","en_gloss":"earns","transliteration":"taksibu","verse_key":"6:164"},{"pos":12,"ar":"كُلُّ","en_gloss":"every","transliteration":"kullu","verse_key":"6:164"},{"pos":13,"ar":"نَفْسٍ","en_gloss":"soul","transliteration":"nafsin","verse_key":"6:164"},{"pos":14,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"6:164"},{"pos":15,"ar":"عَلَيْهَا ۚ","en_gloss":"against itself","transliteration":"ʿalayhā","verse_key":"6:164"},{"pos":16,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"6:164"},{"pos":17,"ar":"تَزِرُ","en_gloss":"bears","transliteration":"taziru","verse_key":"6:164"},{"pos":18,"ar":"وَازِرَةٌۭ","en_gloss":"any bearer of burden","transliteration":"wāziratun","verse_key":"6:164"},{"pos":19,"ar":"وِزْرَ","en_gloss":"burden","transliteration":"wiz'ra","verse_key":"6:164"},{"pos":20,"ar":"أُخْرَىٰ ۚ","en_gloss":"(of) another","transliteration":"ukh'rā","verse_key":"6:164"},{"pos":21,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"6:164"},{"pos":22,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"6:164"},{"pos":23,"ar":"رَبِّكُم","en_gloss":"your Lord","transliteration":"rabbikum","verse_key":"6:164"},{"pos":24,"ar":"مَّرْجِعُكُمْ","en_gloss":"(is) your return","transliteration":"marjiʿukum","verse_key":"6:164"},{"pos":25,"ar":"فَيُنَبِّئُكُم","en_gloss":"then He will inform you","transliteration":"fayunabbi-ukum","verse_key":"6:164"},{"pos":26,"ar":"بِمَا","en_gloss":"about what","transliteration":"bimā","verse_key":"6:164"},{"pos":27,"ar":"كُنتُمْ","en_gloss":"you were","transliteration":"kuntum","verse_key":"6:164"},{"pos":28,"ar":"فِيهِ","en_gloss":"concerning it","transliteration":"fīhi","verse_key":"6:164"},{"pos":29,"ar":"تَخْتَلِفُونَ","en_gloss":"differing","transliteration":"takhtalifūna","verse_key":"6:164"},{"pos":30,"ar":"١٦٤","en_gloss":"(164)","transliteration":"","verse_key":"6:164"}]},{"verse_key":"6:165","surah":6,"ayah":165,"ar_uthmani":"وَهُوَ ٱلَّذِى جَعَلَكُمْ خَلَـٰٓئِفَ ٱلْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَـٰتٍ لِّيَبْلُوَكُمْ فِى مَآ ءَاتَىٰكُمْ ۗ إِنَّ رَبَّكَ سَرِيعُ ٱلْعِقَابِ وَإِنَّهُۥ لَغَفُورٌ رَّحِيمٌۢ","en_translation_id":85,"en":"It is He who made you successors on the earth and raises some of you above others in rank, to test you through what He gives you. [Prophet], your Lord is swift in punishment, yet He is most forgiving and merciful.","words":[{"pos":1,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"6:165"},{"pos":2,"ar":"ٱلَّذِى","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"6:165"},{"pos":3,"ar":"جَعَلَكُمْ","en_gloss":"(has) made you","transliteration":"jaʿalakum","verse_key":"6:165"},{"pos":4,"ar":"خَلَـٰٓئِفَ","en_gloss":"successors","transliteration":"khalāifa","verse_key":"6:165"},{"pos":5,"ar":"ٱلْأَرْضِ","en_gloss":"(of) the earth","transliteration":"l-arḍi","verse_key":"6:165"},{"pos":6,"ar":"وَرَفَعَ","en_gloss":"and raised","transliteration":"warafaʿa","verse_key":"6:165"},{"pos":7,"ar":"بَعْضَكُمْ","en_gloss":"some of you","transliteration":"baʿḍakum","verse_key":"6:165"},{"pos":8,"ar":"فَوْقَ","en_gloss":"above","transliteration":"fawqa","verse_key":"6:165"},{"pos":9,"ar":"بَعْضٍۢ","en_gloss":"others","transliteration":"baʿḍin","verse_key":"6:165"},{"pos":10,"ar":"دَرَجَـٰتٍۢ","en_gloss":"(in) ranks","transliteration":"darajātin","verse_key":"6:165"},{"pos":11,"ar":"لِّيَبْلُوَكُمْ","en_gloss":"so that He may test you","transliteration":"liyabluwakum","verse_key":"6:165"},{"pos":12,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"6:165"},{"pos":13,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"6:165"},{"pos":14,"ar":"ءَاتَىٰكُمْ ۗ","en_gloss":"He has given you","transliteration":"ātākum","verse_key":"6:165"},{"pos":15,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"6:165"},{"pos":16,"ar":"رَبَّكَ","en_gloss":"your Lord","transliteration":"rabbaka","verse_key":"6:165"},{"pos":17,"ar":"سَرِيعُ","en_gloss":"(is) swift","transliteration":"sarīʿu","verse_key":"6:165"},{"pos":18,"ar":"ٱلْعِقَابِ","en_gloss":"(in) the punishment","transliteration":"l-ʿiqābi","verse_key":"6:165"},{"pos":19,"ar":"وَإِنَّهُۥ","en_gloss":"and indeed, He (is)","transliteration":"wa-innahu","verse_key":"6:165"},{"pos":20,"ar":"لَغَفُورٌۭ","en_gloss":"[certainly], Oft-Forgiving","transliteration":"laghafūrun","verse_key":"6:165"},{"pos":21,"ar":"رَّحِيمٌۢ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"6:165"},{"pos":22,"ar":"١٦٥","en_gloss":"(165)","transliteration":"","verse_key":"6:165"}]}]}