":"yāʿibādiya","verse_key":"39:53"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"39:53"},{"pos":4,"ar":"أَسْرَفُوا۟","en_gloss":"have transgressed","transliteration":"asrafū","verse_key":"39:53"},{"pos":5,"ar":"عَلَىٰٓ","en_gloss":"against","transliteration":"ʿalā","verse_key":"39:53"},{"pos":6,"ar":"أَنفُسِهِمْ","en_gloss":"themselves","transliteration":"anfusihim","verse_key":"39:53"},{"pos":7,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"39:53"},{"pos":8,"ar":"تَقْنَطُوا۟","en_gloss":"despair","transliteration":"taqnaṭū","verse_key":"39:53"},{"pos":9,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"39:53"},{"pos":10,"ar":"رَّحْمَةِ","en_gloss":"(the) Mercy","transliteration":"raḥmati","verse_key":"39:53"},{"pos":11,"ar":"ٱللَّهِ ۚ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"39:53"},{"pos":12,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"39:53"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"39:53"},{"pos":14,"ar":"يَغْفِرُ","en_gloss":"forgives","transliteration":"yaghfiru","verse_key":"39:53"},{"pos":15,"ar":"ٱلذُّنُوبَ","en_gloss":"the sins","transliteration":"l-dhunūba","verse_key":"39:53"},{"pos":16,"ar":"جَمِيعًا ۚ","en_gloss":"all","transliteration":"jamīʿan","verse_key":"39:53"},{"pos":17,"ar":"إِنَّهُۥ","en_gloss":"Indeed He","transliteration":"innahu","verse_key":"39:53"},{"pos":18,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"39:53"},{"pos":19,"ar":"ٱلْغَفُورُ","en_gloss":"(is) the Oft-Forgiving","transliteration":"l-ghafūru","verse_key":"39:53"},{"pos":20,"ar":"ٱلرَّحِيمُ","en_gloss":"the Most Merciful","transliteration":"l-raḥīmu","verse_key":"39:53"},{"pos":21,"ar":"٥٣","en_gloss":"(53)","transliteration":"","verse_key":"39:53"}]},{"verse_key":"39:54","surah":39,"ayah":54,"ar_uthmani":"وَأَنِيبُوٓا۟ إِلَىٰ رَبِّكُمْ وَأَسْلِمُوا۟ لَهُۥ مِن قَبْلِ أَن يَأْتِيَكُمُ ٱلْعَذَابُ ثُمَّ لَا تُنصَرُونَ","en_translation_id":85,"en":"Turn to your Lord. Submit to Him before the punishment overtakes you and you can no longer be helped.","words":[{"pos":1,"ar":"وَأَنِيبُوٓا۟","en_gloss":"And turn","transliteration":"wa-anībū","verse_key":"39:54"},{"pos":2,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"39:54"},{"pos":3,"ar":"رَبِّكُمْ","en_gloss":"your Lord","transliteration":"rabbikum","verse_key":"39:54"},{"pos":4,"ar":"وَأَسْلِمُوا۟","en_gloss":"and submit","transliteration":"wa-aslimū","verse_key":"39:54"},{"pos":5,"ar":"لَهُۥ","en_gloss":"to Him","transliteration":"lahu","verse_key":"39:54"},{"pos":6,"ar":"مِن","en_gloss":"before","transliteration":"min","verse_key":"39:54"},{"pos":7,"ar":"قَبْلِ","en_gloss":"before","transliteration":"qabli","verse_key":"39:54"},{"pos":8,"ar":"أَن","en_gloss":"[that]","transliteration":"an","verse_key":"39:54"},{"pos":9,"ar":"يَأْتِيَكُمُ","en_gloss":"comes to you","transliteration":"yatiyakumu","verse_key":"39:54"},{"pos":10,"ar":"ٱلْعَذَابُ","en_gloss":"the punishment","transliteration":"l-ʿadhābu","verse_key":"39:54"},{"pos":11,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"39:54"},{"pos":12,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"39:54"},{"pos":13,"ar":"تُنصَرُونَ","en_gloss":"you will be helped","transliteration":"tunṣarūna","verse_key":"39:54"},{"pos":14,"ar":"٥٤","en_gloss":"(54)","transliteration":"","verse_key":"39:54"}]},{"verse_key":"39:55","surah":39,"ayah":55,"ar_uthmani":"وَٱتَّبِعُوٓا۟ أَحْسَنَ مَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُم مِّن قَبْلِ أَن يَأْتِيَكُمُ ٱلْعَذَابُ بَغْتَةً وَأَنتُمْ لَا تَشْعُرُونَ","en_translation_id":85,"en":"Follow the best teaching sent down to you from your Lord, before the punishment suddenly takes you, unawares,","words":[{"pos":1,"ar":"وَٱتَّبِعُوٓا۟","en_gloss":"And follow","transliteration":"wa-ittabiʿū","verse_key":"39:55"},{"pos":2,"ar":"أَحْسَنَ","en_gloss":"(the) best","transliterat