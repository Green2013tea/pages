"},{"pos":6,"ar":"ءَاخَرَ ۚ","en_gloss":"another","transliteration":"ākhara","verse_key":"15:96"},{"pos":7,"ar":"فَسَوْفَ","en_gloss":"But soon","transliteration":"fasawfa","verse_key":"15:96"},{"pos":8,"ar":"يَعْلَمُونَ","en_gloss":"they will come to know","transliteration":"yaʿlamūna","verse_key":"15:96"},{"pos":9,"ar":"٩٦","en_gloss":"(96)","transliteration":"","verse_key":"15:96"}]},{"verse_key":"15:97","surah":15,"ayah":97,"ar_uthmani":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ","en_translation_id":85,"en":"We are well aware that your heart is weighed down by what they say.","words":[{"pos":1,"ar":"وَلَقَدْ","en_gloss":"And verily","transliteration":"walaqad","verse_key":"15:97"},{"pos":2,"ar":"نَعْلَمُ","en_gloss":"We know","transliteration":"naʿlamu","verse_key":"15:97"},{"pos":3,"ar":"أَنَّكَ","en_gloss":"that [you]","transliteration":"annaka","verse_key":"15:97"},{"pos":4,"ar":"يَضِيقُ","en_gloss":"(is) straitened","transliteration":"yaḍīqu","verse_key":"15:97"},{"pos":5,"ar":"صَدْرُكَ","en_gloss":"your breast","transliteration":"ṣadruka","verse_key":"15:97"},{"pos":6,"ar":"بِمَا","en_gloss":"by what","transliteration":"bimā","verse_key":"15:97"},{"pos":7,"ar":"يَقُولُونَ","en_gloss":"they say","transliteration":"yaqūlūna","verse_key":"15:97"},{"pos":8,"ar":"٩٧","en_gloss":"(97)","transliteration":"","verse_key":"15:97"}]},{"verse_key":"15:98","surah":15,"ayah":98,"ar_uthmani":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ ٱلسَّـٰجِدِينَ","en_translation_id":85,"en":"Celebrate the glory of your Lord and be among those who bow down to Him:","words":[{"pos":1,"ar":"فَسَبِّحْ","en_gloss":"So glorify","transliteration":"fasabbiḥ","verse_key":"15:98"},{"pos":2,"ar":"بِحَمْدِ","en_gloss":"with the praise","transliteration":"biḥamdi","verse_key":"15:98"},{"pos":3,"ar":"رَبِّكَ","en_gloss":"(of) your Lord","transliteration":"rabbika","verse_key":"15:98"},{"pos":4,"ar":"وَكُن","en_gloss":"and be","transliteration":"wakun","verse_key":"15:98"},{"pos":5,"ar