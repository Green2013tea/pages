iteration":"min'hum","verse_key":"5:62"},{"pos":4,"ar":"يُسَـٰرِعُونَ","en_gloss":"hastening","transliteration":"yusāriʿūna","verse_key":"5:62"},{"pos":5,"ar":"فِى","en_gloss":"into","transliteration":"fī","verse_key":"5:62"},{"pos":6,"ar":"ٱلْإِثْمِ","en_gloss":"[the] sin","transliteration":"l-ith'mi","verse_key":"5:62"},{"pos":7,"ar":"وَٱلْعُدْوَٰنِ","en_gloss":"and [the] transgression","transliteration":"wal-ʿud'wāni","verse_key":"5:62"},{"pos":8,"ar":"وَأَكْلِهِمُ","en_gloss":"and eating","transliteration":"wa-aklihimu","verse_key":"5:62"},{"pos":9,"ar":"ٱلسُّحْتَ ۚ","en_gloss":"the forbidden","transliteration":"l-suḥ'ta","verse_key":"5:62"},{"pos":10,"ar":"لَبِئْسَ","en_gloss":"Surely evil","transliteration":"labi'sa","verse_key":"5:62"},{"pos":11,"ar":"مَا","en_gloss":"(is) what","transliteration":"mā","verse_key":"5:62"},{"pos":12,"ar":"كَانُوا۟","en_gloss":"they were","transliteration":"kānū","verse_key":"5:62"},{"pos":13,"ar":"يَعْمَلُونَ","en_gloss":"doing","transliteration":"yaʿmalūna","verse_key":"5:62"},{"pos":14,"ar":"٦٢","en_gloss":"(62)","transliteration":"","verse_key":"5:62"}]},{"verse_key":"5:63","surah":5,"ayah":63,"ar_uthmani":"لَوْلَا يَنْهَىٰهُمُ ٱلرَّبَّـٰنِيُّونَ وَٱلْأَحْبَارُ عَن قَوْلِهِمُ ٱلْإِثْمَ وَأَكْلِهِمُ ٱلسُّحْتَ ۚ لَبِئْسَ مَا كَانُوا۟ يَصْنَعُونَ","en_translation_id":85,"en":"Why do their rabbis and scholars not forbid them to speak sinfully and consume what is unlawful? How evil their deeds are!","words":[{"pos":1,"ar":"لَوْلَا","en_gloss":"Why (do) not","transliteration":"lawlā","verse_key":"5:63"},{"pos":2,"ar":"يَنْهَىٰهُمُ","en_gloss":"forbid them","transliteration":"yanhāhumu","verse_key":"5:63"},{"pos":3,"ar":"ٱلرَّبَّـٰنِيُّونَ","en_gloss":"the Rabbis","transliteration":"l-rabāniyūna","verse_key":"5:63"},{"pos":4,"ar":"وَٱلْأَحْبَارُ","en_gloss":"and the religious scholars","transliteration":"wal-aḥbāru","verse_key":"5:63"},{"pos":5,"ar":"عَن","en_gloss":"from","transliteration":"ʿan","verse_key":"5:63"},{"pos":6,"ar":"