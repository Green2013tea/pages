"37:152"},{"pos":3,"ar":"وَإِنَّهُمْ","en_gloss":"and indeed, they","transliteration":"wa-innahum","verse_key":"37:152"},{"pos":4,"ar":"لَكَـٰذِبُونَ","en_gloss":"surely (are) liars","transliteration":"lakādhibūna","verse_key":"37:152"},{"pos":5,"ar":"١٥٢","en_gloss":"(152)","transliteration":"","verse_key":"37:152"}]},{"verse_key":"37:153","surah":37,"ayah":153,"ar_uthmani":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ","en_translation_id":85,"en":"Did He truly choose daughters in preference to sons?","words":[{"pos":1,"ar":"أَصْطَفَى","en_gloss":"Has He chosen","transliteration":"aṣṭafā","verse_key":"37:153"},{"pos":2,"ar":"ٱلْبَنَاتِ","en_gloss":"[the] daughters","transliteration":"l-banāti","verse_key":"37:153"},{"pos":3,"ar":"عَلَى","en_gloss":"over","transliteration":"ʿalā","verse_key":"37:153"},{"pos":4,"ar":"ٱلْبَنِينَ","en_gloss":"sons","transliteration":"l-banīna","verse_key":"37:153"},{"pos":5,"ar":"١٥٣","en_gloss":"(153)","transliteration":"","verse_key":"37:153"}]}]}