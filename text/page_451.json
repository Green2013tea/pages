rs.","words":[{"pos":1,"ar":"وَإِنَّ","en_gloss":"And indeed","transliteration":"wa-inna","verse_key":"37:133"},{"pos":2,"ar":"لُوطًۭا","en_gloss":"Lut","transliteration":"lūṭan","verse_key":"37:133"},{"pos":3,"ar":"لَّمِنَ","en_gloss":"(was) of","transliteration":"lamina","verse_key":"37:133"},{"pos":4,"ar":"ٱلْمُرْسَلِينَ","en_gloss":"the Messengers","transliteration":"l-mur'salīna","verse_key":"37:133"},{"pos":5,"ar":"١٣٣","en_gloss":"(133)","transliteration":"","verse_key":"37:133"}]},{"verse_key":"37:134","surah":37,"ayah":134,"ar_uthmani":"إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ","en_translation_id":85,"en":"We saved him and all his family-","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"37:134"},{"pos":2,"ar":"نَجَّيْنَـٰهُ","en_gloss":"We saved him","transliteration":"najjaynāhu","verse_key":"37:134"},{"pos":3,"ar":"وَأَهْلَهُۥٓ","en_gloss":"and his family","transliteration":"wa-ahlahu","verse_key":"37:134"},{"pos":4,"ar":"أَجْمَعِينَ","en_gloss":"all","transliteration":"ajmaʿīna","verse_key":"37:134"},{"pos":5,"ar":"١٣٤","en_gloss":"(134)","transliteration":"","verse_key":"37:134"}]},{"verse_key":"37:135","surah":37,"ayah":135,"ar_uthmani":"إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ","en_translation_id":85,"en":"except for an old woman who stayed behind-","words":[{"pos":1,"ar":"إِلَّا","en_gloss":"Except","transliteration":"illā","verse_key":"37:135"},{"pos":2,"ar":"عَجُوزًۭا","en_gloss":"an old woman","transliteration":"ʿajūzan","verse_key":"37:135"},{"pos":3,"ar":"فِى","en_gloss":"(was) among","transliteration":"fī","verse_key":"37:135"},{"pos":4,"ar":"ٱلْغَـٰبِرِينَ","en_gloss":"those who remained behind","transliteration":"l-ghābirīna","verse_key":"37:135"},{"pos":5,"ar":"١٣٥","en_gloss":"(135)","transliteration":"","verse_key":"37:135"}]},{"verse_key":"37:136","surah":37,"ayah":136,"ar_uthmani":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ","en_translation_id":85,"en":"and We destroyed the rest.","words":[{"pos":1,"ar":"ثُمَّ","en