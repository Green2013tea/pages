{"page":225,"verses":[{"verse_key":"11:29","surah":11,"ayah":29,"ar_uthmani":"وَيَـٰقَوْمِ لَآ أَسْـَٔلُكُمْ عَلَيْهِ مَالًا ۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱللَّهِ ۚ وَمَآ أَنَا۠ بِطَارِدِ ٱلَّذِينَ ءَامَنُوٓا۟ ۚ إِنَّهُم مُّلَـٰقُوا۟ رَبِّهِمْ وَلَـٰكِنِّىٓ أَرَىٰكُمْ قَوْمًا تَجْهَلُونَ","en_translation_id":85,"en":"My people, I ask no reward for it from you; my reward comes only from God. I will not drive away the faithful: they are sure to meet their Lord. I can see you are foolish.","words":[{"pos":1,"ar":"وَيَـٰقَوْمِ","en_gloss":"And O my people","transliteration":"wayāqawmi","verse_key":"11:29"},{"pos":2,"ar":"لَآ","en_gloss":"not","transliteration":"lā","verse_key":"11:29"},{"pos":3,"ar":"أَسْـَٔلُكُمْ","en_gloss":"I ask (of) you","transliteration":"asalukum","verse_key":"11:29"},{"pos":4,"ar":"عَلَيْهِ","en_gloss":"for it","transliteration":"ʿalayhi","verse_key":"11:29"},{"pos":5,"ar":"مَالًا ۖ","en_gloss":"any wealth","transliteration":"mālan","verse_key":"11:29"},{"pos":6,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"11:29"},{"pos":7,"ar":"أَجْرِىَ","en_gloss":"(is) my reward","transliteration":"ajriya","verse_key":"11:29"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"11:29"},{"pos":9,"ar":"عَلَى","en_gloss":"from","transliteration":"ʿalā","verse_key":"11:29"},{"pos":10,"ar":"ٱللَّهِ ۚ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"11:29"},{"pos":11,"ar":"وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"11:29"},{"pos":12,"ar":"أَنَا۠","en_gloss":"I am","transliteration":"anā","verse_key":"11:29"},{"pos":13,"ar":"بِطَارِدِ","en_gloss":"going to drive away","transliteration":"biṭāridi","verse_key":"11:29"},{"pos":14,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"11:29"},{"pos":15,"ar":"ءَامَنُوٓا۟ ۚ","en_gloss":"believed","transliteration":"āmanū","verse_key":"11:29"},{"pos":16,"ar":"إِنَّهُم","en_gloss":"Indeed, they","transliteration":"innahum","verse_key":"11:29"},{"pos":17,"ar":"مُّلَـٰقُوا۟","en_gloss":"(will) be meeting","transliteration":"mulāqū","verse_key":"11:29"},{"pos":18,"ar":"رَبِّهِمْ","en_gloss":"their Lord","transliteration":"rabbihim","verse_key":"11:29"},{"pos":19,"ar":"وَلَـٰكِنِّىٓ","en_gloss":"but I","transliteration":"walākinnī","verse_key":"11:29"},{"pos":20,"ar":"أَرَىٰكُمْ","en_gloss":"see you","transliteration":"arākum","verse_key":"11:29"},{"pos":21,"ar":"قَوْمًۭا","en_gloss":"(are) a people","transliteration":"qawman","verse_key":"11:29"},{"pos":22,"ar":"تَجْهَلُونَ","en_gloss":"ignorant","transliteration":"tajhalūna","verse_key":"11:29"},{"pos":23,"ar":"٢٩","en_gloss":"(29)","transliteration":"","verse_key":"11:29"}]},{"verse_key":"11:30","surah":11,"ayah":30,"ar_uthmani":"وَيَـٰقَوْمِ مَن يَنصُرُنِى مِنَ ٱللَّهِ إِن طَرَدتُّهُمْ ۚ أَفَلَا تَذَكَّرُونَ","en_translation_id":85,"en":"My people, who could help me against God if I drove the faithful away? Will you not take heed?","words":[{"pos":1,"ar":"وَيَـٰقَوْمِ","en_gloss":"And O my people","transliteration":"wayāqawmi","verse_key":"11:30"},{"pos":2,"ar":"مَن","en_gloss":"Who","transliteration":"man","verse_key":"11:30"},{"pos":3,"ar":"يَنصُرُنِى","en_gloss":"would help me","transliteration":"yanṣurunī","verse_key":"11:30"},{"pos":4,"ar":"مِنَ","en_gloss":"against","transliteration":"mina","verse_key":"11:30"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"11:30"},{"pos":6,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"11:30"},{"pos":7,"ar":"طَرَدتُّهُمْ ۚ","en_gloss":"I drove them away","transliteration":"ṭaradttuhum","verse_key":"11:30"},{"pos":8,"ar":"أَفَلَا","en_gloss":"Then, will not","transliteration":"afalā","verse_key":"11:30"},{"pos":9,"ar":"تَذَكَّرُونَ","en_gloss":"you take heed","transliteration":"tadhakkarūna","verse_key":"11:30"},{"pos":10,"ar":"٣٠","en_gloss":"(30)","transliteration":"","verse_key":"11:30"}]},{"verse_key":"11:31","surah":11,"ayah":31,"ar_uthmani":"وَلَآ أَقُولُ لَكُمْ عِندِى خَزَآئِنُ ٱللَّهِ وَلَآ أَعْلَمُ ٱلْغَيْبَ وَلَآ أَقُولُ إِنِّى مَلَكٌ وَلَآ أَقُولُ لِلَّذِينَ تَزْدَرِىٓ أَعْيُنُكُمْ لَن يُؤْتِيَهُمُ ٱللَّهُ خَيْرًا ۖ ٱللَّهُ أَعْلَمُ بِمَا فِىٓ أَنفُسِهِمْ ۖ إِنِّىٓ إِذًا لَّمِنَ ٱلظَّـٰلِمِينَ","en_translation_id":85,"en":"I am not telling you that I hold God’s treasures, or have any knowledge of what is hidden, or that I am an angel. Nor do I say that God will not grant any good to those who are despised in your eyes: God Himself knows best what is in their souls. If I did this I would be one of the wrongdoers.’","words":[{"pos":1,"ar":"وَلَآ","en_gloss":"And not","transliteration":"walā","verse_key":"11:31"},{"pos":2,"ar":"أَقُولُ","en_gloss":"I say","transliteration":"aqūlu","verse_key":"11:31"},{"pos":3,"ar":"لَكُمْ","en_gloss":"to you","transliteration":"lakum","verse_key":"11:31"},{"pos":4,"ar":"عِندِى","en_gloss":"(that) with me","transliteration":"ʿindī","verse_key":"11:31"},{"pos":5,"ar":"خَزَآئِنُ","en_gloss":"(are the) treasures","transliteration":"khazāinu","verse_key":"11:31"},{"pos":6,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"11:31"},{"pos":7,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"11:31"},{"pos":8,"ar":"أَعْلَمُ","en_gloss":"I know","transliteration":"aʿlamu","verse_key":"11:31"},{"pos":9,"ar":"ٱلْغَيْبَ","en_gloss":"the unseen","transliteration":"l-ghayba","verse_key":"11:31"},{"pos":10,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"11:31"},{"pos":11,"ar":"أَقُولُ","en_gloss":"I say","transliteration":"aqūlu","verse_key":"11:31"},{"pos":12,"ar":"إِنِّى","en_gloss":"that I am","transliteration":"innī","verse_key":"11:31"},{"pos":13,"ar":"مَلَكٌۭ","en_gloss":"an Angel","transliteration":"malakun","verse_key":"11:31"},{"pos":14,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"11:31"},{"pos":15,"ar":"أَقُولُ","en_gloss":"I say","transliteration":