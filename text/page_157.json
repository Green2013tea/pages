rah":7,"ayah":54,"ar_uthmani":"إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ يُغْشِى ٱلَّيْلَ ٱلنَّهَارَ يَطْلُبُهُۥ حَثِيثًا وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓ ۗ أَلَا لَهُ ٱلْخَلْقُ وَٱلْأَمْرُ ۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","en_translation_id":85,"en":"Your Lord is God, who created the heavens and earth in six Days, then established Himself on the throne; He makes the night cover the day in swift pursuit; He created the sun, moon, and stars to be subservient to His command; all creation and command belong to Him. Exalted be God, Lord of all the worlds!","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"7:54"},{"pos":2,"ar":"رَبَّكُمُ","en_gloss":"your Lord","transliteration":"rabbakumu","verse_key":"7:54"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"(is) Allah","transliteration":"l-lahu","verse_key":"7:54"},{"pos":4,"ar":"ٱلَّذِى","en_gloss":"the One Who","transliteration":"alladhī","verse_key":"7:54"},{"pos":5,"ar":"خَلَقَ","en_gloss":"created","transliteration":"khalaqa","verse_key":"7:54"},{"pos":6,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"7:54"},{"pos":7,"ar":"وَٱلْأَرْضَ","en_gloss":"and the earth","transliteration":"wal-arḍa","verse_key":"7:54"},{"pos":8,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"7:54"},{"pos":9,"ar":"سِتَّةِ","en_gloss":"six","transliteration":"sittati","verse_key":"7:54"},{"pos":10,"ar":"أَيَّامٍۢ","en_gloss":"epochs","transliteration":"ayyāmin","verse_key":"7:54"},{"pos":11,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"7:54"},{"pos":12,"ar":"ٱسْتَوَىٰ","en_gloss":"He ascended","transliteration":"is'tawā","verse_key":"7:54"},{"pos":13,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"7:54"},{"pos":14,"ar":"ٱلْعَرْشِ","en_gloss":"the Throne","transliteration":"l-ʿarshi","verse_key":"7:54"},{"pos":15,"ar":"يُغْشِى","en_gloss":"He covers","transliteration":"yugh'shī","verse_key":"7:54"},{"pos":16,"ar":"ٱلَّيْلَ","en_gloss":"the night","transliteration":"al-layla","verse_key":"7:54"},{"pos":17,"ar":"ٱلنَّهَارَ","en_gloss":"(with) the day","transliteration":"l-nahāra","verse_key":"7:54"},{"pos":18,"ar":"يَطْلُبُهُۥ","en_gloss":"seeking it","transliteration":"yaṭlubuhu","verse_key":"7:54"},{"pos":19,"ar":"حَثِيثًۭا","en_gloss":"rapidly","transliteration":"ḥathīthan","verse_key":"7:54"},{"pos":20,"ar":"وَٱلشَّمْسَ","en_gloss":"and the sun","transliteration":"wal-shamsa","verse_key":"7:54"},{"pos":21,"ar":"وَٱلْقَمَرَ","en_gloss":"and the moon","transliteration":"wal-qamara","verse_key":"7:54"},{"pos":22,"ar":"وَٱلنُّجُومَ","en_gloss":"and the stars ","transliteration":"wal-nujūma","verse_key":"7:54"},{"pos":23,"ar":"مُسَخَّرَٰتٍۭ","en_gloss":"subjected","transliteration":"musakharātin","verse_key":"7:54"},{"pos":24,"ar":"بِأَمْرِهِۦٓ ۗ","en_gloss":"by His command","transliteration":"bi-amrihi","verse_key":"7:54"},{"pos":25,"ar":"أَلَا","en_gloss":"Unquestionably","transliteration":"alā","verse_key":"7:54"},{"pos":26,"ar":"لَهُ","en_gloss":"for Him","transliteration":"lahu","verse_key":"7:54"},{"pos":27,"ar":"ٱلْخَلْقُ","en_gloss":"(is) the creation","transliteration":"l-khalqu","verse_key":"7:54"},{"pos":28,"ar":"وَٱلْأَمْرُ ۗ","en_gloss":"and the command","transliteration":"wal-amru","verse_key":"7:54"},{"pos":29,"ar":"تَبَارَكَ","en_gloss":"blessed","transliteration":"tabāraka","verse_key":"7:54"},{"pos":30,"ar":"ٱللَّهُ","en_gloss":"(is) Allah","transliteration":"l-lahu","verse_key":"7:54"},{"pos":31,"ar":"رَبُّ","en_gloss":"Lord","transliteration":"rabbu","verse_key":"7:54"},{"pos":32,"ar":"ٱلْعَـٰلَمِينَ","en_gloss":"(of) the worlds","transliteration":"l-ʿālamīna","verse_key":"7:54"},{"pos":33,"ar":"٥٤","en_gloss":"(54)","transliteration":"","verse_key":"7:54"}]},{"verse_key":"7:55","surah":7,"ayah":55,"ar_uthmani":"ٱدْعُوا۟ رَبَّكُمْ تَضَرُّعًا وَخُف