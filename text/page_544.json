ينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ","en_translation_id":85,"en":"Have you not seen [Prophet] those who give their loyalty to people with whom God is angry? They are neither with you nor with them, and knowingly swear to lies.","words":[{"pos":1,"ar":"۞ أَلَمْ","en_gloss":"Do not","transliteration":"alam","verse_key":"58:14"},{"pos":2,"ar":"تَرَ","en_gloss":"you see","transliteration":"tara","verse_key":"58:14"},{"pos":3,"ar":"إِلَى","en_gloss":"[to]","transliteration":"ilā","verse_key":"58:14"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"58:14"},{"pos":5,"ar":"تَوَلَّوْا۟","en_gloss":"take as allies","transliteration":"tawallaw","verse_key":"58:14"},{"pos":6,"ar":"قَوْمًا","en_gloss":"a people","transliteration":"qawman","verse_key":"58:14"},{"pos":7,"ar":"غَضِبَ","en_gloss":"wrath","transliteration":"ghaḍiba","verse_key":"58:14"},{"pos":8,"ar":"ٱللَّهُ","en_gloss":"(of) Allah","transliteration":"l-lahu","verse_key":"58:14"},{"pos":9,"ar":"عَلَيْهِم","en_gloss":"(is) upon them","transliteration":"ʿalayhim","verse_key":"58:14"},{"pos":10,"ar":"مَّا","en_gloss":"They (are) not","transliteration":"mā","verse_key":"58:14"},{"pos":11,"ar":"هُم","en_gloss":"They (are) not","transliteration":"hum","verse_key":"58:14"},{"pos":12,"ar":"مِّنكُمْ","en_gloss":"of you","transliteration":"minkum","verse_key":"58:14"},{"pos":13,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"58:14"},{"pos":14,"ar":"مِنْهُمْ","en_gloss":"of them","transliteration":"min'hum","verse_key":"58:14"},{"pos":15,"ar":"وَيَحْلِفُونَ","en_gloss":"and they swear","transliteration":"wayaḥlifūna","verse_key":"58:14"},{"pos":16,"ar":"عَلَى","en_gloss":"to","transliteration":"ʿalā","verse_key":"58:14"},{"pos":17,"ar":"ٱلْكَذِبِ","en_gloss":"the lie","transliteration":"l-kadhibi","verse_key":"58:14"},{"pos":18,"ar":"وَهُمْ","en_gloss":"while they","