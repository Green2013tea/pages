e_key":"4:5"},{"pos":11,"ar":"فِيهَا","en_gloss":"with it","transliteration":"fīhā","verse_key":"4:5"},{"pos":12,"ar":"وَٱكْسُوهُمْ","en_gloss":"and clothe them","transliteration":"wa-ik'sūhum","verse_key":"4:5"},{"pos":13,"ar":"وَقُولُوا۟","en_gloss":"and speak","transliteration":"waqūlū","verse_key":"4:5"},{"pos":14,"ar":"لَهُمْ","en_gloss":"to them","transliteration":"lahum","verse_key":"4:5"},{"pos":15,"ar":"قَوْلًۭا","en_gloss":"words","transliteration":"qawlan","verse_key":"4:5"},{"pos":16,"ar":"مَّعْرُوفًۭا","en_gloss":"(of) kindness","transliteration":"maʿrūfan","verse_key":"4:5"},{"pos":17,"ar":"٥","en_gloss":"(5)","transliteration":"","verse_key":"4:5"}]},{"verse_key":"4:6","surah":4,"ayah":6,"ar_uthmani":"وَٱبْتَلُوا۟ ٱلْيَتَـٰمَىٰ حَتَّىٰٓ إِذَا بَلَغُوا۟ ٱلنِّكَاحَ فَإِنْ ءَانَسْتُم مِّنْهُمْ رُشْدًا فَٱدْفَعُوٓا۟ إِلَيْهِمْ أَمْوَٰلَهُمْ ۖ وَلَا تَأْكُلُوهَآ إِسْرَافًا وَبِدَارًا أَن يَكْبَرُوا۟ ۚ وَمَن كَانَ غَنِيًّا فَلْيَسْتَعْفِفْ ۖ وَمَن كَانَ فَقِيرًا فَلْيَأْكُلْ بِٱلْمَعْرُوفِ ۚ فَإِذَا دَفَعْتُمْ إِلَيْهِمْ أَمْوَٰلَهُمْ فَأَشْهِدُوا۟ عَلَيْهِمْ ۚ وَكَفَىٰ بِٱللَّهِ حَسِيبًا","en_translation_id":85,"en":"Test orphans until they reach marriageable age; then, if you find they have sound judgement, hand over their property to them. Do not consume it hastily before they come of age: if the guardian is well off he should abstain from the orphan’s property, and if he is poor he should use only what is fair. When you give them their property, call witnesses in; but God takes full account of everything you do.","words":[{"pos":1,"ar":"وَٱبْتَلُوا۟","en_gloss":"And test","transliteration":"wa-ib'talū","verse_key":"4:6"},{"pos":2,"ar":"ٱلْيَتَـٰمَىٰ","en_gloss":"the orphans","transliteration":"l-yatāmā","verse_key":"4:6"},{"pos":3,"ar":"حَتَّىٰٓ","en_gloss":"until","transliteration":"ḥattā","verse_key":"4:6"},{"pos":4,"ar":"إِذَا","en_gloss":"[when]","transliteration":"idhā","verse_key":"4:6"},{"pos":5,"ar":"بَلَغُوا۟","en_gloss":"they reach[ed]","tran