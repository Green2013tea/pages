 then marry only one, or your slave(s): that is more likely to make you avoid bias.","words":[{"pos":1,"ar":"وَإِنْ","en_gloss":"And if","transliteration":"wa-in","verse_key":"4:3"},{"pos":2,"ar":"خِفْتُمْ","en_gloss":"you fear","transliteration":"khif'tum","verse_key":"4:3"},{"pos":3,"ar":"أَلَّا","en_gloss":"that not","transliteration":"allā","verse_key":"4:3"},{"pos":4,"ar":"تُقْسِطُوا۟","en_gloss":"you will be able to do justice","transliteration":"tuq'siṭū","verse_key":"4:3"},{"pos":5,"ar":"فِى","en_gloss":"with","transliteration":"fī","verse_key":"4:3"},{"pos":6,"ar":"ٱلْيَتَـٰمَىٰ","en_gloss":"the orphans","transliteration":"l-yatāmā","verse_key":"4:3"},{"pos":7,"ar":"فَٱنكِحُوا۟","en_gloss":"then marry","transliteration":"fa-inkiḥū","verse_key":"4:3"},{"pos":8,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"4:3"},{"pos":9,"ar":"طَابَ","en_gloss":"seems suitable","transliteration":"ṭāba","verse_key":"4:3"},{"pos":10,"ar":"لَكُم","en_gloss":"to you","transliteration":"lakum","verse_key":"4:3"},{"pos":11,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"4:3"},{"pos":12,"ar":"ٱلنِّسَآءِ","en_gloss":"the women","transliteration":"l-nisāi","verse_key":"4:3"},{"pos":13,"ar":"مَثْنَىٰ","en_gloss":"two","transliteration":"mathnā","verse_key":"4:3"},{"pos":14,"ar":"وَثُلَـٰثَ","en_gloss":"or three","transliteration":"wathulātha","verse_key":"4:3"},{"pos":15,"ar":"وَرُبَـٰعَ ۖ","en_gloss":"or four","transliteration":"warubāʿa","verse_key":"4:3"},{"pos":16,"ar":"فَإِنْ","en_gloss":"But if","transliteration":"fa-in","verse_key":"4:3"},{"pos":17,"ar":"خِفْتُمْ","en_gloss":"you fear","transliteration":"khif'tum","verse_key":"4:3"},{"pos":18,"ar":"أَلَّا","en_gloss":"that not","transliteration":"allā","verse_key":"4:3"},{"pos":19,"ar":"تَعْدِلُوا۟","en_gloss":"you can do justice","transliteration":"taʿdilū","verse_key":"4:3"},{"pos":20,"ar":"فَوَٰحِدَةً","en_gloss":"then (marry) one","transliteration":"fawāḥidatan","verse_key":"4:3"},{"p