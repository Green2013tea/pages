":2,"ar":"جَزَآؤُهُم","en_gloss":"(is) their recompense","transliteration":"jazāuhum","verse_key":"17:98"},{"pos":3,"ar":"بِأَنَّهُمْ","en_gloss":"because they","transliteration":"bi-annahum","verse_key":"17:98"},{"pos":4,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"17:98"},{"pos":5,"ar":"بِـَٔايَـٰتِنَا","en_gloss":"in Our Verses","transliteration":"biāyātinā","verse_key":"17:98"},{"pos":6,"ar":"وَقَالُوٓا۟","en_gloss":"and said","transliteration":"waqālū","verse_key":"17:98"},{"pos":7,"ar":"أَءِذَا","en_gloss":"When","transliteration":"a-idhā","verse_key":"17:98"},{"pos":8,"ar":"كُنَّا","en_gloss":"we are","transliteration":"kunnā","verse_key":"17:98"},{"pos":9,"ar":"عِظَـٰمًۭا","en_gloss":"bones","transliteration":"ʿiẓāman","verse_key":"17:98"},{"pos":10,"ar":"وَرُفَـٰتًا","en_gloss":"and crumbled particles","transliteration":"warufātan","verse_key":"17:98"},{"pos":11,"ar":"أَءِنَّا","en_gloss":"will we","transliteration":"a-innā","verse_key":"17:98"},{"pos":12,"ar":"لَمَبْعُوثُونَ","en_gloss":"surely (be) resurrected","transliteration":"lamabʿūthūna","verse_key":"17:98"},{"pos":13,"ar":"خَلْقًۭا","en_gloss":"(as) a creation","transliteration":"khalqan","verse_key":"17:98"},{"pos":14,"ar":"جَدِيدًا","en_gloss":"new","transliteration":"jadīdan","verse_key":"17:98"},{"pos":15,"ar":"٩٨","en_gloss":"(98)","transliteration":"","verse_key":"17:98"}]},{"verse_key":"17:99","surah":17,"ayah":99,"ar_uthmani":"۞ أَوَلَمْ يَرَوْا۟ أَنَّ ٱللَّهَ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ قَادِرٌ عَلَىٰٓ أَن يَخْلُقَ مِثْلَهُمْ وَجَعَلَ لَهُمْ أَجَلًا لَّا رَيْبَ فِيهِ فَأَبَى ٱلظَّـٰلِمُونَ إِلَّا كُفُورًا","en_translation_id":85,"en":"Do they not see that God, who created the heavens and earth, can create the likes of them [anew]? He has ordained a time for them- there is no doubt about that- but the evildoers refuse everything except disbelief.","words":[{"pos":1,"ar":"۞ أَوَلَمْ","en_gloss":"Do not","transliteration":"awalam","verse_key":"17:99"},{"pos":2,"ar":"يَرَوْا۟","en_gloss":"they see","transliteration":"yaraw","verse_key":"17:99"},{"pos":3,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"17:99"},{"pos":4,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"17:99"},{"pos":5,"ar":"ٱلَّذِى","en_gloss":"the One Who","transliteration":"alladhī","verse_key":"17:99"},{"pos":6,"ar":"خَلَقَ","en_gloss":"created","transliteration":"khalaqa","verse_key":"17:99"},{"pos":7,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"17:99"},{"pos":8,"ar":"وَٱلْأَرْضَ","en_gloss":"and the earth","transliteration":"wal-arḍa","verse_key":"17:99"},{"pos":9,"ar":"قَادِرٌ","en_gloss":"(is) Able","transliteration":"qādirun","verse_key":"17:99"},{"pos":10,"ar":"عَلَىٰٓ","en_gloss":"[on]","transliteration":"ʿalā","verse_key":"17:99"},{"pos":11,"ar":"أَن","en_gloss":"to","transliteration":"an","verse_key":"17:99"},{"pos":12,"ar":"يَخْلُقَ","en_gloss":"create","transliteration":"yakhluqa","verse_key":"17:99"},{"pos":13,"ar":"مِثْلَهُمْ","en_gloss":"the like of them","transliteration":"mith'lahum","verse_key":"17:99"},{"pos":14,"ar":"وَجَعَلَ","en_gloss":"And He has made","transliteration":"wajaʿala","verse_key":"17:99"},{"pos":15,"ar":"لَهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"17:99"},{"pos":16,"ar":"أَجَلًۭا","en_gloss":"a term","transliteration":"ajalan","verse_key":"17:99"},{"pos":17,"ar":"لَّا","en_gloss":"no","transliteration":"lā","verse_key":"17:99"},{"pos":18,"ar":"رَيْبَ","en_gloss":"doubt","transliteration":"rayba","verse_key":"17:99"},{"pos":19,"ar":"فِيهِ","en_gloss":"in it","transliteration":"fīhi","verse_key":"17:99"},{"pos":20,"ar":"فَأَبَى","en_gloss":"But refused","transliteration":"fa-abā","verse_key":"17:99"},{"pos":21,"ar":"ٱلظَّـٰلِمُونَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimūna","verse_key":"17:99"},{"pos":22,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key"