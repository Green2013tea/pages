n":"lahu","verse_key":"59:24"},{"pos":7,"ar":"ٱلْأَسْمَآءُ","en_gloss":"(are) the names","transliteration":"l-asmāu","verse_key":"59:24"},{"pos":8,"ar":"ٱلْحُسْنَىٰ ۚ","en_gloss":"the beautiful","transliteration":"l-ḥus'nā","verse_key":"59:24"},{"pos":9,"ar":"يُسَبِّحُ","en_gloss":"Glorifies","transliteration":"yusabbiḥu","verse_key":"59:24"},{"pos":10,"ar":"لَهُۥ","en_gloss":"Him","transliteration":"lahu","verse_key":"59:24"},{"pos":11,"ar":"مَا","en_gloss":"whatever","transliteration":"mā","verse_key":"59:24"},{"pos":12,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"59:24"},{"pos":13,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"59:24"},{"pos":14,"ar":"وَٱلْأَرْضِ ۖ","en_gloss":"and the earth","transliteration":"wal-arḍi","verse_key":"59:24"},{"pos":15,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"59:24"},{"pos":16,"ar":"ٱلْعَزِيزُ","en_gloss":"(is) the All-Mighty","transliteration":"l-ʿazīzu","verse_key":"59:24"},{"pos":17,"ar":"ٱلْحَكِيمُ","en_gloss":"the All-Wise","transliteration":"l-ḥakīmu","verse_key":"59:24"},{"pos":18,"ar":"٢٤","en_gloss":"(24)","transliteration":"","verse_key":"59:24"}]}]}