_key":"35:40"},{"pos":26,"ar":"بَلْ","en_gloss":"Nay","transliteration":"bal","verse_key":"35:40"},{"pos":27,"ar":"إِن","en_gloss":"not","transliteration":"in","verse_key":"35:40"},{"pos":28,"ar":"يَعِدُ","en_gloss":"promise","transliteration":"yaʿidu","verse_key":"35:40"},{"pos":29,"ar":"ٱلظَّـٰلِمُونَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimūna","verse_key":"35:40"},{"pos":30,"ar":"بَعْضُهُم","en_gloss":"some of them","transliteration":"baʿḍuhum","verse_key":"35:40"},{"pos":31,"ar":"بَعْضًا","en_gloss":"(to) others","transliteration":"baʿḍan","verse_key":"35:40"},{"pos":32,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"35:40"},{"pos":33,"ar":"غُرُورًا","en_gloss":"delusion","transliteration":"ghurūran","verse_key":"35:40"},{"pos":34,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"35:40"}]},{"verse_key":"35:41","surah":35,"ayah":41,"ar_uthmani":"۞ إِنَّ ٱللَّهَ يُمْسِكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ أَن تَزُولَا ۚ وَلَئِن زَالَتَآ إِنْ أَمْسَكَهُمَا مِنْ أَحَدٍ مِّنۢ بَعْدِهِۦٓ ۚ إِنَّهُۥ كَانَ حَلِيمًا غَفُورًا","en_translation_id":85,"en":"God keeps the heavens and earth from vanishing; if they did vanish, no one else could stop them. God is most forbearing, most forgiving.","words":[{"pos":1,"ar":"۞ إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"35:41"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"35:41"},{"pos":3,"ar":"يُمْسِكُ","en_gloss":"upholds","transliteration":"yum'siku","verse_key":"35:41"},{"pos":4,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"35:41"},{"pos":5,"ar":"وَٱلْأَرْضَ","en_gloss":"and the earth","transliteration":"wal-arḍa","verse_key":"35:41"},{"pos":6,"ar":"أَن","en_gloss":"lest","transliteration":"an","verse_key":"35:41"},{"pos":7,"ar":"تَزُولَا ۚ","en_gloss":"they cease","transliteration":"tazūlā","verse_key":"35:41"},{"pos":8,"ar":"وَلَئِن","en_gloss":"And if","transliteration":"wala-in"