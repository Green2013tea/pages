4"},{"pos":12,"ar":"وَأَنَّ","en_gloss":"and that","transliteration":"wa-anna","verse_key":"9:104"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"9:104"},{"pos":14,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"9:104"},{"pos":15,"ar":"ٱلتَّوَّابُ","en_gloss":"(is) the Acceptor of repentance","transliteration":"l-tawābu","verse_key":"9:104"},{"pos":16,"ar":"ٱلرَّحِيمُ","en_gloss":"the Most Merciful","transliteration":"l-raḥīmu","verse_key":"9:104"},{"pos":17,"ar":"١٠٤","en_gloss":"(104)","transliteration":"","verse_key":"9:104"}]},{"verse_key":"9:105","surah":9,"ayah":105,"ar_uthmani":"وَقُلِ ٱعْمَلُوا۟ فَسَيَرَى ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ وَٱلْمُؤْمِنُونَ ۖ وَسَتُرَدُّونَ إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ","en_translation_id":85,"en":"Say [Prophet], ‘Take action! God will see your actions- as will His Messenger and the believers- and then you will be returned to Him who knows what is seen and unseen, and He will tell you what you have been doing.","words":[{"pos":1,"ar":"وَقُلِ","en_gloss":"And say","transliteration":"waquli","verse_key":"9:105"},{"pos":2,"ar":"ٱعْمَلُوا۟","en_gloss":"Do","transliteration":"iʿ'malū","verse_key":"9:105"},{"pos":3,"ar":"فَسَيَرَى","en_gloss":"then Allah will see","transliteration":"fasayarā","verse_key":"9:105"},{"pos":4,"ar":"ٱللَّهُ","en_gloss":"then Allah will see","transliteration":"l-lahu","verse_key":"9:105"},{"pos":5,"ar":"عَمَلَكُمْ","en_gloss":"your deed","transliteration":"ʿamalakum","verse_key":"9:105"},{"pos":6,"ar":"وَرَسُولُهُۥ","en_gloss":"and His Messenger","transliteration":"warasūluhu","verse_key":"9:105"},{"pos":7,"ar":"وَٱلْمُؤْمِنُونَ ۖ","en_gloss":"and the believers","transliteration":"wal-mu'minūna","verse_key":"9:105"},{"pos":8,"ar":"وَسَتُرَدُّونَ","en_gloss":"And you will be brought back","transliteration":"wasaturaddūna","verse_key":"9:105"},{"pos":9,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"