lation_id":85,"en":"Let those of you who are willing to trade the life of this world for the life to come, fight in God’s way. To anyone who fights in God’s way, whether killed or victorious, We shall give a great reward.","words":[{"pos":1,"ar":"۞ فَلْيُقَـٰتِلْ","en_gloss":"So let fight","transliteration":"falyuqātil","verse_key":"4:74"},{"pos":2,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"4:74"},{"pos":3,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"4:74"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"4:74"},{"pos":5,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"4:74"},{"pos":6,"ar":"يَشْرُونَ","en_gloss":"sell","transliteration":"yashrūna","verse_key":"4:74"},{"pos":7,"ar":"ٱلْحَيَوٰةَ","en_gloss":"the life","transliteration":"l-ḥayata","verse_key":"4:74"},{"pos":8,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"4:74"},{"pos":9,"ar":"بِٱلْـَٔاخِرَةِ ۚ","en_gloss":"for the Hereafter","transliteration":"bil-ākhirati","verse_key":"4:74"},{"pos":10,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"4:74"},{"pos":11,"ar":"يُقَـٰتِلْ","en_gloss":"fights","transliteration":"yuqātil","verse_key":"4:74"},{"pos":12,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"4:74"},{"pos":13,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"4:74"},{"pos":14,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"4:74"},{"pos":15,"ar":"فَيُقْتَلْ","en_gloss":"then he is killed","transliteration":"fayuq'tal","verse_key":"4:74"},{"pos":16,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"4:74"},{"pos":17,"ar":"يَغْلِبْ","en_gloss":"achieves victory","transliteration":"yaghlib","verse_key":"4:74"},{"pos":18,"ar":"فَسَوْفَ","en_gloss":"then soon","transliteration":"fasawfa","verse_key":"4:74"},{"pos":19,"ar":"نُؤْتِيهِ