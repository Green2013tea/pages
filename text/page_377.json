{"page":377,"verses":[{"verse_key":"27:1","surah":27,"ayah":1,"ar_uthmani":" طسٓ ۚ تِلْكَ ءَايَـٰتُ ٱلْقُرْءَانِ وَكِتَابٍ مُّبِينٍ","en_translation_id":85,"en":"Ta Sin These are the verses of the Quran––a scripture that makes things clear;","words":[{"pos":1,"ar":"طسٓ ۚ","en_gloss":"Ta Seen","transliteration":"tta-seen","verse_key":"27:1"},{"pos":2,"ar":"تِلْكَ","en_gloss":"These","transliteration":"til'ka","verse_key":"27:1"},{"pos":3,"ar":"ءَايَـٰتُ","en_gloss":"(are the) Verses","transliteration":"āyātu","verse_key":"27:1"},{"pos":4,"ar":"ٱلْقُرْءَانِ","en_gloss":"(of) the Quran","transliteration":"l-qur'āni","verse_key":"27:1"},{"pos":5,"ar":"وَكِتَابٍۢ","en_gloss":"and a Book","transliteration":"wakitābin","verse_key":"27:1"},{"pos":6,"ar":"مُّبِينٍ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"27:1"},{"pos":7,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"27:1"}]},{"verse_key":"27:2","surah":27,"ayah":2,"ar_uthmani":"هُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ","en_translation_id":85,"en":"a guide and joyful news for the believers","words":[{"pos":1,"ar":"هُدًۭى","en_gloss":"A guidance","transliteration":"hudan","verse_key":"27:2"},{"pos":2,"ar":"وَبُشْرَىٰ","en_gloss":"and glad tidings","transliteration":"wabush'rā","verse_key":"27:2"},{"pos":3,"ar":"لِلْمُؤْمِنِينَ","en_gloss":"for the believers","transliteration":"lil'mu'minīna","verse_key":"27:2"},{"pos":4,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"27:2"}]},{"verse_key":"27:3","surah":27,"ayah":3,"ar_uthmani":"ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْـَٔاخِرَةِ هُمْ يُوقِنُونَ","en_translation_id":85,"en":"who keep up the prayer, pay the prescribed alms, and believe firmly in the life to come.","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"27:3"},{"pos":2,"ar":"يُقِيمُونَ","en_gloss":"establish","transliteration":"yuqīmūna","verse_key":"27:3"},{"pos":3,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the pray