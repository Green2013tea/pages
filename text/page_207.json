":14,"ar":"ٱلْعَرْشِ","en_gloss":"(of) the Throne","transliteration":"l-ʿarshi","verse_key":"9:129"},{"pos":15,"ar":"ٱلْعَظِيمِ","en_gloss":"the Great","transliteration":"l-ʿaẓīmi","verse_key":"9:129"},{"pos":16,"ar":"١٢٩","en_gloss":"(129)","transliteration":"","verse_key":"9:129"}]}]}