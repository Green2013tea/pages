e whatever He withholds: He is the Almighty, the All Wise.","words":[{"pos":1,"ar":"مَّا","en_gloss":"What","transliteration":"mā","verse_key":"35:2"},{"pos":2,"ar":"يَفْتَحِ","en_gloss":"Allah grants","transliteration":"yaftaḥi","verse_key":"35:2"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"Allah grants","transliteration":"l-lahu","verse_key":"35:2"},{"pos":4,"ar":"لِلنَّاسِ","en_gloss":"to mankind","transliteration":"lilnnāsi","verse_key":"35:2"},{"pos":5,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"35:2"},{"pos":6,"ar":"رَّحْمَةٍۢ","en_gloss":"Mercy","transliteration":"raḥmatin","verse_key":"35:2"},{"pos":7,"ar":"فَلَا","en_gloss":"then none","transliteration":"falā","verse_key":"35:2"},{"pos":8,"ar":"مُمْسِكَ","en_gloss":"(can) withhold","transliteration":"mum'sika","verse_key":"35:2"},{"pos":9,"ar":"لَهَا ۖ","en_gloss":"it","transliteration":"lahā","verse_key":"35:2"},{"pos":10,"ar":"وَمَا","en_gloss":"And what","transliteration":"wamā","verse_key":"35:2"},{"pos":11,"ar":"يُمْسِكْ","en_gloss":"He withholds","transliteration":"yum'sik","verse_key":"35:2"},{"pos":12,"ar":"فَلَا","en_gloss":"then none","transliteration":"falā","verse_key":"35:2"},{"pos":13,"ar":"مُرْسِلَ","en_gloss":"(can) release","transliteration":"mur'sila","verse_key":"35:2"},{"pos":14,"ar":"لَهُۥ","en_gloss":"it","transliteration":"lahu","verse_key":"35:2"},{"pos":15,"ar":"مِنۢ","en_gloss":"thereafter","transliteration":"min","verse_key":"35:2"},{"pos":16,"ar":"بَعْدِهِۦ ۚ","en_gloss":"thereafter","transliteration":"baʿdihi","verse_key":"35:2"},{"pos":17,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"35:2"},{"pos":18,"ar":"ٱلْعَزِيزُ","en_gloss":"(is) the All-Mighty","transliteration":"l-ʿazīzu","verse_key":"35:2"},{"pos":19,"ar":"ٱلْحَكِيمُ","en_gloss":"the All-Wise","transliteration":"l-ḥakīmu","verse_key":"35:2"},{"pos":20,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"35:2"}]},{"verse_key":"35:3","surah":35,"ayah":3,"ar_uthmani":"يَـٰٓأَ