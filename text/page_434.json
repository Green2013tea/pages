{"page":434,"verses":[{"verse_key":"34:49","surah":34,"ayah":49,"ar_uthmani":"قُلْ جَآءَ ٱلْحَقُّ وَمَا يُبْدِئُ ٱلْبَـٰطِلُ وَمَا يُعِيدُ","en_translation_id":85,"en":"Say, ‘The Truth has come; falsehood is powerless.’","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"34:49"},{"pos":2,"ar":"جَآءَ","en_gloss":"Has come","transliteration":"jāa","verse_key":"34:49"},{"pos":3,"ar":"ٱلْحَقُّ","en_gloss":"the truth","transliteration":"l-ḥaqu","verse_key":"34:49"},{"pos":4,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"34:49"},{"pos":5,"ar":"يُبْدِئُ","en_gloss":"(can) originate","transliteration":"yub'di-u","verse_key":"34:49"},{"pos":6,"ar":"ٱلْبَـٰطِلُ","en_gloss":"the falsehood","transliteration":"l-bāṭilu","verse_key":"34:49"},{"pos":7,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"34:49"},{"pos":8,"ar":"يُعِيدُ","en_gloss":"repeat","transliteration":"yuʿīdu","verse_key":"34:49"},{"pos":9,"ar":"٤٩","en_gloss":"(49)","transliteration":"","verse_key":"34:49"}]},{"verse_key":"34:50","surah":34,"ayah":50,"ar_uthmani":"قُلْ إِن ضَلَلْتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفْسِى ۖ وَإِنِ ٱهْتَدَيْتُ فَبِمَا يُوحِىٓ إِلَىَّ رَبِّىٓ ۚ إِنَّهُۥ سَمِيعٌ قَرِيبٌ","en_translation_id":85,"en":"Say, ‘If I go astray, that is my loss, and if I am rightly guided, it is through what my Lord has revealed to me. He is all hearing, and ever near.’","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"34:50"},{"pos":2,"ar":"إِن","en_gloss":"If","transliteration":"in","verse_key":"34:50"},{"pos":3,"ar":"ضَلَلْتُ","en_gloss":"I err","transliteration":"ḍalaltu","verse_key":"34:50"},{"pos":4,"ar":"فَإِنَّمَآ","en_gloss":"then only","transliteration":"fa-innamā","verse_key":"34:50"},{"pos":5,"ar":"أَضِلُّ","en_gloss":"I will err","transliteration":"aḍillu","verse_key":"34:50"},{"pos":6,"ar":"عَلَىٰ","en_gloss":"against","transliteration":"ʿalā","verse_key":"34:50"},{"pos":7,"ar":"نَف