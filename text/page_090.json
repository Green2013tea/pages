_gloss":"(77)","transliteration":"","verse_key":"4:77"}]},{"verse_key":"4:78","surah":4,"ayah":78,"ar_uthmani":"أَيْنَمَا تَكُونُوا۟ يُدْرِككُّمُ ٱلْمَوْتُ وَلَوْ كُنتُمْ فِى بُرُوجٍ مُّشَيَّدَةٍ ۗ وَإِن تُصِبْهُمْ حَسَنَةٌ يَقُولُوا۟ هَـٰذِهِۦ مِنْ عِندِ ٱللَّهِ ۖ وَإِن تُصِبْهُمْ سَيِّئَةٌ يَقُولُوا۟ هَـٰذِهِۦ مِنْ عِندِكَ ۚ قُلْ كُلٌّ مِّنْ عِندِ ٱللَّهِ ۖ فَمَالِ هَـٰٓؤُلَآءِ ٱلْقَوْمِ لَا يَكَادُونَ يَفْقَهُونَ حَدِيثًا","en_translation_id":85,"en":"Death will overtake you no matter where you may be, even inside high towers.’ When good fortune comes their way, they say, ‘This is from God,’ but when harm befalls them, they say, ‘This is from you [Prophet].’ Say to them, ‘Both come from God.’ What is the matter with these people that they can barely understand what they are told?","words":[{"pos":1,"ar":"أَيْنَمَا","en_gloss":"Wherever","transliteration":"aynamā","verse_key":"4:78"},{"pos":2,"ar":"تَكُونُوا۟","en_gloss":"you be","transliteration":"takūnū","verse_key":"4:78"},{"pos":3,"ar":"يُدْرِككُّمُ","en_gloss":"will overtake you","transliteration":"yud'rikkumu","verse_key":"4:78"},{"pos":4,"ar":"ٱلْمَوْتُ","en_gloss":"[the] death","transliteration":"l-mawtu","verse_key":"4:78"},{"pos":5,"ar":"وَلَوْ","en_gloss":"even if","transliteration":"walaw","verse_key":"4:78"},{"pos":6,"ar":"كُنتُمْ","en_gloss":"you are","transliteration":"kuntum","verse_key":"4:78"},{"pos":7,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"4:78"},{"pos":8,"ar":"بُرُوجٍۢ","en_gloss":"towers","transliteration":"burūjin","verse_key":"4:78"},{"pos":9,"ar":"مُّشَيَّدَةٍۢ ۗ","en_gloss":"lofty","transliteration":"mushayyadatin","verse_key":"4:78"},{"pos":10,"ar":"وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"4:78"},{"pos":11,"ar":"تُصِبْهُمْ","en_gloss":"befalls them","transliteration":"tuṣib'hum","verse_key":"4:78"},{"pos":12,"ar":"حَسَنَةٌۭ","en_gloss":"any good","transliteration":"ḥasanatun","verse_key":"4:78"},{"pos":13,"ar":"يَقُولُوا۟","en_gloss":"they