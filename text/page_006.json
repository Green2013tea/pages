e disobedient.","words":[{"pos":1,"ar":"وَإِذْ","en_gloss":"And when","transliteration":"wa-idh","verse_key":"2:34"},{"pos":2,"ar":"قُلْنَا","en_gloss":"We said","transliteration":"qul'nā","verse_key":"2:34"},{"pos":3,"ar":"لِلْمَلَـٰٓئِكَةِ","en_gloss":"to the angels","transliteration":"lil'malāikati","verse_key":"2:34"},{"pos":4,"ar":"ٱسْجُدُوا۟","en_gloss":"Prostrate","transliteration":"us'judū","verse_key":"2:34"},{"pos":5,"ar":"لِـَٔادَمَ","en_gloss":"to Adam","transliteration":"liādama","verse_key":"2:34"},{"pos":6,"ar":"فَسَجَدُوٓا۟","en_gloss":"[so] they prostrated","transliteration":"fasajadū","verse_key":"2:34"},{"pos":7,"ar":"إِلَّآ","en_gloss":"except","transliteration":"illā","verse_key":"2:34"},{"pos":8,"ar":"إِبْلِيسَ","en_gloss":"Iblis","transliteration":"ib'līsa","verse_key":"2:34"},{"pos":9,"ar":"أَبَىٰ","en_gloss":"He refused","transliteration":"abā","verse_key":"2:34"},{"pos":10,"ar":"وَٱسْتَكْبَرَ","en_gloss":"and was arrogant","transliteration":"wa-is'takbara","verse_key":"2:34"},{"pos":11,"ar":"وَكَانَ","en_gloss":"and became","transliteration":"wakāna","verse_key":"2:34"},{"pos":12,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"2:34"},{"pos":13,"ar":"ٱلْكَـٰفِرِينَ","en_gloss":"the disbelievers","transliteration":"l-kāfirīna","verse_key":"2:34"},{"pos":14,"ar":"٣٤","en_gloss":"(34)","transliteration":"","verse_key":"2:34"}]},{"verse_key":"2:35","surah":2,"ayah":35,"ar_uthmani":"وَقُلْنَا يَـٰٓـَٔادَمُ ٱسْكُنْ أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ وَكُلَا مِنْهَا رَغَدًا حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَـٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّـٰلِمِينَ","en_translation_id":85,"en":"We said, ‘Adam, live with your wife in this garden. Both of you eat freely there as you will, but do not go near this tree, or you will both become wrongdoers.’","words":[{"pos":1,"ar":"وَقُلْنَا","en_gloss":"And We said","transliteration":"waqul'nā","verse_key":"2:35"},{"pos":2,"ar":"يَـٰٓـَٔادَمُ","en_gloss":"O Adam","transliteration":"yāādamu","verse_