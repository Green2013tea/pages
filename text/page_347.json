ayah":83,"ar_uthmani":"لَقَدْ وُعِدْنَا نَحْنُ وَءَابَآؤُنَا هَـٰذَا مِن قَبْلُ إِنْ هَـٰذَآ إِلَّآ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","en_translation_id":85,"en":"We have heard such promises before, and so did our forefathers. These are just ancient fables.’","words":[{"pos":1,"ar":"لَقَدْ","en_gloss":"Verily","transliteration":"laqad","verse_key":"23:83"},{"pos":2,"ar":"وُعِدْنَا","en_gloss":"we have been promised","transliteration":"wuʿid'nā","verse_key":"23:83"},{"pos":3,"ar":"نَحْنُ","en_gloss":"[we]","transliteration":"naḥnu","verse_key":"23:83"},{"pos":4,"ar":"وَءَابَآؤُنَا","en_gloss":"and our forefathers","transliteration":"waābāunā","verse_key":"23:83"},{"pos":5,"ar":"هَـٰذَا","en_gloss":"this","transliteration":"hādhā","verse_key":"23:83"},{"pos":6,"ar":"مِن","en_gloss":"before","transliteration":"min","verse_key":"23:83"},{"pos":7,"ar":"قَبْلُ","en_gloss":"before","transliteration":"qablu","verse_key":"23:83"},{"pos":8,"ar":"إِنْ","en_gloss":"not","transliteration":"in","verse_key":"23:83"},{"pos":9,"ar":"هَـٰذَآ","en_gloss":"(is) this","transliteration":"hādhā","verse_key":"23:83"},{"pos":10,"ar":"إِلَّآ","en_gloss":"but","transliteration":"illā","verse_key":"23:83"},{"pos":11,"ar":"أَسَـٰطِيرُ","en_gloss":"(the) tales","transliteration":"asāṭīru","verse_key":"23:83"},{"pos":12,"ar":"ٱلْأَوَّلِينَ","en_gloss":"(of) the former (people)","transliteration":"l-awalīna","verse_key":"23:83"},{"pos":13,"ar":"٨٣","en_gloss":"(83)","transliteration":"","verse_key":"23:83"}]},{"verse_key":"23:84","surah":23,"ayah":84,"ar_uthmani":"قُل لِّمَنِ ٱلْأَرْضُ وَمَن فِيهَآ إِن كُنتُمْ تَعْلَمُونَ","en_translation_id":85,"en":"Say [Prophet], ‘Who owns the earth and all who live in it, if you know [so much]?’","words":[{"pos":1,"ar":"قُل","en_gloss":"Say","transliteration":"qul","verse_key":"23:84"},{"pos":2,"ar":"لِّمَنِ","en_gloss":"To whom (belongs)","transliteration":"limani","verse_key":"23:84"},{"pos":3,"ar":"ٱلْأَرْضُ","en_gloss":"the earth","transliteration":"l-arḍu