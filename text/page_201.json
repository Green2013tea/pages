":"9:91"},{"pos":24,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"9:91"},{"pos":25,"ar":"غَفُورٌۭ","en_gloss":"(is) Oft-Forgiving","transliteration":"ghafūrun","verse_key":"9:91"},{"pos":26,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"9:91"},{"pos":27,"ar":"٩١","en_gloss":"(91)","transliteration":"","verse_key":"9:91"}]},{"verse_key":"9:92","surah":9,"ayah":92,"ar_uthmani":"وَلَا عَلَى ٱلَّذِينَ إِذَا مَآ أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ لَآ أَجِدُ مَآ أَحْمِلُكُمْ عَلَيْهِ تَوَلَّوا۟ وَّأَعْيُنُهُمْ تَفِيضُ مِنَ ٱلدَّمْعِ حَزَنًا أَلَّا يَجِدُوا۟ مَا يُنفِقُونَ","en_translation_id":85,"en":"And there is no blame attached to those who came to you [Prophet] for riding animals and to whom you said, ‘I cannot find a mount for you’: they turned away with their eyes overflowing with tears of grief that they had nothing they could contribute.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"9:92"},{"pos":2,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"9:92"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"9:92"},{"pos":4,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"9:92"},{"pos":5,"ar":"مَآ","en_gloss":"when","transliteration":"mā","verse_key":"9:92"},{"pos":6,"ar":"أَتَوْكَ","en_gloss":"they came to you","transliteration":"atawka","verse_key":"9:92"},{"pos":7,"ar":"لِتَحْمِلَهُمْ","en_gloss":"that you provide them with mounts","transliteration":"litaḥmilahum","verse_key":"9:92"},{"pos":8,"ar":"قُلْتَ","en_gloss":"you said","transliteration":"qul'ta","verse_key":"9:92"},{"pos":9,"ar":"لَآ","en_gloss":"Not","transliteration":"lā","verse_key":"9:92"},{"pos":10,"ar":"أَجِدُ","en_gloss":"I find","transliteration":"ajidu","verse_key":"9:92"},{"pos":11,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"9:92"},{"pos":12,"ar":"أَحْمِلُكُمْ","en_gloss":"to mou