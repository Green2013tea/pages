59"},{"pos":24,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"6:59"},{"pos":25,"ar":"رَطْبٍۢ","en_gloss":"moist","transliteration":"raṭbin","verse_key":"6:59"},{"pos":26,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"6:59"},{"pos":27,"ar":"يَابِسٍ","en_gloss":"dry","transliteration":"yābisin","verse_key":"6:59"},{"pos":28,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"6:59"},{"pos":29,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"6:59"},{"pos":30,"ar":"كِتَـٰبٍۢ","en_gloss":"a Record","transliteration":"kitābin","verse_key":"6:59"},{"pos":31,"ar":"مُّبِينٍۢ","en_gloss":"Clear","transliteration":"mubīnin","verse_key":"6:59"},{"pos":32,"ar":"٥٩","en_gloss":"(59)","transliteration":"","verse_key":"6:59"}]}]}