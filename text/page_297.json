َغِيثُوا۟ يُغَاثُوا۟ بِمَآءٍ كَٱلْمُهْلِ يَشْوِى ٱلْوُجُوهَ ۚ بِئْسَ ٱلشَّرَابُ وَسَآءَتْ مُرْتَفَقًا","en_translation_id":85,"en":"Say, ‘Now the truth has come from your Lord: let those who wish to believe in it do so, and let those who wish to reject it do so.’ We have prepared a Fire for the wrongdoers that will envelop them from all sides. If they call for relief, they will be relieved with water like molten metal, scalding their faces. What a terrible drink! What a painful resting place!","words":[{"pos":1,"ar":"وَقُلِ","en_gloss":"And say","transliteration":"waquli","verse_key":"18:29"},{"pos":2,"ar":"ٱلْحَقُّ","en_gloss":"The truth","transliteration":"l-ḥaqu","verse_key":"18:29"},{"pos":3,"ar":"مِن","en_gloss":"(is) from","transliteration":"min","verse_key":"18:29"},{"pos":4,"ar":"رَّبِّكُمْ ۖ","en_gloss":"your Lord","transliteration":"rabbikum","verse_key":"18:29"},{"pos":5,"ar":"فَمَن","en_gloss":"so whoever","transliteration":"faman","verse_key":"18:29"},{"pos":6,"ar":"شَآءَ","en_gloss":"wills ","transliteration":"shāa","verse_key":"18:29"},{"pos":7,"ar":"فَلْيُؤْمِن","en_gloss":"let him believe","transliteration":"falyu'min","verse_key":"18:29"},{"pos":8,"ar":"وَمَن","en_gloss":"and whoever","transliteration":"waman","verse_key":"18:29"},{"pos":9,"ar":"شَآءَ","en_gloss":"wills ","transliteration":"shāa","verse_key":"18:29"},{"pos":10,"ar":"فَلْيَكْفُرْ ۚ","en_gloss":"let him disbelieve","transliteration":"falyakfur","verse_key":"18:29"},{"pos":11,"ar":"إِنَّآ","en_gloss":"Indeed, We","transliteration":"innā","verse_key":"18:29"},{"pos":12,"ar":"أَعْتَدْنَا","en_gloss":"have prepared","transliteration":"aʿtadnā","verse_key":"18:29"},{"pos":13,"ar":"لِلظَّـٰلِمِينَ","en_gloss":"for the wrongdoers","transliteration":"lilẓẓālimīna","verse_key":"18:29"},{"pos":14,"ar":"نَارًا","en_gloss":"a Fire","transliteration":"nāran","verse_key":"18:29"},{"pos":15,"ar":"أَحَاطَ","en_gloss":"will surround","transliteration":"aḥāṭa","verse_key":"18:29"},{"pos":16,"ar":