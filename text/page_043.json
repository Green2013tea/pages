e who do evil.","words":[{"pos":1,"ar":"أَلَمْ","en_gloss":"Did not","transliteration":"alam","verse_key":"2:258"},{"pos":2,"ar":"تَرَ","en_gloss":"you see","transliteration":"tara","verse_key":"2:258"},{"pos":3,"ar":"إِلَى","en_gloss":"[towards]","transliteration":"ilā","verse_key":"2:258"},{"pos":4,"ar":"ٱلَّذِى","en_gloss":"the one who","transliteration":"alladhī","verse_key":"2:258"},{"pos":5,"ar":"حَآجَّ","en_gloss":"argued","transliteration":"ḥājja","verse_key":"2:258"},{"pos":6,"ar":"إِبْرَٰهِـۧمَ","en_gloss":"(with) Ibrahim","transliteration":"ib'rāhīma","verse_key":"2:258"},{"pos":7,"ar":"فِى","en_gloss":"concerning","transliteration":"fī","verse_key":"2:258"},{"pos":8,"ar":"رَبِّهِۦٓ","en_gloss":"his Lord","transliteration":"rabbihi","verse_key":"2:258"},{"pos":9,"ar":"أَنْ","en_gloss":"because","transliteration":"an","verse_key":"2:258"},{"pos":10,"ar":"ءَاتَىٰهُ","en_gloss":"gave him","transliteration":"ātāhu","verse_key":"2:258"},{"pos":11,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"2:258"},{"pos":12,"ar":"ٱلْمُلْكَ","en_gloss":"the kingdom","transliteration":"l-mul'ka","verse_key":"2:258"},{"pos":13,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"2:258"},{"pos":14,"ar":"قَالَ","en_gloss":"Said","transliteration":"qāla","verse_key":"2:258"},{"pos":15,"ar":"إِبْرَٰهِـۧمُ","en_gloss":"Ibrahim","transliteration":"ib'rāhīmu","verse_key":"2:258"},{"pos":16,"ar":"رَبِّىَ","en_gloss":"My Lord","transliteration":"rabbiya","verse_key":"2:258"},{"pos":17,"ar":"ٱلَّذِى","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"2:258"},{"pos":18,"ar":"يُحْىِۦ","en_gloss":"grants life","transliteration":"yuḥ'yī","verse_key":"2:258"},{"pos":19,"ar":"وَيُمِيتُ","en_gloss":"and causes death","transliteration":"wayumītu","verse_key":"2:258"},{"pos":20,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"2:258"},{"pos":21,"ar":"أَنَا۠","en_gloss":"I","transliteration":"anā","verse_key":"2:2