"},{"pos":14,"ar":"لَا","en_gloss":"(will) not","transliteration":"lā","verse_key":"3:25"},{"pos":15,"ar":"يُظْلَمُونَ","en_gloss":"be wronged","transliteration":"yuẓ'lamūna","verse_key":"3:25"},{"pos":16,"ar":"٢٥","en_gloss":"(25)","transliteration":"","verse_key":"3:25"}]},{"verse_key":"3:26","surah":3,"ayah":26,"ar_uthmani":"قُلِ ٱللَّهُمَّ مَـٰلِكَ ٱلْمُلْكِ تُؤْتِى ٱلْمُلْكَ مَن تَشَآءُ وَتَنزِعُ ٱلْمُلْكَ مِمَّن تَشَآءُ وَتُعِزُّ مَن تَشَآءُ وَتُذِلُّ مَن تَشَآءُ ۖ بِيَدِكَ ٱلْخَيْرُ ۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","en_translation_id":85,"en":"Say, ‘God, holder of all control, You give control to whoever You will and remove it from whoever You will; You elevate whoever You will and humble whoever You will. All that is good lies in Your hand: You have power over everything.","words":[{"pos":1,"ar":"قُلِ","en_gloss":"Say","transliteration":"quli","verse_key":"3:26"},{"pos":2,"ar":"ٱللَّهُمَّ","en_gloss":"O Allah","transliteration":"l-lahuma","verse_key":"3:26"},{"pos":3,"ar":"مَـٰلِكَ","en_gloss":"Owner","transliteration":"mālika","verse_key":"3:26"},{"pos":4,"ar":"ٱلْمُلْكِ","en_gloss":"(of) the Dominion","transliteration":"l-mul'ki","verse_key":"3:26"},{"pos":5,"ar":"تُؤْتِى","en_gloss":"You give","transliteration":"tu'tī","verse_key":"3:26"},{"pos":6,"ar":"ٱلْمُلْكَ","en_gloss":"the dominion","transliteration":"l-mul'ka","verse_key":"3:26"},{"pos":7,"ar":"مَن","en_gloss":"(to) whom","transliteration":"man","verse_key":"3:26"},{"pos":8,"ar":"تَشَآءُ","en_gloss":"You will","transliteration":"tashāu","verse_key":"3:26"},{"pos":9,"ar":"وَتَنزِعُ","en_gloss":"and You take away","transliteration":"watanziʿu","verse_key":"3:26"},{"pos":10,"ar":"ٱلْمُلْكَ","en_gloss":"the dominion","transliteration":"l-mul'ka","verse_key":"3:26"},{"pos":11,"ar":"مِمَّن","en_gloss":"from whom","transliteration":"mimman","verse_key":"3:26"},{"pos":12,"ar":"تَشَآءُ","en_gloss":"You will","transliteration":"tashāu","verse_key":"3:26"},{"pos":13,"ar":"وَتُعِزُّ","en_gloss":"a