 ذَٰلِكَ فَلَيْسَ مِنَ ٱللَّهِ فِى شَىْءٍ إِلَّآ أَن تَتَّقُوا۟ مِنْهُمْ تُقَىٰةً ۗ وَيُحَذِّرُكُمُ ٱللَّهُ نَفْسَهُۥ ۗ وَإِلَى ٱللَّهِ ٱلْمَصِيرُ","en_translation_id":85,"en":"The believers should not make the disbelievers their allies rather than other believers- anyone who does such a thing will isolate himself completely from God- except when you need to protect yourselves from them. God warns you to beware of Him: the Final Return is to God.","words":[{"pos":1,"ar":"لَّا","en_gloss":"(Let) not","transliteration":"lā","verse_key":"3:28"},{"pos":2,"ar":"يَتَّخِذِ","en_gloss":"take","transliteration":"yattakhidhi","verse_key":"3:28"},{"pos":3,"ar":"ٱلْمُؤْمِنُونَ","en_gloss":"the believers","transliteration":"l-mu'minūna","verse_key":"3:28"},{"pos":4,"ar":"ٱلْكَـٰفِرِينَ","en_gloss":"the disbelievers","transliteration":"l-kāfirīna","verse_key":"3:28"},{"pos":5,"ar":"أَوْلِيَآءَ","en_gloss":"(as) allies","transliteration":"awliyāa","verse_key":"3:28"},{"pos":6,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"3:28"},{"pos":7,"ar":"دُونِ","en_gloss":"instead of","transliteration":"dūni","verse_key":"3:28"},{"pos":8,"ar":"ٱلْمُؤْمِنِينَ ۖ","en_gloss":"the believers","transliteration":"l-mu'minīna","verse_key":"3:28"},{"pos":9,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"3:28"},{"pos":10,"ar":"يَفْعَلْ","en_gloss":"does","transliteration":"yafʿal","verse_key":"3:28"},{"pos":11,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"3:28"},{"pos":12,"ar":"فَلَيْسَ","en_gloss":"then not he (has)","transliteration":"falaysa","verse_key":"3:28"},{"pos":13,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"3:28"},{"pos":14,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"3:28"},{"pos":15,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"3:28"},{"pos":16,"ar":"شَىْءٍ","en_gloss":"anything","transliteration":"shayin","verse_key":"3:28"},{"pos":17,"ar":"إ