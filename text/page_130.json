,"verse_key":"6:19"},{"pos":35,"ar":"بَرِىٓءٌۭ","en_gloss":"free","transliteration":"barīon","verse_key":"6:19"},{"pos":36,"ar":"مِّمَّا","en_gloss":"of what","transliteration":"mimmā","verse_key":"6:19"},{"pos":37,"ar":"تُشْرِكُونَ","en_gloss":"you associate (with Him)","transliteration":"tush'rikūna","verse_key":"6:19"},{"pos":38,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"6:19"}]},{"verse_key":"6:20","surah":6,"ayah":20,"ar_uthmani":"ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ أَبْنَآءَهُمُ ۘ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ","en_translation_id":85,"en":"Those to whom We have given the Scripture know this as well as they know their own sons. Those who have lost their souls will not believe.","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"Those (to) whom","transliteration":"alladhīna","verse_key":"6:20"},{"pos":2,"ar":"ءَاتَيْنَـٰهُمُ","en_gloss":"We have given them","transliteration":"ātaynāhumu","verse_key":"6:20"},{"pos":3,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","verse_key":"6:20"},{"pos":4,"ar":"يَعْرِفُونَهُۥ","en_gloss":"they recognize him","transliteration":"yaʿrifūnahu","verse_key":"6:20"},{"pos":5,"ar":"كَمَا","en_gloss":"as","transliteration":"kamā","verse_key":"6:20"},{"pos":6,"ar":"يَعْرِفُونَ","en_gloss":"they recognize","transliteration":"yaʿrifūna","verse_key":"6:20"},{"pos":7,"ar":"أَبْنَآءَهُمُ ۘ","en_gloss":"their sons","transliteration":"abnāahumu","verse_key":"6:20"},{"pos":8,"ar":"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"6:20"},{"pos":9,"ar":"خَسِرُوٓا۟","en_gloss":"lost","transliteration":"khasirū","verse_key":"6:20"},{"pos":10,"ar":"أَنفُسَهُمْ","en_gloss":"themselves","transliteration":"anfusahum","verse_key":"6:20"},{"pos":11,"ar":"فَهُمْ","en_gloss":"then they","transliteration":"fahum","verse_key":"6:20"},{"pos":12,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"6:20"},{"pos":13,"ar"