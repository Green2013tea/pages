ation":"lasiḥ'run","verse_key":"10:76"},{"pos":10,"ar":"مُّبِينٌۭ","en_gloss":"clear","transliteration":"mubīnun","verse_key":"10:76"},{"pos":11,"ar":"٧٦","en_gloss":"(76)","transliteration":"","verse_key":"10:76"}]},{"verse_key":"10:77","surah":10,"ayah":77,"ar_uthmani":"قَالَ مُوسَىٰٓ أَتَقُولُونَ لِلْحَقِّ لَمَّا جَآءَكُمْ ۖ أَسِحْرٌ هَـٰذَا وَلَا يُفْلِحُ ٱلسَّـٰحِرُونَ","en_translation_id":85,"en":"Moses said, ‘Is this what you say about the Truth when it comes to you? Is this sorcery? Sorcerers never prosper.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"Musa said","transliteration":"qāla","verse_key":"10:77"},{"pos":2,"ar":"مُوسَىٰٓ","en_gloss":"Musa said","transliteration":"mūsā","verse_key":"10:77"},{"pos":3,"ar":"أَتَقُولُونَ","en_gloss":"Do you say","transliteration":"ataqūlūna","verse_key":"10:77"},{"pos":4,"ar":"لِلْحَقِّ","en_gloss":"about the truth","transliteration":"lil'ḥaqqi","verse_key":"10:77"},{"pos":5,"ar":"لَمَّا","en_gloss":"when","transliteration":"lammā","verse_key":"10:77"},{"pos":6,"ar":"جَآءَكُمْ ۖ","en_gloss":"it has come to you","transliteration":"jāakum","verse_key":"10:77"},{"pos":7,"ar":"أَسِحْرٌ","en_gloss":"Is this magic","transliteration":"asiḥ'run","verse_key":"10:77"},{"pos":8,"ar":"هَـٰذَا","en_gloss":"Is this magic","transliteration":"hādhā","verse_key":"10:77"},{"pos":9,"ar":"وَلَا","en_gloss":"But (will) not","transliteration":"walā","verse_key":"10:77"},{"pos":10,"ar":"يُفْلِحُ","en_gloss":"succeed","transliteration":"yuf'liḥu","verse_key":"10:77"},{"pos":11,"ar":"ٱلسَّـٰحِرُونَ","en_gloss":"the magicians","transliteration":"l-sāḥirūna","verse_key":"10:77"},{"pos":12,"ar":"٧٧","en_gloss":"(77)","transliteration":"","verse_key":"10:77"}]},{"verse_key":"10:78","surah":10,"ayah":78,"ar_uthmani":"قَالُوٓا۟ أَجِئْتَنَا لِتَلْفِتَنَا عَمَّا وَجَدْنَا عَلَيْهِ ءَابَآءَنَا وَتَكُونَ لَكُمَا ٱلْكِبْرِيَآءُ فِى ٱلْأَرْضِ وَمَا نَحْنُ لَكُمَا بِمُؤْمِنِينَ","en_translation_id":85,"en":"They said, ‘Have you come to turn us away from the faith we found our fathers following, so that you and your brother can gain greatness in this land? We will never believe in you.’","words":[{"pos":1,"ar":"قَالُوٓا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"10:78"},{"pos":2,"ar":"أَجِئْتَنَا","en_gloss":"Have you come to us","transliteration":"aji'tanā","verse_key":"10:78"},{"pos":3,"ar":"لِتَلْفِتَنَا","en_gloss":"to turn us away","transliteration":"litalfitanā","verse_key":"10:78"},{"pos":4,"ar":"عَمَّا","en_gloss":"from that","transliteration":"ʿammā","verse_key":"10:78"},{"pos":5,"ar":"وَجَدْنَا","en_gloss":"we found","transliteration":"wajadnā","verse_key":"10:78"},{"pos":6,"ar":"عَلَيْهِ","en_gloss":"on it","transliteration":"ʿalayhi","verse_key":"10:78"},{"pos":7,"ar":"ءَابَآءَنَا","en_gloss":"our forefathers","transliteration":"ābāanā","verse_key":"10:78"},{"pos":8,"ar":"وَتَكُونَ","en_gloss":"and you two (may) have","transliteration":"watakūna","verse_key":"10:78"},{"pos":9,"ar":"لَكُمَا","en_gloss":"and you two (may) have","transliteration":"lakumā","verse_key":"10:78"},{"pos":10,"ar":"ٱلْكِبْرِيَآءُ","en_gloss":"the greatness","transliteration":"l-kib'riyāu","verse_key":"10:78"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:78"},{"pos":12,"ar":"ٱلْأَرْضِ","en_gloss":"the land","transliteration":"l-arḍi","verse_key":"10:78"},{"pos":13,"ar":"وَمَا","en_gloss":"And we (are) not","transliteration":"wamā","verse_key":"10:78"},{"pos":14,"ar":"نَحْنُ","en_gloss":"And we (are) not","transliteration":"naḥnu","verse_key":"10:78"},{"pos":15,"ar":"لَكُمَا","en_gloss":"(in) you two","transliteration":"lakumā","verse_key":"10:78"},{"pos":16,"ar":"بِمُؤْمِنِينَ","en_gloss":"believers","transliteration":"bimu'minīna","verse_key":"10:78"},{"pos":17,"ar":"٧٨","en_gloss":"(78)","transliteration":"","verse_key":"10:78"}]}]}