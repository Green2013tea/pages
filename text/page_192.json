ُوا۟ فِيهِنَّ أَنفُسَكُمْ ۚ وَقَـٰتِلُوا۟ ٱلْمُشْرِكِينَ كَآفَّةً كَمَا يُقَـٰتِلُونَكُمْ كَآفَّةً ۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ","en_translation_id":85,"en":"God decrees that there are twelve months- ordained in God’s Book on the Day when He created the heavens and earth- four months of which are sacred: this is the correct calculation. Do not wrong your souls in these months- though you may fight the idolaters at any time, if they first fight you- remember that God is with those who are mindful of Him.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"9:36"},{"pos":2,"ar":"عِدَّةَ","en_gloss":"(the) number","transliteration":"ʿiddata","verse_key":"9:36"},{"pos":3,"ar":"ٱلشُّهُورِ","en_gloss":"(of) the months","transliteration":"l-shuhūri","verse_key":"9:36"},{"pos":4,"ar":"عِندَ","en_gloss":"with","transliteration":"ʿinda","verse_key":"9:36"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"9:36"},{"pos":6,"ar":"ٱثْنَا","en_gloss":"(is) twelve","transliteration":"ith'nā","verse_key":"9:36"},{"pos":7,"ar":"عَشَرَ","en_gloss":"(is) twelve","transliteration":"ʿashara","verse_key":"9:36"},{"pos":8,"ar":"شَهْرًۭا","en_gloss":"months","transliteration":"shahran","verse_key":"9:36"},{"pos":9,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"9:36"},{"pos":10,"ar":"كِتَـٰبِ","en_gloss":"(the) ordinance","transliteration":"kitābi","verse_key":"9:36"},{"pos":11,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"9:36"},{"pos":12,"ar":"يَوْمَ","en_gloss":"(from the) Day","transliteration":"yawma","verse_key":"9:36"},{"pos":13,"ar":"خَلَقَ","en_gloss":"He created","transliteration":"khalaqa","verse_key":"9:36"},{"pos":14,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"9:36"},{"pos":15,"ar":"وَٱلْأَرْضَ","en_gloss":"and the earth","transliteration":"wal-arḍa","verse_key":"9:36"},{"pos":16,"ar":"مِنْهَآ