ey":"18:52","surah":18,"ayah":52,"ar_uthmani":"وَيَوْمَ يَقُولُ نَادُوا۟ شُرَكَآءِىَ ٱلَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ وَجَعَلْنَا بَيْنَهُم مَّوْبِقًا","en_translation_id":85,"en":"On the Day God will say, ‘Call on those you claimed were My partners,’ they will call them but they will not answer; We shall set a deadly gulf between them.","words":[{"pos":1,"ar":"وَيَوْمَ","en_gloss":"And the Day","transliteration":"wayawma","verse_key":"18:52"},{"pos":2,"ar":"يَقُولُ","en_gloss":"He will say","transliteration":"yaqūlu","verse_key":"18:52"},{"pos":3,"ar":"نَادُوا۟","en_gloss":"Call","transliteration":"nādū","verse_key":"18:52"},{"pos":4,"ar":"شُرَكَآءِىَ","en_gloss":"My partners","transliteration":"shurakāiya","verse_key":"18:52"},{"pos":5,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"18:52"},{"pos":6,"ar":"زَعَمْتُمْ","en_gloss":"you claimed","transliteration":"zaʿamtum","verse_key":"18:52"},{"pos":7,"ar":"فَدَعَوْهُمْ","en_gloss":"then they will call them","transliteration":"fadaʿawhum","verse_key":"18:52"},{"pos":8,"ar":"فَلَمْ","en_gloss":"but not","transliteration":"falam","verse_key":"18:52"},{"pos":9,"ar":"يَسْتَجِيبُوا۟","en_gloss":"they will respond","transliteration":"yastajībū","verse_key":"18:52"},{"pos":10,"ar":"لَهُمْ","en_gloss":"to them","transliteration":"lahum","verse_key":"18:52"},{"pos":11,"ar":"وَجَعَلْنَا","en_gloss":"And We will make","transliteration":"wajaʿalnā","verse_key":"18:52"},{"pos":12,"ar":"بَيْنَهُم","en_gloss":"between them","transliteration":"baynahum","verse_key":"18:52"},{"pos":13,"ar":"مَّوْبِقًۭا","en_gloss":"a barrier","transliteration":"mawbiqan","verse_key":"18:52"},{"pos":14,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"18:52"}]},{"verse_key":"18:53","surah":18,"ayah":53,"ar_uthmani":"وَرَءَا ٱلْمُجْرِمُونَ ٱلنَّارَ فَظَنُّوٓا۟ أَنَّهُم مُّوَاقِعُوهَا وَلَمْ يَجِدُوا۟ عَنْهَا مَصْرِفًا","en_translation_id":85,"en":"The evildoers will see the Fire and they will realize that they are about to fall into it: they will find no escape from it.","words":[{"pos":1,"ar":"وَرَءَا","en_gloss":"And will see","transliteration":"waraā","verse_key":"18:53"},{"pos":2,"ar":"ٱلْمُجْرِمُونَ","en_gloss":"the criminals","transliteration":"l-muj'rimūna","verse_key":"18:53"},{"pos":3,"ar":"ٱلنَّارَ","en_gloss":"the Fire","transliteration":"l-nāra","verse_key":"18:53"},{"pos":4,"ar":"فَظَنُّوٓا۟","en_gloss":"and they (will be) certain","transliteration":"faẓannū","verse_key":"18:53"},{"pos":5,"ar":"أَنَّهُم","en_gloss":"that they","transliteration":"annahum","verse_key":"18:53"},{"pos":6,"ar":"مُّوَاقِعُوهَا","en_gloss":"are to fall in it","transliteration":"muwāqiʿūhā","verse_key":"18:53"},{"pos":7,"ar":"وَلَمْ","en_gloss":"And not","transliteration":"walam","verse_key":"18:53"},{"pos":8,"ar":"يَجِدُوا۟","en_gloss":"they will find","transliteration":"yajidū","verse_key":"18:53"},{"pos":9,"ar":"عَنْهَا","en_gloss":"from it","transliteration":"ʿanhā","verse_key":"18:53"},{"pos":10,"ar":"مَصْرِفًۭا","en_gloss":"a way of escape","transliteration":"maṣrifan","verse_key":"18:53"},{"pos":11,"ar":"٥٣","en_gloss":"(53)","transliteration":"","verse_key":"18:53"}]}]}