teration":"alīman","verse_key":"4:18"},{"pos":25,"ar":"١٨","en_gloss":"(18)","transliteration":"","verse_key":"4:18"}]},{"verse_key":"4:19","surah":4,"ayah":19,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا يَحِلُّ لَكُمْ أَن تَرِثُوا۟ ٱلنِّسَآءَ كَرْهًا ۖ وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا۟ بِبَعْضِ مَآ ءَاتَيْتُمُوهُنَّ إِلَّآ أَن يَأْتِينَ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ ۚ وَعَاشِرُوهُنَّ بِٱلْمَعْرُوفِ ۚ فَإِن كَرِهْتُمُوهُنَّ فَعَسَىٰٓ أَن تَكْرَهُوا۟ شَيْـًٔا وَيَجْعَلَ ٱللَّهُ فِيهِ خَيْرًا كَثِيرًا","en_translation_id":85,"en":"You who believe, it is not lawful for you to inherit women against their will, nor should you treat your wives harshly, hoping to take back some of the bride-gift you gave them, unless they are guilty of something clearly outrageous. Live with them in accordance with what is fair and kind: if you dislike them, it may well be that you dislike something in which God has put much good.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"4:19"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"4:19"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"4:19"},{"pos":4,"ar":"لَا","en_gloss":"Not","transliteration":"lā","verse_key":"4:19"},{"pos":5,"ar":"يَحِلُّ","en_gloss":"(is) lawful","transliteration":"yaḥillu","verse_key":"4:19"},{"pos":6,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"4:19"},{"pos":7,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"4:19"},{"pos":8,"ar":"تَرِثُوا۟","en_gloss":"you inherit","transliteration":"tarithū","verse_key":"4:19"},{"pos":9,"ar":"ٱلنِّسَآءَ","en_gloss":"the women","transliteration":"l-nisāa","verse_key":"4:19"},{"pos":10,"ar":"كَرْهًۭا ۖ","en_gloss":"(by) force","transliteration":"karhan","verse_key":"4:19"},{"pos":11,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"4:19"},{"pos":12,"ar":"تَعْضُلُوهُنَّ","en_gloss":"you constraint them","transliteration":"taʿḍulūhunna","verse_key":"4:19"},{"pos":13,"ar":"لِتَذْهَبُوا۟","en_gloss":"so that you may take","transliteration":"litadhhabū","verse_key":"4:19"},{"pos":14,"ar":"بِبَعْضِ","en_gloss":"a part","transliteration":"bibaʿḍi","verse_key":"4:19"},{"pos":15,"ar":"مَآ","en_gloss":"(of) what","transliteration":"mā","verse_key":"4:19"},{"pos":16,"ar":"ءَاتَيْتُمُوهُنَّ","en_gloss":"you have given them","transliteration":"ātaytumūhunna","verse_key":"4:19"},{"pos":17,"ar":"إِلَّآ","en_gloss":"except","transliteration":"illā","verse_key":"4:19"},{"pos":18,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"4:19"},{"pos":19,"ar":"يَأْتِينَ","en_gloss":"they commit","transliteration":"yatīna","verse_key":"4:19"},{"pos":20,"ar":"بِفَـٰحِشَةٍۢ","en_gloss":"immorality","transliteration":"bifāḥishatin","verse_key":"4:19"},{"pos":21,"ar":"مُّبَيِّنَةٍۢ ۚ","en_gloss":"open","transliteration":"mubayyinatin","verse_key":"4:19"},{"pos":22,"ar":"وَعَاشِرُوهُنَّ","en_gloss":"And live with them","transliteration":"waʿāshirūhunna","verse_key":"4:19"},{"pos":23,"ar":"بِٱلْمَعْرُوفِ ۚ","en_gloss":"in kindness","transliteration":"bil-maʿrūfi","verse_key":"4:19"},{"pos":24,"ar":"فَإِن","en_gloss":"But if","transliteration":"fa-in","verse_key":"4:19"},{"pos":25,"ar":"كَرِهْتُمُوهُنَّ","en_gloss":"you dislike them","transliteration":"karih'tumūhunna","verse_key":"4:19"},{"pos":26,"ar":"فَعَسَىٰٓ","en_gloss":"then perhaps","transliteration":"faʿasā","verse_key":"4:19"},{"pos":27,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"4:19"},{"pos":28,"ar":"تَكْرَهُوا۟","en_gloss":"you dislike","transliteration":"takrahū","verse_key":"4:19"},{"pos":29,"ar":"شَيْـًۭٔا","en_gloss":"a thing","transliteration":"shayan","verse_key":"4:19"},{"pos":30,"ar":"وَيَجْعَلَ","en_gloss":"and has placed","transliteration":"wayajʿala","verse_key":"4:19"},{"pos":31,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"4:19"},{"pos":32,"ar":"فِيهِ","en_gloss":"in it","transliteration":"fīhi","verse_key":"4:19"},{"pos":33,"ar":"خَيْرًۭا","en_gloss":"good","transliteration":"khayran","verse_key":"4:19"},{"pos":34,"ar":"كَثِيرًۭا","en_gloss":"much","transliteration":"kathīran","verse_key":"4:19"},{"pos":35,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"4:19"}]}]}