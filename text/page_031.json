{"page":31,"verses":[{"verse_key":"2:197","surah":2,"ayah":197,"ar_uthmani":"ٱلْحَجُّ أَشْهُرٌ مَّعْلُومَـٰتٌ ۚ فَمَن فَرَضَ فِيهِنَّ ٱلْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِى ٱلْحَجِّ ۗ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ يَعْلَمْهُ ٱللَّهُ ۗ وَتَزَوَّدُوا۟ فَإِنَّ خَيْرَ ٱلزَّادِ ٱلتَّقْوَىٰ ۚ وَٱتَّقُونِ يَـٰٓأُو۟لِى ٱلْأَلْبَـٰبِ","en_translation_id":85,"en":"The pilgrimage takes place during the prescribed months. There should be no indecent speech, misbehaviour, or quarrelling for anyone undertaking the pilgrimage- whatever good you do, God is well aware of it. Provide well for yourselves: the best provision is to be mindful of God- always be mindful of Me, you who have understanding-","words":[{"pos":1,"ar":"ٱلْحَجُّ","en_gloss":"(For) the Hajj","transliteration":"al-ḥaju","verse_key":"2:197"},{"pos":2,"ar":"أَشْهُرٌۭ","en_gloss":"(are) months","transliteration":"ashhurun","verse_key":"2:197"},{"pos":3,"ar":"مَّعْلُومَـٰتٌۭ ۚ","en_gloss":"well known","transliteration":"maʿlūmātun","verse_key":"2:197"},{"pos":4,"ar":"فَمَن","en_gloss":"then whoever","transliteration":"faman","verse_key":"2:197"},{"pos":5,"ar":"فَرَضَ","en_gloss":"undertakes","transliteration":"faraḍa","verse_key":"2:197"},{"pos":6,"ar":"فِيهِنَّ","en_gloss":"therein","transliteration":"fīhinna","verse_key":"2:197"},{"pos":7,"ar":"ٱلْحَجَّ","en_gloss":"the Hajj","transliteration":"l-ḥaja","verse_key":"2:197"},{"pos":8,"ar":"فَلَا","en_gloss":"then no","transliteration":"falā","verse_key":"2:197"},{"pos":9,"ar":"رَفَثَ","en_gloss":"sexual relations","transliteration":"rafatha","verse_key":"2:197"},{"pos":10,"ar":"وَلَا","en_gloss":"and no","transliteration":"walā","verse_key":"2:197"},{"pos":11,"ar":"فُسُوقَ","en_gloss":"wickedness","transliteration":"fusūqa","verse_key":"2:197"},{"pos":12,"ar":"وَلَا","en_gloss":"and no","transliteration":"walā","verse_key":"2:197"},{"pos":13,"ar":"جِدَالَ","en_gloss":"quarrelling","transliteration":"jidāla","verse_key":"2:197"},{"pos":14,"ar":"فِى","en_gloss":"during","transliteration":"fī","verse_key":"2:197"},{"pos":15,"ar":"ٱلْحَجِّ ۗ","en_gloss":"the Hajj","transliteration":"l-ḥaji","verse_key":"2:197"},{"pos":16,"ar":"وَمَا","en_gloss":"And whatever","transliteration":"wamā","verse_key":"2:197"},{"pos":17,"ar":"تَفْعَلُوا۟","en_gloss":"you do","transliteration":"tafʿalū","verse_key":"2:197"},{"pos":18,"ar":"مِنْ","en_gloss":"of","transliteration":"min","verse_key":"2:197"},{"pos":19,"ar":"خَيْرٍۢ","en_gloss":"good","transliteration":"khayrin","verse_key":"2:197"},{"pos":20,"ar":"يَعْلَمْهُ","en_gloss":"knows it","transliteration":"yaʿlamhu","verse_key":"2:197"},{"pos":21,"ar":"ٱللَّهُ ۗ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"2:197"},{"pos":22,"ar":"وَتَزَوَّدُوا۟","en_gloss":"And take provision","transliteration":"watazawwadū","verse_key":"2:197"},{"pos":23,"ar":"فَإِنَّ","en_gloss":"(but) indeed","transliteration":"fa-inna","verse_key":"2:197"},{"pos":24,"ar":"خَيْرَ","en_gloss":"(the) best","transliteration":"khayra","verse_key":"2:197"},{"pos":25,"ar":"ٱلزَّادِ","en_gloss":"provision","transliteration":"l-zādi","verse_key":"2:197"},{"pos":26,"ar":"ٱلتَّقْوَىٰ ۚ","en_gloss":"(is) righteousness","transliteration":"l-taqwā","verse_key":"2:197"},{"pos":27,"ar":"وَٱتَّقُونِ","en_gloss":"And fear Me","transliteration":"wa-ittaqūni","verse_key":"2:197"},{"pos":28,"ar":"يَـٰٓأُو۟لِى","en_gloss":"O men","transliteration":"yāulī","verse_key":"2:197"},{"pos":29,"ar":"ٱلْأَلْبَـٰبِ","en_gloss":"(of) understanding","transliteration":"l-albābi","verse_key":"2:197"},{"pos":30,"ar":"١٩٧","en_gloss":"(197)","transliteration":"","verse_key":"2:197"}]},{"verse_key":"2:198","surah":2,"ayah":198,"ar_uthmani":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَبْتَغُوا۟ فَضْلًا مِّن رَّبِّكُمْ ۚ فَإِذَآ أَفَضْتُم مِّنْ عَرَفَـٰتٍ فَٱذْكُرُوا۟ ٱللَّهَ عِندَ ٱلْمَشْعَرِ ٱلْحَرَامِ ۖ وَٱذْكُرُوهُ كَمَا هَدَىٰكُمْ وَإِن كُنتُم مِّن قَبْلِهِۦ لَمِنَ ٱلضَّآلِّينَ","en_translation_id":85,"en":"but it is no offence to seek some bounty from your Lord. When you surge down from Arafat remember God at the sacred place. Remember Him: He has guided you. Before that you were astray.","words":[{"pos":1,"ar":"لَيْسَ","en_gloss":"Not is","transliteration":"laysa","verse_key":"2:198"},{"pos":2,"ar":"عَلَيْكُمْ","en_gloss":"on you","transliteration":"ʿalaykum","verse_key":"2:198"},{"pos":3,"ar":"جُنَاحٌ","en_gloss":"any sin","transliteration":"junāḥun","verse_key":"2:198"},{"pos":4,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"2:198"},{"pos":5,"ar":"تَبْتَغُوا۟","en_gloss":"you seek","transliteration":"tabtaghū","verse_key":"2:198"},{"pos":6,"ar":"فَضْلًۭا","en_gloss":"bounty","transliteration":"faḍlan","verse_key":"2:198"},{"pos":7,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"2:198"},{"pos":8,"ar":"رَّبِّكُمْ ۚ","en_gloss":"your Lord","transliteration":"rabbikum","verse_key":"2:198"},{"pos":9,"ar":"فَإِذَآ","en_gloss":"And when","transliteration":"fa-idhā","verse_key":"2:198"},{"pos":10,"ar":"أَفَضْتُم","en_gloss":"you depart","transliteration":"afaḍtum","verse_key":"2:198"},{"pos":11,"ar":"مِّنْ","en_gloss":"from","transliteration":"min","verse_key":"2:198"},{"pos":12,"ar":"عَرَفَـٰتٍۢ","en_gloss":"(Mount) Arafat","transliteration":"ʿarafātin","verse_key":"2:198"},{"pos":13,"ar":"فَٱذْكُرُوا۟","en_gloss":"then remember","transliteration":"fa-udh'kurū","verse_key":"2:198"},{"pos":14,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"2:198"},{"pos":15,"ar":"عِندَ","en_gloss":"near","transliteration":"ʿinda","verse_key":"2:198"},{"pos":16,"ar":"ٱلْمَشْعَرِ","en_gloss":"the Monument","transliteration":"l-mashʿari","verse_key":"2:198"},{"pos":17,"ar":"ٱلْحَرَامِ ۖ","en_gloss":"[the] Sacred","transliteration":"l-ḥarāmi","verse_key":"2:198"},{"pos":18,"ar":"وَٱذْكُرُوهُ","en_gloss":"And remember Him","transliteration":"wa-udh'kurūhu","verse_key":"2:198"},{"pos":19,"ar":"كَمَا","en_gloss":"as","transliteration":"kamā","verse_key":"2:198"},{"pos":2