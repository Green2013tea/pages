fter performing the ritual prayer, continue to remember God- standing, sitting, and lying on your sides- and once you are safe, keep up regular prayer, for prayer is obligatory for the believers at prescribed times.","words":[{"pos":1,"ar":"فَإِذَا","en_gloss":"Then when","transliteration":"fa-idhā","verse_key":"4:103"},{"pos":2,"ar":"قَضَيْتُمُ","en_gloss":"you (have) finished","transliteration":"qaḍaytumu","verse_key":"4:103"},{"pos":3,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"4:103"},{"pos":4,"ar":"فَٱذْكُرُوا۟","en_gloss":"then remember","transliteration":"fa-udh'kurū","verse_key":"4:103"},{"pos":5,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"4:103"},{"pos":6,"ar":"قِيَـٰمًۭا","en_gloss":"standing","transliteration":"qiyāman","verse_key":"4:103"},{"pos":7,"ar":"وَقُعُودًۭا","en_gloss":"and sitting","transliteration":"waquʿūdan","verse_key":"4:103"},{"pos":8,"ar":"وَعَلَىٰ","en_gloss":"and (lying) on","transliteration":"waʿalā","verse_key":"4:103"},{"pos":9,"ar":"جُنُوبِكُمْ ۚ","en_gloss":"your sides","transliteration":"junūbikum","verse_key":"4:103"},{"pos":10,"ar":"فَإِذَا","en_gloss":"But when","transliteration":"fa-idhā","verse_key":"4:103"},{"pos":11,"ar":"ٱطْمَأْنَنتُمْ","en_gloss":"you are secure","transliteration":"iṭ'manantum","verse_key":"4:103"},{"pos":12,"ar":"فَأَقِيمُوا۟","en_gloss":"then establish","transliteration":"fa-aqīmū","verse_key":"4:103"},{"pos":13,"ar":"ٱلصَّلَوٰةَ ۚ","en_gloss":"the (regular) prayer","transliteration":"l-ṣalata","verse_key":"4:103"},{"pos":14,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"4:103"},{"pos":15,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"4:103"},{"pos":16,"ar":"كَانَتْ","en_gloss":"is","transliteration":"kānat","verse_key":"4:103"},{"pos":17,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"4:103"},{"pos":18,"ar":"ٱلْمُؤْمِنِينَ","en_gloss":"the believers","