ent their brother, Hud. He said, ‘My people, worship God. You have no god other than Him; you are only making up lies.","words":[{"pos":1,"ar":"وَإِلَىٰ","en_gloss":"And to","transliteration":"wa-ilā","verse_key":"11:50"},{"pos":2,"ar":"عَادٍ","en_gloss":"Aad","transliteration":"ʿādin","verse_key":"11:50"},{"pos":3,"ar":"أَخَاهُمْ","en_gloss":"(We sent) their brother","transliteration":"akhāhum","verse_key":"11:50"},{"pos":4,"ar":"هُودًۭا ۚ","en_gloss":"Hud","transliteration":"hūdan","verse_key":"11:50"},{"pos":5,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"11:50"},{"pos":6,"ar":"يَـٰقَوْمِ","en_gloss":"O my people","transliteration":"yāqawmi","verse_key":"11:50"},{"pos":7,"ar":"ٱعْبُدُوا۟","en_gloss":"Worship","transliteration":"uʿ'budū","verse_key":"11:50"},{"pos":8,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"11:50"},{"pos":9,"ar":"مَا","en_gloss":"not","transliteration":"mā","verse_key":"11:50"},{"pos":10,"ar":"لَكُم","en_gloss":"(is) for you","transliteration":"lakum","verse_key":"11:50"},{"pos":11,"ar":"مِّنْ","en_gloss":"any","transliteration":"min","verse_key":"11:50"},{"pos":12,"ar":"إِلَـٰهٍ","en_gloss":"god","transliteration":"ilāhin","verse_key":"11:50"},{"pos":13,"ar":"غَيْرُهُۥٓ ۖ","en_gloss":"other than Him","transliteration":"ghayruhu","verse_key":"11:50"},{"pos":14,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"11:50"},{"pos":15,"ar":"أَنتُمْ","en_gloss":"you","transliteration":"antum","verse_key":"11:50"},{"pos":16,"ar":"إِلَّا","en_gloss":"(are) but","transliteration":"illā","verse_key":"11:50"},{"pos":17,"ar":"مُفْتَرُونَ","en_gloss":"inventors","transliteration":"muf'tarūna","verse_key":"11:50"},{"pos":18,"ar":"٥٠","en_gloss":"(50)","transliteration":"","verse_key":"11:50"}]},{"verse_key":"11:51","surah":11,"ayah":51,"ar_uthmani":"يَـٰقَوْمِ لَآ أَسْـَٔلُكُمْ عَلَيْهِ أَجْرًا ۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱلَّذِى فَطَرَنِىٓ ۚ أَفَلَا تَعْقِلُونَ","en_translation_id":85,"en":"I ask no reward from you, my people; my reward comes only from Him who created me. Why do you not use your reason?","words":[{"pos":1,"ar":"يَـٰقَوْمِ","en_gloss":"O my people","transliteration":"yāqawmi","verse_key":"11:51"},{"pos":2,"ar":"لَآ","en_gloss":"Not","transliteration":"lā","verse_key":"11:51"},{"pos":3,"ar":"أَسْـَٔلُكُمْ","en_gloss":"I ask you","transliteration":"asalukum","verse_key":"11:51"},{"pos":4,"ar":"عَلَيْهِ","en_gloss":"for it","transliteration":"ʿalayhi","verse_key":"11:51"},{"pos":5,"ar":"أَجْرًا ۖ","en_gloss":"any reward","transliteration":"ajran","verse_key":"11:51"},{"pos":6,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"11:51"},{"pos":7,"ar":"أَجْرِىَ","en_gloss":"(is) my reward","transliteration":"ajriya","verse_key":"11:51"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"11:51"},{"pos":9,"ar":"عَلَى","en_gloss":"from","transliteration":"ʿalā","verse_key":"11:51"},{"pos":10,"ar":"ٱلَّذِى","en_gloss":"the One Who","transliteration":"alladhī","verse_key":"11:51"},{"pos":11,"ar":"فَطَرَنِىٓ ۚ","en_gloss":"created me","transliteration":"faṭaranī","verse_key":"11:51"},{"pos":12,"ar":"أَفَلَا","en_gloss":"Then will not","transliteration":"afalā","verse_key":"11:51"},{"pos":13,"ar":"تَعْقِلُونَ","en_gloss":"you use reason","transliteration":"taʿqilūna","verse_key":"11:51"},{"pos":14,"ar":"٥١","en_gloss":"(51)","transliteration":"","verse_key":"11:51"}]},{"verse_key":"11:52","surah":11,"ayah":52,"ar_uthmani":"وَيَـٰقَوْمِ ٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ تُوبُوٓا۟ إِلَيْهِ يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًا وَيَزِدْكُمْ قُوَّةً إِلَىٰ قُوَّتِكُمْ وَلَا تَتَوَلَّوْا۟ مُجْرِمِينَ","en_translation_id":85,"en":"My people, ask forgiveness from your Lord, and return to Him. He will send down for you rain in abundance from the sky, and give you extra strength. Do not turn away and be lost in your sins.’","words":[{"pos":1,"ar":"وَيَـٰقَوْمِ","en_gloss":"And O my people","transliteration":"wayāqawmi","verse_key":"11:52"},{"pos":2,"ar":"ٱسْتَغْفِرُوا۟","en_gloss":"Ask forgiveness","transliteration":"is'taghfirū","verse_key":"11:52"},{"pos":3,"ar":"رَبَّكُمْ","en_gloss":"(of) your Lord","transliteration":"rabbakum","verse_key":"11:52"},{"pos":4,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"11:52"},{"pos":5,"ar":"تُوبُوٓا۟","en_gloss":"turn in repentance","transliteration":"tūbū","verse_key":"11:52"},{"pos":6,"ar":"إِلَيْهِ","en_gloss":"to Him","transliteration":"ilayhi","verse_key":"11:52"},{"pos":7,"ar":"يُرْسِلِ","en_gloss":"He will send","transliteration":"yur'sili","verse_key":"11:52"},{"pos":8,"ar":"ٱلسَّمَآءَ","en_gloss":"(from) the sky (rain)","transliteration":"l-samāa","verse_key":"11:52"},{"pos":9,"ar":"عَلَيْكُم","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"11:52"},{"pos":10,"ar":"مِّدْرَارًۭا","en_gloss":"(in) abundance","transliteration":"mid'rāran","verse_key":"11:52"},{"pos":11,"ar":"وَيَزِدْكُمْ","en_gloss":"and increase you","transliteration":"wayazid'kum","verse_key":"11:52"},{"pos":12,"ar":"قُوَّةً","en_gloss":"(in) strength","transliteration":"quwwatan","verse_key":"11:52"},{"pos":13,"ar":"إِلَىٰ","en_gloss":"(added) to","transliteration":"ilā","verse_key":"11:52"},{"pos":14,"ar":"قُوَّتِكُمْ","en_gloss":"your strength","transliteration":"quwwatikum","verse_key":"11:52"},{"pos":15,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"11:52"},{"pos":16,"ar":"تَتَوَلَّوْا۟","en_gloss":"turn away","transliteration":"tatawallaw","verse_key":"11:52"},{"pos":17,"ar":"مُجْرِمِينَ","en_gloss":"(as) criminals","transliteration":"muj'rimīna","verse_key":"11:52"},{"pos":18,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"11:52"}]},{"verse_key":"11:53","surah":11,"ayah":53,"ar_uthmani":"قَالُوا۟ يَـٰهُودُ مَا جِئْتَنَا بِبَيِّنَةٍ وَمَا نَحْنُ بِتَارِكِىٓ ءَالِهَتِنَا عَن قَوْلِكَ وَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ","en_translation_id":85,"en":"They replied, ‘Hud, you have not brought us any clear evidence. We will not forsake our gods on the strength of your word alone, nor will we believe in you.","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"11:53"},{"pos":2,"ar":"يَـٰهُودُ","en_gloss":"O Hud","transliteration":"yāhūdu","verse_key":"11:53"},{"pos":3,"ar":"مَا","en_gloss":"You have not brought us","transliteration":"mā","verse_key":"11:53"},{"pos":4,"ar":"جِئْتَنَا","en_gloss":"You have not brought us","transliteration":"ji'tanā","verse_key":"11:53"},{"pos":5,"ar":"بِبَيِّنَةٍۢ","en_gloss":"clear proofs","transliteration":"bibayyinatin","verse_key":"11:53"},{"pos":6,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"11:53"},{"pos":7,"ar":"نَحْنُ","en_gloss":"we","transliteration":"naḥnu","verse_key":"11:53"},{"pos":8,"ar":"بِتَارِكِىٓ","en_gloss":"(will) leave","transliteration":"bitārikī","verse_key":"11:53"},{"pos":9,"ar":"ءَالِهَتِنَا","en_gloss":"our gods","transliteration":"ālihatinā","verse_key":"11:53"},{"pos":10,"ar":"عَن","en_gloss":"on","transliteration":"ʿan","verse_key":"11:53"},{"pos":11,"ar":"قَوْلِكَ","en_gloss":"your saying","transliteration":"qawlika","verse_key":"11:53"},{"pos":12,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"11:53"},{"pos":13,"ar":"نَحْنُ","en_gloss":"we (are)","transliteration":"naḥnu","verse_key":"11:53"},{"pos":14,"ar":"لَكَ","en_gloss":"in you","transliteration":"laka","verse_key":"11:53"},{"pos":15,"ar":"بِمُؤْمِنِينَ","en_gloss":"believers","transliteration":"bimu'minīna","verse_key":"11:53"},{"pos":16,"ar":"٥٣","en_gloss":"(53)","transliteration":"","verse_key":"11:53"}]}]}