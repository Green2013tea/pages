ى ٱلْأَلْبَـٰبِ","en_translation_id":85,"en":"Have you not considered that God sends water down from the sky, guides it along to form springs in the earth, and then, with it, brings forth vegetation of various colours, which later withers, turns yellow before your eyes, and is crumbled to dust at His command? There is truly a reminder in this for those who have understanding.","words":[{"pos":1,"ar":"أَلَمْ","en_gloss":"Do not","transliteration":"alam","verse_key":"39:21"},{"pos":2,"ar":"تَرَ","en_gloss":"you see","transliteration":"tara","verse_key":"39:21"},{"pos":3,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"39:21"},{"pos":4,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"39:21"},{"pos":5,"ar":"أَنزَلَ","en_gloss":"sends down","transliteration":"anzala","verse_key":"39:21"},{"pos":6,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"39:21"},{"pos":7,"ar":"ٱلسَّمَآءِ","en_gloss":"the sky","transliteration":"l-samāi","verse_key":"39:21"},{"pos":8,"ar":"مَآءًۭ","en_gloss":"water","transliteration":"māan","verse_key":"39:21"},{"pos":9,"ar":"فَسَلَكَهُۥ","en_gloss":"and He makes it flow","transliteration":"fasalakahu","verse_key":"39:21"},{"pos":10,"ar":"يَنَـٰبِيعَ","en_gloss":"(as) springs","transliteration":"yanābīʿa","verse_key":"39:21"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"39:21"},{"pos":12,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"39:21"},{"pos":13,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"39:21"},{"pos":14,"ar":"يُخْرِجُ","en_gloss":"He produces","transliteration":"yukh'riju","verse_key":"39:21"},{"pos":15,"ar":"بِهِۦ","en_gloss":"with it","transliteration":"bihi","verse_key":"39:21"},{"pos":16,"ar":"زَرْعًۭا","en_gloss":"crops","transliteration":"zarʿan","verse_key":"39:21"},{"pos":17,"ar":"مُّخْتَلِفًا","en_gloss":"(of) different","transliteration":"mukh'talifan","verse_key":"39:21"},{"pos":18,"ar":"أَلْوَٰنُهُۥ","en_gloss":"colors","transliteration":"alwānuhu","verse_key":"39:21"},{"pos":19,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"39:21"},{"pos":20,"ar":"يَهِيجُ","en_gloss":"they wither","transliteration":"yahīju","verse_key":"39:21"},{"pos":21,"ar":"فَتَرَىٰهُ","en_gloss":"and you see it","transliteration":"fatarāhu","verse_key":"39:21"},{"pos":22,"ar":"مُصْفَرًّۭا","en_gloss":"turn yellow","transliteration":"muṣ'farran","verse_key":"39:21"},{"pos":23,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"39:21"},{"pos":24,"ar":"يَجْعَلُهُۥ","en_gloss":"He makes them","transliteration":"yajʿaluhu","verse_key":"39:21"},{"pos":25,"ar":"حُطَـٰمًا ۚ","en_gloss":"debris","transliteration":"ḥuṭāman","verse_key":"39:21"},{"pos":26,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"39:21"},{"pos":27,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"39:21"},{"pos":28,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"39:21"},{"pos":29,"ar":"لَذِكْرَىٰ","en_gloss":"surely, (is) a reminder","transliteration":"ladhik'rā","verse_key":"39:21"},{"pos":30,"ar":"لِأُو۟لِى","en_gloss":"for those of understanding","transliteration":"li-ulī","verse_key":"39:21"},{"pos":31,"ar":"ٱلْأَلْبَـٰبِ","en_gloss":"for those of understanding","transliteration":"l-albābi","verse_key":"39:21"},{"pos":32,"ar":"٢١","en_gloss":"(21)","transliteration":"","verse_key":"39:21"}]}]}