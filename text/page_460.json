{"page":460,"verses":[{"verse_key":"39:11","surah":39,"ayah":11,"ar_uthmani":"قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَعْبُدَ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ","en_translation_id":85,"en":"Say, ‘I have been commanded to serve God, dedicating my worship entirely to Him.","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"39:11"},{"pos":2,"ar":"إِنِّىٓ","en_gloss":"Indeed, I","transliteration":"innī","verse_key":"39:11"},{"pos":3,"ar":"أُمِرْتُ","en_gloss":"[I] am commanded","transliteration":"umir'tu","verse_key":"39:11"},{"pos":4,"ar":"أَنْ","en_gloss":"that","transliteration":"an","verse_key":"39:11"},{"pos":5,"ar":"أَعْبُدَ","en_gloss":"I worship","transliteration":"aʿbuda","verse_key":"39:11"},{"pos":6,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"39:11"},{"pos":7,"ar":"مُخْلِصًۭا","en_gloss":"(being) sincere","transliteration":"mukh'liṣan","verse_key":"39:11"},{"pos":8,"ar":"لَّهُ","en_gloss":"to Him","transliteration":"lahu","verse_key":"39:11"},{"pos":9,"ar":"ٱلدِّينَ","en_gloss":"(in) the religion","transliteration":"l-dīna","verse_key":"39:11"},{"pos":10,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"39:11"}]},{"verse_key":"39:12","surah":39,"ayah":12,"ar_uthmani":"وَأُمِرْتُ لِأَنْ أَكُونَ أَوَّلَ ٱلْمُسْلِمِينَ","en_translation_id":85,"en":"I have been commanded to be the first to submit.’","words":[{"pos":1,"ar":"وَأُمِرْتُ","en_gloss":"And I am commanded","transliteration":"wa-umir'tu","verse_key":"39:12"},{"pos":2,"ar":"لِأَنْ","en_gloss":"that","transliteration":"li-an","verse_key":"39:12"},{"pos":3,"ar":"أَكُونَ","en_gloss":"I be","transliteration":"akūna","verse_key":"39:12"},{"pos":4,"ar":"أَوَّلَ","en_gloss":"(the) first","transliteration":"awwala","verse_key":"39:12"},{"pos":5,"ar":"ٱلْمُسْلِمِينَ","en_gloss":"(of) those who submit","transliteration":"l-mus'limīna","verse_key":"39:12"},{"pos":6,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"39:12"}]},{"verse_key":"39:13