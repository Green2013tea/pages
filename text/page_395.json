:"to","transliteration":"ʿalā","verse_key":"28:79"},{"pos":3,"ar":"قَوْمِهِۦ","en_gloss":"his people","transliteration":"qawmihi","verse_key":"28:79"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"28:79"},{"pos":5,"ar":"زِينَتِهِۦ ۖ","en_gloss":"his adornment","transliteration":"zīnatihi","verse_key":"28:79"},{"pos":6,"ar":"قَالَ","en_gloss":"Said","transliteration":"qāla","verse_key":"28:79"},{"pos":7,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"28:79"},{"pos":8,"ar":"يُرِيدُونَ","en_gloss":"desire","transliteration":"yurīdūna","verse_key":"28:79"},{"pos":9,"ar":"ٱلْحَيَوٰةَ","en_gloss":"the life","transliteration":"l-ḥayata","verse_key":"28:79"},{"pos":10,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"28:79"},{"pos":11,"ar":"يَـٰلَيْتَ","en_gloss":"O! Would that","transliteration":"yālayta","verse_key":"28:79"},{"pos":12,"ar":"لَنَا","en_gloss":"for us","transliteration":"lanā","verse_key":"28:79"},{"pos":13,"ar":"مِثْلَ","en_gloss":"(the) like","transliteration":"mith'la","verse_key":"28:79"},{"pos":14,"ar":"مَآ","en_gloss":"(of) what","transliteration":"mā","verse_key":"28:79"},{"pos":15,"ar":"أُوتِىَ","en_gloss":"has been given","transliteration":"ūtiya","verse_key":"28:79"},{"pos":16,"ar":"قَـٰرُونُ","en_gloss":"(to) Qarun","transliteration":"qārūnu","verse_key":"28:79"},{"pos":17,"ar":"إِنَّهُۥ","en_gloss":"Indeed, he","transliteration":"innahu","verse_key":"28:79"},{"pos":18,"ar":"لَذُو","en_gloss":"(is the) owner","transliteration":"ladhū","verse_key":"28:79"},{"pos":19,"ar":"حَظٍّ","en_gloss":"(of) fortune","transliteration":"ḥaẓẓin","verse_key":"28:79"},{"pos":20,"ar":"عَظِيمٍۢ","en_gloss":"great","transliteration":"ʿaẓīmin","verse_key":"28:79"},{"pos":21,"ar":"٧٩","en_gloss":"(79)","transliteration":"","verse_key":"28:79"}]},{"verse_key":"28:80","surah":28,"ayah":80,"ar_uthmani":"وَقَالَ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ وَيْلَكُمْ ثَوَابُ ٱللَّهِ خَيْرٌ لِّمَنْ ءَامَنَ وَعَمِلَ صَـٰلِحًا وَلَا يُلَقَّىٰهَآ إِلَّا ٱلصَّـٰبِرُونَ","en_translation_id":85,"en":"but those who were given knowledge said, ‘Alas for you! God’s reward is better for those who believe and do good deeds: only those who are steadfast will attain this.’","words":[{"pos":1,"ar":"وَقَالَ","en_gloss":"But said","transliteration":"waqāla","verse_key":"28:80"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"28:80"},{"pos":3,"ar":"أُوتُوا۟","en_gloss":"were given","transliteration":"ūtū","verse_key":"28:80"},{"pos":4,"ar":"ٱلْعِلْمَ","en_gloss":"the knowledge","transliteration":"l-ʿil'ma","verse_key":"28:80"},{"pos":5,"ar":"وَيْلَكُمْ","en_gloss":"Woe to you","transliteration":"waylakum","verse_key":"28:80"},{"pos":6,"ar":"ثَوَابُ","en_gloss":"(The) reward","transliteration":"thawābu","verse_key":"28:80"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"28:80"},{"pos":8,"ar":"خَيْرٌۭ","en_gloss":"(is) better","transliteration":"khayrun","verse_key":"28:80"},{"pos":9,"ar":"لِّمَنْ","en_gloss":"for (he) who","transliteration":"liman","verse_key":"28:80"},{"pos":10,"ar":"ءَامَنَ","en_gloss":"believes","transliteration":"āmana","verse_key":"28:80"},{"pos":11,"ar":"وَعَمِلَ","en_gloss":"and does","transliteration":"waʿamila","verse_key":"28:80"},{"pos":12,"ar":"صَـٰلِحًۭا","en_gloss":"righteous (deeds)","transliteration":"ṣāliḥan","verse_key":"28:80"},{"pos":13,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"28:80"},{"pos":14,"ar":"يُلَقَّىٰهَآ","en_gloss":"it is granted","transliteration":"yulaqqāhā","verse_key":"28:80"},{"pos":15,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"28:80"},{"pos":16,"ar":"ٱلصَّـٰبِرُونَ","en_gloss":"(to) the patient ones","transliteration":"l-ṣābirūna","verse_key":"28:80"},{"pos":17,"ar":"٨٠","en_gloss":"(80)","transliteration":"","verse_key":"28:80"}]},{"verse_key":"28:81","surah":28,"ayah":81,"ar_uthmani":"فَخَسَفْنَا بِهِۦ وَبِدَارِهِ ٱلْأَرْضَ فَمَا كَانَ لَهُۥ مِن فِئَةٍ يَنصُرُونَهُۥ مِن دُونِ ٱللَّهِ وَمَا كَانَ مِنَ ٱلْمُنتَصِرِينَ","en_translation_id":85,"en":"We caused the earth to swallow him and his home: he had no one to help him against God, nor could he defend himself.","words":[{"pos":1,"ar":"فَخَسَفْنَا","en_gloss":"Then We caused to swallow up","transliteration":"fakhasafnā","verse_key":"28:81"},{"pos":2,"ar":"بِهِۦ","en_gloss":"him","transliteration":"bihi","verse_key":"28:81"},{"pos":3,"ar":"وَبِدَارِهِ","en_gloss":"and his home","transliteration":"wabidārihi","verse_key":"28:81"},{"pos":4,"ar":"ٱلْأَرْضَ","en_gloss":"the earth","transliteration":"l-arḍa","verse_key":"28:81"},{"pos":5,"ar":"فَمَا","en_gloss":"Then not","transliteration":"famā","verse_key":"28:81"},{"pos":6,"ar":"كَانَ","en_gloss":"was","transliteration":"kāna","verse_key":"28:81"},{"pos":7,"ar":"لَهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"28:81"},{"pos":8,"ar":"مِن","en_gloss":"any","transliteration":"min","verse_key":"28:81"},{"pos":9,"ar":"فِئَةٍۢ","en_gloss":"group","transliteration":"fi-atin","verse_key":"28:81"},{"pos":10,"ar":"يَنصُرُونَهُۥ","en_gloss":"(to) help him","transliteration":"yanṣurūnahu","verse_key":"28:81"},{"pos":11,"ar":"مِن","en_gloss":"besides","transliteration":"min","verse_key":"28:81"},{"pos":12,"ar":"دُونِ","en_gloss":"besides","transliteration":"dūni","verse_key":"28:81"},{"pos":13,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"28:81"},{"pos":14,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"28:81"},{"pos":15,"ar":"كَانَ","en_gloss":"was","transliteration":"kāna","verse_key":"28:81"},{"pos":16,"ar":"مِنَ","en_gloss":"(he) of","transliteration":"mina","verse_key":"28:81"},{"pos":17,"ar":"ٱلْمُنتَصِرِينَ","en_gloss":"those who (could) defend themselves","transliteration":"l-muntaṣirīna","verse_key":"28:81"},{"pos":18,"ar":"٨١","en_gloss":"(81)","transliteration":"","verse_key":"28:81"}]},{"verse_key":"28:82","surah":28,"ayah":82,"ar_uthmani":"وَأَصْبَحَ ٱلَّذِينَ تَمَنَّوْا۟ مَكَانَهُۥ بِٱلْأَمْسِ يَقُولُونَ وَيْكَأَنَّ ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ مِنْ عِبَادِهِۦ وَيَقْدِرُ ۖ لَوْلَآ أَن مَّنَّ ٱللَّهُ عَلَيْنَا لَخَسَفَ بِنَا ۖ وَيْكَأَنَّهُۥ لَا يُفْلِحُ ٱلْكَـٰفِرُونَ","en_translation_id":85,"en":"The next day, those who had, the day before, wished to be in his place exclaimed, ‘Alas [for you, Qarun]! It is God alone who gives what He will, abundantly or sparingly, to whichever He will of His creatures: if God had not been gracious to us, He would have caused the earth to swallow us too.’ Alas indeed! Those who deny the truth will never prosper.","words":[{"pos":1,"ar":"وَأَصْبَحَ","en_gloss":"And began","transliteration":"wa-aṣbaḥa","verse_key":"28:82"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"28:82"},{"pos":3,"ar":"تَمَنَّوْا۟","en_gloss":"(had) wished","transliteration":"tamannaw","verse_key":"28:82"},{"pos":4,"ar":"مَكَانَهُۥ","en_gloss":"his position","transliteration":"makānahu","verse_key":"28:82"},{"pos":5,"ar":"بِٱلْأَمْسِ","en_gloss":"the day before","transliteration":"bil-amsi","verse_key":"28:82"},{"pos":6,"ar":"يَقُولُونَ","en_gloss":"(to) say","transliteration":"yaqūlūna","verse_key":"28:82"},{"pos":7,"ar":"وَيْكَأَنَّ","en_gloss":"Ah! That","transliteration":"wayka-anna","verse_key":"28:82"},{"pos":8,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"28:82"},{"pos":9,"ar":"يَبْسُطُ","en_gloss":"extends","transliteration":"yabsuṭu","verse_key":"28:82"},{"pos":10,"ar":"ٱلرِّزْقَ","en_gloss":"the provision","transliteration":"l-riz'qa","verse_key":"28:82"},{"pos":11,"ar":"لِمَن","en_gloss":"for whom","transliteration":"liman","verse_key":"28:82"},{"pos":12,"ar":"يَشَآءُ","en_gloss":"He wills","transliteration":"yashāu","verse_key":"28:82"},{"pos":13,"ar":"مِنْ","en_gloss":"of","transliteration":"min","verse_key":"28:82"},{"pos":14,"ar":"عِبَادِهِۦ","en_gloss":"His slaves","transliteration":"ʿibādihi","verse_key":"28:82"},{"pos":15,"ar":"وَيَقْدِرُ ۖ","en_gloss":"and restricts it","transliteration":"wayaqdiru","verse_key":"28:82"},{"pos":16,"ar":"لَوْلَآ","en_gloss":"If not","transliteration":"lawlā","verse_key":"28:82"},{"pos":17,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"28:82"},{"pos":18,"ar":"مَّنَّ","en_gloss":"Allah had favored","transliteration":"manna","verse_key":"28:82"},{"pos":19,"ar":"ٱللَّهُ","en_gloss":"Allah had favored","transliteration":"l-lahu","verse_key":"28:82"},{"pos":20,"ar":"عَلَيْنَا","en_gloss":"[to] us","transliteration":"ʿalaynā","verse_key":"28:82"},{"pos":21,"ar":"لَخَسَفَ","en_gloss":"He would have caused it to swallow us","transliteration":"lakhasafa","verse_key":"28:82"},{"pos":22,"ar":"بِنَا ۖ","en_gloss":"He would have caused it to swallow us","transliteration":"binā","verse_key":"28:82"},{"pos":23,"ar":"وَيْكَأَنَّهُۥ","en_gloss":"Ah! That","transliteration":"wayka-annahu","verse_key":"28:82"},{"pos":24,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"28:82"},{"pos":25,"ar":"يُفْلِحُ","en_gloss":"will succeed","transliteration":"yuf'liḥu","verse_key":"28:82"},{"pos":26,"ar":"ٱلْكَـٰفِرُونَ","en_gloss":"the disbelievers","transliteration":"l-kāfirūna","verse_key":"28:82"},{"pos":27,"ar":"٨٢","en_gloss":"(82)","transliteration":"","verse_key":"28:82"}]},{"verse_key":"28:83","surah":28,"ayah":83,"ar_uthmani":"تِلْكَ ٱلدَّارُ ٱلْـَٔاخِرَةُ نَجْعَلُهَا لِلَّذِينَ لَا يُرِيدُونَ عُلُوًّا فِى ٱلْأَرْضِ وَلَا فَسَادًا ۚ وَٱلْعَـٰقِبَةُ لِلْمُتَّقِينَ","en_translation_id":85,"en":"We grant the Home in the Hereafter to those who do not seek superiority on earth or spread corruption: the happy ending is awarded to those who are mindful of God.","words":[{"pos":1,"ar":"تِلْكَ","en_gloss":"That","transliteration":"til'ka","verse_key":"28:83"},{"pos":2,"ar":"ٱلدَّارُ","en_gloss":"the Home","transliteration":"l-dāru","verse_key":"28:8