36:76"},{"pos":4,"ar":"إِنَّا","en_gloss":"Indeed, We","transliteration":"innā","verse_key":"36:76"},{"pos":5,"ar":"نَعْلَمُ","en_gloss":"[We] know","transliteration":"naʿlamu","verse_key":"36:76"},{"pos":6,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"36:76"},{"pos":7,"ar":"يُسِرُّونَ","en_gloss":"they conceal","transliteration":"yusirrūna","verse_key":"36:76"},{"pos":8,"ar":"وَمَا","en_gloss":"and what","transliteration":"wamā","verse_key":"36:76"},{"pos":9,"ar":"يُعْلِنُونَ","en_gloss":"they declare","transliteration":"yuʿ'linūna","verse_key":"36:76"},{"pos":10,"ar":"٧٦","en_gloss":"(76)","transliteration":"","verse_key":"36:76"}]},{"verse_key":"36:77","surah":36,"ayah":77,"ar_uthmani":"أَوَلَمْ يَرَ ٱلْإِنسَـٰنُ أَنَّا خَلَقْنَـٰهُ مِن نُّطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُّبِينٌ","en_translation_id":85,"en":"Can man not see that We created him from a drop of fluid? Yet- lo and behold!- he disputes openly,","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Does not","transliteration":"awalam","verse_key":"36:77"},{"pos":2,"ar":"يَرَ","en_gloss":"see","transliteration":"yara","verse_key":"36:77"},{"pos":3,"ar":"ٱلْإِنسَـٰنُ","en_gloss":"[the] man","transliteration":"l-insānu","verse_key":"36:77"},{"pos":4,"ar":"أَنَّا","en_gloss":"that We","transliteration":"annā","verse_key":"36:77"},{"pos":5,"ar":"خَلَقْنَـٰهُ","en_gloss":"[We] created him","transliteration":"khalaqnāhu","verse_key":"36:77"},{"pos":6,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"36:77"},{"pos":7,"ar":"نُّطْفَةٍۢ","en_gloss":"a semen-drop","transliteration":"nuṭ'fatin","verse_key":"36:77"},{"pos":8,"ar":"فَإِذَا","en_gloss":"Then behold","transliteration":"fa-idhā","verse_key":"36:77"},{"pos":9,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"36:77"},{"pos":10,"ar":"خَصِيمٌۭ","en_gloss":"(is) an opponent","transliteration":"khaṣīmun","verse_key":"36:77"},{"pos":11,"ar":"مُّبِينٌۭ","en_gloss":"clear","transliteration":"mubīnun","verse_key":"36:77"},{"pos":12,"ar":"٧٧","en_gloss":"(77)","transliteration":"","verse_key":"36:77"}]},{"verse_key":"36:78","surah":36,"ayah":78,"ar_uthmani":"وَضَرَبَ لَنَا مَثَلًا وَنَسِىَ خَلْقَهُۥ ۖ قَالَ مَن يُحْىِ ٱلْعِظَـٰمَ وَهِىَ رَمِيمٌ","en_translation_id":85,"en":"producing arguments against Us, forgetting his own creation. He says, ‘Who can give life back to bones after they have decayed?’","words":[{"pos":1,"ar":"وَضَرَبَ","en_gloss":"And he sets forth","transliteration":"waḍaraba","verse_key":"36:78"},{"pos":2,"ar":"لَنَا","en_gloss":"for Us","transliteration":"lanā","verse_key":"36:78"},{"pos":3,"ar":"مَثَلًۭا","en_gloss":"an example","transliteration":"mathalan","verse_key":"36:78"},{"pos":4,"ar":"وَنَسِىَ","en_gloss":"and forgets","transliteration":"wanasiya","verse_key":"36:78"},{"pos":5,"ar":"خَلْقَهُۥ ۖ","en_gloss":"his (own) creation","transliteration":"khalqahu","verse_key":"36:78"},{"pos":6,"ar":"قَالَ","en_gloss":"He says","transliteration":"qāla","verse_key":"36:78"},{"pos":7,"ar":"مَن","en_gloss":"Who","transliteration":"man","verse_key":"36:78"},{"pos":8,"ar":"يُحْىِ","en_gloss":"will give life","transliteration":"yuḥ'yī","verse_key":"36:78"},{"pos":9,"ar":"ٱلْعِظَـٰمَ","en_gloss":"(to) the bones","transliteration":"l-ʿiẓāma","verse_key":"36:78"},{"pos":10,"ar":"وَهِىَ","en_gloss":"while they","transliteration":"wahiya","verse_key":"36:78"},{"pos":11,"ar":"رَمِيمٌۭ","en_gloss":"(are) decomposed","transliteration":"ramīmun","verse_key":"36:78"},{"pos":12,"ar":"٧٨","en_gloss":"(78)","transliteration":"","verse_key":"36:78"}]},{"verse_key":"36:79","surah":36,"ayah":79,"ar_uthmani":"قُلْ يُحْيِيهَا ٱلَّذِىٓ أَنشَأَهَآ أَوَّلَ مَرَّةٍ ۖ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ","en_translation_id":85,"en":"Say, ‘He who created them in the first place will give them life again: He has full knowledge of every act of creation.","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"36:79"},{"pos":2,"ar":"يُحْيِيهَا","en_gloss":"He will give them lif