ُمْ وَٱلصَّـٰبِرِينَ عَلَىٰ مَآ أَصَابَهُمْ وَٱلْمُقِيمِى ٱلصَّلَوٰةِ وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ","en_translation_id":85,"en":"whose hearts fill with awe whenever God is mentioned, who endure whatever happens to them with patience, who keep up the prayer, who give to others out of Our provision to them.","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"Those","transliteration":"alladhīna","verse_key":"22:35"},{"pos":2,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"22:35"},{"pos":3,"ar":"ذُكِرَ","en_gloss":"is mentioned","transliteration":"dhukira","verse_key":"22:35"},{"pos":4,"ar":"ٱللَّهُ","en_gloss":"Allah ","transliteration":"l-lahu","verse_key":"22:35"},{"pos":5,"ar":"وَجِلَتْ","en_gloss":"fear","transliteration":"wajilat","verse_key":"22:35"},{"pos":6,"ar":"قُلُوبُهُمْ","en_gloss":"their hearts","transliteration":"qulūbuhum","verse_key":"22:35"},{"pos":7,"ar":"وَٱلصَّـٰبِرِينَ","en_gloss":"and those who are patient","transliteration":"wal-ṣābirīna","verse_key":"22:35"},{"pos":8,"ar":"عَلَىٰ","en_gloss":"over","transliteration":"ʿalā","verse_key":"22:35"},{"pos":9,"ar":"مَآ","en_gloss":"whatever","transliteration":"mā","verse_key":"22:35"},{"pos":10,"ar":"أَصَابَهُمْ","en_gloss":"has afflicted them","transliteration":"aṣābahum","verse_key":"22:35"},{"pos":11,"ar":"وَٱلْمُقِيمِى","en_gloss":"and those who establish","transliteration":"wal-muqīmī","verse_key":"22:35"},{"pos":12,"ar":"ٱلصَّلَوٰةِ","en_gloss":"the prayer","transliteration":"l-ṣalati","verse_key":"22:35"},{"pos":13,"ar":"وَمِمَّا","en_gloss":"and out of what","transliteration":"wamimmā","verse_key":"22:35"},{"pos":14,"ar":"رَزَقْنَـٰهُمْ","en_gloss":"We have provided them","transliteration":"razaqnāhum","verse_key":"22:35"},{"pos":15,"ar":"يُنفِقُونَ","en_gloss":"they spend","transliteration":"yunfiqūna","verse_key":"22:35"},{"pos":16,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"22:35"}]},{"verse_key":"22:36","surah":22,"ayah":36,"ar_uthmani":"وَٱلْبُدْ