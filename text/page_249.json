 These are the ones who deny their Lord, who will wear iron collars around their necks and be the inhabitants of the Fire, there to remain.","words":[{"pos":1,"ar":"۞ وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"13:5"},{"pos":2,"ar":"تَعْجَبْ","en_gloss":"you (are) astonished","transliteration":"taʿjab","verse_key":"13:5"},{"pos":3,"ar":"فَعَجَبٌۭ","en_gloss":"then astonishing","transliteration":"faʿajabun","verse_key":"13:5"},{"pos":4,"ar":"قَوْلُهُمْ","en_gloss":"(is) their saying","transliteration":"qawluhum","verse_key":"13:5"},{"pos":5,"ar":"أَءِذَا","en_gloss":"When","transliteration":"a-idhā","verse_key":"13:5"},{"pos":6,"ar":"كُنَّا","en_gloss":"we are","transliteration":"kunnā","verse_key":"13:5"},{"pos":7,"ar":"تُرَٰبًا","en_gloss":"dust","transliteration":"turāban","verse_key":"13:5"},{"pos":8,"ar":"أَءِنَّا","en_gloss":"will we","transliteration":"a-innā","verse_key":"13:5"},{"pos":9,"ar":"لَفِى","en_gloss":"(be) indeed, in","transliteration":"lafī","verse_key":"13:5"},{"pos":10,"ar":"خَلْقٍۢ","en_gloss":"a creation","transliteration":"khalqin","verse_key":"13:5"},{"pos":11,"ar":"جَدِيدٍ ۗ","en_gloss":"new","transliteration":"jadīdin","verse_key":"13:5"},{"pos":12,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those","transliteration":"ulāika","verse_key":"13:5"},{"pos":13,"ar":"ٱلَّذِينَ","en_gloss":"(are) the ones who","transliteration":"alladhīna","verse_key":"13:5"},{"pos":14,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"13:5"},{"pos":15,"ar":"بِرَبِّهِمْ ۖ","en_gloss":"in their Lord","transliteration":"birabbihim","verse_key":"13:5"},{"pos":16,"ar":"وَأُو۟لَـٰٓئِكَ","en_gloss":"and those","transliteration":"wa-ulāika","verse_key":"13:5"},{"pos":17,"ar":"ٱلْأَغْلَـٰلُ","en_gloss":"the iron chains","transliteration":"l-aghlālu","verse_key":"13:5"},{"pos":18,"ar":"فِىٓ","en_gloss":"(will be) in","transliteration":"fī","verse_key":"13:5"},{"pos":19,"ar":"أَعْنَاقِهِمْ ۖ","en_gloss":"their necks","transliteration":"aʿnāqihim","verse_key":"13:5"},{"pos":20,"ar":"وَأُو۟لَـٰٓئِكَ","en_gloss":"those","transliteration":"wa-ulāika","verse_key":"13:5"},{"pos":21,"ar":"أَصْحَـٰبُ","en_gloss":"(are the) companions","transliteration":"aṣḥābu","verse_key":"13:5"},{"pos":22,"ar":"ٱلنَّارِ ۖ","en_gloss":"(of) the Fire","transliteration":"l-nāri","verse_key":"13:5"},{"pos":23,"ar":"هُمْ","en_gloss":"they","transliteration":"hum","verse_key":"13:5"},{"pos":24,"ar":"فِيهَا","en_gloss":"in it","transliteration":"fīhā","verse_key":"13:5"},{"pos":25,"ar":"خَـٰلِدُونَ","en_gloss":"(will) abide forever","transliteration":"khālidūna","verse_key":"13:5"},{"pos":26,"ar":"٥","en_gloss":"(5)","transliteration":"","verse_key":"13:5"}]}]}