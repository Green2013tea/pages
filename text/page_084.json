ٰ وَٱلْمَسَـٰكِينِ وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ وَٱبْنِ ٱلسَّبِيلِ وَمَا مَلَكَتْ أَيْمَـٰنُكُمْ ۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخْتَالًا فَخُورًا","en_translation_id":85,"en":"Worship God; join nothing with Him. Be good to your parents, to relatives, to orphans, to the needy, to neighbours near and far, to travellers in need, and to your slaves. God does not like arrogant, boastful people,","words":[{"pos":1,"ar":"۞ وَٱعْبُدُوا۟","en_gloss":"And worship","transliteration":"wa-uʿ'budū","verse_key":"4:36"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"4:36"},{"pos":3,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"4:36"},{"pos":4,"ar":"تُشْرِكُوا۟","en_gloss":"associate","transliteration":"tush'rikū","verse_key":"4:36"},{"pos":5,"ar":"بِهِۦ","en_gloss":"with Him","transliteration":"bihi","verse_key":"4:36"},{"pos":6,"ar":"شَيْـًۭٔا ۖ","en_gloss":"anything","transliteration":"shayan","verse_key":"4:36"},{"pos":7,"ar":"وَبِٱلْوَٰلِدَيْنِ","en_gloss":"and to the parents","transliteration":"wabil-wālidayni","verse_key":"4:36"},{"pos":8,"ar":"إِحْسَـٰنًۭا","en_gloss":"(do) good","transliteration":"iḥ'sānan","verse_key":"4:36"},{"pos":9,"ar":"وَبِذِى","en_gloss":"and with","transliteration":"wabidhī","verse_key":"4:36"},{"pos":10,"ar":"ٱلْقُرْبَىٰ","en_gloss":"the relatives","transliteration":"l-qur'bā","verse_key":"4:36"},{"pos":11,"ar":"وَٱلْيَتَـٰمَىٰ","en_gloss":"and the orphans","transliteration":"wal-yatāmā","verse_key":"4:36"},{"pos":12,"ar":"وَٱلْمَسَـٰكِينِ","en_gloss":"and the needy","transliteration":"wal-masākīni","verse_key":"4:36"},{"pos":13,"ar":"وَٱلْجَارِ","en_gloss":"and the neighbor","transliteration":"wal-jāri","verse_key":"4:36"},{"pos":14,"ar":"ذِى","en_gloss":"(who is)","transliteration":"dhī","verse_key":"4:36"},{"pos":15,"ar":"ٱلْقُرْبَىٰ","en_gloss":"near","transliteration":"l-qur'bā","verse_key":"4:36"},{"pos":16,"ar":"وَٱلْجَارِ"