{"page":422,"verses":[{"verse_key":"33:31","surah":33,"ayah":31,"ar_uthmani":"۞ وَمَن يَقْنُتْ مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ وَتَعْمَلْ صَـٰلِحًا نُّؤْتِهَآ أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًا كَرِيمًا","en_translation_id":85,"en":"but if any of you is obedient to God and His Messenger and does good deeds, know that We shall give her a double reward and have prepared a generous provision for her.","words":[{"pos":1,"ar":"۞ وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"33:31"},{"pos":2,"ar":"يَقْنُتْ","en_gloss":"is obedient","transliteration":"yaqnut","verse_key":"33:31"},{"pos":3,"ar":"مِنكُنَّ","en_gloss":"among you","transliteration":"minkunna","verse_key":"33:31"},{"pos":4,"ar":"لِلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"33:31"},{"pos":5,"ar":"وَرَسُولِهِۦ","en_gloss":"and His Messenger","transliteration":"warasūlihi","verse_key":"33:31"},{"pos":6,"ar":"وَتَعْمَلْ","en_gloss":"and does","transliteration":"wataʿmal","verse_key":"33:31"},{"pos":7,"ar":"صَـٰلِحًۭا","en_gloss":"righteousness","transliteration":"ṣāliḥan","verse_key":"33:31"},{"pos":8,"ar":"نُّؤْتِهَآ","en_gloss":"We will give her","transliteration":"nu'tihā","verse_key":"33:31"},{"pos":9,"ar":"أَجْرَهَا","en_gloss":"her reward","transliteration":"ajrahā","verse_key":"33:31"},{"pos":10,"ar":"مَرَّتَيْنِ","en_gloss":"twice","transliteration":"marratayni","verse_key":"33:31"},{"pos":11,"ar":"وَأَعْتَدْنَا","en_gloss":"and We have prepared","transliteration":"wa-aʿtadnā","verse_key":"33:31"},{"pos":12,"ar":"لَهَا","en_gloss":"for her","transliteration":"lahā","verse_key":"33:31"},{"pos":13,"ar":"رِزْقًۭا","en_gloss":"a provision","transliteration":"riz'qan","verse_key":"33:31"},{"pos":14,"ar":"كَرِيمًۭا","en_gloss":"noble","transliteration":"karīman","verse_key":"33:31"},{"pos":15,"ar":"٣١","en_gloss":"(31)","transliteration":"","verse_key":"33:31"}]},{"verse_key":"33:32","surah":33,"ayah":32,"ar_uthmani":"يَـٰنِسَآءَ ٱلنَّبِىِّ لَسْتُنَّ كَأَحَدٍ مِّنَ ٱلنِّسَآءِ ۚ إِنِ ٱتَّقَيْتُنَّ فَلَا تَخْضَعْنَ بِٱلْقَوْلِ فَيَطْمَعَ ٱلَّذِى فِى قَلْبِهِۦ مَرَضٌ وَقُلْنَ قَوْلًا مَّعْرُوفًا","en_translation_id":85,"en":"Wives of the Prophet, you are not like any other woman. If you are truly mindful of God, do not speak too softly in case the sick at heart should lust after you, but speak in an appropriate manner;","words":[{"pos":1,"ar":"يَـٰنِسَآءَ","en_gloss":"O wives","transliteration":"yānisāa","verse_key":"33:32"},{"pos":2,"ar":"ٱلنَّبِىِّ","en_gloss":"(of) the Prophet","transliteration":"l-nabiyi","verse_key":"33:32"},{"pos":3,"ar":"لَسْتُنَّ","en_gloss":"You are not","transliteration":"lastunna","verse_key":"33:32"},{"pos":4,"ar":"كَأَحَدٍۢ","en_gloss":"like anyone","transliteration":"ka-aḥadin","verse_key":"33:32"},{"pos":5,"ar":"مِّنَ","en_gloss":"among","transliteration":"mina","verse_key":"33:32"},{"pos":6,"ar":"ٱلنِّسَآءِ ۚ","en_gloss":"the women","transliteration":"l-nisāi","verse_key":"33:32"},{"pos":7,"ar":"إِنِ","en_gloss":"If","transliteration":"ini","verse_key":"33:32"},{"pos":8,"ar":"ٱتَّقَيْتُنَّ","en_gloss":"you fear (Allah)","transliteration":"ittaqaytunna","verse_key":"33:32"},{"pos":9,"ar":"فَلَا","en_gloss":"then (do) not","transliteration":"falā","verse_key":"33:32"},{"pos":10,"ar":"تَخْضَعْنَ","en_gloss":"be soft","transliteration":"takhḍaʿna","verse_key":"33:32"},{"pos":11,"ar":"بِٱلْقَوْلِ","en_gloss":"in speech","transliteration":"bil-qawli","verse_key":"33:32"},{"pos":12,"ar":"فَيَطْمَعَ","en_gloss":"lest should be moved with desire","transliteration":"fayaṭmaʿa","verse_key":"33:32"},{"pos":13,"ar":"ٱلَّذِى","en_gloss":"he who","transliteration":"alladhī","verse_key":"33:32"},{"pos":14,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"33:32"},{"pos":15,"ar":"قَلْبِهِۦ","en_gloss":"his heart","transliteration":"qalbihi","verse_key":"33:32"},{"pos":16,"ar":"مَرَضٌۭ","en_gloss":"(is) a disease","transliteration":"maraḍun","verse_key":"33:32"},{"pos":17,"ar":"وَقُلْنَ","en_gloss":"but say","transliteration":"waqul'na","verse_key":"33:32"},{"pos":18,"ar":"قَوْلًۭا","en_gloss":"a word","transliteration":"qawlan","verse_key":"33:32"},{"pos":19,"ar":"مَّعْرُوفًۭا","en_gloss":"appropriate","transliteration":"maʿrūfan","verse_key":"33:32"},{"pos":20,"ar":"٣٢","en_gloss":"(32)","transliteration":"","verse_key":"33:32"}]},{"verse_key":"33:33","surah":33,"ayah":33,"ar_uthmani":"وَقَرْنَ فِى بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا","en_translation_id":85,"en":"stay at home, and do not flaunt your finery as they used to in the pagan past; keep up the prayer, give the prescribed alms, and obey God and His Messenger. God wishes to keep uncleanness away from you, people of the [Prophet’s] House, and to purify you thoroughly.","words":[{"pos":1,"ar":"وَقَرْنَ","en_gloss":"And stay","transliteration":"waqarna","verse_key":"33:33"},{"pos":2,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"33:33"},{"pos":3,"ar":"بُيُوتِكُنَّ","en_gloss":"your houses","transliteration":"buyūtikunna","verse_key":"33:33"},{"pos":4,"ar":"وَلَا","en_gloss":"and (do) not","transliteration":"walā","verse_key":"33:33"},{"pos":5,"ar":"تَبَرَّجْنَ","en_gloss":"display yourselves","transliteration":"tabarrajna","verse_key":"33:33"},{"pos":6,"ar":"تَبَرُّجَ","en_gloss":"(as was the) display","transliteration":"tabarruja","verse_key":"33:33"},{"pos":7,"ar":"ٱلْجَـٰهِلِيَّةِ","en_gloss":"(of the times of) ignorance","transliteration":"l-jāhiliyati","verse_key":"33:33"},{"pos":8,"ar":"ٱلْأُولَىٰ ۖ","en_gloss":"the former","transliteration":"l-ūlā","verse_key":"33:33"},{"pos":9,"ar":"وَأَقِمْنَ","en_gloss":"And establish","transliteration":"wa-aqim'na","verse_key":"33:33"},{"pos":10,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"33:33"},{"pos":11,"ar":"وَءَاتِينَ","en_gloss":"and give","transliteration":"waātīna","verse_key":"33:33"},{"pos":12,"ar":"ٱلزَّكَوٰةَ","en_gloss":"zakah","transliteration":"l-zakata","verse_key":"33:33"},{"pos":13,"ar":"وَأَطِعْنَ","en_gloss":"and obey","transliteration":"wa-aṭiʿ'na","verse_key":"33:33"},{"pos":14,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"33:33"},{"pos":15,"ar":"وَرَسُولَهُۥٓ ۚ","en_gloss":"and His Messenger","transliteration":"warasūlahu","verse_key":"33:33"},{"pos":16,"ar":"إِنَّمَا","en_gloss":"Only","transliteration":"innamā","verse_key":"33:33"},{"pos":17,"ar":"يُرِيدُ","en_gloss":"Allah wishes","transliteration":"yurīdu","verse_key":"33:33"},{"pos":18,"ar":"ٱللَّهُ","en_gloss":"Allah wishes","transliteration":"l-lahu","verse_key":"33:33"},{"pos":19,"ar":"لِيُذْهِبَ","en_gloss":"to remove","transliteration":"liyudh'hiba","verse_key":"33:33"},{"pos":20,"ar":"عَنكُمُ","en_gloss":"from you","transliteration":"ʿankumu","verse_key":"33:33"},{"pos":21,"ar":"ٱلرِّجْسَ","en_gloss":"the impurity","transliteration":"l-rij'sa","verse_key":"33:33"},{"pos":22,"ar":"أَهْلَ","en_gloss":"(O) People","transliteration":"ahla","verse_key":"33:33"},{"pos":23,"ar":"ٱلْبَيْتِ","en_gloss":"(of) the House","transliteration":"l-bayti","verse_key":"33:33"},{"pos":24,"ar":"وَيُطَهِّرَكُمْ","en_gloss":"And to purify you","transliteration":"wayuṭahhirakum","verse_key":"33:33"},{"pos":25,"ar":"تَطْهِيرًۭا","en_gloss":"(with thorough) purification","transliteration":"taṭhīran","verse_key":"33:33"},{"pos":26,"ar":"٣٣","en_gloss":"(33)","transliteration":"","verse_key":"33:33"}]},{"verse_key":"33:34","surah":33,"ayah":34,"ar_uthmani":"وَٱذْكُرْنَ مَا يُتْلَىٰ فِى بُيُوتِكُنَّ مِنْ ءَايَـٰتِ ٱللَّهِ وَٱلْحِكْمَةِ ۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا","en_translation_id":85,"en":"Remember what is recited in your houses of God’s revelations and wisdom, for God is all subtle, all aware.","words":[{"pos":1,"ar":"وَٱذْكُرْنَ","en_gloss":"And remember","transliteration":"wa-udh'kur'na","verse_key":"33:34"},{"pos":2,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"33:34"},{"pos":3,"ar":"يُتْلَىٰ","en_gloss":"is recited","transliteration":"yut'lā","verse_key":"33:34"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"33:34"},{"pos":5,"ar":"بُيُوتِكُنَّ","en_gloss":"your houses","transliteration":"buyūtikunna","verse_key":"33:34"},{"pos":6,"ar":"مِنْ","en_gloss":"of","transliteration":"min","verse_key":"33:34"},{"pos":7,"ar":"ءَايَـٰتِ","en_gloss":"(the) Verses","transliteration":"āyāti","verse_key":"33:34"},{"pos":8,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"33:34"},{"pos":9,"ar":"وَٱلْحِكْمَةِ ۚ","en_gloss":"and the wisdom","transliteration":"wal-ḥik'mati","verse_key":"33:34"},{"pos":10,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"33:34"},{"pos":11,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"33:34"},{"pos":12,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"33:34"},{"pos":13,"ar":"لَطِيفًا","en_gloss":"All-Subtle","transliteration":"laṭīfan","verse_key":"33:34"},{"pos":14,"ar":"خَبِيرًا","en_gloss":"All-Aware","transliteration":"khabīran","verse_key":"33:34"},{"pos":15,"ar":"٣٤","en_gloss":"(34)","transliteration":"","verse_key":"33:34"}]},{"verse_key":"33:35","surah":33,"ayah":35,"ar_uthmani":"إِنَّ ٱلْمُسْلِمِينَ وَٱلْمُسْلِمَـٰتِ وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَٱلْقَـٰنِتِينَ وَٱلْقَـٰنِتَـٰتِ وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ فُرُوجَهُمْ وَٱلْحَـٰفِظَـٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًا وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغْفِرَةً وَأَجْرًا عَظِيمًا","en_translation_id":85,"en":"For men and women who are devoted to God- believing men and women, obedient men and women, truthful men and women, steadfast men and women, humble men and women, charitable men and women, fasting men and women, chaste men and women, men and women who remember God often- God has prepared forgiveness and a rich reward.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"33:35"},{"pos":2,"ar":"ٱلْمُسْلِمِينَ","en_gloss":"the Muslim men","transliteration":"l-mus'limīna","verse_key":"33:35"},{"pos":3,"ar":"وَٱلْمُسْلِمَـٰتِ","en_gloss":"and the Muslim women","transliteration":"wal-mus'limāti","verse_key":"33:35"},{"pos":4,"ar":"وَٱلْمُؤْمِنِينَ","en_gloss":"and the believing men","transliteration":"wal-mu'minīna","verse_key":"33:35"},{"pos":5,"ar":"وَٱلْمُؤْمِنَـٰتِ","en_gloss":"and the believing women","transliteration":"wal-mu'mināti","verse_key":"33:35"},{"pos":6,"ar":"وَٱلْقَـٰنِتِينَ","en_gloss":"and the obedient men","transliteration":"wal-qānitīna","verse_key":"33:35"},{"pos":7,"ar":"وَٱلْقَـٰنِتَـٰتِ","en_gloss":"and the obedient women","transliteration":"wal-qānitāti","verse_key":"33:35"},{"pos":8,"ar":"وَٱلصَّـٰدِقِينَ","en_gloss":"and the truthful men","transliteration":"wal-ṣādiqīna","verse_key":"33:35"},{"pos":9,"ar":"وَٱلصَّـٰدِقَـٰتِ","en_gloss":"and the truthful women","transliteration":"wal-ṣādiqāti","verse_key":"33:35"},{"pos":10,"ar":"وَٱلصَّـٰبِرِينَ","en_gloss":"and the patient men","transliteration":"wal-ṣābirīna","verse_key":"33:35"},{"pos":11,"ar":"وَٱلصَّـٰبِرَٰتِ","en_gloss":"and the patient women","transliteration":"wal-ṣābirāti","verse_key":"33:35"},{"pos":12,"ar":"وَٱلْخَـٰشِعِينَ","en_gloss":"and the humble men","transliteration":"wal-khāshiʿīna","verse_key":"33:35"},{"pos":13,"ar":"وَٱلْخَـٰشِعَـٰتِ","en_gloss":"and the humble women","transliteration":"wal-khāshiʿāti","verse_key":"33:35"},{"pos":14,"ar":"وَٱلْمُتَصَدِّقِينَ","en_gloss":"and the men who give charity","transliteration":"wal-mutaṣadiqīna","verse_key":"33:35"},{"pos":15,"ar":"وَٱلْمُتَصَدِّقَـٰتِ","en_gloss":"and the women who give charity","transliteration":"wal-mutaṣadiqāti","verse_key":"33:35"},{"pos":16,"ar":"وَٱلصَّـٰٓئِمِينَ","en_gloss":"and the men who fast","transliteration":"wal-ṣāimīna","verse_key":"33:35"},{"pos":17,"ar":"وَٱلصَّـٰٓئِمَـٰتِ","en_gloss":"and the women who fast","transliteration":"wal-ṣāimāti","verse_key":"33:35"},{"pos":18,"ar":"وَٱلْحَـٰفِظِينَ","en_gloss":"and the men who guard","transliteration":"wal-ḥāfiẓīna","verse_key":"33:35"},{"pos":19,"ar":"فُرُوجَهُمْ","en_gloss":"their chastity","transliteration":"furūjahum","verse_key":"33:35"},{"pos":20,"ar":"وَٱلْحَـٰفِظَـٰتِ","en_gloss":"and the women who guard (it)","transliteration":"wal-ḥāfiẓāti","verse_key":"33:35"},{"pos":21,"ar":"وَٱلذَّٰكِرِينَ","en_gloss":"and the men who remember","transliteration":"wal-dhākirīna","verse_key":"33:35"},{"pos":22,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"33:35"},{"pos":23,"ar":"كَثِيرًۭا","en_gloss":"much","transliteration":"kathīran","verse_key":"33:35"},{"pos":24,"ar":"وَٱلذَّٰكِرَٰتِ","en_gloss":"and the women who remember","transliteration":"wal-dhākirāti","verse_key":"33:35"},{"pos":25,"ar":"أَعَدَّ","en_gloss":"Allah has prepared","transliteration":"aʿadda","verse_key":"33:35"},{"pos":26,"ar":"ٱللَّهُ","en_gloss":"Allah has prepared","transliteration":"l-lahu","verse_key":"33:35"},{"pos":27,"ar":"لَهُم","en_gloss":"for them","transliteration":"lahum","verse_key":"33:35"},{"pos":28,"ar":"مَّغْفِرَةًۭ","en_gloss":"forgiveness","transliteration":"maghfiratan","verse_key":"33:35"},{"pos":29,"ar":"وَأَجْرًا","en_gloss":"and a reward","transliteration":"wa-ajran","verse_key":"33:35"},{"pos":30,"ar":"عَظِيمًۭا","en_gloss":"great","transliteration":"ʿaẓīman","verse_key":"33:35"},{"pos":31,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"33:35"}]}]}