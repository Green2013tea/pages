":"talbisū","verse_key":"2:42"},{"pos":3,"ar":"ٱلْحَقَّ","en_gloss":"the Truth","transliteration":"l-ḥaqa","verse_key":"2:42"},{"pos":4,"ar":"بِٱلْبَـٰطِلِ","en_gloss":"with [the] falsehood","transliteration":"bil-bāṭili","verse_key":"2:42"},{"pos":5,"ar":"وَتَكْتُمُوا۟","en_gloss":"and conceal","transliteration":"wataktumū","verse_key":"2:42"},{"pos":6,"ar":"ٱلْحَقَّ","en_gloss":"the Truth","transliteration":"l-ḥaqa","verse_key":"2:42"},{"pos":7,"ar":"وَأَنتُمْ","en_gloss":"while you","transliteration":"wa-antum","verse_key":"2:42"},{"pos":8,"ar":"تَعْلَمُونَ","en_gloss":"[you] know","transliteration":"taʿlamūna","verse_key":"2:42"},{"pos":9,"ar":"٤٢","en_gloss":"(42)","transliteration":"","verse_key":"2:42"}]},{"verse_key":"2:43","surah":2,"ayah":43,"ar_uthmani":"وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱرْكَعُوا۟ مَعَ ٱلرَّٰكِعِينَ","en_translation_id":85,"en":"Keep up the prayer, pay the prescribed alms, and bow your heads [in worship] with those who bow theirs.","words":[{"pos":1,"ar":"وَأَقِيمُوا۟","en_gloss":"And establish","transliteration":"wa-aqīmū","verse_key":"2:43"},{"pos":2,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"2:43"},{"pos":3,"ar":"وَءَاتُوا۟","en_gloss":"and give","transliteration":"waātū","verse_key":"2:43"},{"pos":4,"ar":"ٱلزَّكَوٰةَ","en_gloss":"zakah","transliteration":"l-zakata","verse_key":"2:43"},{"pos":5,"ar":"وَٱرْكَعُوا۟","en_gloss":"and bow down","transliteration":"wa-ir'kaʿū","verse_key":"2:43"},{"pos":6,"ar":"مَعَ","en_gloss":"with","transliteration":"maʿa","verse_key":"2:43"},{"pos":7,"ar":"ٱلرَّٰكِعِينَ","en_gloss":"those who bow down","transliteration":"l-rākiʿīna","verse_key":"2:43"},{"pos":8,"ar":"٤٣","en_gloss":"(43)","transliteration":"","verse_key":"2:43"}]},{"verse_key":"2:44","surah":2,"ayah":44,"ar_uthmani":"۞ أَتَأْمُرُونَ ٱلنَّاسَ بِٱلْبِرِّ وَتَنسَوْنَ أَنفُسَكُمْ وَأَنتُمْ تَتْلُونَ ٱلْكِتَـٰبَ ۚ أَفَلَا تَعْقِلُونَ","en_translation_id":85,"en":"How can you tell peopl