ts you with this, and on the Day of the Resurrection He will make clear to you those things you differed about.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"16:92"},{"pos":2,"ar":"تَكُونُوا۟","en_gloss":"be","transliteration":"takūnū","verse_key":"16:92"},{"pos":3,"ar":"كَٱلَّتِى","en_gloss":"like her who","transliteration":"ka-allatī","verse_key":"16:92"},{"pos":4,"ar":"نَقَضَتْ","en_gloss":"untwists","transliteration":"naqaḍat","verse_key":"16:92"},{"pos":5,"ar":"غَزْلَهَا","en_gloss":"her spun yarn","transliteration":"ghazlahā","verse_key":"16:92"},{"pos":6,"ar":"مِنۢ","en_gloss":"after","transliteration":"min","verse_key":"16:92"},{"pos":7,"ar":"بَعْدِ","en_gloss":"after","transliteration":"baʿdi","verse_key":"16:92"},{"pos":8,"ar":"قُوَّةٍ","en_gloss":"strength","transliteration":"quwwatin","verse_key":"16:92"},{"pos":9,"ar":"أَنكَـٰثًۭا","en_gloss":"(into) untwisted strands","transliteration":"ankāthan","verse_key":"16:92"},{"pos":10,"ar":"تَتَّخِذُونَ","en_gloss":"you take","transliteration":"tattakhidhūna","verse_key":"16:92"},{"pos":11,"ar":"أَيْمَـٰنَكُمْ","en_gloss":"your oaths","transliteration":"aymānakum","verse_key":"16:92"},{"pos":12,"ar":"دَخَلًۢا","en_gloss":"(as) a deception","transliteration":"dakhalan","verse_key":"16:92"},{"pos":13,"ar":"بَيْنَكُمْ","en_gloss":"between you","transliteration":"baynakum","verse_key":"16:92"},{"pos":14,"ar":"أَن","en_gloss":"because","transliteration":"an","verse_key":"16:92"},{"pos":15,"ar":"تَكُونَ","en_gloss":"is","transliteration":"takūna","verse_key":"16:92"},{"pos":16,"ar":"أُمَّةٌ","en_gloss":"a community","transliteration":"ummatun","verse_key":"16:92"},{"pos":17,"ar":"هِىَ","en_gloss":"[it]","transliteration":"hiya","verse_key":"16:92"},{"pos":18,"ar":"أَرْبَىٰ","en_gloss":"more numerous","transliteration":"arbā","verse_key":"16:92"},{"pos":19,"ar":"مِنْ","en_gloss":"than","transliteration":"min","verse_key":"16:92"},{"pos":20,"ar":"أُمَّةٍ ۚ","en_gloss":