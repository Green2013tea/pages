{"page":277,"verses":[{"verse_key":"16:88","surah":16,"ayah":88,"ar_uthmani":"ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ زِدْنَـٰهُمْ عَذَابًا فَوْقَ ٱلْعَذَابِ بِمَا كَانُوا۟ يُفْسِدُونَ","en_translation_id":85,"en":"Because of the corruption they spread, We shall add torment upon torment for those who disbelieved and barred others from the path of God.","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"And those who","transliteration":"alladhīna","verse_key":"16:88"},{"pos":2,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"16:88"},{"pos":3,"ar":"وَصَدُّوا۟","en_gloss":"and hindered","transliteration":"waṣaddū","verse_key":"16:88"},{"pos":4,"ar":"عَن","en_gloss":"from","transliteration":"ʿan","verse_key":"16:88"},{"pos":5,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"16:88"},{"pos":6,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"16:88"},{"pos":7,"ar":"زِدْنَـٰهُمْ","en_gloss":"We will increase them","transliteration":"zid'nāhum","verse_key":"16:88"},{"pos":8,"ar":"عَذَابًۭا","en_gloss":"(in) punishment","transliteration":"ʿadhāban","verse_key":"16:88"},{"pos":9,"ar":"فَوْقَ","en_gloss":"over","transliteration":"fawqa","verse_key":"16:88"},{"pos":10,"ar":"ٱلْعَذَابِ","en_gloss":"punishment","transliteration":"l-ʿadhābi","verse_key":"16:88"},{"pos":11,"ar":"بِمَا","en_gloss":"because","transliteration":"bimā","verse_key":"16:88"},{"pos":12,"ar":"كَانُوا۟","en_gloss":"they used (to)","transliteration":"kānū","verse_key":"16:88"},{"pos":13,"ar":"يُفْسِدُونَ","en_gloss":"spread corruption","transliteration":"yuf'sidūna","verse_key":"16:88"},{"pos":14,"ar":"٨٨","en_gloss":"(88)","transliteration":"","verse_key":"16:88"}]},{"verse_key":"16:89","surah":16,"ayah":89,"ar_uthmani":"وَيَوْمَ نَبْعَثُ فِى كُلِّ أُمَّةٍ شَهِيدًا عَلَيْهِم مِّنْ أَنفُسِهِمْ ۖ وَجِئْنَا بِكَ شَهِيدًا عَلَىٰ هَـٰٓؤُلَآءِ ۚ وَنَزَّلْنَا عَلَيْكَ ٱلْكِتَـٰبَ تِبْيَـٰنًا لِّكُلِّ شَىْءٍ وَهُدًى وَرَحْمَةً وَبُشْرَىٰ لِلْمُسْلِمِينَ","en_translation_id":85,"en":"The day will come when We raise up in each community a witness against them, and We shall bring you [Prophet] as a witness against these people, for We have sent the Scripture down to you explaining everything, and as guidance and mercy and good news to those who devote themselves to God.","words":[{"pos":1,"ar":"وَيَوْمَ","en_gloss":"And the Day","transliteration":"wayawma","verse_key":"16:89"},{"pos":2,"ar":"نَبْعَثُ","en_gloss":"We will resurrect","transliteration":"nabʿathu","verse_key":"16:89"},{"pos":3,"ar":"فِى","en_gloss":"among","transliteration":"fī","verse_key":"16:89"},{"pos":4,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"16:89"},{"pos":5,"ar":"أُمَّةٍۢ","en_gloss":"nation","transliteration":"ummatin","verse_key":"16:89"},{"pos":6,"ar":"شَهِيدًا","en_gloss":"a witness","transliteration":"shahīdan","verse_key":"16:89"},{"pos":7,"ar":"عَلَيْهِم","en_gloss":"over them","transliteration":"ʿalayhim","verse_key":"16:89"},{"pos":8,"ar":"مِّنْ","en_gloss":"from","transliteration":"min","verse_key":"16:89"},{"pos":9,"ar":"أَنفُسِهِمْ ۖ","en_gloss":"themselves","transliteration":"anfusihim","verse_key":"16:89"},{"pos":10,"ar":"وَجِئْنَا","en_gloss":"And We (will) bring","transliteration":"waji'nā","verse_key":"16:89"},{"pos":11,"ar":"بِكَ","en_gloss":"you","transliteration":"bika","verse_key":"16:89"},{"pos":12,"ar":"شَهِيدًا","en_gloss":"(as) a witness","transliteration":"shahīdan","verse_key":"16:89"},{"pos":13,"ar":"عَلَىٰ","en_gloss":"over","transliteration":"ʿalā","verse_key":"16:89"},{"pos":14,"ar":"هَـٰٓؤُلَآءِ ۚ","en_gloss":"these","transliteration":"hāulāi","verse_key":"16:89"},{"pos":15,"ar":"وَنَزَّلْنَا","en_gloss":"And We sent down","transliteration":"wanazzalnā","verse_key":"16:89"},{"pos":16,"ar":"عَلَيْكَ","en_gloss":"to you","transliteration":"ʿalayka","verse_key":"16:89"},{"pos":17,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","vers