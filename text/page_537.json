_gloss":"All-Powerful","transliteration":"qadīrun","verse_key":"57:2"},{"pos":12,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"57:2"}]},{"verse_key":"57:3","surah":57,"ayah":3,"ar_uthmani":"هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ وَٱلظَّـٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ","en_translation_id":85,"en":"He is the First and the Last; the Outer and the Inner; He has knowledge of all things.","words":[{"pos":1,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"57:3"},{"pos":2,"ar":"ٱلْأَوَّلُ","en_gloss":"(is) the First","transliteration":"l-awalu","verse_key":"57:3"},{"pos":3,"ar":"وَٱلْـَٔاخِرُ","en_gloss":"and the Last","transliteration":"wal-ākhiru","verse_key":"57:3"},{"pos":4,"ar":"وَٱلظَّـٰهِرُ","en_gloss":"and the Apparent","transliteration":"wal-ẓāhiru","verse_key":"57:3"},{"pos":5,"ar":"وَٱلْبَاطِنُ ۖ","en_gloss":"and the Unapparent","transliteration":"wal-bāṭinu","verse_key":"57:3"},{"pos":6,"ar":"وَهُوَ","en_gloss":"and He","transliteration":"wahuwa","verse_key":"57:3"},{"pos":7,"ar":"بِكُلِّ","en_gloss":"(is) of every","transliteration":"bikulli","verse_key":"57:3"},{"pos":8,"ar":"شَىْءٍ","en_gloss":"thing","transliteration":"shayin","verse_key":"57:3"},{"pos":9,"ar":"عَلِيمٌ","en_gloss":"All-Knower","transliteration":"ʿalīmun","verse_key":"57:3"},{"pos":10,"ar":"٣","en_gloss":"(3)","transliteration":"","verse_key":"57:3"}]}]}