ayah":23,"ar_uthmani":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","en_translation_id":85,"en":"these are nothing but names you have invented yourselves, you and your forefathers. God has sent no authority for them. These people merely follow guesswork and the whims of their souls, even though guidance has come to them from their Lord.","words":[{"pos":1,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"53:23"},{"pos":2,"ar":"هِىَ","en_gloss":"they","transliteration":"hiya","verse_key":"53:23"},{"pos":3,"ar":"إِلَّآ","en_gloss":"(are) except","transliteration":"illā","verse_key":"53:23"},{"pos":4,"ar":"أَسْمَآءٌۭ","en_gloss":"names","transliteration":"asmāon","verse_key":"53:23"},{"pos":5,"ar":"سَمَّيْتُمُوهَآ","en_gloss":"you have named them","transliteration":"sammaytumūhā","verse_key":"53:23"},{"pos":6,"ar":"أَنتُمْ","en_gloss":"you","transliteration":"antum","verse_key":"53:23"},{"pos":7,"ar":"وَءَابَآؤُكُم","en_gloss":"and your forefathers","transliteration":"waābāukum","verse_key":"53:23"},{"pos":8,"ar":"مَّآ","en_gloss":"not","transliteration":"mā","verse_key":"53:23"},{"pos":9,"ar":"أَنزَلَ","en_gloss":"has Allah sent down","transliteration":"anzala","verse_key":"53:23"},{"pos":10,"ar":"ٱللَّهُ","en_gloss":"has Allah sent down","transliteration":"l-lahu","verse_key":"53:23"},{"pos":11,"ar":"بِهَا","en_gloss":"for it","transliteration":"bihā","verse_key":"53:23"},{"pos":12,"ar":"مِن","en_gloss":"any","transliteration":"min","verse_key":"53:23"},{"pos":13,"ar":"سُلْطَـٰنٍ ۚ","en_gloss":"authority","transliteration":"sul'ṭānin","verse_key":"53:23"},{"pos":14,"ar":"إِن","en_gloss":"Not","transliteration":"in","verse_key":"53:23"},{"pos":15,"ar":"يَتَّبِعُونَ","en_gloss":"they follow","transliteration":"yattabiʿūna","verse_key":"53:23"},{"pos":16,"ar":"إِلَّا","en_gloss