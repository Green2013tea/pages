ar":"لَّمْ","en_gloss":"not","transliteration":"lam","verse_key":"12:60"},{"pos":3,"ar":"تَأْتُونِى","en_gloss":"you bring him to me","transliteration":"tatūnī","verse_key":"12:60"},{"pos":4,"ar":"بِهِۦ","en_gloss":"you bring him to me","transliteration":"bihi","verse_key":"12:60"},{"pos":5,"ar":"فَلَا","en_gloss":"then (there will be) no","transliteration":"falā","verse_key":"12:60"},{"pos":6,"ar":"كَيْلَ","en_gloss":"measure","transliteration":"kayla","verse_key":"12:60"},{"pos":7,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"12:60"},{"pos":8,"ar":"عِندِى","en_gloss":"from me","transliteration":"ʿindī","verse_key":"12:60"},{"pos":9,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"12:60"},{"pos":10,"ar":"تَقْرَبُونِ","en_gloss":"you will come near me","transliteration":"taqrabūni","verse_key":"12:60"},{"pos":11,"ar":"٦٠","en_gloss":"(60)","transliteration":"","verse_key":"12:60"}]},{"verse_key":"12:61","surah":12,"ayah":61,"ar_uthmani":"قَالُوا۟ سَنُرَٰوِدُ عَنْهُ أَبَاهُ وَإِنَّا لَفَـٰعِلُونَ","en_translation_id":85,"en":"They said, ‘We shall do all we can to persuade his father to send him with us, indeed we shall.’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"12:61"},{"pos":2,"ar":"سَنُرَٰوِدُ","en_gloss":"We will try to get permission","transliteration":"sanurāwidu","verse_key":"12:61"},{"pos":3,"ar":"عَنْهُ","en_gloss":"for him","transliteration":"ʿanhu","verse_key":"12:61"},{"pos":4,"ar":"أَبَاهُ","en_gloss":"(from) his father","transliteration":"abāhu","verse_key":"12:61"},{"pos":5,"ar":"وَإِنَّا","en_gloss":"and indeed we","transliteration":"wa-innā","verse_key":"12:61"},{"pos":6,"ar":"لَفَـٰعِلُونَ","en_gloss":"surely will do","transliteration":"lafāʿilūna","verse_key":"12:61"},{"pos":7,"ar":"٦١","en_gloss":"(61)","transliteration":"","verse_key":"12:61"}]},{"verse_key":"12:62","surah":12,"ayah":62,"ar_uthmani":"وَقَالَ لِفِتْيَـٰنِهِ ٱجْعَلُوا۟ بِضَـٰعَتَهُمْ فِى رِحَالِهِمْ لَعَلَّهُمْ يَعْرِفُونَهَآ إِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمْ لَعَلَّهُمْ يَرْجِعُونَ","en_translation_id":85,"en":"Joseph said to his servants, ‘Put their [traded] goods back into their saddlebags, so that they may recognize them when they go back to their family, and [be eager to] return.’","words":[{"pos":1,"ar":"وَقَالَ","en_gloss":"And he said","transliteration":"waqāla","verse_key":"12:62"},{"pos":2,"ar":"لِفِتْيَـٰنِهِ","en_gloss":"to his servants","transliteration":"lifit'yānihi","verse_key":"12:62"},{"pos":3,"ar":"ٱجْعَلُوا۟","en_gloss":"Put","transliteration":"ij'ʿalū","verse_key":"12:62"},{"pos":4,"ar":"بِضَـٰعَتَهُمْ","en_gloss":"their merchandise","transliteration":"biḍāʿatahum","verse_key":"12:62"},{"pos":5,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"12:62"},{"pos":6,"ar":"رِحَالِهِمْ","en_gloss":"their saddlebags","transliteration":"riḥālihim","verse_key":"12:62"},{"pos":7,"ar":"لَعَلَّهُمْ","en_gloss":"so that they","transliteration":"laʿallahum","verse_key":"12:62"},{"pos":8,"ar":"يَعْرِفُونَهَآ","en_gloss":"may recognize it","transliteration":"yaʿrifūnahā","verse_key":"12:62"},{"pos":9,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"12:62"},{"pos":10,"ar":"ٱنقَلَبُوٓا۟","en_gloss":"they go back","transliteration":"inqalabū","verse_key":"12:62"},{"pos":11,"ar":"إِلَىٰٓ","en_gloss":"to","transliteration":"ilā","verse_key":"12:62"},{"pos":12,"ar":"أَهْلِهِمْ","en_gloss":"their people","transliteration":"ahlihim","verse_key":"12:62"},{"pos":13,"ar":"لَعَلَّهُمْ","en_gloss":"so that they may","transliteration":"laʿallahum","verse_key":"12:62"},{"pos":14,"ar":"يَرْجِعُونَ","en_gloss":"return","transliteration":"yarjiʿūna","verse_key":"12:62"},{"pos":15,"ar":"٦٢","en_gloss":"(62)","transliteration":"","verse_key":"12:62"}]},{"verse_key":"12:63","surah":12,"ayah":63,"ar_uthmani":"فَلَمَّا رَجَعُوٓا۟ إِلَىٰٓ أَبِيهِمْ قَالُوا۟ يَـٰٓأَبَانَا مُنِعَ مِنَّا ٱلْكَيْلُ فَأَرْسِلْ مَعَنَآ أَخَانَا نَكْتَلْ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ","en_translation_id":85,"en":"When they returned to their father, they said, ‘Father, we have been denied any more corn, but send our brother back with us and we shall be given another measure. We shall guard him carefully.’","words":[{"pos":1,"ar":"فَلَمَّا","en_gloss":"So when","transliteration":"falammā","verse_key":"12:63"},{"pos":2,"ar":"رَجَعُوٓا۟","en_gloss":"they returned","transliteration":"rajaʿū","verse_key":"12:63"},{"pos":3,"ar":"إِلَىٰٓ","en_gloss":"to","transliteration":"ilā","verse_key":"12:63"},{"pos":4,"ar":"أَبِيهِمْ","en_gloss":"their father","transliteration":"abīhim","verse_key":"12:63"},{"pos":5,"ar":"قَالُوا۟","en_gloss":"they said","transliteration":"qālū","verse_key":"12:63"},{"pos":6,"ar":"يَـٰٓأَبَانَا","en_gloss":"O our father","transliteration":"yāabānā","verse_key":"12:63"},{"pos":7,"ar":"مُنِعَ","en_gloss":"Has been denied","transliteration":"muniʿa","verse_key":"12:63"},{"pos":8,"ar":"مِنَّا","en_gloss":"to us","transliteration":"minnā","verse_key":"12:63"},{"pos":9,"ar":"ٱلْكَيْلُ","en_gloss":"the measure","transliteration":"l-kaylu","verse_key":"12:63"},{"pos":10,"ar":"فَأَرْسِلْ","en_gloss":"so send","transliteration":"fa-arsil","verse_key":"12:63"},{"pos":11,"ar":"مَعَنَآ","en_gloss":"with us","transliteration":"maʿanā","verse_key":"12:63"},{"pos":12,"ar":"أَخَانَا","en_gloss":"our brother","transliteration":"akhānā","verse_key":"12:63"},{"pos":13,"ar":"نَكْتَلْ","en_gloss":"(that) we will get measure","transliteration":"naktal","verse_key":"12:63"},{"pos":14,"ar":"وَإِنَّا","en_gloss":"And indeed, we","transliteration":"wa-innā","verse_key":"12:63"},{"pos":15,"ar":"لَهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"12:63"},{"pos":16,"ar":"لَحَـٰفِظُونَ","en_gloss":"(will) surely (be) guardians","transliteration":"laḥāfiẓūna","verse_key":"12:63"},{"pos":17,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"12:63"}]}]}