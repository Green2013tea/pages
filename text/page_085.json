16,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"4:40"}]},{"verse_key":"4:41","surah":4,"ayah":41,"ar_uthmani":"فَكَيْفَ إِذَا جِئْنَا مِن كُلِّ أُمَّةٍۭ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَىٰ هَـٰٓؤُلَآءِ شَهِيدًا","en_translation_id":85,"en":"What will they do when We bring a witness from each community, with you [Muhammad] as a witness against these people?","words":[{"pos":1,"ar":"فَكَيْفَ","en_gloss":"So how (will it be)","transliteration":"fakayfa","verse_key":"4:41"},{"pos":2,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"4:41"},{"pos":3,"ar":"جِئْنَا","en_gloss":"We bring","transliteration":"ji'nā","verse_key":"4:41"},{"pos":4,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"4:41"},{"pos":5,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"4:41"},{"pos":6,"ar":"أُمَّةٍۭ","en_gloss":"nation","transliteration":"ummatin","verse_key":"4:41"},{"pos":7,"ar":"بِشَهِيدٍۢ","en_gloss":"a witness","transliteration":"bishahīdin","verse_key":"4:41"},{"pos":8,"ar":"وَجِئْنَا","en_gloss":"and We bring","transliteration":"waji'nā","verse_key":"4:41"},{"pos":9,"ar":"بِكَ","en_gloss":"you","transliteration":"bika","verse_key":"4:41"},{"pos":10,"ar":"عَلَىٰ","en_gloss":"against","transliteration":"ʿalā","verse_key":"4:41"},{"pos":11,"ar":"هَـٰٓؤُلَآءِ","en_gloss":"these (people)","transliteration":"hāulāi","verse_key":"4:41"},{"pos":12,"ar":"شَهِيدًۭا","en_gloss":"(as) a witness","transliteration":"shahīdan","verse_key":"4:41"},{"pos":13,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"4:41"}]},{"verse_key":"4:42","surah":4,"ayah":42,"ar_uthmani":"يَوْمَئِذٍ يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ وَعَصَوُا۟ ٱلرَّسُولَ لَوْ تُسَوَّىٰ بِهِمُ ٱلْأَرْضُ وَلَا يَكْتُمُونَ ٱللَّهَ حَدِيثًا","en_translation_id":85,"en":"On that day, those who disbelieved and disobeyed the Prophet will wish that the earth could swallow them up: they will not be able to hide anything from God.","words":[{"pos":1,"ar":"يَوْمَئِذٍۢ","en_gloss":"(On) that Day","transliteration":"yawma-idhin","verse_key":"4:42"},{"pos":2,"ar":"يَوَدُّ","en_gloss":"will wish","transliteration":"yawaddu","verse_key":"4:42"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"4:42"},{"pos":4,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"4:42"},{"pos":5,"ar":"وَعَصَوُا۟","en_gloss":"and disobeyed","transliteration":"waʿaṣawū","verse_key":"4:42"},{"pos":6,"ar":"ٱلرَّسُولَ","en_gloss":"the Messenger","transliteration":"l-rasūla","verse_key":"4:42"},{"pos":7,"ar":"لَوْ","en_gloss":"if","transliteration":"law","verse_key":"4:42"},{"pos":8,"ar":"تُسَوَّىٰ","en_gloss":"was leveled","transliteration":"tusawwā","verse_key":"4:42"},{"pos":9,"ar":"بِهِمُ","en_gloss":"with them","transliteration":"bihimu","verse_key":"4:42"},{"pos":10,"ar":"ٱلْأَرْضُ","en_gloss":"the earth","transliteration":"l-arḍu","verse_key":"4:42"},{"pos":11,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"4:42"},{"pos":12,"ar":"يَكْتُمُونَ","en_gloss":"they will (be able to) hide","transliteration":"yaktumūna","verse_key":"4:42"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"(from) Allah","transliteration":"l-laha","verse_key":"4:42"},{"pos":14,"ar":"حَدِيثًۭا","en_gloss":"(any) statement","transliteration":"ḥadīthan","verse_key":"4:42"},{"pos":15,"ar":"٤٢","en_gloss":"(42)","transliteration":"","verse_key":"4:42"}]},{"verse_key":"4:43","surah":4,"ayah":43,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقْرَبُوا۟ ٱلصَّلَوٰةَ وَأَنتُمْ سُكَـٰرَىٰ حَتَّىٰ تَعْلَمُوا۟ مَا تَقُولُونَ وَلَا جُنُبًا إِلَّا عَابِرِى سَبِيلٍ حَتَّىٰ تَغْتَسِلُوا۟ ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَـٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءً فَتَيَمَّمُوا۟ صَعِيدًا طَيِّبًا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُمْ ۗ إِنَّ ٱللَّهَ كَانَ عَفُوًّا غَفُورًا","en_translation_id":85,"en":"You who believe, do not come anywhere near the prayer if you are intoxicated, not until you know what you are saying; nor if you are in a state of major ritual impurity- though you may pass through the mosque- not until you have bathed; if you are ill, on a journey, have relieved yourselves, or had intercourse, and cannot find any water, then find some clean sand and wipe your faces and hands with it. God is always ready to pardon and forgive.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"4:43"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"4:43"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"4:43"},{"pos":4,"ar":"لَا","en_gloss":"(Do) not","transliteration":"lā","verse_key":"4:43"},{"pos":5,"ar":"تَقْرَبُوا۟","en_gloss":"go near","transliteration":"taqrabū","verse_key":"4:43"},{"pos":6,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"4:43"},{"pos":7,"ar":"وَأَنتُمْ","en_gloss":"while you","transliteration":"wa-antum","verse_key":"4:43"},{"pos":8,"ar":"سُكَـٰرَىٰ","en_gloss":"(are) intoxicated","transliteration":"sukārā","verse_key":"4:43"},{"pos":9,"ar":"حَتَّىٰ","en_gloss":"until","transliteration":"ḥattā","verse_key":"4:43"},{"pos":10,"ar":"تَعْلَمُوا۟","en_gloss":"you know","transliteration":"taʿlamū","verse_key":"4:43"},{"pos":11,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"4:43"},{"pos":12,"ar":"تَقُولُونَ","en_gloss":"you are saying","transliteration":"taqūlūna","verse_key":"4:43"},{"pos":13,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"4:43"},{"pos":14,"ar":"جُنُبًا","en_gloss":"(when you are) impure","transliteration":"junuban","verse_key":"4:43"},{"pos":15,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"4:43"},{"pos":16,"ar":"عَابِرِى","en_gloss":"(when) passing","transliteration":"ʿābirī","verse_key":"4:43"},{"pos":17,"ar":"سَبِيلٍ","en_gloss":"(throug