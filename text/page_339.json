s":"All-Aware","transliteration":"khabīrun","verse_key":"22:63"},{"pos":16,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"22:63"}]},{"verse_key":"22:64","surah":22,"ayah":64,"ar_uthmani":"لَّهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۗ وَإِنَّ ٱللَّهَ لَهُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ","en_translation_id":85,"en":"everything in the heavens and earth belongs to Him; God alone is self-sufficient, worthy of all praise.","words":[{"pos":1,"ar":"لَّهُۥ","en_gloss":"For Him","transliteration":"lahu","verse_key":"22:64"},{"pos":2,"ar":"مَا","en_gloss":"(is) whatever","transliteration":"mā","verse_key":"22:64"},{"pos":3,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"22:64"},{"pos":4,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"22:64"},{"pos":5,"ar":"وَمَا","en_gloss":"and whatever","transliteration":"wamā","verse_key":"22:64"},{"pos":6,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"22:64"},{"pos":7,"ar":"ٱلْأَرْضِ ۗ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"22:64"},{"pos":8,"ar":"وَإِنَّ","en_gloss":"And indeed","transliteration":"wa-inna","verse_key":"22:64"},{"pos":9,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"22:64"},{"pos":10,"ar":"لَهُوَ","en_gloss":"surely, He","transliteration":"lahuwa","verse_key":"22:64"},{"pos":11,"ar":"ٱلْغَنِىُّ","en_gloss":"(is) Free of need","transliteration":"l-ghaniyu","verse_key":"22:64"},{"pos":12,"ar":"ٱلْحَمِيدُ","en_gloss":"the Praiseworthy","transliteration":"l-ḥamīdu","verse_key":"22:64"},{"pos":13,"ar":"٦٤","en_gloss":"(64)","transliteration":"","verse_key":"22:64"}]}]}