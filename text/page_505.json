َالِهَةًۢ ۖ بَلْ ضَلُّوا۟ عَنْهُمْ ۚ وَذَٰلِكَ إِفْكُهُمْ وَمَا كَانُوا۟ يَفْتَرُونَ","en_translation_id":85,"en":"so why did their gods not help them, those they set up as gods besides God to bring them nearer to Him? No indeed! They failed them utterly: it was all a lie of their own making.","words":[{"pos":1,"ar":"فَلَوْلَا","en_gloss":"Then why (did) not","transliteration":"falawlā","verse_key":"46:28"},{"pos":2,"ar":"نَصَرَهُمُ","en_gloss":"help them","transliteration":"naṣarahumu","verse_key":"46:28"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those whom","transliteration":"alladhīna","verse_key":"46:28"},{"pos":4,"ar":"ٱتَّخَذُوا۟","en_gloss":"they had taken","transliteration":"ittakhadhū","verse_key":"46:28"},{"pos":5,"ar":"مِن","en_gloss":"besides","transliteration":"min","verse_key":"46:28"},{"pos":6,"ar":"دُونِ","en_gloss":"besides","transliteration":"dūni","verse_key":"46:28"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"46:28"},{"pos":8,"ar":"قُرْبَانًا","en_gloss":"gods as a way of approach","transliteration":"qur'bānan","verse_key":"46:28"},{"pos":9,"ar":"ءَالِهَةًۢ ۖ","en_gloss":"gods as a way of approach","transliteration":"ālihatan","verse_key":"46:28"},{"pos":10,"ar":"بَلْ","en_gloss":"Nay","transliteration":"bal","verse_key":"46:28"},{"pos":11,"ar":"ضَلُّوا۟","en_gloss":"they were lost","transliteration":"ḍallū","verse_key":"46:28"},{"pos":12,"ar":"عَنْهُمْ ۚ","en_gloss":"from them","transliteration":"ʿanhum","verse_key":"46:28"},{"pos":13,"ar":"وَذَٰلِكَ","en_gloss":"And that","transliteration":"wadhālika","verse_key":"46:28"},{"pos":14,"ar":"إِفْكُهُمْ","en_gloss":"(was) their falsehood","transliteration":"if'kuhum","verse_key":"46:28"},{"pos":15,"ar":"وَمَا","en_gloss":"and what","transliteration":"wamā","verse_key":"46:28"},{"pos":16,"ar":"كَانُوا۟","en_gloss":"they were","transliteration":"kānū","verse_key":"46:28"},{"pos":17,"ar":"يَفْتَرُونَ","en_gloss":"inventing","transliteration":"yaftarūna","verse_key":