{"page":309,"verses":[{"verse_key":"19:52","surah":19,"ayah":52,"ar_uthmani":"وَنَـٰدَيْنَـٰهُ مِن جَانِبِ ٱلطُّورِ ٱلْأَيْمَنِ وَقَرَّبْنَـٰهُ نَجِيًّا","en_translation_id":85,"en":"We called to him from the right-hand side of the mountain and brought him close to Us in secret communion;","words":[{"pos":1,"ar":"وَنَـٰدَيْنَـٰهُ","en_gloss":"And We called him","transliteration":"wanādaynāhu","verse_key":"19:52"},{"pos":2,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"19:52"},{"pos":3,"ar":"جَانِبِ","en_gloss":"(the) side","transliteration":"jānibi","verse_key":"19:52"},{"pos":4,"ar":"ٱلطُّورِ","en_gloss":"(of) the Mount","transliteration":"l-ṭūri","verse_key":"19:52"},{"pos":5,"ar":"ٱلْأَيْمَنِ","en_gloss":"the right","transliteration":"l-aymani","verse_key":"19:52"},{"pos":6,"ar":"وَقَرَّبْنَـٰهُ","en_gloss":"and brought him near","transliteration":"waqarrabnāhu","verse_key":"19:52"},{"pos":7,"ar":"نَجِيًّۭا","en_gloss":"(for) conversation","transliteration":"najiyyan","verse_key":"19:52"},{"pos":8,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"19:52"}]},{"verse_key":"19:53","surah":19,"ayah":53,"ar_uthmani":"وَوَهَبْنَا لَهُۥ مِن رَّحْمَتِنَآ أَخَاهُ هَـٰرُونَ نَبِيًّا","en_translation_id":85,"en":"out of Our grace We granted him his brother Aaron as a prophet.","words":[{"pos":1,"ar":"وَوَهَبْنَا","en_gloss":"And We bestowed","transliteration":"wawahabnā","verse_key":"19:53"},{"pos":2,"ar":"لَهُۥ","en_gloss":"[to] him","transliteration":"lahu","verse_key":"19:53"},{"pos":3,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"19:53"},{"pos":4,"ar":"رَّحْمَتِنَآ","en_gloss":"Our Mercy","transliteration":"raḥmatinā","verse_key":"19:53"},{"pos":5,"ar":"أَخَاهُ","en_gloss":"his brother","transliteration":"akhāhu","verse_key":"19:53"},{"pos":6,"ar":"هَـٰرُونَ","en_gloss":"Harun","transliteration":"hārūna","verse_key":"19:53"},{"pos":7,"ar":"نَبِيًّۭا","en_gloss":"a Prophet","transliteration":"nabiyyan","verse_key":"19:5