{"page":262,"verses":[{"verse_key":"15:1","surah":15,"ayah":1,"ar_uthmani":" الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ وَقُرْءَانٍ مُّبِينٍ","en_translation_id":85,"en":"Alif Lam Ra These are the verses of the Scripture, a Quran that makes things clear.","words":[{"pos":1,"ar":"الٓر ۚ","en_gloss":"Alif Laam Ra","transliteration":"alif-lam-ra","verse_key":"15:1"},{"pos":2,"ar":"تِلْكَ","en_gloss":"These","transliteration":"til'ka","verse_key":"15:1"},{"pos":3,"ar":"ءَايَـٰتُ","en_gloss":"(are) the Verses","transliteration":"āyātu","verse_key":"15:1"},{"pos":4,"ar":"ٱلْكِتَـٰبِ","en_gloss":"(of) the Book","transliteration":"l-kitābi","verse_key":"15:1"},{"pos":5,"ar":"وَقُرْءَانٍۢ","en_gloss":"and Quran","transliteration":"waqur'ānin","verse_key":"15:1"},{"pos":6,"ar":"مُّبِينٍۢ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"15:1"},{"pos":7,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"15:1"}]},{"verse_key":"15:2","surah":15,"ayah":2,"ar_uthmani":"رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ","en_translation_id":85,"en":"The disbelievers may well come to wish they had submitted to God,","words":[{"pos":1,"ar":"رُّبَمَا","en_gloss":"Perhaps","transliteration":"rubamā","verse_key":"15:2"},{"pos":2,"ar":"يَوَدُّ","en_gloss":"will wish","transliteration":"yawaddu","verse_key":"15:2"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"15:2"},{"pos":4,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"15:2"},{"pos":5,"ar":"لَوْ","en_gloss":"if","transliteration":"law","verse_key":"15:2"},{"pos":6,"ar":"كَانُوا۟","en_gloss":"they had been","transliteration":"kānū","verse_key":"15:2"},{"pos":7,"ar":"مُسْلِمِينَ","en_gloss":"Muslims","transliteration":"mus'limīna","verse_key":"15:2"},{"pos":8,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"15:2"}]},{"verse_key":"15:3","surah":15,"ayah":3,"ar_uthmani":"ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْ