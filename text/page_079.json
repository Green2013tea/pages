َمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا ۚ وَذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ","en_translation_id":85,"en":"These are the bounds set by God: God will admit those who obey Him and His Messenger to Gardens graced with flowing streams, and there they will stay- that is the supreme triumph!","words":[{"pos":1,"ar":"تِلْكَ","en_gloss":"These","transliteration":"til'ka","verse_key":"4:13"},{"pos":2,"ar":"حُدُودُ","en_gloss":"(are the) limits","transliteration":"ḥudūdu","verse_key":"4:13"},{"pos":3,"ar":"ٱللَّهِ ۚ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"4:13"},{"pos":4,"ar":"وَمَن","en_gloss":"and whoever","transliteration":"waman","verse_key":"4:13"},{"pos":5,"ar":"يُطِعِ","en_gloss":"obeys","transliteration":"yuṭiʿi","verse_key":"4:13"},{"pos":6,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"4:13"},{"pos":7,"ar":"وَرَسُولَهُۥ","en_gloss":"and His Messenger","transliteration":"warasūlahu","verse_key":"4:13"},{"pos":8,"ar":"يُدْخِلْهُ","en_gloss":"He will admit him","transliteration":"yud'khil'hu","verse_key":"4:13"},{"pos":9,"ar":"جَنَّـٰتٍۢ","en_gloss":"(to) Gardens","transliteration":"jannātin","verse_key":"4:13"},{"pos":10,"ar":"تَجْرِى","en_gloss":"flows","transliteration":"tajrī","verse_key":"4:13"},{"pos":11,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"4:13"},{"pos":12,"ar":"تَحْتِهَا","en_gloss":"underneath them","transliteration":"taḥtihā","verse_key":"4:13"},{"pos":13,"ar":"ٱلْأَنْهَـٰرُ","en_gloss":"the rivers ","transliteration":"l-anhāru","verse_key":"4:13"},{"pos":14,"ar":"خَـٰلِدِينَ","en_gloss":"(will) abide forever","transliteration":"khālidīna","verse_key":"4:13"},{"pos":15,"ar":"فِيهَا ۚ","en_gloss":"in it","transliteration":"fīhā","verse_key":"4:13"},{"pos":16,"ar":"وَذَٰلِكَ","en_gloss":"And that","transliteration":"wadhālika","verse_key":"4:13"},{"pos":17,"ar":"ٱلْفَوْزُ","en_gloss":"(is) the success","transliteratio