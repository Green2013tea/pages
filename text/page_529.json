":"annī","verse_key":"54:10"},{"pos":4,"ar":"مَغْلُوبٌۭ","en_gloss":"one overpowered","transliteration":"maghlūbun","verse_key":"54:10"},{"pos":5,"ar":"فَٱنتَصِرْ","en_gloss":"so help","transliteration":"fa-intaṣir","verse_key":"54:10"},{"pos":6,"ar":"١٠","en_gloss":"(10)","transliteration":"","verse_key":"54:10"}]},{"verse_key":"54:11","surah":54,"ayah":11,"ar_uthmani":"فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍ مُّنْهَمِرٍ","en_translation_id":85,"en":"So We opened the gates of the sky with torrential water,","words":[{"pos":1,"ar":"فَفَتَحْنَآ","en_gloss":"So We opened","transliteration":"fafataḥnā","verse_key":"54:11"},{"pos":2,"ar":"أَبْوَٰبَ","en_gloss":"(the) gates","transliteration":"abwāba","verse_key":"54:11"},{"pos":3,"ar":"ٱلسَّمَآءِ","en_gloss":"(of) heaven","transliteration":"l-samāi","verse_key":"54:11"},{"pos":4,"ar":"بِمَآءٍۢ","en_gloss":"with water","transliteration":"bimāin","verse_key":"54:11"},{"pos":5,"ar":"مُّنْهَمِرٍۢ","en_gloss":"pouring down","transliteration":"mun'hamirin","verse_key":"54:11"},{"pos":6,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"54:11"}]},{"verse_key":"54:12","surah":54,"ayah":12,"ar_uthmani":"وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍ قَدْ قُدِرَ","en_translation_id":85,"en":"burst the earth with gushing springs: the waters met for a preordained purpose.","words":[{"pos":1,"ar":"وَفَجَّرْنَا","en_gloss":"And We caused to burst","transliteration":"wafajjarnā","verse_key":"54:12"},{"pos":2,"ar":"ٱلْأَرْضَ","en_gloss":"the earth","transliteration":"l-arḍa","verse_key":"54:12"},{"pos":3,"ar":"عُيُونًۭا","en_gloss":"(with) springs","transliteration":"ʿuyūnan","verse_key":"54:12"},{"pos":4,"ar":"فَٱلْتَقَى","en_gloss":"so met","transliteration":"fal-taqā","verse_key":"54:12"},{"pos":5,"ar":"ٱلْمَآءُ","en_gloss":"the water(s)","transliteration":"l-māu","verse_key":"54:12"},{"pos":6,"ar":"عَلَىٰٓ","en_gloss":"for","transliteration":"ʿalā","verse_key":"54:12"},{"pos":7,"ar":"أَمْرٍۢ"