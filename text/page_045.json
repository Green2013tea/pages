269"},{"pos":6,"ar":"يُؤْتَ","en_gloss":"is granted","transliteration":"yu'ta","verse_key":"2:269"},{"pos":7,"ar":"ٱلْحِكْمَةَ","en_gloss":"[the] wisdom","transliteration":"l-ḥik'mata","verse_key":"2:269"},{"pos":8,"ar":"فَقَدْ","en_gloss":"then certainly","transliteration":"faqad","verse_key":"2:269"},{"pos":9,"ar":"أُوتِىَ","en_gloss":"he is granted","transliteration":"ūtiya","verse_key":"2:269"},{"pos":10,"ar":"خَيْرًۭا","en_gloss":"good","transliteration":"khayran","verse_key":"2:269"},{"pos":11,"ar":"كَثِيرًۭا ۗ","en_gloss":"abundant","transliteration":"kathīran","verse_key":"2:269"},{"pos":12,"ar":"وَمَا","en_gloss":"And none","transliteration":"wamā","verse_key":"2:269"},{"pos":13,"ar":"يَذَّكَّرُ","en_gloss":"remembers","transliteration":"yadhakkaru","verse_key":"2:269"},{"pos":14,"ar":"إِلَّآ","en_gloss":"except","transliteration":"illā","verse_key":"2:269"},{"pos":15,"ar":"أُو۟لُوا۟","en_gloss":"those","transliteration":"ulū","verse_key":"2:269"},{"pos":16,"ar":"ٱلْأَلْبَـٰبِ","en_gloss":"(of) understanding","transliteration":"l-albābi","verse_key":"2:269"},{"pos":17,"ar":"٢٦٩","en_gloss":"(269)","transliteration":"","verse_key":"2:269"}]}]}