۟ فِيهِ ۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَنِىٌّ حَمِيدٌ","en_translation_id":85,"en":"You who believe, give charitably from the good things you have acquired and that We have produced for you from the earth. Do not give away the bad things that you yourself would only accept with your eyes closed: remember that God is self-sufficient, worthy of all praise.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"2:267"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"2:267"},{"pos":3,"ar":"ءَامَنُوٓا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"2:267"},{"pos":4,"ar":"أَنفِقُوا۟","en_gloss":"Spend","transliteration":"anfiqū","verse_key":"2:267"},{"pos":5,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"2:267"},{"pos":6,"ar":"طَيِّبَـٰتِ","en_gloss":"(the) good things","transliteration":"ṭayyibāti","verse_key":"2:267"},{"pos":7,"ar":"مَا","en_gloss":"that","transliteration":"mā","verse_key":"2:267"},{"pos":8,"ar":"كَسَبْتُمْ","en_gloss":"you have earned","transliteration":"kasabtum","verse_key":"2:267"},{"pos":9,"ar":"وَمِمَّآ","en_gloss":"and whatever","transliteration":"wamimmā","verse_key":"2:267"},{"pos":10,"ar":"أَخْرَجْنَا","en_gloss":"We brought forth","transliteration":"akhrajnā","verse_key":"2:267"},{"pos":11,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"2:267"},{"pos":12,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"2:267"},{"pos":13,"ar":"ٱلْأَرْضِ ۖ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"2:267"},{"pos":14,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"2:267"},{"pos":15,"ar":"تَيَمَّمُوا۟","en_gloss":"aim (at)","transliteration":"tayammamū","verse_key":"2:267"},{"pos":16,"ar":"ٱلْخَبِيثَ","en_gloss":"the bad","transliteration":"l-khabītha","verse_key":"2:267"},{"pos":17,"ar":"مِنْهُ","en_gloss":"of it","transliteration":"min'hu","verse_ke