iteration":"dhahaba","verse_key":"11:74"},{"pos":3,"ar":"عَنْ","en_gloss":"from","transliteration":"ʿan","verse_key":"11:74"},{"pos":4,"ar":"إِبْرَٰهِيمَ","en_gloss":"Ibrahim","transliteration":"ib'rāhīma","verse_key":"11:74"},{"pos":5,"ar":"ٱلرَّوْعُ","en_gloss":"the fright","transliteration":"l-rawʿu","verse_key":"11:74"},{"pos":6,"ar":"وَجَآءَتْهُ","en_gloss":"and had reached him","transliteration":"wajāathu","verse_key":"11:74"},{"pos":7,"ar":"ٱلْبُشْرَىٰ","en_gloss":"the glad tidings","transliteration":"l-bush'rā","verse_key":"11:74"},{"pos":8,"ar":"يُجَـٰدِلُنَا","en_gloss":"he argued with Us","transliteration":"yujādilunā","verse_key":"11:74"},{"pos":9,"ar":"فِى","en_gloss":"concerning","transliteration":"fī","verse_key":"11:74"},{"pos":10,"ar":"قَوْمِ","en_gloss":"the people","transliteration":"qawmi","verse_key":"11:74"},{"pos":11,"ar":"لُوطٍ","en_gloss":"of Lut","transliteration":"lūṭin","verse_key":"11:74"},{"pos":12,"ar":"٧٤","en_gloss":"(74)","transliteration":"","verse_key":"11:74"}]},{"verse_key":"11:75","surah":11,"ayah":75,"ar_uthmani":"إِنَّ إِبْرَٰهِيمَ لَحَلِيمٌ أَوَّٰهٌ مُّنِيبٌ","en_translation_id":85,"en":"for Abraham was forbearing, tender-hearted, and devout.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"11:75"},{"pos":2,"ar":"إِبْرَٰهِيمَ","en_gloss":"Ibrahim","transliteration":"ib'rāhīma","verse_key":"11:75"},{"pos":3,"ar":"لَحَلِيمٌ","en_gloss":"(was) certainly forbearing","transliteration":"laḥalīmun","verse_key":"11:75"},{"pos":4,"ar":"أَوَّٰهٌۭ","en_gloss":"imploring","transliteration":"awwāhun","verse_key":"11:75"},{"pos":5,"ar":"مُّنِيبٌۭ","en_gloss":"and oft-returning","transliteration":"munībun","verse_key":"11:75"},{"pos":6,"ar":"٧٥","en_gloss":"(75)","transliteration":"","verse_key":"11:75"}]},{"verse_key":"11:76","surah":11,"ayah":76,"ar_uthmani":"يَـٰٓإِبْرَٰهِيمُ أَعْرِضْ عَنْ هَـٰذَآ ۖ إِنَّهُۥ قَدْ جَآءَ أَمْرُ رَبِّكَ ۖ وَإِنَّهُمْ ءَاتِيهِمْ عَذَابٌ غَيْرُ مَرْدُودٍ","en_translation_id":85,"en":"‘Abraham, cease your pleading: what your Lord has ordained has come about; punishment is coming to them, which cannot be turned back.’","words":[{"pos":1,"ar":"يَـٰٓإِبْرَٰهِيمُ","en_gloss":"O Ibrahim","transliteration":"yāib'rāhīmu","verse_key":"11:76"},{"pos":2,"ar":"أَعْرِضْ","en_gloss":"Turn away","transliteration":"aʿriḍ","verse_key":"11:76"},{"pos":3,"ar":"عَنْ","en_gloss":"from","transliteration":"ʿan","verse_key":"11:76"},{"pos":4,"ar":"هَـٰذَآ ۖ","en_gloss":"this","transliteration":"hādhā","verse_key":"11:76"},{"pos":5,"ar":"إِنَّهُۥ","en_gloss":"Indeed, it","transliteration":"innahu","verse_key":"11:76"},{"pos":6,"ar":"قَدْ","en_gloss":"certainly","transliteration":"qad","verse_key":"11:76"},{"pos":7,"ar":"جَآءَ","en_gloss":"has come","transliteration":"jāa","verse_key":"11:76"},{"pos":8,"ar":"أَمْرُ","en_gloss":"(the) Command","transliteration":"amru","verse_key":"11:76"},{"pos":9,"ar":"رَبِّكَ ۖ","en_gloss":"(of) your Lord","transliteration":"rabbika","verse_key":"11:76"},{"pos":10,"ar":"وَإِنَّهُمْ","en_gloss":"and indeed, [they]","transliteration":"wa-innahum","verse_key":"11:76"},{"pos":11,"ar":"ءَاتِيهِمْ","en_gloss":"(will) come (for) them","transliteration":"ātīhim","verse_key":"11:76"},{"pos":12,"ar":"عَذَابٌ","en_gloss":"a punishment","transliteration":"ʿadhābun","verse_key":"11:76"},{"pos":13,"ar":"غَيْرُ","en_gloss":"(which) cannot","transliteration":"ghayru","verse_key":"11:76"},{"pos":14,"ar":"مَرْدُودٍۢ","en_gloss":"(be) repelled","transliteration":"mardūdin","verse_key":"11:76"},{"pos":15,"ar":"٧٦","en_gloss":"(76)","transliteration":"","verse_key":"11:76"}]},{"verse_key":"11:77","surah":11,"ayah":77,"ar_uthmani":"وَلَمَّا جَآءَتْ رُسُلُنَا لُوطًا سِىٓءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعًا وَقَالَ هَـٰذَا يَوْمٌ عَصِيبٌ","en_translation_id":85,"en":"And when Our messengers came to Lot, he was anxious for them, feeling powerless to protect them, and said, ‘This is a truly terrible day!’","words":[{"pos":1,"ar":"وَلَمَّا","en_gloss":"And when","transliteration":"walammā","verse_key":"11:77"},{"pos":2,"ar":"جَآءَتْ","en_gloss":"came","transliteration":"jāat","verse_key":"11:77"},{"pos":3,"ar":"رُسُلُنَا","en_gloss":"Our messengers","transliteration":"rusulunā","verse_key":"11:77"},{"pos":4,"ar":"لُوطًۭا","en_gloss":"(to) Lut","transliteration":"lūṭan","verse_key":"11:77"},{"pos":5,"ar":"سِىٓءَ","en_gloss":"he was distressed","transliteration":"sīa","verse_key":"11:77"},{"pos":6,"ar":"بِهِمْ","en_gloss":"for them","transliteration":"bihim","verse_key":"11:77"},{"pos":7,"ar":"وَضَاقَ","en_gloss":"and felt straitened","transliteration":"waḍāqa","verse_key":"11:77"},{"pos":8,"ar":"بِهِمْ","en_gloss":"for them","transliteration":"bihim","verse_key":"11:77"},{"pos":9,"ar":"ذَرْعًۭا","en_gloss":"(and) uneasy","transliteration":"dharʿan","verse_key":"11:77"},{"pos":10,"ar":"وَقَالَ","en_gloss":"and said","transliteration":"waqāla","verse_key":"11:77"},{"pos":11,"ar":"هَـٰذَا","en_gloss":"This","transliteration":"hādhā","verse_key":"11:77"},{"pos":12,"ar":"يَوْمٌ","en_gloss":"(is) a day","transliteration":"yawmun","verse_key":"11:77"},{"pos":13,"ar":"عَصِيبٌۭ","en_gloss":"distressful","transliteration":"ʿaṣībun","verse_key":"11:77"},{"pos":14,"ar":"٧٧","en_gloss":"(77)","transliteration":"","verse_key":"11:77"}]},{"verse_key":"11:78","surah":11,"ayah":78,"ar_uthmani":"وَجَآءَهُۥ قَوْمُهُۥ يُهْرَعُونَ إِلَيْهِ وَمِن قَبْلُ كَانُوا۟ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ ۚ قَالَ يَـٰقَوْمِ هَـٰٓؤُلَآءِ بَنَاتِى هُنَّ أَطْهَرُ لَكُمْ ۖ فَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ فِى ضَيْفِىٓ ۖ أَلَيْسَ مِنكُمْ رَجُلٌ رَّشِيدٌ","en_translation_id":85,"en":"His people came rushing towards him; they used to commit foul deeds. He said, ‘My people, here are my daughters.They are more wholesome for you, so have some fear of God and do not disgrace me with my guests. Is there not a single right-minded man among you?’","words":[{"pos":1,"ar":"وَجَآءَهُۥ","en_gloss":"And came (to) him","transliteration":"wajāahu","verse_key":"11:78"},{"pos":2,"ar":"قَوْمُهُۥ","en_gloss":"his people","transliteration":"qawmuhu","verse_key":"11:78"},{"pos":3,"ar":"يُهْرَعُونَ","en_gloss":"rushing","transliteration":"yuh'raʿūna","verse_key":"11:78"},{"pos":4,"ar":"إِلَيْهِ","en_gloss":"to him","transliteration":"ilayhi","verse_key":"11:78"},{"pos":5,"ar":"وَمِن","en_gloss":"and before","transliteration":"wamin","verse_key":"11:78"},{"pos":6,"ar":"قَبْلُ","en_gloss":"and before","transliteration":"qablu","verse_key":"11:78"},{"pos":7,"ar":"كَانُوا۟","en_gloss":"they (had) been","transliteration":"kānū","verse_key":"11:78"},{"pos":8,"ar":"يَعْمَلُونَ","en_gloss":"doing","transliteration":"yaʿmalūna","verse_key":"11:78"},{"pos":9,"ar":"ٱلسَّيِّـَٔاتِ ۚ","en_gloss":"the evil deeds","transliteration":"l-sayiāti","verse_key":"11:78"},{"pos":10,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"11:78"},{"pos":11,"ar":"يَـٰقَوْمِ","en_gloss":"O my people","transliteration":"yāqawmi","verse_key":"11:78"},{"pos":12,"ar":"هَـٰٓؤُلَآءِ","en_gloss":"These","transliteration":"hāulāi","verse_key":"11:78"},{"pos":13,"ar":"بَنَاتِى","en_gloss":"(are) my daughters","transliteration":"banātī","verse_key":"11:78"},{"pos":14,"ar":"هُنَّ","en_gloss":"they","transliteration":"hunna","verse_key":"11:78"},{"pos":15,"ar":"أَطْهَرُ","en_gloss":"(are) purer","transliteration":"aṭharu","verse_key":"11:78"},{"pos":16,"ar":"لَكُمْ ۖ","en_gloss":"for you","transliteration":"lakum","verse_key":"11:78"},{"pos":17,"ar":"فَٱتَّقُوا۟","en_gloss":"So fear","transliteration":"fa-ittaqū","verse_key":"11:78"},{"pos":18,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"11:78"},{"pos":19,"ar":"وَلَا","en_gloss":"and (do) not","transliteration":"walā","verse_key":"11:78"},{"pos":20,"ar":"تُخْزُونِ","en_gloss":"disgrace me","transliteration":"tukh'zūni","verse_key":"11:78"},{"pos":21,"ar":"فِى","en_gloss":"concerning","transliteration":"fī","verse_key":"11:78"},{"pos":22,"ar":"ضَيْفِىٓ ۖ","en_gloss":"my