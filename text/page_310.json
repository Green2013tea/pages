loss":"(67)","transliteration":"","verse_key":"19:67"}]},{"verse_key":"19:68","surah":19,"ayah":68,"ar_uthmani":"فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَٱلشَّيَـٰطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ جَهَنَّمَ جِثِيًّا","en_translation_id":85,"en":"By your Lord [Prophet] We shall gather them and the devils together and set them on their knees around Hell;","words":[{"pos":1,"ar":"فَوَرَبِّكَ","en_gloss":"So by your Lord","transliteration":"fawarabbika","verse_key":"19:68"},{"pos":2,"ar":"لَنَحْشُرَنَّهُمْ","en_gloss":"surely, We will gather them","transliteration":"lanaḥshurannahum","verse_key":"19:68"},{"pos":3,"ar":"وَٱلشَّيَـٰطِينَ","en_gloss":"and the devils","transliteration":"wal-shayāṭīna","verse_key":"19:68"},{"pos":4,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"19:68"},{"pos":5,"ar":"لَنُحْضِرَنَّهُمْ","en_gloss":"surely, We will bring them","transliteration":"lanuḥ'ḍirannahum","verse_key":"19:68"},{"pos":6,"ar":"حَوْلَ","en_gloss":"around","transliteration":"ḥawla","verse_key":"19:68"},{"pos":7,"ar":"جَهَنَّمَ","en_gloss":"Hell","transliteration":"jahannama","verse_key":"19:68"},{"pos":8,"ar":"جِثِيًّۭا","en_gloss":"bent (on) knees","transliteration":"jithiyyan","verse_key":"19:68"},{"pos":9,"ar":"٦٨","en_gloss":"(68)","transliteration":"","verse_key":"19:68"}]},{"verse_key":"19:69","surah":19,"ayah":69,"ar_uthmani":"ثُمَّ لَنَنزِعَنَّ مِن كُلِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى ٱلرَّحْمَـٰنِ عِتِيًّا","en_translation_id":85,"en":"We shall seize out of each group those who were most disobedient towards the Lord of Mercy-","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"19:69"},{"pos":2,"ar":"لَنَنزِعَنَّ","en_gloss":"surely, We will drag out","transliteration":"lananziʿanna","verse_key":"19:69"},{"pos":3,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"19:69"},{"pos":4,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"19:69"},{"pos":5,"ar":"شِيعَةٍ","en_gloss":"sect","transliteration":"shīʿatin","verse_key":"19:69"},{"pos":6,"ar":"أَيُّهُمْ","en_gloss":"those of them","transliteration":"ayyuhum","verse_key":"19:69"},{"pos":7,"ar":"أَشَدُّ","en_gloss":"(who were) worst","transliteration":"ashaddu","verse_key":"19:69"},{"pos":8,"ar":"عَلَى","en_gloss":"against","transliteration":"ʿalā","verse_key":"19:69"},{"pos":9,"ar":"ٱلرَّحْمَـٰنِ","en_gloss":"the Most Gracious","transliteration":"l-raḥmāni","verse_key":"19:69"},{"pos":10,"ar":"عِتِيًّۭا","en_gloss":"(in) rebellion","transliteration":"ʿitiyyan","verse_key":"19:69"},{"pos":11,"ar":"٦٩","en_gloss":"(69)","transliteration":"","verse_key":"19:69"}]},{"verse_key":"19:70","surah":19,"ayah":70,"ar_uthmani":"ثُمَّ لَنَحْنُ أَعْلَمُ بِٱلَّذِينَ هُمْ أَوْلَىٰ بِهَا صِلِيًّا","en_translation_id":85,"en":"We know best who most deserves to burn in Hell-","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"19:70"},{"pos":2,"ar":"لَنَحْنُ","en_gloss":"surely, We","transliteration":"lanaḥnu","verse_key":"19:70"},{"pos":3,"ar":"أَعْلَمُ","en_gloss":"know best","transliteration":"aʿlamu","verse_key":"19:70"},{"pos":4,"ar":"بِٱلَّذِينَ","en_gloss":"[of] those who","transliteration":"bi-alladhīna","verse_key":"19:70"},{"pos":5,"ar":"هُمْ","en_gloss":"[they]","transliteration":"hum","verse_key":"19:70"},{"pos":6,"ar":"أَوْلَىٰ","en_gloss":"(are) most worthy","transliteration":"awlā","verse_key":"19:70"},{"pos":7,"ar":"بِهَا","en_gloss":"therein","transliteration":"bihā","verse_key":"19:70"},{"pos":8,"ar":"صِلِيًّۭا","en_gloss":"(of) being burnt","transliteration":"ṣiliyyan","verse_key":"19:70"},{"pos":9,"ar":"٧٠","en_gloss":"(70)","transliteration":"","verse_key":"19:70"}]},{"verse_key":"19:71","surah":19,"ayah":71,"ar_uthmani":"وَإِن مِّنكُمْ إِلَّا وَارِدُهَا ۚ كَانَ عَلَىٰ رَبِّكَ حَتْمًا مَّقْضِيًّا","en_translation_id":85,"en":"but every single one of you will approach it, a decree from your Lord which must be fulfilled.","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And (there is) not","transliteration":"wa-in","verse_key":"19:71"},{"pos":2,"ar":"مِّنكُمْ","en_gloss":"(any) of you","transliteration":"minkum","verse_key":"19:71"},{"pos":3,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"19:71"},{"pos":4,"ar":"وَارِدُهَا ۚ","en_gloss":"(will be) passing over it","transliteration":"wāriduhā","verse_key":"19:71"},{"pos":5,"ar":"كَانَ","en_gloss":"(This) is","transliteration":"kāna","verse_key":"19:71"},{"pos":6,"ar":"عَلَىٰ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"19:71"},{"pos":7,"ar":"رَبِّكَ","en_gloss":"your Lord","transliteration":"rabbika","verse_key":"19:71"},{"pos":8,"ar":"حَتْمًۭا","en_gloss":"an inevitability","transliteration":"ḥatman","verse_key":"19:71"},{"pos":9,"ar":"مَّقْضِيًّۭا","en_gloss":"decreed","transliteration":"maqḍiyyan","verse_key":"19:71"},{"pos":10,"ar":"٧١","en_gloss":"(71)","transliteration":"","verse_key":"19:71"}]},{"verse_key":"19:72","surah":19,"ayah":72,"ar_uthmani":"ثُمَّ نُنَجِّى ٱلَّذِينَ ٱتَّقَوا۟ وَّنَذَرُ ٱلظَّـٰلِمِينَ فِيهَا جِثِيًّا","en_translation_id":85,"en":"We shall save the devout and leave the evildoers there on their knees.","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"19:72"},{"pos":2,"ar":"نُنَجِّى","en_gloss":"We will deliver","transliteration":"nunajjī","verse_key":"19:72"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"19:72"},{"pos":4,"ar":"ٱتَّقَوا۟","en_gloss":"feared (Allah)","transliteration":"ittaqaw","verse_key":"19:72"},{"pos":5,"ar":"وَّنَذَرُ","en_gloss":"and We will leave","transliteration":"wanadharu","verse_key":"19:72"},{"pos":6,"ar":"ٱلظَّـٰلِمِينَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimīna","verse_key":"19:72"},{"pos":7,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"19:72"},{"pos":8,"ar":"جِثِيًّۭا","en_gloss":"bent (on) knees","transliteration":"jithiyyan","verse_key":"19:72"},{"pos":9,"ar":"٧٢","en_gloss":"(72)","transliteration":"","verse_key":"19:72"}]},{"verse_key":"19:73","surah":19,"ayah":73,"ar_uthmani":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍ قَالَ ٱلَّذِينَ كَفَرُوا۟ لِلَّذِينَ ءَامَنُوٓا۟ أَىُّ ٱلْفَرِيقَيْنِ خَيْرٌ مَّقَامًا وَأَحْسَنُ نَدِيًّا","en_translation_id":85,"en":"When Our revelations are recited to them in all their clarity, [all that] the disbelievers say to the believers [is], ‘Which side is better situated? Which side has the better following?’","words":[{"pos":1,"ar":"وَإِذَا","en_gloss":"And when","transliteration":"wa-idhā","verse_key":"19:73"},{"pos":2,"ar":"تُتْلَىٰ","en_gloss":"are recited","transliteration":"tut'lā","verse_key":"19:73"},{"pos":3,"ar":"عَلَيْهِمْ","en_gloss":"to them","transliteration":"ʿalayhim","verse_key":"19:73"},{"pos":4,"ar":"ءَايَـٰتُنَا","en_gloss":"Our Verses","transliteration":"āyātunā","verse_key":"19:73"},{"pos":5,"ar":"بَيِّنَـٰتٍۢ","en_gloss":"clear","transliteration":"bayyinātin","verse_key":"19:73"},{"pos":6,"ar":"قَالَ","en_gloss":"say","transliteration":"qāla","verse_key":"19:73"},{"pos":7,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"19:73"},{"pos":8,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"19:73"},{"pos":9,"ar":"لِلَّذِينَ","en_gloss":"to those who","transliteration":"lilladhīna","verse_key":"19:73"},{"pos":10,"ar":"ءَامَنُوٓا۟","en_gloss":"believed","transliteration":"āmanū","verse_key":"19:73"},{"pos":11,"ar":"أَىُّ","en_gloss":"Which","transliteration":"ayyu","verse_key":"19:73"},{"pos":12,"ar":"ٱلْفَرِيقَيْنِ","en_gloss":"(of) the two groups","transliteration":"l-farīqayni","verse_key":"19:73"},{"pos":13,"ar":"خَيْرٌۭ","en_gloss":"(is) better","transliteration":"khayrun","verse_key":"19:73"},{"pos":14,"ar":"مَّقَامًۭا","en_gloss":"(in) position","transliteration":"maqāman","verse_key":"19:73"},{"pos":15,"ar":"وَأَحْسَنُ","en_gloss":"and best","transliteration":"wa-aḥsanu","verse_key"