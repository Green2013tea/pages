":"16:37"},{"pos":5,"ar":"فَإِنَّ","en_gloss":"then indeed","transliteration":"fa-inna","verse_key":"16:37"},{"pos":6,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"16:37"},{"pos":7,"ar":"لَا","en_gloss":"(will) not","transliteration":"lā","verse_key":"16:37"},{"pos":8,"ar":"يَهْدِى","en_gloss":"guide","transliteration":"yahdī","verse_key":"16:37"},{"pos":9,"ar":"مَن","en_gloss":"whom","transliteration":"man","verse_key":"16:37"},{"pos":10,"ar":"يُضِلُّ ۖ","en_gloss":"He lets go astray","transliteration":"yuḍillu","verse_key":"16:37"},{"pos":11,"ar":"وَمَا","en_gloss":"and not (are)","transliteration":"wamā","verse_key":"16:37"},{"pos":12,"ar":"لَهُم","en_gloss":"for them","transliteration":"lahum","verse_key":"16:37"},{"pos":13,"ar":"مِّن","en_gloss":"any","transliteration":"min","verse_key":"16:37"},{"pos":14,"ar":"نَّـٰصِرِينَ","en_gloss":"helpers","transliteration":"nāṣirīna","verse_key":"16:37"},{"pos":15,"ar":"٣٧","en_gloss":"(37)","transliteration":"","verse_key":"16:37"}]},{"verse_key":"16:38","surah":16,"ayah":38,"ar_uthmani":"وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَـٰنِهِمْ ۙ لَا يَبْعَثُ ٱللَّهُ مَن يَمُوتُ ۚ بَلَىٰ وَعْدًا عَلَيْهِ حَقًّا وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ","en_translation_id":85,"en":"They have sworn by God with their strongest oaths that He will not raise the dead to life. But He will- it is His binding promise, though most people do not realize it-","words":[{"pos":1,"ar":"وَأَقْسَمُوا۟","en_gloss":"And they swear","transliteration":"wa-aqsamū","verse_key":"16:38"},{"pos":2,"ar":"بِٱللَّهِ","en_gloss":"by Allah","transliteration":"bil-lahi","verse_key":"16:38"},{"pos":3,"ar":"جَهْدَ","en_gloss":"strongest","transliteration":"jahda","verse_key":"16:38"},{"pos":4,"ar":"أَيْمَـٰنِهِمْ ۙ","en_gloss":"(of) their oaths","transliteration":"aymānihim","verse_key":"16:38"},{"pos":5,"ar":"لَا","en_gloss":"Allah will not resurrect","transliteration":"lā","verse_key":"16:38"},{"pos":6,"ar":"يَبْعَثُ","en_gloss":"Allah will not resurrect","transliteration":"yabʿathu","verse_key":"16:38"},{"pos":7,"ar":"ٱللَّهُ","en_gloss":"Allah will not resurrect","transliteration":"l-lahu","verse_key":"16:38"},{"pos":8,"ar":"مَن","en_gloss":"(one) who","transliteration":"man","verse_key":"16:38"},{"pos":9,"ar":"يَمُوتُ ۚ","en_gloss":"dies","transliteration":"yamūtu","verse_key":"16:38"},{"pos":10,"ar":"بَلَىٰ","en_gloss":"Nay","transliteration":"balā","verse_key":"16:38"},{"pos":11,"ar":"وَعْدًا","en_gloss":"(it is) a promise","transliteration":"waʿdan","verse_key":"16:38"},{"pos":12,"ar":"عَلَيْهِ","en_gloss":"upon Him","transliteration":"ʿalayhi","verse_key":"16:38"},{"pos":13,"ar":"حَقًّۭا","en_gloss":"(in) truth","transliteration":"ḥaqqan","verse_key":"16:38"},{"pos":14,"ar":"وَلَـٰكِنَّ","en_gloss":"but","transliteration":"walākinna","verse_key":"16:38"},{"pos":15,"ar":"أَكْثَرَ","en_gloss":"most","transliteration":"akthara","verse_key":"16:38"},{"pos":16,"ar":"ٱلنَّاسِ","en_gloss":"(of) the mankind","transliteration":"l-nāsi","verse_key":"16:38"},{"pos":17,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"16:38"},{"pos":18,"ar":"يَعْلَمُونَ","en_gloss":"know","transliteration":"yaʿlamūna","verse_key":"16:38"},{"pos":19,"ar":"٣٨","en_gloss":"(38)","transliteration":"","verse_key":"16:38"}]},{"verse_key":"16:39","surah":16,"ayah":39,"ar_uthmani":"لِيُبَيِّنَ لَهُمُ ٱلَّذِى يَخْتَلِفُونَ فِيهِ وَلِيَعْلَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّهُمْ كَانُوا۟ كَـٰذِبِينَ","en_translation_id":85,"en":"in order to make clear for them what they have differed about and so that the disbelievers may realize that what they said was false.","words":[{"pos":1,"ar":"لِيُبَيِّنَ","en_gloss":"That He will make clear","transliteration":"liyubayyina","verse_key":"16:39"},{"pos":2,"ar":"لَهُمُ","en_gloss":"to them","transliteration":"lahumu","verse_key":"16:39"},{"pos":3,"ar":"ٱلَّذِى","en_gloss":"that","transliteration":"alladhī","verse_key":"16:39"},{"pos":4,"ar":"يَخْتَلِفُونَ","en_gloss":"they differ","transliteration":"yakhtalifūna","verse_key":"16:39"},{"pos":5,"ar":"فِيهِ","en_gloss":"wherein","transliteration":"fīhi","verse_key":"16:39"},{"pos":6,"ar":"وَلِيَعْلَمَ","en_gloss":"and that may know","transliteration":"waliyaʿlama","verse_key":"16:39"},{"pos":7,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"16:39"},{"pos":8,"ar":"كَفَرُوٓا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"16:39"},{"pos":9,"ar":"أَنَّهُمْ","en_gloss":"that they","transliteration":"annahum","verse_key":"16:39"},{"pos":10,"ar":"كَانُوا۟","en_gloss":"were","transliteration":"kānū","verse_key":"16:39"},{"pos":11,"ar":"كَـٰذِبِينَ","en_gloss":"liars","transliteration":"kādhibīna","verse_key":"16:39"},{"pos":12,"ar":"٣٩","en_gloss":"(39)","transliteration":"","verse_key":"16:39"}]},{"verse_key":"16:40","surah":16,"ayah":40,"ar_uthmani":"إِنَّمَا قَوْلُنَا لِشَىْءٍ إِذَآ أَرَدْنَـٰهُ أَن نَّقُولَ لَهُۥ كُن فَيَكُونُ","en_translation_id":85,"en":"When We will something to happen, all that We say is, ‘Be,’ and it is.","words":[{"pos":1,"ar":"إِنَّمَا","en_gloss":"Only","transliteration":"innamā","verse_key":"16:40"},{"pos":2,"ar":"قَوْلُنَا","en_gloss":"Our Word","transliteration":"qawlunā","verse_key":"16:40"},{"pos":3,"ar":"لِشَىْءٍ","en_gloss":"to a thing","transliteration":"lishayin","verse_key":"16:40"},{"pos":4,"ar":"إِذَآ","en_gloss":"when","transliteration":"idhā","verse_key":"16:40"},{"pos":5,"ar":"أَرَدْنَـٰهُ","en_gloss":"We intend it","transliteration":"aradnāhu","verse_key":"16:40"},{"pos":6,"ar":"أَن","en_gloss":"(is) that","transliteration":"an","verse_key":"16:40"},{"pos":7,"ar":"نَّقُولَ","en_gloss":"We say","transliteration":"naqūla","verse_key":"16:40"},{"pos":8,"ar":"لَهُۥ","en_gloss":"to it","transliteration":"lahu","verse_key":"16:40"},{"pos":9,"ar":"كُن","en_gloss":"Be","transliteration":"kun","verse_key":"16:40"},{"pos":10,"ar":"فَيَكُونُ","en_gloss":"and it is","transliteration":"fayakūnu","verse_key":"16:40"},{"pos":11,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"16:40"}]},{"verse_key":"16:41","surah":16,"ayah":41,"ar_uthmani":"وَٱلَّذِينَ هَاجَرُوا۟ فِى ٱللَّهِ مِنۢ بَعْدِ مَا ظُلِمُوا۟ لَنُبَوِّئَنَّهُمْ فِى ٱلدُّنْيَا حَسَنَةً ۖ وَلَأَجْرُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ","en_translation_id":85,"en":"As for those who emi-grated in God’s cause after being wronged, We shall give them a good home in this world, but the reward of the Hereafter will be far greater, if they only knew it.","words":[{"pos":1,"ar":"وَٱلَّذِينَ","en_gloss":"And those who","transliteration":"wa-alladhīna","verse_key":"16:41"},{"pos":2,"ar":"هَاجَرُوا۟","en_gloss":"emigrated","transliteration":"hājarū","verse_key":"16:41"},{"pos":3,"ar":"فِى","en_gloss":"in (the way)","transliteration":"fī","verse_key":"16:41"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"16:41"},{"pos":5,"ar":"مِنۢ","en_gloss":"after","transliteration":"min","verse_key":"16:41"},{"pos":6,"ar":"بَعْدِ","en_gloss":"after","transliteration":"baʿdi","verse_key":"16:41"},{"pos":7,"ar":"مَا","en_gloss":"[what]","transliteration":"mā","verse_key":"16:41"},{"pos":8,"ar":"ظُلِمُوا۟","en_gloss":"they were wronged","transliteration":"ẓulimū","verse_key":"16:41"},{"pos":9,"ar":"لَنُبَوِّئَنَّهُمْ","en_gloss":"surely We will give them position","transliteration":"lanubawwi-annahum","verse_key":"16:41"},{"pos":10,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"16:41"},{"pos":11,"ar":"ٱلدُّنْيَا","en_gloss":"the world","transliteration":"l-dun'yā","verse_key":"16:41"},{"pos":12,"ar":"حَسَنَةًۭ ۖ","en_gloss":"good","transliteration":"ḥasanatan","verse_key":"16:41"},{"pos":13,"ar":"وَلَأَجْرُ","en_gloss":"but surely the reward","transliteration":"wala-ajru","verse_key":"16:41"},{"pos":14,"ar":"ٱلْـَٔاخِرَةِ","en_gloss":"(of) the Hereafter","transliteration":"l-ākhirati","verse_key":"16:41"},{"pos":15,"ar":"أَكْبَرُ ۚ","en_gloss":"(is) greater