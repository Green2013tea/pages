{"page":465,"verses":[{"verse_key":"39:57","surah":39,"ayah":57,"ar_uthmani":"أَوْ تَقُولَ لَوْ أَنَّ ٱللَّهَ هَدَىٰنِى لَكُنتُ مِنَ ٱلْمُتَّقِينَ","en_translation_id":85,"en":"Or it says, “If God had guided me, I would have joined the righteous!”","words":[{"pos":1,"ar":"أَوْ","en_gloss":"Or","transliteration":"aw","verse_key":"39:57"},{"pos":2,"ar":"تَقُولَ","en_gloss":"it should say","transliteration":"taqūla","verse_key":"39:57"},{"pos":3,"ar":"لَوْ","en_gloss":"If that","transliteration":"law","verse_key":"39:57"},{"pos":4,"ar":"أَنَّ","en_gloss":"If that","transliteration":"anna","verse_key":"39:57"},{"pos":5,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"39:57"},{"pos":6,"ar":"هَدَىٰنِى","en_gloss":"(had) guided me","transliteration":"hadānī","verse_key":"39:57"},{"pos":7,"ar":"لَكُنتُ","en_gloss":"surely, I (would) have been","transliteration":"lakuntu","verse_key":"39:57"},{"pos":8,"ar":"مِنَ","en_gloss":"among","transliteration":"mina","verse_key":"39:57"},{"pos":9,"ar":"ٱلْمُتَّقِينَ","en_gloss":"the righteous","transliteration":"l-mutaqīna","verse_key":"39:57"},{"pos":10,"ar":"٥٧","en_gloss":"(57)","transliteration":"","verse_key":"39:57"}]},{"verse_key":"39:58","surah":39,"ayah":58,"ar_uthmani":"أَوْ تَقُولَ حِينَ تَرَى ٱلْعَذَابَ لَوْ أَنَّ لِى كَرَّةً فَأَكُونَ مِنَ ٱلْمُحْسِنِينَ","en_translation_id":85,"en":"Or, faced by punishment, it says, “If only I could have another chance, I would join those who do good!”","words":[{"pos":1,"ar":"أَوْ","en_gloss":"Or","transliteration":"aw","verse_key":"39:58"},{"pos":2,"ar":"تَقُولَ","en_gloss":"it should say","transliteration":"taqūla","verse_key":"39:58"},{"pos":3,"ar":"حِينَ","en_gloss":"when","transliteration":"ḥīna","verse_key":"39:58"},{"pos":4,"ar":"تَرَى","en_gloss":"it sees","transliteration":"tarā","verse_key":"39:58"},{"pos":5,"ar":"ٱلْعَذَابَ","en_gloss":"the punishment","transliteration":"l-ʿadhāba","verse_key":"39:58"},{"pos":6,"ar":"لَوْ","en_gloss":"If","transliteration":"law","verse_key":"39:58"},{"pos":7,"ar":"أَنَّ","en_gloss":"only","transliteration":"anna","verse_key":"39:58"},{"pos":8,"ar":"لِى","en_gloss":"for me","transliteration":"lī","verse_key":"39:58"},{"pos":9,"ar":"كَرَّةًۭ","en_gloss":"another chance","transliteration":"karratan","verse_key":"39:58"},{"pos":10,"ar":"فَأَكُونَ","en_gloss":"then I could be","transliteration":"fa-akūna","verse_key":"39:58"},{"pos":11,"ar":"مِنَ","en_gloss":"among","transliteration":"mina","verse_key":"39:58"},{"pos":12,"ar":"ٱلْمُحْسِنِينَ","en_gloss":"the good-doers","transliteration":"l-muḥ'sinīna","verse_key":"39:58"},{"pos":13,"ar":"٥٨","en_gloss":"(58)","transliteration":"","verse_key":"39:58"}]},{"verse_key":"39:59","surah":39,"ayah":59,"ar_uthmani":"بَلَىٰ قَدْ جَآءَتْكَ ءَايَـٰتِى فَكَذَّبْتَ بِهَا وَٱسْتَكْبَرْتَ وَكُنتَ مِنَ ٱلْكَـٰفِرِينَ","en_translation_id":85,"en":"No indeed! My messages came to you and you rejected them: you were arrogant and rejected the truth.’","words":[{"pos":1,"ar":"بَلَىٰ","en_gloss":"Yes","transliteration":"balā","verse_key":"39:59"},{"pos":2,"ar":"قَدْ","en_gloss":"verily","transliteration":"qad","verse_key":"39:59"},{"pos":3,"ar":"جَآءَتْكَ","en_gloss":"came to you","transliteration":"jāatka","verse_key":"39:59"},{"pos":4,"ar":"ءَايَـٰتِى","en_gloss":"My Verses","transliteration":"āyātī","verse_key":"39:59"},{"pos":5,"ar":"فَكَذَّبْتَ","en_gloss":"but you denied","transliteration":"fakadhabta","verse_key":"39:59"},{"pos":6,"ar":"بِهَا","en_gloss":"them","transliteration":"bihā","verse_key":"39:59"},{"pos":7,"ar":"وَٱسْتَكْبَرْتَ","en_gloss":"and were arrogant","transliteration":"wa-is'takbarta","verse_key":"39:59"},{"pos":8,"ar":"وَكُنتَ","en_gloss":"and you were","transliteration":"wakunta","verse_key":"39:59"},{"pos":9,"ar":"مِنَ","en_gloss":"among","transliteration":"mina","verse_key":"39:59"},{"pos":10,"ar":"ٱلْكَـٰفِرِينَ","en_gloss":"the disbelievers","transliteration":"l-kāfirīna","verse_key":"39:59"},{"pos":11,"ar":"٥٩","en_gloss":"(59)","transliteration":"","verse_key":"39:59"}]},{"verse_key":"39:60","surah":39,"ayah":60,"ar_uthmani":"وَيَوْمَ ٱلْقِيَـٰمَةِ تَرَى ٱلَّذِينَ كَذَبُوا۟ عَلَى ٱللَّهِ وُجُوهُهُم مُّسْوَدَّةٌ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْمُتَكَبِّرِينَ","en_translation_id":85,"en":"On the Day of Resurrection, you [Prophet] will see those who told lies against God, their faces darkened. Is there not ample punishment for the arrogant in Hell?","words":[{"pos":1,"ar":"وَيَوْمَ","en_gloss":"And (on the) Day","transliteration":"wayawma","verse_key":"39:60"},{"pos":2,"ar":"ٱلْقِيَـٰمَةِ","en_gloss":"(of) the Resurrection","transliteration":"l-qiyāmati","verse_key":"39:60"},{"pos":3,"ar":"تَرَى","en_gloss":"you will see","transliteration":"tarā","verse_key":"39:60"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"39:60"},{"pos":5,"ar":"كَذَبُوا۟","en_gloss":"lied","transliteration":"kadhabū","verse_key":"39:60"},{"pos":6,"ar":"عَلَى","en_gloss":"about","transliteration":"ʿalā","verse_key":"39:60"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"39:60"},{"pos":8,"ar":"وُجُوهُهُم","en_gloss":"their faces","transliteration":"wujūhuhum","verse_key":"39:60"},{"pos":9,"ar":"مُّسْوَدَّةٌ ۚ","en_gloss":"(will be) blackened","transliteration":"mus'waddatun","verse_key":"39:60"},{"pos":10,"ar":"أَلَيْسَ","en_gloss":"Is (there) not","transliteration":"alaysa","verse_key":"39:60"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"39:60"},{"pos":12,"ar":"جَهَنَّمَ","en_gloss":"Hell","transliteration":"jahannama","verse_key":"39:60"},{"pos":13,"ar":"مَثْوًۭى","en_gloss":"an abode","transliteration":"mathwan","verse_key":"39:60"},{"pos":14,"ar":"لِّلْمُتَكَبِّرِينَ","en_gloss":"for the arrogant","transliteration":"lil'mutakabbirīna","verse_key":"39:60"},{"pos":15,"ar":"٦٠","en_gloss":"(60)","transliteration":"","verse_key":"39:60"}]},{"verse_key":"39:61","surah":39,"ayah":61,"ar_uthmani":"وَيُنَجِّى ٱللَّهُ ٱلَّذِينَ ٱتَّقَوْا۟ بِمَفَازَتِهِمْ لَا يَمَسُّهُمُ ٱلسُّوٓءُ وَلَا هُمْ يَحْزَنُونَ","en_translation_id":85,"en":"But God will deliver those who took heed of Him to their place of safety: no harm will touch them, nor will they grieve.","words":[{"pos":1,"ar":"وَيُنَجِّى","en_gloss":"And Allah will deliver","transliteration":"wayunajjī","verse_key":"39:61"},{"pos":2,"ar":"ٱللَّهُ","en_gloss":"And Allah will deliver","transliteration":"l-lahu","verse_key":"39:61"},{"pos":3,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"39:61"},{"pos":4,"ar":"ٱتَّقَوْا۟","en_gloss":"feared (Him)","transliteration":"ittaqaw","verse_key":"39:61"},{"pos":5,"ar":"بِمَفَازَتِهِمْ","en_gloss":"to their place of salvation","transliteration":"bimafāzatihim","verse_key":"39:61"},{"pos":6,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"39:61"},{"pos":7,"ar":"يَمَسُّهُمُ","en_gloss":"will touch them","transliteration":"yamassuhumu","verse_key":"39:61"},{"pos":8,"ar":"ٱلسُّوٓءُ","en_gloss":"the evil","transliteration":"l-sūu","verse_key":"39:61"},{"pos":9,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"39:61"},{"pos":10,"ar":"هُمْ","en_gloss":"they","transliteration":"hum","verse_key":"39:61"},{"pos":11,"ar":"يَحْزَنُونَ","en_gloss":"will grieve","transliteration":"yaḥzanūna","verse_key":"39:61"},{"pos":12,"ar":"٦١","en_gloss":"(61)","transliteration":"","verse_key":"39:61"}]},{"verse_key":"39:62","surah":39,"ayah":62,"ar_uthmani":"ٱللَّهُ خَـٰلِقُ كُلِّ شَىْءٍ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ وَكِيلٌ","en_translation_id":85,"en":"God is the Creator of all things; He has charge of everything;","words":[{"pos":1,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"al-lahu","verse_key":"39:62"},{"pos":2,"ar":"خَـٰلِقُ","en_gloss":"(is the) Creator","transliteration":"khāliqu","verse_key":"39:62"},{"pos":3,"ar":"كُلِّ","en_gloss":"(of) all","transliteration":"kulli","verse_key":"39:62"},{"pos":4,"ar":"شَىْءٍۢ ۖ","en_gloss":"things","transliteration":"shayin","verse_key":"39:62"},{"pos":5,"ar":"وَهُوَ","en_gloss":"and He","transliteration":"wahuwa","verse_key":"39:62"},{"pos":6,"ar":"عَلَىٰ","en_gloss":"(is) over","transliteration":"ʿalā","verse_key":"39:62"},{"pos":7,"ar":"كُلِّ","en_gloss":"all","transliteration":"kulli","verse_key":"39:62"},{"pos":8,"ar":"شَىْءٍۢ","en_gloss":"things","transliteration":"shayin","verse_key":"39:62"},{"pos":9,"ar":"وَكِيلٌۭ","en_gloss":"a Guardian","transliteration":"wakīlun","verse_key":"39:62"},{"pos":10,"ar":"٦٢","en_gloss":"(62)","transliteration":"","verse_key":"39:62"}]},{"verse_key":"39:63","surah":39,"ayah":63,"ar_uthmani":"لَّهُۥ مَقَالِيدُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۗ وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِ ٱللَّهِ أُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ","en_translation_id":85,"en":"the keys of the heavens and earth are His. Those who have rejected the revelations of God will be the losers.","words":[{"pos":1,"ar":"لَّهُۥ","en_gloss":"For Him","transliteration":"lahu","verse_key":"39:63"},{"pos":2,"ar":"مَقَالِيدُ","en_gloss":"(are the) keys","transliteration":"maqālīdu","verse_key":"39:63"},{"pos":3,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"(of) the heavens","transliteration":"l-samāwāti","verse_key":"39:63"},{"pos":4,"ar":"وَٱلْأَرْضِ ۗ","en_gloss":"and the earth","transliteration":"wal-arḍi","verse_key":"39:63"},{"pos":5,"ar":"وَٱلَّذِينَ","en_gloss":"And those who","transliteration":"wa-alladhīna","verse_key":"39:63"},{"pos":6,"ar":"كَفَرُوا۟","en_gloss":"disbelieve","transliteration":"kafarū","verse_key":"39:63"},{"pos":7,"ar":"بِـَٔايَـٰتِ","en_gloss":"in (the) Verses","transliteration":"biāyāti","verse_key":"39:63"},{"pos":8,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"39:63"},{"pos":9,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"those ","transliteration":"ulāika","verse_key":"39:63"},{"pos":10,"ar":"هُمُ","en_gloss":"they","transliteration":"humu","verse_key":"39:63"},{"pos":11,"ar":"ٱلْخَـٰسِرُونَ","en_gloss":"(are) the losers","transliteration":"l-khāsirūna","verse_key":"39:63"},{"pos":12,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"39:63"}]},{"verse_key":"39:64","surah":39,"ayah":64,"ar_uthmani":"قُلْ أَفَغَيْرَ ٱللَّهِ تَأْمُرُوٓنِّىٓ أَعْبُدُ أَيُّهَا ٱلْجَـٰهِلُونَ","en_translation_id":85,"en":"Say, ‘Do you order me to worship someone other than God, you foolish people?’","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"39:64"},{"pos":2,"ar":"أَفَغَيْرَ","en_gloss":"Is (it) other than","transliteration":"afaghayra","verse_key":"39:64"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"39:64"},{"pos":4,"ar":"تَأْمُرُوٓنِّىٓ","en_gloss":"you order me","transliteration":"tamurūnnī","verse_key":"39:64"},{"pos":5,"ar":"أَعْبُدُ","en_gloss":"(to) worship","transliteration":"aʿbudu","verse_key":"39:64"},{"pos":6,"ar":"أَيُّهَا","en_gloss":"O","transliteration":"ayyuhā","verse_key":"39:64"},{"pos":7,"ar":"ٱلْجَـٰهِلُونَ","en_gloss":"ignorant ones","transliteration":"l-jāhilūna","verse_key":"39:64"},{"pos":8,"ar":"٦٤","en_gloss":"(64)","transliteration":"","verse_key":"39:64"}]},{"verse_key":"39:65","surah":39,"ayah":65,"ar_uthmani":"وَلَقَدْ أُوحِىَ إِلَيْكَ وَإِلَى ٱلَّذِينَ مِن قَبْلِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ ٱلْخَـٰسِرِينَ","en_translation_id":85,"en":"It has already been revealed to you [Prophet] and to those before you: ‘If you ascribe any partner to God, all your work will come to nothing: you will be one if the losers.","words":[{"pos":1,"ar":"وَلَقَدْ","en_gloss":"And verily","transliteration":"walaqad","verse_key":"39:65"},{"pos":2,"ar":"أُوحِىَ","en_gloss":"it has been revealed","transliteration":"ūḥiya","verse_key":"39:65"},{"pos":3,"ar":"إِلَيْكَ","en_gloss":"to you","transliteration":"ilayka","verse_key":"39:65"},{"pos":4,"ar":"وَإِلَى","en_gloss":"and to","transliteration":"wa-ilā","verse_key":"39:65"},{"pos":5,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"39:65"},{"pos":6,"ar":"مِن","en_gloss":"(were) before you","transliteration":"min","verse_key":"39:65"},{"pos":7,"ar":"قَبْلِكَ","en_gloss":"(were) before you","transliteration":"qablika","verse_key":"39:65"},{"pos":8,"ar":"لَئِنْ","en_gloss":"if","transliteration":"la-in","verse_key":"39:65"},{"pos":9,"ar":"أَشْرَكْتَ","en_gloss":"you associate (with Allah)","transliteration":"ashrakta","verse_key":"39:65"},{"pos":10,"ar":"لَيَحْبَطَنَّ","en_gloss":"surely, will become worthless","transliteration":"layaḥbaṭanna","verse_key":"39:65"},{"pos":11,"ar":"عَمَلُكَ","en_gloss":"your deeds","transliteration":"ʿamaluka","verse_key":"39:65"},{"pos":12,"ar":"وَلَتَكُونَنَّ","en_gloss":"and you will surely be","transliteration":"walatakūnanna","verse_key":"39:65"},{"pos":13,"ar":"مِنَ","en_gloss":"among","transliteration":"mina","verse_key":"39:65"},{"pos":14,"ar":"ٱلْخَـٰسِرِينَ","en_gloss":"the losers","transliteration":"l-khāsirīna","verse_key":"39:65"},{"pos":15,"ar":"٦٥","en_gloss":"(65)","transliteration":"","verse_key":"39:65"}]},{"verse_key":"39:66","surah":39,"ayah":66,"ar_uthmani":"بَلِ ٱللَّهَ فَٱعْبُدْ وَكُن مِّنَ ٱلشَّـٰكِرِينَ","en_translation_id":85,"en":"No! Worship God alone and be one of those who are grateful to Him.’","words":[{"pos":1,"ar":"بَلِ","en_gloss":"Nay","transliteration":"bali","verse_key":"39:66"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"But worship Allah","transliteration":"l-laha","verse_key":"39:66"},{"pos":3,"ar":"فَٱعْبُدْ","en_gloss":"But worship Allah","transliteration":"fa-uʿ'bud","verse_key":"39:66"},{"pos":4,"ar":"وَكُن","en_gloss":"and be","transliteration":"wakun","verse_key":"39:66"},{"pos":5,"ar":"مِّنَ","en_gloss":"among","transliteration":"mina","verse_key":"39:66"},{"pos":6,"ar":"ٱلشَّـٰكِرِينَ","en_gloss":"the thankful ones","transliteration":"l-shākirīna","verse_key":"39:66"},{"pos":7,"ar":"٦٦","en_gloss":"(66)","transliteration":"","verse_key":"39:66"}]},{"verse_key":"39:67","surah":39,"ayah":67,"ar_uthmani":"وَمَا قَدَرُوا۟ ٱللَّهَ حَقَّ قَدْرِهِۦ وَٱلْأَرْضُ جَمِيعًا قَبْضَتُهُۥ يَوْمَ ٱلْقِيَـٰمَةِ وَٱلسَّمَـٰوَٰتُ مَطْوِيَّـٰتٌۢ بِيَمِينِهِۦ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ","en_translation_id":85,"en":"These people have no grasp of God’s true measure. On the Day of Resurrection, the whole earth will be in His grip. The heavens will be rolled up in His right hand- Glory be to Him! He is far above the partners they ascribe to Him!-","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"39:67"},{"pos":2,"ar":"قَدَرُوا۟","en_gloss":"they appraised","transliteration":"qadarū","verse_key":"39:67"},{"pos":3,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"39:67"},{"pos":4,"ar":"حَقَّ","en_gloss":"(with) true","transliteration":"ḥaqqa","verse_key":"39:67"},{"pos":5,"ar":"قَدْرِهِۦ","en_gloss":"appraisal","transliteration":"qadrihi","verse_key":"39:67"},{"pos":6,"ar":"وَٱلْأَرْضُ","en_gloss":"while the earth","transliteration":"wal-arḍu","verse_key":"39:67"},{"pos":7,"ar":"جَمِيعًۭا","en_gloss":"entirely","transliteration":"jamīʿan","verse_key":"39:67"},{"pos":8,"ar":"قَبْضَتُهُۥ","en_gloss":"(will be) in His Grip","transliteration":"qabḍatuhu","verse_key":"39:67"},{"pos":9,"ar":"يَوْمَ","en_gloss":"(on the) Day","transliteration":"yawma","verse_key":"39:67"},{"pos":10,"ar":"ٱلْقِيَـٰمَةِ","en_gloss":"(of) the Resurrection","transliteration":"l-qiyāmati","verse_key":"39:67"},{"pos":11,"ar":"وَٱلسَّمَـٰوَٰتُ","en_gloss":"and the heavens","transliteration":"wal-samāwātu","verse_key":"39:67"},{"pos":12,"ar":"مَطْوِيَّـٰتٌۢ","en_gloss":"(will be) folded","transliteration":"maṭwiyyātun","verse_key":"39:67"},{"pos":13,"ar":"بِيَمِينِهِۦ ۚ","en_gloss":"in His Right Hand","transliteration":"biyamīnihi","verse_key":"39:67"},{"pos":14,"ar":"سُبْحَـٰنَهُۥ","en_gloss":"Glory be to Him","transliteration":"sub'ḥānahu","verse_key":"39:67"},{"pos":15,"ar":"وَتَعَـٰلَىٰ","en_gloss":"And High is He","transliteration":"wataʿālā","verse_key":"39:67"},{"pos":16,"ar":"عَمَّا","en_gloss":"above what","transliteration":"ʿammā","verse_key":"39:67"},{"pos":17,"ar":"يُشْرِكُونَ","en_gloss":"they associate (with Him)","transliteration":"yush'rikūna","verse_key":"39:67"},{"pos":18,"ar":"٦٧","en_gloss":"(67)","transliteration":"","verse_key":"39:67"}]}]}