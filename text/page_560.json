{"page":560,"verses":[{"verse_key":"66:1","surah":66,"ayah":1,"ar_uthmani":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَ ۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","en_translation_id":85,"en":"Prophet, why do you prohibit what God has made lawful to you in your desire to please your wives? Yet God is forgiving and merciful:","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O","transliteration":"yāayyuhā","verse_key":"66:1"},{"pos":2,"ar":"ٱلنَّبِىُّ","en_gloss":"Prophet","transliteration":"l-nabiyu","verse_key":"66:1"},{"pos":3,"ar":"لِمَ","en_gloss":"Why (do)","transliteration":"lima","verse_key":"66:1"},{"pos":4,"ar":"تُحَرِّمُ","en_gloss":"you prohibit","transliteration":"tuḥarrimu","verse_key":"66:1"},{"pos":5,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"66:1"},{"pos":6,"ar":"أَحَلَّ","en_gloss":"has made lawful","transliteration":"aḥalla","verse_key":"66:1"},{"pos":7,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"66:1"},{"pos":8,"ar":"لَكَ ۖ","en_gloss":"for you","transliteration":"laka","verse_key":"66:1"},{"pos":9,"ar":"تَبْتَغِى","en_gloss":"seeking","transliteration":"tabtaghī","verse_key":"66:1"},{"pos":10,"ar":"مَرْضَاتَ","en_gloss":"(to) please","transliteration":"marḍāta","verse_key":"66:1"},{"pos":11,"ar":"أَزْوَٰجِكَ ۚ","en_gloss":"your wives","transliteration":"azwājika","verse_key":"66:1"},{"pos":12,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"66:1"},{"pos":13,"ar":"غَفُورٌۭ","en_gloss":"(is) Oft-Forgiving","transliteration":"ghafūrun","verse_key":"66:1"},{"pos":14,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"66:1"},{"pos":15,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"66:1"}]},{"verse_key":"66:2","surah":66,"ayah":2,"ar_uthmani":"قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ","en_translation_id":85,"en":"