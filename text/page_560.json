Him, given to fasting, whether previously married or virgins.","words":[{"pos":1,"ar":"عَسَىٰ","en_gloss":"Perhaps","transliteration":"ʿasā","verse_key":"66:5"},{"pos":2,"ar":"رَبُّهُۥٓ","en_gloss":"his Lord","transliteration":"rabbuhu","verse_key":"66:5"},{"pos":3,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"66:5"},{"pos":4,"ar":"طَلَّقَكُنَّ","en_gloss":"he divorced you","transliteration":"ṭallaqakunna","verse_key":"66:5"},{"pos":5,"ar":"أَن","en_gloss":"[that]","transliteration":"an","verse_key":"66:5"},{"pos":6,"ar":"يُبْدِلَهُۥٓ","en_gloss":"He will substitute for him","transliteration":"yub'dilahu","verse_key":"66:5"},{"pos":7,"ar":"أَزْوَٰجًا","en_gloss":"wives","transliteration":"azwājan","verse_key":"66:5"},{"pos":8,"ar":"خَيْرًۭا","en_gloss":"better","transliteration":"khayran","verse_key":"66:5"},{"pos":9,"ar":"مِّنكُنَّ","en_gloss":"than you","transliteration":"minkunna","verse_key":"66:5"},{"pos":10,"ar":"مُسْلِمَـٰتٍۢ","en_gloss":"submissive","transliteration":"mus'limātin","verse_key":"66:5"},{"pos":11,"ar":"مُّؤْمِنَـٰتٍۢ","en_gloss":"faithful","transliteration":"mu'minātin","verse_key":"66:5"},{"pos":12,"ar":"قَـٰنِتَـٰتٍۢ","en_gloss":"obedient","transliteration":"qānitātin","verse_key":"66:5"},{"pos":13,"ar":"تَـٰٓئِبَـٰتٍ","en_gloss":"repentant","transliteration":"tāibātin","verse_key":"66:5"},{"pos":14,"ar":"عَـٰبِدَٰتٍۢ","en_gloss":"who worship","transliteration":"ʿābidātin","verse_key":"66:5"},{"pos":15,"ar":"سَـٰٓئِحَـٰتٍۢ","en_gloss":"who fast","transliteration":"sāiḥātin","verse_key":"66:5"},{"pos":16,"ar":"ثَيِّبَـٰتٍۢ","en_gloss":"previously married","transliteration":"thayyibātin","verse_key":"66:5"},{"pos":17,"ar":"وَأَبْكَارًۭا","en_gloss":"and virgins","transliteration":"wa-abkāran","verse_key":"66:5"},{"pos":18,"ar":"٥","en_gloss":"(5)","transliteration":"","verse_key":"66:5"}]},{"verse_key":"66:6","surah":66,"ayah":6,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ قُوٓا۟ أَنفُسَكُمْ وَأَهْلِيكُمْ نَارًا وَقُودُهَا 