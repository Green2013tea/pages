os":1,"ar":"وَإِذْ","en_gloss":"And when","transliteration":"wa-idh","verse_key":"66:3"},{"pos":2,"ar":"أَسَرَّ","en_gloss":"confided","transliteration":"asarra","verse_key":"66:3"},{"pos":3,"ar":"ٱلنَّبِىُّ","en_gloss":"the Prophet","transliteration":"l-nabiyu","verse_key":"66:3"},{"pos":4,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"66:3"},{"pos":5,"ar":"بَعْضِ","en_gloss":"one","transliteration":"baʿḍi","verse_key":"66:3"},{"pos":6,"ar":"أَزْوَٰجِهِۦ","en_gloss":"(of) his wives","transliteration":"azwājihi","verse_key":"66:3"},{"pos":7,"ar":"حَدِيثًۭا","en_gloss":"a statement","transliteration":"ḥadīthan","verse_key":"66:3"},{"pos":8,"ar":"فَلَمَّا","en_gloss":"and when","transliteration":"falammā","verse_key":"66:3"},{"pos":9,"ar":"نَبَّأَتْ","en_gloss":"she informed","transliteration":"nabba-at","verse_key":"66:3"},{"pos":10,"ar":"بِهِۦ","en_gloss":"about it","transliteration":"bihi","verse_key":"66:3"},{"pos":11,"ar":"وَأَظْهَرَهُ","en_gloss":"and made it apparent","transliteration":"wa-aẓharahu","verse_key":"66:3"},{"pos":12,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"66:3"},{"pos":13,"ar":"عَلَيْهِ","en_gloss":"to him","transliteration":"ʿalayhi","verse_key":"66:3"},{"pos":14,"ar":"عَرَّفَ","en_gloss":"he made known","transliteration":"ʿarrafa","verse_key":"66:3"},{"pos":15,"ar":"بَعْضَهُۥ","en_gloss":"a part of it","transliteration":"baʿḍahu","verse_key":"66:3"},{"pos":16,"ar":"وَأَعْرَضَ","en_gloss":"and avoided","transliteration":"wa-aʿraḍa","verse_key":"66:3"},{"pos":17,"ar":"عَنۢ","en_gloss":"[of]","transliteration":"ʿan","verse_key":"66:3"},{"pos":18,"ar":"بَعْضٍۢ ۖ","en_gloss":"a part","transliteration":"baʿḍin","verse_key":"66:3"},{"pos":19,"ar":"فَلَمَّا","en_gloss":"Then when","transliteration":"falammā","verse_key":"66:3"},{"pos":20,"ar":"نَبَّأَهَا","en_gloss":"he informed her","transliteration":"nabba-ahā","verse_key":"66:3"},{"pos":21,"ar":"بِهِۦ","en_gloss":"about it","transliteration":"bihi","verse_key":"66:3"},{"pos":22,"ar":"قَالَتْ","en_gloss":"she said","transliteration":"qālat","verse_key":"66:3"},{"pos":23,"ar":"مَنْ","en_gloss":"Who","transliteration":"man","verse_key":"66:3"},{"pos":24,"ar":"أَنۢبَأَكَ","en_gloss":"informed you","transliteration":"anba-aka","verse_key":"66:3"},{"pos":25,"ar":"هَـٰذَا ۖ","en_gloss":"this","transliteration":"hādhā","verse_key":"66:3"},{"pos":26,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"66:3"},{"pos":27,"ar":"نَبَّأَنِىَ","en_gloss":"Has informed me","transliteration":"nabba-aniya","verse_key":"66:3"},{"pos":28,"ar":"ٱلْعَلِيمُ","en_gloss":"the All-Knower","transliteration":"l-ʿalīmu","verse_key":"66:3"},{"pos":29,"ar":"ٱلْخَبِيرُ","en_gloss":"the All-Aware","transliteration":"l-khabīru","verse_key":"66:3"},{"pos":30,"ar":"٣","en_gloss":"(3)","transliteration":"","verse_key":"66:3"}]},{"verse_key":"66:4","surah":66,"ayah":4,"ar_uthmani":"إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا ۖ وَإِن تَظَـٰهَرَا عَلَيْهِ فَإِنَّ ٱللَّهَ هُوَ مَوْلَىٰهُ وَجِبْرِيلُ وَصَـٰلِحُ ٱلْمُؤْمِنِينَ ۖ وَٱلْمَلَـٰٓئِكَةُ بَعْدَ ذَٰلِكَ ظَهِيرٌ","en_translation_id":85,"en":"If both of you [wives] repent to God––for your hearts have deviated––[all will be well]; if you collaborate against him, [be warned that] God will aid him, as will Gabriel and all righteous believers, and the angels too will back him.","words":[{"pos":1,"ar":"إِن","en_gloss":"If","transliteration":"in","verse_key":"66:4"},{"pos":2,"ar":"تَتُوبَآ","en_gloss":"you both turn","transliteration":"tatūbā","verse_key":"66:4"},{"pos":3,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"66:4"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"66:4"},{"pos":5,"ar":"فَقَدْ","en_gloss":"so indeed","transliteration":"faqad","verse_key":"66:4"},{"pos":6,"ar":"صَغَتْ","en_gloss":"(are) inclined","transliteration":"ṣaghat","verse_key":"66:4"},{"pos":7,"ar":"قُلُوبُكُمَا ۖ","en_gloss":"your heart