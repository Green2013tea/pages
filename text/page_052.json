{"page":52,"verses":[{"verse_key":"3:16","surah":3,"ayah":16,"ar_uthmani":"ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا فَٱغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ","en_translation_id":85,"en":"those who say, “Our Lord, we believe, so forgive us our sins and protect us from suffering in the Fire,”","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"3:16"},{"pos":2,"ar":"يَقُولُونَ","en_gloss":"say","transliteration":"yaqūlūna","verse_key":"3:16"},{"pos":3,"ar":"رَبَّنَآ","en_gloss":"Our Lord","transliteration":"rabbanā","verse_key":"3:16"},{"pos":4,"ar":"إِنَّنَآ","en_gloss":"Indeed, we","transliteration":"innanā","verse_key":"3:16"},{"pos":5,"ar":"ءَامَنَّا","en_gloss":"(have) believed","transliteration":"āmannā","verse_key":"3:16"},{"pos":6,"ar":"فَٱغْفِرْ","en_gloss":"so forgive","transliteration":"fa-igh'fir","verse_key":"3:16"},{"pos":7,"ar":"لَنَا","en_gloss":"for us","transliteration":"lanā","verse_key":"3:16"},{"pos":8,"ar":"ذُنُوبَنَا","en_gloss":"our sins","transliteration":"dhunūbanā","verse_key":"3:16"},{"pos":9,"ar":"وَقِنَا","en_gloss":"and save us","transliteration":"waqinā","verse_key":"3:16"},{"pos":10,"ar":"عَذَابَ","en_gloss":"(from) punishment","transliteration":"ʿadhāba","verse_key":"3:16"},{"pos":11,"ar":"ٱلنَّارِ","en_gloss":"(of) the Fire","transliteration":"l-nāri","verse_key":"3:16"},{"pos":12,"ar":"١٦","en_gloss":"(16)","transliteration":"","verse_key":"3:16"}]},{"verse_key":"3:17","surah":3,"ayah":17,"ar_uthmani":"ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ بِٱلْأَسْحَارِ","en_translation_id":85,"en":"those who are steadfast, truthful, truly devout, who give [in God’s cause] and pray before dawn for forgiveness.’","words":[{"pos":1,"ar":"ٱلصَّـٰبِرِينَ","en_gloss":"The patient","transliteration":"al-ṣābirīna","verse_key":"3:17"},{"pos":2,"ar":"وَٱلصَّـٰدِقِينَ","en_gloss":"and the truthful","transliteration":"wal-ṣādiqīna","verse_ke