O you","transliteration":"yāayyuhā","verse_key":"3:200"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"3:200"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"3:200"},{"pos":4,"ar":"ٱصْبِرُوا۟","en_gloss":"Be steadfast","transliteration":"iṣ'birū","verse_key":"3:200"},{"pos":5,"ar":"وَصَابِرُوا۟","en_gloss":"and [be] patient","transliteration":"waṣābirū","verse_key":"3:200"},{"pos":6,"ar":"وَرَابِطُوا۟","en_gloss":"and [be] constant","transliteration":"warābiṭū","verse_key":"3:200"},{"pos":7,"ar":"وَٱتَّقُوا۟","en_gloss":"and fear","transliteration":"wa-ittaqū","verse_key":"3:200"},{"pos":8,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"3:200"},{"pos":9,"ar":"لَعَلَّكُمْ","en_gloss":"so that you may","transliteration":"laʿallakum","verse_key":"3:200"},{"pos":10,"ar":"تُفْلِحُونَ","en_gloss":"(be) successful","transliteration":"tuf'liḥūna","verse_key":"3:200"},{"pos":11,"ar":"٢٠٠","en_gloss":"(200)","transliteration":"","verse_key":"3:200"}]}]}