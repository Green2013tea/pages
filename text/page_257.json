translation_id":85,"en":"The disbelievers said to their messengers, ‘We shall expel you from our land unless you return to our religion.’ But their Lord inspired the messengers: ‘We shall destroy the evildoers,","words":[{"pos":1,"ar":"وَقَالَ","en_gloss":"And said","transliteration":"waqāla","verse_key":"14:13"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"14:13"},{"pos":3,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"14:13"},{"pos":4,"ar":"لِرُسُلِهِمْ","en_gloss":"to their Messengers","transliteration":"lirusulihim","verse_key":"14:13"},{"pos":5,"ar":"لَنُخْرِجَنَّكُم","en_gloss":"Surely we will drive you out","transliteration":"lanukh'rijannakum","verse_key":"14:13"},{"pos":6,"ar":"مِّنْ","en_gloss":"of","transliteration":"min","verse_key":"14:13"},{"pos":7,"ar":"أَرْضِنَآ","en_gloss":"our land","transliteration":"arḍinā","verse_key":"14:13"},{"pos":8,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"14:13"},{"pos":9,"ar":"لَتَعُودُنَّ","en_gloss":"surely you should return","transliteration":"lataʿūdunna","verse_key":"14:13"},{"pos":10,"ar":"فِى","en_gloss":"to","transliteration":"fī","verse_key":"14:13"},{"pos":11,"ar":"مِلَّتِنَا ۖ","en_gloss":"our religion","transliteration":"millatinā","verse_key":"14:13"},{"pos":12,"ar":"فَأَوْحَىٰٓ","en_gloss":"So inspired","transliteration":"fa-awḥā","verse_key":"14:13"},{"pos":13,"ar":"إِلَيْهِمْ","en_gloss":"to them","transliteration":"ilayhim","verse_key":"14:13"},{"pos":14,"ar":"رَبُّهُمْ","en_gloss":"their Lord","transliteration":"rabbuhum","verse_key":"14:13"},{"pos":15,"ar":"لَنُهْلِكَنَّ","en_gloss":"We will surely destroy","transliteration":"lanuh'likanna","verse_key":"14:13"},{"pos":16,"ar":"ٱلظَّـٰلِمِينَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimīna","verse_key":"14:13"},{"pos":17,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"14:13"}]},{"verse_key":"14:14","surah":14,"ayah":14,"ar_uthm