81"},{"pos":3,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"16:81"},{"pos":4,"ar":"مِّمَّا","en_gloss":"from what","transliteration":"mimmā","verse_key":"16:81"},{"pos":5,"ar":"خَلَقَ","en_gloss":"He created","transliteration":"khalaqa","verse_key":"16:81"},{"pos":6,"ar":"ظِلَـٰلًۭا","en_gloss":"shades","transliteration":"ẓilālan","verse_key":"16:81"},{"pos":7,"ar":"وَجَعَلَ","en_gloss":"and (has) made","transliteration":"wajaʿala","verse_key":"16:81"},{"pos":8,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"16:81"},{"pos":9,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"16:81"},{"pos":10,"ar":"ٱلْجِبَالِ","en_gloss":"the mountains","transliteration":"l-jibāli","verse_key":"16:81"},{"pos":11,"ar":"أَكْنَـٰنًۭا","en_gloss":"shelters","transliteration":"aknānan","verse_key":"16:81"},{"pos":12,"ar":"وَجَعَلَ","en_gloss":"and (has) made","transliteration":"wajaʿala","verse_key":"16:81"},{"pos":13,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"16:81"},{"pos":14,"ar":"سَرَٰبِيلَ","en_gloss":"garments","transliteration":"sarābīla","verse_key":"16:81"},{"pos":15,"ar":"تَقِيكُمُ","en_gloss":"to protect you","transliteration":"taqīkumu","verse_key":"16:81"},{"pos":16,"ar":"ٱلْحَرَّ","en_gloss":"(from) the heat","transliteration":"l-ḥara","verse_key":"16:81"},{"pos":17,"ar":"وَسَرَٰبِيلَ","en_gloss":"and garments","transliteration":"wasarābīla","verse_key":"16:81"},{"pos":18,"ar":"تَقِيكُم","en_gloss":"to protect you","transliteration":"taqīkum","verse_key":"16:81"},{"pos":19,"ar":"بَأْسَكُمْ ۚ","en_gloss":"from your (mutual) violence","transliteration":"basakum","verse_key":"16:81"},{"pos":20,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"16:81"},{"pos":21,"ar":"يُتِمُّ","en_gloss":"He completes","transliteration":"yutimmu","verse_key":"16:81"},{"pos":22,"ar":"نِعْمَتَهُۥ","en_gloss":"His Favor","transliteration":"niʿ'matahu","verse_key":"16:81"},{"pos":23,"ar":"عَلَيْكُمْ","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"16:81"},{"pos":24,"ar":"لَعَلَّكُمْ","en_gloss":"so that you may","transliteration":"laʿallakum","verse_key":"16:81"},{"pos":25,"ar":"تُسْلِمُونَ","en_gloss":"submit","transliteration":"tus'limūna","verse_key":"16:81"},{"pos":26,"ar":"٨١","en_gloss":"(81)","transliteration":"","verse_key":"16:81"}]},{"verse_key":"16:82","surah":16,"ayah":82,"ar_uthmani":"فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ ٱلْبَلَـٰغُ ٱلْمُبِينُ","en_translation_id":85,"en":"But if they turn away [Prophet], your only duty is to deliver the message clearly.","words":[{"pos":1,"ar":"فَإِن","en_gloss":"Then, if","transliteration":"fa-in","verse_key":"16:82"},{"pos":2,"ar":"تَوَلَّوْا۟","en_gloss":"they turn away","transliteration":"tawallaw","verse_key":"16:82"},{"pos":3,"ar":"فَإِنَّمَا","en_gloss":"then only","transliteration":"fa-innamā","verse_key":"16:82"},{"pos":4,"ar":"عَلَيْكَ","en_gloss":"upon you","transliteration":"ʿalayka","verse_key":"16:82"},{"pos":5,"ar":"ٱلْبَلَـٰغُ","en_gloss":"(is) the conveyance","transliteration":"l-balāghu","verse_key":"16:82"},{"pos":6,"ar":"ٱلْمُبِينُ","en_gloss":"the clear","transliteration":"l-mubīnu","verse_key":"16:82"},{"pos":7,"ar":"٨٢","en_gloss":"(82)","transliteration":"","verse_key":"16:82"}]},{"verse_key":"16:83","surah":16,"ayah":83,"ar_uthmani":"يَعْرِفُونَ نِعْمَتَ ٱللَّهِ ثُمَّ يُنكِرُونَهَا وَأَكْثَرُهُمُ ٱلْكَـٰفِرُونَ","en_translation_id":85,"en":"They know God’s blessings, but refuse to recognize them: most of them are ungrateful.","words":[{"pos":1,"ar":"يَعْرِفُونَ","en_gloss":"They recognize","transliteration":"yaʿrifūna","verse_key":"16:83"},{"pos":2,"ar":"نِعْمَتَ","en_gloss":"(the) Favor","transliteration":"niʿ'mata","verse_key":"16:83"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"16:83"},{"pos":4,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"16:83"},{"pos":5,"ar":"يُنكِرُونَهَ