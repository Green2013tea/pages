18"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"3:118"},{"pos":4,"ar":"لَا","en_gloss":"(Do) not","transliteration":"lā","verse_key":"3:118"},{"pos":5,"ar":"تَتَّخِذُوا۟","en_gloss":"take","transliteration":"tattakhidhū","verse_key":"3:118"},{"pos":6,"ar":"بِطَانَةًۭ","en_gloss":"(as) intimates","transliteration":"biṭānatan","verse_key":"3:118"},{"pos":7,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"3:118"},{"pos":8,"ar":"دُونِكُمْ","en_gloss":"other than yourselves","transliteration":"dūnikum","verse_key":"3:118"},{"pos":9,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"3:118"},{"pos":10,"ar":"يَأْلُونَكُمْ","en_gloss":"they will spare you","transliteration":"yalūnakum","verse_key":"3:118"},{"pos":11,"ar":"خَبَالًۭا","en_gloss":"(any) ruin","transliteration":"khabālan","verse_key":"3:118"},{"pos":12,"ar":"وَدُّوا۟","en_gloss":"They wish","transliteration":"waddū","verse_key":"3:118"},{"pos":13,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"3:118"},{"pos":14,"ar":"عَنِتُّمْ","en_gloss":"distresses you","transliteration":"ʿanittum","verse_key":"3:118"},{"pos":15,"ar":"قَدْ","en_gloss":"Indeed","transliteration":"qad","verse_key":"3:118"},{"pos":16,"ar":"بَدَتِ","en_gloss":"(has become) apparent","transliteration":"badati","verse_key":"3:118"},{"pos":17,"ar":"ٱلْبَغْضَآءُ","en_gloss":"the hatred","transliteration":"l-baghḍāu","verse_key":"3:118"},{"pos":18,"ar":"مِنْ","en_gloss":"from","transliteration":"min","verse_key":"3:118"},{"pos":19,"ar":"أَفْوَٰهِهِمْ","en_gloss":"their mouths","transliteration":"afwāhihim","verse_key":"3:118"},{"pos":20,"ar":"وَمَا","en_gloss":"and what","transliteration":"wamā","verse_key":"3:118"},{"pos":21,"ar":"تُخْفِى","en_gloss":"conceals","transliteration":"tukh'fī","verse_key":"3:118"},{"pos":22,"ar":"صُدُورُهُمْ","en_gloss":"their breasts","transliteration":"ṣudūruhum","verse_key":"3:118"},{"pos":23,"ar":"أَكْبَرُ ۚ","en_gloss":"(is