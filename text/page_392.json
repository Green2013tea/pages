rahum","verse_key":"28:57"},{"pos":24,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"28:57"},{"pos":25,"ar":"يَعْلَمُونَ","en_gloss":"know","transliteration":"yaʿlamūna","verse_key":"28:57"},{"pos":26,"ar":"٥٧","en_gloss":"(57)","transliteration":"","verse_key":"28:57"}]},{"verse_key":"28:58","surah":28,"ayah":58,"ar_uthmani":"وَكَمْ أَهْلَكْنَا مِن قَرْيَةٍۭ بَطِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ مَسَـٰكِنُهُمْ لَمْ تُسْكَن مِّنۢ بَعْدِهِمْ إِلَّا قَلِيلًا ۖ وَكُنَّا نَحْنُ ٱلْوَٰرِثِينَ","en_translation_id":85,"en":"We have destroyed many a community that once revelled in its wanton wealth and easy living: since then their dwelling places have barely been inhabited- We are the only heir.","words":[{"pos":1,"ar":"وَكَمْ","en_gloss":"And how many","transliteration":"wakam","verse_key":"28:58"},{"pos":2,"ar":"أَهْلَكْنَا","en_gloss":"We have destroyed","transliteration":"ahlaknā","verse_key":"28:58"},{"pos":3,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"28:58"},{"pos":4,"ar":"قَرْيَةٍۭ","en_gloss":"a town","transliteration":"qaryatin","verse_key":"28:58"},{"pos":5,"ar":"بَطِرَتْ","en_gloss":"which exulted","transliteration":"baṭirat","verse_key":"28:58"},{"pos":6,"ar":"مَعِيشَتَهَا ۖ","en_gloss":"(in) its means of livelihood","transliteration":"maʿīshatahā","verse_key":"28:58"},{"pos":7,"ar":"فَتِلْكَ","en_gloss":"And these","transliteration":"fatil'ka","verse_key":"28:58"},{"pos":8,"ar":"مَسَـٰكِنُهُمْ","en_gloss":"(are) their dwellings","transliteration":"masākinuhum","verse_key":"28:58"},{"pos":9,"ar":"لَمْ","en_gloss":"not","transliteration":"lam","verse_key":"28:58"},{"pos":10,"ar":"تُسْكَن","en_gloss":"have been inhabited","transliteration":"tus'kan","verse_key":"28:58"},{"pos":11,"ar":"مِّنۢ","en_gloss":"after them","transliteration":"min","verse_key":"28:58"},{"pos":12,"ar":"بَعْدِهِمْ","en_gloss":"after them","transliteration":"baʿdihim","verse_key":"28:58"},{"pos":13,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"28:58"},{"pos":14,"ar":"قَلِيلًۭا ۖ","en_gloss":"a little","transliteration":"qalīlan","verse_key":"28:58"},{"pos":15,"ar":"وَكُنَّا","en_gloss":"And indeed, [We]","transliteration":"wakunnā","verse_key":"28:58"},{"pos":16,"ar":"نَحْنُ","en_gloss":"We","transliteration":"naḥnu","verse_key":"28:58"},{"pos":17,"ar":"ٱلْوَٰرِثِينَ","en_gloss":"(are) the inheritors","transliteration":"l-wārithīna","verse_key":"28:58"},{"pos":18,"ar":"٥٨","en_gloss":"(58)","transliteration":"","verse_key":"28:58"}]},{"verse_key":"28:59","surah":28,"ayah":59,"ar_uthmani":"وَمَا كَانَ رَبُّكَ مُهْلِكَ ٱلْقُرَىٰ حَتَّىٰ يَبْعَثَ فِىٓ أُمِّهَا رَسُولًا يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِنَا ۚ وَمَا كُنَّا مُهْلِكِى ٱلْقُرَىٰٓ إِلَّا وَأَهْلُهَا ظَـٰلِمُونَ","en_translation_id":85,"en":"Your Lord would never destroy towns without first raising a messenger in their midst to recite Our messages to them, nor would We destroy towns unless their inhabitants were evildoers.","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"28:59"},{"pos":2,"ar":"كَانَ","en_gloss":"was","transliteration":"kāna","verse_key":"28:59"},{"pos":3,"ar":"رَبُّكَ","en_gloss":"your Lord","transliteration":"rabbuka","verse_key":"28:59"},{"pos":4,"ar":"مُهْلِكَ","en_gloss":"(the) one to destroy","transliteration":"muh'lika","verse_key":"28:59"},{"pos":5,"ar":"ٱلْقُرَىٰ","en_gloss":"the towns","transliteration":"l-qurā","verse_key":"28:59"},{"pos":6,"ar":"حَتَّىٰ","en_gloss":"until","transliteration":"ḥattā","verse_key":"28:59"},{"pos":7,"ar":"يَبْعَثَ","en_gloss":"He (had) sent","transliteration":"yabʿatha","verse_key":"28:59"},{"pos":8,"ar":"فِىٓ","en_gloss":"in","transliteration":"fī","verse_key":"28:59"},{"pos":9,"ar":"أُمِّهَا","en_gloss":"their mother (town)","transliteration":"ummihā","verse_key":"28:59"},{"pos":10,"ar":"رَسُولًۭا","en_gloss":"a Messenger","transliteration":"rasūlan","verse_key":"28:59"},{"pos":11,"ar":"يَتْلُوا۟","en_gloss":"reciting","transliteration":"yatlū","verse_key":"28:59"},{"pos":12,"ar":"عَلَيْهِمْ","en_gloss":"to them","transliteration":"ʿalayhim","verse_key":"28:59"},{"pos":13,"ar":"ءَايَـٰتِنَا ۚ","en_gloss":"Our Verses","transliteration":"āyātinā","verse_key":"28:59"},{"pos":14,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"28:59"},{"pos":15,"ar":"كُنَّا","en_gloss":"We would be","transliteration":"kunnā","verse_key":"28:59"},{"pos":16,"ar":"مُهْلِكِى","en_gloss":"(the) one to destroy","transliteration":"muh'likī","verse_key":"28:59"},{"pos":17,"ar":"ٱلْقُرَىٰٓ","en_gloss":"the towns","transliteration":"l-qurā","verse_key":"28:59"},{"pos":18,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"28:59"},{"pos":19,"ar":"وَأَهْلُهَا","en_gloss":"while their people","transliteration":"wa-ahluhā","verse_key":"28:59"},{"pos":20,"ar":"ظَـٰلِمُونَ","en_gloss":"(were) wrongdoers","transliteration":"ẓālimūna","verse_key":"28:59"},{"pos":21,"ar":"٥٩","en_gloss":"(59)","transliteration":"","verse_key":"28:59"}]}]}