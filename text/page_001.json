{"page":1,"verses":[{"verse_key":"1:1","surah":1,"ayah":1,"ar_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","en_translation_id":85,"en":"In the name of God, the Lord of Mercy, the Giver of Mercy!","words":[{"pos":1,"ar":"بِسْمِ","en_gloss":"In (the) name","transliteration":"bis'mi","verse_key":"1:1"},{"pos":2,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"1:1"},{"pos":3,"ar":"ٱلرَّحْمَـٰنِ","en_gloss":"the Most Gracious","transliteration":"l-raḥmāni","verse_key":"1:1"},{"pos":4,"ar":"ٱلرَّحِيمِ","en_gloss":"the Most Merciful","transliteration":"l-raḥīmi","verse_key":"1:1"},{"pos":5,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"1:1"}]},{"verse_key":"1:2","surah":1,"ayah":2,"ar_uthmani":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","en_translation_id":85,"en":"Praise belongs to God, Lord of the Worlds,","words":[{"pos":1,"ar":"ٱلْحَمْدُ","en_gloss":"All praises and thanks","transliteration":"al-ḥamdu","verse_key":"1:2"},{"pos":2,"ar":"لِلَّهِ","en_gloss":"(be) to Allah","transliteration":"lillahi","verse_key":"1:2"},{"pos":3,"ar":"رَبِّ","en_gloss":"the Lord","transliteration":"rabbi","verse_key":"1:2"},{"pos":4,"ar":"ٱلْعَـٰلَمِينَ","en_gloss":"of the universe","transliteration":"l-ʿālamīna","verse_key":"1:2"},{"pos":5,"ar":"٢","en_gloss":"(2)","transliteration":"","verse_key":"1:2"}]},{"verse_key":"1:3","surah":1,"ayah":3,"ar_uthmani":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","en_translation_id":85,"en":"the Lord of Mercy, the Giver of Mercy,","words":[{"pos":1,"ar":"ٱلرَّحْمَـٰنِ","en_gloss":"The Most Gracious","transliteration":"al-raḥmāni","verse_key":"1:3"},{"pos":2,"ar":"ٱلرَّحِيمِ","en_gloss":"the Most Merciful","transliteration":"l-raḥīmi","verse_key":"1:3"},{"pos":3,"ar":"٣","en_gloss":"(3)","transliteration":"","verse_key":"1:3"}]},{"verse_key":"1:4","surah":1,"ayah":4,"ar_uthmani":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","en_translation_id":85,"en":"Master of the Day of Judgement.","words":[{"pos":1,"ar":"مَـٰلِكِ","en_gloss":"(The) Master","transliteration":"māliki","verse_key":"1:4"},{"pos":2,"ar":"يَوْمِ","en_gloss":"(of the) Day","transliteration":"yawmi","verse_key":"1:4"},{"pos":3,"ar":"ٱلدِّينِ","en_gloss":"(of the) Judgment","transliteration":"l-dīni","verse_key":"1:4"},{"pos":4,"ar":"٤","en_gloss":"(4)","transliteration":"","verse_key":"1:4"}]},{"verse_key":"1:5","surah":1,"ayah":5,"ar_uthmani":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","en_translation_id":85,"en":"It is You we worship; it is You we ask for help.","words":[{"pos":1,"ar":"إِيَّاكَ","en_gloss":"You Alone","transliteration":"iyyāka","verse_key":"1:5"},{"pos":2,"ar":"نَعْبُدُ","en_gloss":"we worship","transliteration":"naʿbudu","verse_key":"1:5"},{"pos":3,"ar":"وَإِيَّاكَ","en_gloss":"and You Alone","transliteration":"wa-iyyāka","verse_key":"1:5"},{"pos":4,"ar":"نَسْتَعِينُ","en_gloss":"we ask for help","transliteration":"nastaʿīnu","verse_key":"1:5"},{"pos":5,"ar":"٥","en_gloss":"(5)","transliteration":"","verse_key":"1:5"}]},{"verse_key":"1:6","surah":1,"ayah":6,"ar_uthmani":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","en_translation_id":85,"en":"Guide us to the straight path:","words":[{"pos":1,"ar":"ٱهْدِنَا","en_gloss":"Guide us","transliteration":"ih'dinā","verse_key":"1:6"},{"pos":2,"ar":"ٱلصِّرَٰطَ","en_gloss":"(to) the path","transliteration":"l-ṣirāṭa","verse_key":"1:6"},{"pos":3,"ar":"ٱلْمُسْتَقِيمَ","en_gloss":"the straight","transliteration":"l-mus'taqīma","verse_key":"1:6"},{"pos":4,"ar":"٦","en_gloss":"(6)","transliteration":"","verse_key":"1:6"}]},{"verse_key":"1:7","surah":1,"ayah":7,"ar_uthmani":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","en_translation_id":85,"en":"the path of those You have blessed, those who incur no anger and who have not gone astray.","words":[{"pos":1,"ar":"صِرَٰطَ","en_gloss":"(The) path","transliteration":"ṣirāṭa","verse_key":"1:7"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"(of) those","transliteration":"alladhīna","verse_key":"1:7"},{"pos":3,"ar":