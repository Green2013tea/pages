":"64:8"},{"pos":9,"ar":"تَعْمَلُونَ","en_gloss":"you do","transliteration":"taʿmalūna","verse_key":"64:8"},{"pos":10,"ar":"خَبِيرٌۭ","en_gloss":"(is) All-Aware","transliteration":"khabīrun","verse_key":"64:8"},{"pos":11,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"64:8"}]},{"verse_key":"64:9","surah":64,"ayah":9,"ar_uthmani":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِ ۖ ذَٰلِكَ يَوْمُ ٱلتَّغَابُنِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ وَيَعْمَلْ صَـٰلِحًا يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُدْخِلْهُ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ","en_translation_id":85,"en":"When He gathers you for the Day of Gathering, the Day of mutual neglect, He will cancel the sins of those who believed in Him and acted righteously: He will admit them into Gardens graced with flowing streams, there to remain for ever- the supreme triumph.","words":[{"pos":1,"ar":"يَوْمَ","en_gloss":"(The) Day","transliteration":"yawma","verse_key":"64:9"},{"pos":2,"ar":"يَجْمَعُكُمْ","en_gloss":"He will assemble you","transliteration":"yajmaʿukum","verse_key":"64:9"},{"pos":3,"ar":"لِيَوْمِ","en_gloss":"for (the) Day","transliteration":"liyawmi","verse_key":"64:9"},{"pos":4,"ar":"ٱلْجَمْعِ ۖ","en_gloss":"(of) the Assembly","transliteration":"l-jamʿi","verse_key":"64:9"},{"pos":5,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"64:9"},{"pos":6,"ar":"يَوْمُ","en_gloss":"(will be the) Day","transliteration":"yawmu","verse_key":"64:9"},{"pos":7,"ar":"ٱلتَّغَابُنِ ۗ","en_gloss":"(of) mutual loss and gain","transliteration":"l-taghābuni","verse_key":"64:9"},{"pos":8,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"64:9"},{"pos":9,"ar":"يُؤْمِنۢ","en_gloss":"believes","transliteration":"yu'min","verse_key":"64:9"},{"pos":10,"ar":"بِٱللَّهِ","en_gloss":"in Allah","transliteration":"bil-lahi","verse_key":"64:9"},{"pos":11,"ar":"وَيَعْمَلْ","en_gloss":"and does","transliteration":"wayaʿmal","ve