 ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَكُمْ هُزُوًا وَلَعِبًا مِّنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ مِن قَبْلِكُمْ وَٱلْكُفَّارَ أَوْلِيَآءَ ۚ وَٱتَّقُوا۟ ٱللَّهَ إِن كُنتُم مُّؤْمِنِينَ","en_translation_id":85,"en":"You who believe, do not take as allies those who ridicule your religion and make fun of it- whether people who were given the Scripture before you, or disbelievers- and be mindful of God if you are true believers.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"5:57"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"5:57"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"5:57"},{"pos":4,"ar":"لَا","en_gloss":"(Do) not","transliteration":"lā","verse_key":"5:57"},{"pos":5,"ar":"تَتَّخِذُوا۟","en_gloss":"take","transliteration":"tattakhidhū","verse_key":"5:57"},{"pos":6,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"5:57"},{"pos":7,"ar":"ٱتَّخَذُوا۟","en_gloss":"take","transliteration":"ittakhadhū","verse_key":"5:57"},{"pos":8,"ar":"دِينَكُمْ","en_gloss":"your religion","transliteration":"dīnakum","verse_key":"5:57"},{"pos":9,"ar":"هُزُوًۭا","en_gloss":"(in) ridicule","transliteration":"huzuwan","verse_key":"5:57"},{"pos":10,"ar":"وَلَعِبًۭا","en_gloss":"and fun","transliteration":"walaʿiban","verse_key":"5:57"},{"pos":11,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"5:57"},{"pos":12,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"5:57"},{"pos":13,"ar":"أُوتُوا۟","en_gloss":"are given","transliteration":"ūtū","verse_key":"5:57"},{"pos":14,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","verse_key":"5:57"},{"pos":15,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"5:57"},{"pos":16,"ar":"قَبْلِكُمْ","en_gloss":"before you","transliteration":"qablikum","verse_key":"5:57"},{"pos":17,"ar"