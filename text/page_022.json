144"},{"pos":11,"ar":"وَجْهَكَ","en_gloss":"your face","transliteration":"wajhaka","verse_key":"2:144"},{"pos":12,"ar":"شَطْرَ","en_gloss":"towards the direction","transliteration":"shaṭra","verse_key":"2:144"},{"pos":13,"ar":"ٱلْمَسْجِدِ","en_gloss":"(of) Al-Masjid","transliteration":"l-masjidi","verse_key":"2:144"},{"pos":14,"ar":"ٱلْحَرَامِ ۚ","en_gloss":"Al-Haraam","transliteration":"l-ḥarāmi","verse_key":"2:144"},{"pos":15,"ar":"وَحَيْثُ","en_gloss":"and wherever","transliteration":"waḥaythu","verse_key":"2:144"},{"pos":16,"ar":"مَا","en_gloss":"that","transliteration":"mā","verse_key":"2:144"},{"pos":17,"ar":"كُنتُمْ","en_gloss":"you are","transliteration":"kuntum","verse_key":"2:144"},{"pos":18,"ar":"فَوَلُّوا۟","en_gloss":"[so] turn","transliteration":"fawallū","verse_key":"2:144"},{"pos":19,"ar":"وُجُوهَكُمْ","en_gloss":"your faces","transliteration":"wujūhakum","verse_key":"2:144"},{"pos":20,"ar":"شَطْرَهُۥ ۗ","en_gloss":"(in) its direction","transliteration":"shaṭrahu","verse_key":"2:144"},{"pos":21,"ar":"وَإِنَّ","en_gloss":"And indeed","transliteration":"wa-inna","verse_key":"2:144"},{"pos":22,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"2:144"},{"pos":23,"ar":"أُوتُوا۟","en_gloss":"were given","transliteration":"ūtū","verse_key":"2:144"},{"pos":24,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","verse_key":"2:144"},{"pos":25,"ar":"لَيَعْلَمُونَ","en_gloss":"surely know","transliteration":"layaʿlamūna","verse_key":"2:144"},{"pos":26,"ar":"أَنَّهُ","en_gloss":"that it","transliteration":"annahu","verse_key":"2:144"},{"pos":27,"ar":"ٱلْحَقُّ","en_gloss":"(is) the truth","transliteration":"l-ḥaqu","verse_key":"2:144"},{"pos":28,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"2:144"},{"pos":29,"ar":"رَّبِّهِمْ ۗ","en_gloss":"their Lord","transliteration":"rabbihim","verse_key":"2:144"},{"pos":30,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"2:144"},{"pos"