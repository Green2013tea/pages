{"page":472,"verses":[{"verse_key":"40:41","surah":40,"ayah":41,"ar_uthmani":"۞ وَيَـٰقَوْمِ مَا لِىٓ أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ إِلَى ٱلنَّارِ","en_translation_id":85,"en":"My people, why do I call you to salvation when you call me to the Fire?","words":[{"pos":1,"ar":"۞ وَيَـٰقَوْمِ","en_gloss":"And O my people","transliteration":"wayāqawmi","verse_key":"40:41"},{"pos":2,"ar":"مَا","en_gloss":"What (is)","transliteration":"mā","verse_key":"40:41"},{"pos":3,"ar":"لِىٓ","en_gloss":"for me","transliteration":"lī","verse_key":"40:41"},{"pos":4,"ar":"أَدْعُوكُمْ","en_gloss":"(that) I call you","transliteration":"adʿūkum","verse_key":"40:41"},{"pos":5,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"40:41"},{"pos":6,"ar":"ٱلنَّجَوٰةِ","en_gloss":"the salvation","transliteration":"l-najati","verse_key":"40:41"},{"pos":7,"ar":"وَتَدْعُونَنِىٓ","en_gloss":"while you call me","transliteration":"watadʿūnanī","verse_key":"40:41"},{"pos":8,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"40:41"},{"pos":9,"ar":"ٱلنَّارِ","en_gloss":"the Fire","transliteration":"l-nāri","verse_key":"40:41"},{"pos":10,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"40:41"}]},{"verse_key":"40:42","surah":40,"ayah":42,"ar_uthmani":"تَدْعُونَنِى لِأَكْفُرَ بِٱللَّهِ وَأُشْرِكَ بِهِۦ مَا لَيْسَ لِى بِهِۦ عِلْمٌ وَأَنَا۠ أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ ٱلْغَفَّـٰرِ","en_translation_id":85,"en":"You call me to disbelieve in God and to associate with Him things of which I have no knowledge; I call you to the Mighty, the Forgiving One.","words":[{"pos":1,"ar":"تَدْعُونَنِى","en_gloss":"You call me","transliteration":"tadʿūnanī","verse_key":"40:42"},{"pos":2,"ar":"لِأَكْفُرَ","en_gloss":"that I disbelieve","transliteration":"li-akfura","verse_key":"40:42"},{"pos":3,"ar":"بِٱللَّهِ","en_gloss":"in Allah","transliteration":"bil-lahi","verse_key":"40:42"},{"pos":4,"ar":"وَأُشْرِكَ","en_gloss":"and (to) associate","transliteration":"wa-ush'rika",