{"page":595,"verses":[{"verse_key":"90:19","surah":90,"ayah":19,"ar_uthmani":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","en_translation_id":85,"en":"but those who disbelieve in Our revelations will be on the left-hand side,","words":[{"pos":1,"ar":"وَٱلَّذِينَ","en_gloss":"But those who","transliteration":"wa-alladhīna","verse_key":"90:19"},{"pos":2,"ar":"كَفَرُوا۟","en_gloss":"disbelieve","transliteration":"kafarū","verse_key":"90:19"},{"pos":3,"ar":"بِـَٔايَـٰتِنَا","en_gloss":"in Our Verses","transliteration":"biāyātinā","verse_key":"90:19"},{"pos":4,"ar":"هُمْ","en_gloss":"they","transliteration":"hum","verse_key":"90:19"},{"pos":5,"ar":"أَصْحَـٰبُ","en_gloss":"(are the) companions","transliteration":"aṣḥābu","verse_key":"90:19"},{"pos":6,"ar":"ٱلْمَشْـَٔمَةِ","en_gloss":"(of) the left (hand)","transliteration":"l-mashamati","verse_key":"90:19"},{"pos":7,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"90:19"}]},{"verse_key":"90:20","surah":90,"ayah":20,"ar_uthmani":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ","en_translation_id":85,"en":"and the Fire will close in on them.","words":[{"pos":1,"ar":"عَلَيْهِمْ","en_gloss":"Over them","transliteration":"ʿalayhim","verse_key":"90:20"},{"pos":2,"ar":"نَارٌۭ","en_gloss":"(will be the) Fire","transliteration":"nārun","verse_key":"90:20"},{"pos":3,"ar":"مُّؤْصَدَةٌۢ","en_gloss":"closed in","transliteration":"mu'ṣadatun","verse_key":"90:20"},{"pos":4,"ar":"٢٠","en_gloss":"(20)","transliteration":"","verse_key":"90:20"}]},{"verse_key":"91:1","surah":91,"ayah":1,"ar_uthmani":" وَٱلشَّمْسِ وَضُحَىٰهَا","en_translation_id":85,"en":"By the sun in its morning brightness","words":[{"pos":1,"ar":"وَٱلشَّمْسِ","en_gloss":"By the sun","transliteration":"wal-shamsi","verse_key":"91:1"},{"pos":2,"ar":"وَضُحَىٰهَا","en_gloss":"and its brightness","transliteration":"waḍuḥāhā","verse_key":"91:1"},{"pos":3,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"91:1"}]},{"verse_key":"91:2","surah":91,"ay