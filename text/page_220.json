ransliteration":"alladhīna","verse_key":"10:100"},{"pos":13,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"10:100"},{"pos":14,"ar":"يَعْقِلُونَ","en_gloss":"use reason","transliteration":"yaʿqilūna","verse_key":"10:100"},{"pos":15,"ar":"١٠٠","en_gloss":"(100)","transliteration":"","verse_key":"10:100"}]},{"verse_key":"10:101","surah":10,"ayah":101,"ar_uthmani":"قُلِ ٱنظُرُوا۟ مَاذَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَا تُغْنِى ٱلْـَٔايَـٰتُ وَٱلنُّذُرُ عَن قَوْمٍ لَّا يُؤْمِنُونَ","en_translation_id":85,"en":"Say, ‘Look at what is in the heavens and on the earth.’ But what use are signs and warnings to people who will not believe?","words":[{"pos":1,"ar":"قُلِ","en_gloss":"Say","transliteration":"quli","verse_key":"10:101"},{"pos":2,"ar":"ٱنظُرُوا۟","en_gloss":"See","transliteration":"unẓurū","verse_key":"10:101"},{"pos":3,"ar":"مَاذَا","en_gloss":"what","transliteration":"mādhā","verse_key":"10:101"},{"pos":4,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"10:101"},{"pos":5,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"10:101"},{"pos":6,"ar":"وَٱلْأَرْضِ ۚ","en_gloss":"and the earth","transliteration":"wal-arḍi","verse_key":"10:101"},{"pos":7,"ar":"وَمَا","en_gloss":"But not","transliteration":"wamā","verse_key":"10:101"},{"pos":8,"ar":"تُغْنِى","en_gloss":"will avail","transliteration":"tugh'nī","verse_key":"10:101"},{"pos":9,"ar":"ٱلْـَٔايَـٰتُ","en_gloss":"the Signs","transliteration":"l-āyātu","verse_key":"10:101"},{"pos":10,"ar":"وَٱلنُّذُرُ","en_gloss":"and the warners","transliteration":"wal-nudhuru","verse_key":"10:101"},{"pos":11,"ar":"عَن","en_gloss":"to","transliteration":"ʿan","verse_key":"10:101"},{"pos":12,"ar":"قَوْمٍۢ","en_gloss":"a people","transliteration":"qawmin","verse_key":"10:101"},{"pos":13,"ar":"لَّا","en_gloss":"(who do) not","transliteration":"lā","verse_key":"10:101"},{"pos":14,"ar":"يُؤْمِنُونَ","en_gloss":"believe","transliteration":"yu'minūna","verse_key":"10:101"},{"pos":15,"ar":"١٠١","en_gloss":"(101)","transliteration":"","verse_key":"10:101"}]},{"verse_key":"10:102","surah":10,"ayah":102,"ar_uthmani":"فَهَلْ يَنتَظِرُونَ إِلَّا مِثْلَ أَيَّامِ ٱلَّذِينَ خَلَوْا۟ مِن قَبْلِهِمْ ۚ قُلْ فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم مِّنَ ٱلْمُنتَظِرِينَ","en_translation_id":85,"en":"What are they waiting for but the punishment that came to those before them? Say, ‘Wait then, I am waiting too.’","words":[{"pos":1,"ar":"فَهَلْ","en_gloss":"Then do","transliteration":"fahal","verse_key":"10:102"},{"pos":2,"ar":"يَنتَظِرُونَ","en_gloss":"they wait","transliteration":"yantaẓirūna","verse_key":"10:102"},{"pos":3,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"10:102"},{"pos":4,"ar":"مِثْلَ","en_gloss":"like","transliteration":"mith'la","verse_key":"10:102"},{"pos":5,"ar":"أَيَّامِ","en_gloss":"the days","transliteration":"ayyāmi","verse_key":"10:102"},{"pos":6,"ar":"ٱلَّذِينَ","en_gloss":"(of) those who","transliteration":"alladhīna","verse_key":"10:102"},{"pos":7,"ar":"خَلَوْا۟","en_gloss":"passed away","transliteration":"khalaw","verse_key":"10:102"},{"pos":8,"ar":"مِن","en_gloss":"before them","transliteration":"min","verse_key":"10:102"},{"pos":9,"ar":"قَبْلِهِمْ ۚ","en_gloss":"before them","transliteration":"qablihim","verse_key":"10:102"},{"pos":10,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"10:102"},{"pos":11,"ar":"فَٱنتَظِرُوٓا۟","en_gloss":"Then wait","transliteration":"fa-intaẓirū","verse_key":"10:102"},{"pos":12,"ar":"إِنِّى","en_gloss":"indeed, I (am)","transliteration":"innī","verse_key":"10:102"},{"pos":13,"ar":"مَعَكُم","en_gloss":"with you","transliteration":"maʿakum","verse_key":"10:102"},{"pos":14,"ar":"مِّنَ","en_gloss":"among","transliteration":"mina","verse_key":"10:102"},{"pos":15,"ar":"ٱلْمُنتَظِرِينَ","en_gloss":"the ones who wait","transliteration":"l-muntaẓirīna","verse_key":"10:102"},{"pos":16,"ar":"١٠٢","en_gloss":"(102)","transliteration":"","verse_key":"10:102"}]},{"verse_key":"10:103","surah":10,"ayah":103,"ar_uthmani":"ثُمَّ نُنَجِّى رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ حَقًّا عَلَيْنَا نُنجِ ٱلْمُؤْمِنِينَ","en_translation_id":85,"en":"In the end We shall save Our messengers and the believers. We take it upon Ourself to save the believers.","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"10:103"},{"pos":2,"ar":"نُنَجِّى","en_gloss":"We will save","transliteration":"nunajjī","verse_key":"10:103"},{"pos":3,"ar":"رُسُلَنَا","en_gloss":"Our Messengers","transliteration":"rusulanā","verse_key":"10:103"},{"pos":4,"ar":"وَٱلَّذِينَ","en_gloss":"and those who","transliteration":"wa-alladhīna","verse_key":"10:103"},{"pos":5,"ar":"ءَامَنُوا۟ ۚ","en_gloss":"believe","transliteration":"āmanū","verse_key":"10:103"},{"pos":6,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"10:103"},{"pos":7,"ar":"حَقًّا","en_gloss":"(it is) an obligation","transliteration":"ḥaqqan","verse_key":"10:103"},{"pos":8,"ar":"عَلَيْنَا","en_gloss":"upon Us","transliteration":"ʿalaynā","verse_key":"10:103"},{"pos":9,"ar":"نُنجِ","en_gloss":"(that) We save","transliteration":"nunji","verse_key":"10:103"},{"pos":10,"ar":"ٱلْمُؤْمِنِينَ","en_gloss":"the believers","transliteration":"l-mu'minīna","verse_key":"10:103"},{"pos":11,"ar":"١٠٣","en_gloss":"(103)","transliteration":"","verse_key":"10:103"}]},{"verse_key":"10:104","surah":10,"ayah":104,"ar_uthmani":"قُلْ يَـٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمْ فِى شَكٍّ مِّن دِينِى فَلَآ أَعْبُدُ ٱلَّذِينَ تَعْبُدُونَ مِن دُونِ ٱللَّهِ وَلَـٰكِنْ أَعْبُدُ ٱللَّهَ ٱلَّذِى يَتَوَفَّىٰكُمْ ۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ ٱلْمُؤْمِنِينَ","en_translation_id":85,"en":"[Prophet] say, ‘People, even if you are in doubt about my religion, I do not worship those you worship other than God, but I worship God who will cause you to die, and I am commanded to be a believer.’","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key