n","verse_key":"27:62"},{"pos":2,"ar":"يُجِيبُ","en_gloss":"responds","transliteration":"yujību","verse_key":"27:62"},{"pos":3,"ar":"ٱلْمُضْطَرَّ","en_gloss":"(to) the distressed one","transliteration":"l-muḍ'ṭara","verse_key":"27:62"},{"pos":4,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"27:62"},{"pos":5,"ar":"دَعَاهُ","en_gloss":"he calls Him","transliteration":"daʿāhu","verse_key":"27:62"},{"pos":6,"ar":"وَيَكْشِفُ","en_gloss":"and He removes","transliteration":"wayakshifu","verse_key":"27:62"},{"pos":7,"ar":"ٱلسُّوٓءَ","en_gloss":"the evil","transliteration":"l-sūa","verse_key":"27:62"},{"pos":8,"ar":"وَيَجْعَلُكُمْ","en_gloss":"and makes you","transliteration":"wayajʿalukum","verse_key":"27:62"},{"pos":9,"ar":"خُلَفَآءَ","en_gloss":"inheritors","transliteration":"khulafāa","verse_key":"27:62"},{"pos":10,"ar":"ٱلْأَرْضِ ۗ","en_gloss":"(of) the earth","transliteration":"l-arḍi","verse_key":"27:62"},{"pos":11,"ar":"أَءِلَـٰهٌۭ","en_gloss":"Is there any god","transliteration":"a-ilāhun","verse_key":"27:62"},{"pos":12,"ar":"مَّعَ","en_gloss":"with","transliteration":"maʿa","verse_key":"27:62"},{"pos":13,"ar":"ٱللَّهِ ۚ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"27:62"},{"pos":14,"ar":"قَلِيلًۭا","en_gloss":"Little","transliteration":"qalīlan","verse_key":"27:62"},{"pos":15,"ar":"مَّا","en_gloss":"(is) what","transliteration":"mā","verse_key":"27:62"},{"pos":16,"ar":"تَذَكَّرُونَ","en_gloss":"you remember","transliteration":"tadhakkarūna","verse_key":"27:62"},{"pos":17,"ar":"٦٢","en_gloss":"(62)","transliteration":"","verse_key":"27:62"}]},{"verse_key":"27:63","surah":27,"ayah":63,"ar_uthmani":"أَمَّن يَهْدِيكُمْ فِى ظُلُمَـٰتِ ٱلْبَرِّ وَٱلْبَحْرِ وَمَن يُرْسِلُ ٱلرِّيَـٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦٓ ۗ أَءِلَـٰهٌ مَّعَ ٱللَّهِ ۚ تَعَـٰلَى ٱللَّهُ عَمَّا يُشْرِكُونَ","en_translation_id":85,"en":"Who is it that guides you through the darkness on land and sea? Who sends the winds as heralds of good news before His merc