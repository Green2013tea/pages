","transliteration":"yawma","verse_key":"58:6"},{"pos":2,"ar":"يَبْعَثُهُمُ","en_gloss":"(when) Allah will raise them","transliteration":"yabʿathuhumu","verse_key":"58:6"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"(when) Allah will raise them","transliteration":"l-lahu","verse_key":"58:6"},{"pos":4,"ar":"جَمِيعًۭا","en_gloss":"all","transliteration":"jamīʿan","verse_key":"58:6"},{"pos":5,"ar":"فَيُنَبِّئُهُم","en_gloss":"and inform them","transliteration":"fayunabbi-uhum","verse_key":"58:6"},{"pos":6,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"58:6"},{"pos":7,"ar":"عَمِلُوٓا۟ ۚ","en_gloss":"they did","transliteration":"ʿamilū","verse_key":"58:6"},{"pos":8,"ar":"أَحْصَىٰهُ","en_gloss":"Allah has recorded it","transliteration":"aḥṣāhu","verse_key":"58:6"},{"pos":9,"ar":"ٱللَّهُ","en_gloss":"Allah has recorded it","transliteration":"l-lahu","verse_key":"58:6"},{"pos":10,"ar":"وَنَسُوهُ ۚ","en_gloss":"while they forgot it","transliteration":"wanasūhu","verse_key":"58:6"},{"pos":11,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"58:6"},{"pos":12,"ar":"عَلَىٰ","en_gloss":"(is) over","transliteration":"ʿalā","verse_key":"58:6"},{"pos":13,"ar":"كُلِّ","en_gloss":"all","transliteration":"kulli","verse_key":"58:6"},{"pos":14,"ar":"شَىْءٍۢ","en_gloss":"things","transliteration":"shayin","verse_key":"58:6"},{"pos":15,"ar":"شَهِيدٌ","en_gloss":"a Witness","transliteration":"shahīdun","verse_key":"58:6"},{"pos":16,"ar":"٦","en_gloss":"(6)","transliteration":"","verse_key":"58:6"}]}]}