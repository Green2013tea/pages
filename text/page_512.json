:"لَكَ","en_gloss":"to you","transliteration":"laka","verse_key":"48:11"},{"pos":3,"ar":"ٱلْمُخَلَّفُونَ","en_gloss":"those who remained behind","transliteration":"l-mukhalafūna","verse_key":"48:11"},{"pos":4,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"48:11"},{"pos":5,"ar":"ٱلْأَعْرَابِ","en_gloss":"the Bedouins","transliteration":"l-aʿrābi","verse_key":"48:11"},{"pos":6,"ar":"شَغَلَتْنَآ","en_gloss":"Kept us busy","transliteration":"shaghalatnā","verse_key":"48:11"},{"pos":7,"ar":"أَمْوَٰلُنَا","en_gloss":"our properties","transliteration":"amwālunā","verse_key":"48:11"},{"pos":8,"ar":"وَأَهْلُونَا","en_gloss":"and our families","transliteration":"wa-ahlūnā","verse_key":"48:11"},{"pos":9,"ar":"فَٱسْتَغْفِرْ","en_gloss":"so ask forgiveness","transliteration":"fa-is'taghfir","verse_key":"48:11"},{"pos":10,"ar":"لَنَا ۚ","en_gloss":"for us","transliteration":"lanā","verse_key":"48:11"},{"pos":11,"ar":"يَقُولُونَ","en_gloss":"They say","transliteration":"yaqūlūna","verse_key":"48:11"},{"pos":12,"ar":"بِأَلْسِنَتِهِم","en_gloss":"with their tongues","transliteration":"bi-alsinatihim","verse_key":"48:11"},{"pos":13,"ar":"مَّا","en_gloss":"what","transliteration":"mā","verse_key":"48:11"},{"pos":14,"ar":"لَيْسَ","en_gloss":"is not","transliteration":"laysa","verse_key":"48:11"},{"pos":15,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"48:11"},{"pos":16,"ar":"قُلُوبِهِمْ ۚ","en_gloss":"their hearts","transliteration":"qulūbihim","verse_key":"48:11"},{"pos":17,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"48:11"},{"pos":18,"ar":"فَمَن","en_gloss":"Then who","transliteration":"faman","verse_key":"48:11"},{"pos":19,"ar":"يَمْلِكُ","en_gloss":"has power","transliteration":"yamliku","verse_key":"48:11"},{"pos":20,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"48:11"},{"pos":21,"ar":"مِّنَ","en_gloss":"against","transliteration":"mina","verse_key":"48:11"},{"pos":22,"ar":"ٱللَّهِ","en_gloss":"Al