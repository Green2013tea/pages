ُحَرِّمُ عَلَيْهِمُ ٱلْخَبَـٰٓئِثَ وَيَضَعُ عَنْهُمْ إِصْرَهُمْ وَٱلْأَغْلَـٰلَ ٱلَّتِى كَانَتْ عَلَيْهِمْ ۚ فَٱلَّذِينَ ءَامَنُوا۟ بِهِۦ وَعَزَّرُوهُ وَنَصَرُوهُ وَٱتَّبَعُوا۟ ٱلنُّورَ ٱلَّذِىٓ أُنزِلَ مَعَهُۥٓ ۙ أُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ","en_translation_id":85,"en":"who follow the Messenger- the unlettered prophet they find described in the Torah that is with them, and in the Gospel- who commands them to do right and forbids them to do wrong, who makes good things lawful to them and bad things unlawful, and relieves them of their burdens, and the iron collars that were on them. So it is those who believe him, honour and help him, and who follow the light which has been sent down with him, who will succeed.’","words":[{"pos":1,"ar":"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"7:157"},{"pos":2,"ar":"يَتَّبِعُونَ","en_gloss":"follow","transliteration":"yattabiʿūna","verse_key":"7:157"},{"pos":3,"ar":"ٱلرَّسُولَ","en_gloss":"the Messenger","transliteration":"l-rasūla","verse_key":"7:157"},{"pos":4,"ar":"ٱلنَّبِىَّ","en_gloss":"the Prophet","transliteration":"l-nabiya","verse_key":"7:157"},{"pos":5,"ar":"ٱلْأُمِّىَّ","en_gloss":"the unlettered","transliteration":"l-umiya","verse_key":"7:157"},{"pos":6,"ar":"ٱلَّذِى","en_gloss":"whom","transliteration":"alladhī","verse_key":"7:157"},{"pos":7,"ar":"يَجِدُونَهُۥ","en_gloss":"they find him","transliteration":"yajidūnahu","verse_key":"7:157"},{"pos":8,"ar":"مَكْتُوبًا","en_gloss":"written","transliteration":"maktūban","verse_key":"7:157"},{"pos":9,"ar":"عِندَهُمْ","en_gloss":"with them","transliteration":"ʿindahum","verse_key":"7:157"},{"pos":10,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"7:157"},{"pos":11,"ar":"ٱلتَّوْرَىٰةِ","en_gloss":"the Taurat","transliteration":"l-tawrāti","verse_key":"7:157"},{"pos":12,"ar":"وَٱلْإِنجِيلِ","en_gloss":"and the Injeel","transliteration":"wal-injīli","verse_key":"7:157"},{"pos":13,"ar":"يَأْمُرُهُم","en_gloss":"He commands th