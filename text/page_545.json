":30,"ar":"وَيُدْخِلُهُمْ","en_gloss":"And He will admit them","transliteration":"wayud'khiluhum","verse_key":"58:22"},{"pos":31,"ar":"جَنَّـٰتٍۢ","en_gloss":"(to) Gardens","transliteration":"jannātin","verse_key":"58:22"},{"pos":32,"ar":"تَجْرِى","en_gloss":"flow","transliteration":"tajrī","verse_key":"58:22"},{"pos":33,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"58:22"},{"pos":34,"ar":"تَحْتِهَا","en_gloss":"underneath it","transliteration":"taḥtihā","verse_key":"58:22"},{"pos":35,"ar":"ٱلْأَنْهَـٰرُ","en_gloss":"the rivers","transliteration":"l-anhāru","verse_key":"58:22"},{"pos":36,"ar":"خَـٰلِدِينَ","en_gloss":"will abide forever","transliteration":"khālidīna","verse_key":"58:22"},{"pos":37,"ar":"فِيهَا ۚ","en_gloss":"in it","transliteration":"fīhā","verse_key":"58:22"},{"pos":38,"ar":"رَضِىَ","en_gloss":"Allah is pleased","transliteration":"raḍiya","verse_key":"58:22"},{"pos":39,"ar":"ٱللَّهُ","en_gloss":"Allah is pleased","transliteration":"l-lahu","verse_key":"58:22"},{"pos":40,"ar":"عَنْهُمْ","en_gloss":"with them","transliteration":"ʿanhum","verse_key":"58:22"},{"pos":41,"ar":"وَرَضُوا۟","en_gloss":"and they are pleased","transliteration":"waraḍū","verse_key":"58:22"},{"pos":42,"ar":"عَنْهُ ۚ","en_gloss":"with Him","transliteration":"ʿanhu","verse_key":"58:22"},{"pos":43,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those","transliteration":"ulāika","verse_key":"58:22"},{"pos":44,"ar":"حِزْبُ","en_gloss":"(are the) party","transliteration":"ḥiz'bu","verse_key":"58:22"},{"pos":45,"ar":"ٱللَّهِ ۚ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"58:22"},{"pos":46,"ar":"أَلَآ","en_gloss":"No doubt","transliteration":"alā","verse_key":"58:22"},{"pos":47,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"58:22"},{"pos":48,"ar":"حِزْبَ","en_gloss":"(the) party","transliteration":"ḥiz'ba","verse_key":"58:22"},{"pos":49,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"58:22"},{"pos":50,"ar":"هُمُ","en_gloss":"they","transliteration":"humu","verse_key":"58:22"},{"pos":51,"ar":"ٱلْمُفْلِحُونَ","en_gloss":"(are) the successful ones","transliteration":"l-muf'liḥūna","verse_key":"58:22"},{"pos":52,"ar":"٢٢","en_gloss":"(22)","transliteration":"","verse_key":"58:22"}]},{"verse_key":"59:1","surah":59,"ayah":1,"ar_uthmani":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","en_translation_id":85,"en":"Everything in the heavens and earth glorifies God; He is the Almighty, the Wise.","words":[{"pos":1,"ar":"سَبَّحَ","en_gloss":"Glorifies","transliteration":"sabbaḥa","verse_key":"59:1"},{"pos":2,"ar":"لِلَّهِ","en_gloss":"[to] Allah","transliteration":"lillahi","verse_key":"59:1"},{"pos":3,"ar":"مَا","en_gloss":"whatever","transliteration":"mā","verse_key":"59:1"},{"pos":4,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"59:1"},{"pos":5,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"59:1"},{"pos":6,"ar":"وَمَا","en_gloss":"and whatever","transliteration":"wamā","verse_key":"59:1"},{"pos":7,"ar":"فِى","en_gloss":"(is) in","transliteration":"fī","verse_key":"59:1"},{"pos":8,"ar":"ٱلْأَرْضِ ۖ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"59:1"},{"pos":9,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"59:1"},{"pos":10,"ar":"ٱلْعَزِيزُ","en_gloss":"(is) the All-Mighty","transliteration":"l-ʿazīzu","verse_key":"59:1"},{"pos":11,"ar":"ٱلْحَكِيمُ","en_gloss":"the All-Wise","transliteration":"l-ḥakīmu","verse_key":"59:1"},{"pos":12,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"59:1"}]},{"verse_key":"59:2","surah":59,"ayah":2,"ar_uthmani":"هُوَ ٱلَّذِىٓ أَخْرَجَ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ مِن دِيَـٰرِهِمْ لِأَوَّلِ ٱلْحَشْرِ ۚ مَا ظَنَنتُمْ أَن يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا۟ ۖ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ ۚ يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَـٰٓأُو۟لِى ٱلْأَبْصَـٰرِ","en_translation_id":85,"en":"It was He who drove those of the People of the Book who broke faith out from their homes at the first gathering of forces––you [believers] never thought they would go, and they themselves thought their fortifications would protect them against God. God came up on them from where they least expected and put panic into their hearts: their homes were destroyed by their own hands, and the hands of the believers. Learn from this, all of you with insight!","words":[{"pos":1,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"59:2"},{"pos":2,"ar":"ٱلَّذِىٓ","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"59:2"},{"pos":3,"ar":"أَخْرَجَ","en_gloss":"expelled","transliteration":"akhraja","verse_key":"59:2"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"59:2"},{"pos":5,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"59:2"},{"pos":6,"ar":"مِنْ","en_gloss":"from","transliteration":"min","verse_key":"59:2"},{"pos":7,"ar":"أَهْلِ","en_gloss":"(the) People","transliteration":"ahli","verse_key":"59:2"},{"pos":8,"ar":"ٱلْكِتَـٰبِ","en_gloss":"(of) the Scripture","transliteration":"l-kitābi","verse_key":"59:2"},{"pos":9,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"59:2"},{"pos":10,"ar":"دِيَـٰرِهِمْ","en_gloss":"their homes","transliteration":"diyārihim","verse_key":"59:2"},{"pos":11,"ar":"لِأَوَّلِ","en_gloss":"at (the) first","transliteration":"li-awwali","verse_key":"59:2"},{"pos":12,"ar":"ٱلْحَشْرِ ۚ","en_gloss":"gathering","transliteration":"l-ḥashri","verse_key":"59:2"},{"pos":13,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"59:2"},{"pos":14,"ar":"ظَنَنتُمْ","en_gloss":"you think","transliteration":"ẓanantum","verse_key":"59:2"},{"pos":15,"ar":"أَن","en_gloss":"that","transliterati