:"لَأُعَذِّبَنَّهُۥ عَذَابًا شَدِيدًا أَوْ لَأَا۟ذْبَحَنَّهُۥٓ أَوْ لَيَأْتِيَنِّى بِسُلْطَـٰنٍ مُّبِينٍ","en_translation_id":85,"en":"I will punish him severely, or kill him, unless he brings me a convincing excuse for his absence.’","words":[{"pos":1,"ar":"لَأُعَذِّبَنَّهُۥ","en_gloss":"I will surely punish him","transliteration":"la-uʿadhibannahu","verse_key":"27:21"},{"pos":2,"ar":"عَذَابًۭا","en_gloss":"(with) a punishment","transliteration":"ʿadhāban","verse_key":"27:21"},{"pos":3,"ar":"شَدِيدًا","en_gloss":"severe","transliteration":"shadīdan","verse_key":"27:21"},{"pos":4,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"27:21"},{"pos":5,"ar":"لَأَا۟ذْبَحَنَّهُۥٓ","en_gloss":"I will surely slaughter him","transliteration":"laādh'baḥannahu","verse_key":"27:21"},{"pos":6,"ar":"أَوْ","en_gloss":"unless","transliteration":"aw","verse_key":"27:21"},{"pos":7,"ar":"لَيَأْتِيَنِّى","en_gloss":"he brings me","transliteration":"layatiyannī","verse_key":"27:21"},{"pos":8,"ar":"بِسُلْطَـٰنٍۢ","en_gloss":"a reason","transliteration":"bisul'ṭānin","verse_key":"27:21"},{"pos":9,"ar":"مُّبِينٍۢ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"27:21"},{"pos":10,"ar":"٢١","en_gloss":"(21)","transliteration":"","verse_key":"27:21"}]},{"verse_key":"27:22","surah":27,"ayah":22,"ar_uthmani":"فَمَكَثَ غَيْرَ بَعِيدٍ فَقَالَ أَحَطتُ بِمَا لَمْ تُحِطْ بِهِۦ وَجِئْتُكَ مِن سَبَإٍۭ بِنَبَإٍ يَقِينٍ","en_translation_id":85,"en":"But the hoopoe did not stay away long: he came and said, ‘I have learned something you did not know: I come to you from Sheba with firm news.","words":[{"pos":1,"ar":"فَمَكَثَ","en_gloss":"So he stayed","transliteration":"famakatha","verse_key":"27:22"},{"pos":2,"ar":"غَيْرَ","en_gloss":"not","transliteration":"ghayra","verse_key":"27:22"},{"pos":3,"ar":"بَعِيدٍۢ","en_gloss":"long","transliteration":"baʿīdin","verse_key":"27:22"},{"pos":4,"ar":"فَقَالَ","en_gloss":"and he said","transliteration":"faqāla","verse_key":"27:22"},{"pos":5,"