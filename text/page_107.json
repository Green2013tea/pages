nsliteration":"ʿallamakumu","verse_key":"5:4"},{"pos":17,"ar":"ٱللَّهُ ۖ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"5:4"},{"pos":18,"ar":"فَكُلُوا۟","en_gloss":"So eat","transliteration":"fakulū","verse_key":"5:4"},{"pos":19,"ar":"مِمَّآ","en_gloss":"of what","transliteration":"mimmā","verse_key":"5:4"},{"pos":20,"ar":"أَمْسَكْنَ","en_gloss":"they catch","transliteration":"amsakna","verse_key":"5:4"},{"pos":21,"ar":"عَلَيْكُمْ","en_gloss":"for you","transliteration":"ʿalaykum","verse_key":"5:4"},{"pos":22,"ar":"وَٱذْكُرُوا۟","en_gloss":"but mention","transliteration":"wa-udh'kurū","verse_key":"5:4"},{"pos":23,"ar":"ٱسْمَ","en_gloss":"(the) name","transliteration":"is'ma","verse_key":"5:4"},{"pos":24,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"5:4"},{"pos":25,"ar":"عَلَيْهِ ۖ","en_gloss":"on it","transliteration":"ʿalayhi","verse_key":"5:4"},{"pos":26,"ar":"وَٱتَّقُوا۟","en_gloss":"and fear","transliteration":"wa-ittaqū","verse_key":"5:4"},{"pos":27,"ar":"ٱللَّهَ ۚ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"5:4"},{"pos":28,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"5:4"},{"pos":29,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"5:4"},{"pos":30,"ar":"سَرِيعُ","en_gloss":"is swift","transliteration":"sarīʿu","verse_key":"5:4"},{"pos":31,"ar":"ٱلْحِسَابِ","en_gloss":"(in taking) account","transliteration":"l-ḥisābi","verse_key":"5:4"},{"pos":32,"ar":"٤","en_gloss":"(4)","transliteration":"","verse_key":"5:4"}]},{"verse_key":"5:5","surah":5,"ayah":5,"ar_uthmani":"ٱلْيَوْمَ أُحِلَّ لَكُمُ ٱلطَّيِّبَـٰتُ ۖ وَطَعَامُ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ حِلٌّ لَّكُمْ وَطَعَامُكُمْ حِلٌّ لَّهُمْ ۖ وَٱلْمُحْصَنَـٰتُ مِنَ ٱلْمُؤْمِنَـٰتِ وَٱلْمُحْصَنَـٰتُ مِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ مِن قَبْلِكُمْ إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ غَيْرَ مُسَـٰفِحِينَ وَلَا مُتَّخِذِىٓ أَخْدَانٍ ۗ وَمَن يَكْفُرْ بِٱلْإِيمَـٰنِ فَقَدْ حَبِطَ عَمَلُهُۥ وَهُوَ فِى ٱلْـَٔاخِرَةِ مِنَ ٱلْخَـٰسِرِينَ","en_translation_id":85,"en":"Today all good things have been made lawful for you. The food of the People of the Book is lawful for you as your food is lawful for them. So are chaste, believing, women as well as chaste women of the people who were given the Scripture before you, as long as you have given them their bride-gifts and married them, not taking them as lovers or secret mistresses. The deeds of anyone who rejects faith will come to nothing, and in the Hereafter he will be one of the losers.","words":[{"pos":1,"ar":"ٱلْيَوْمَ","en_gloss":"This day","transliteration":"al-yawma","verse_key":"5:5"},{"pos":2,"ar":"أُحِلَّ","en_gloss":"are made lawful","transliteration":"uḥilla","verse_key":"5:5"},{"pos":3,"ar":"لَكُمُ","en_gloss":"for you","transliteration":"lakumu","verse_key":"5:5"},{"pos":4,"ar":"ٱلطَّيِّبَـٰتُ ۖ","en_gloss":"the good things","transliteration":"l-ṭayibātu","verse_key":"5:5"},{"pos":5,"ar":"وَطَعَامُ","en_gloss":"and (the) food","transliteration":"waṭaʿāmu","verse_key":"5:5"},{"pos":6,"ar":"ٱلَّذِينَ","en_gloss":"(of) those who","transliteration":"alladhīna","verse_key":"5:5"},{"pos":7,"ar":"أُوتُوا۟","en_gloss":"were given","transliteration":"ūtū","verse_key":"5:5"},{"pos":8,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","verse_key":"5:5"},{"pos":9,"ar":"حِلٌّۭ","en_gloss":"(is) lawful","transliteration":"ḥillun","verse_key":"5:5"},{"pos":10,"ar":"لَّكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"5:5"},{"pos":11,"ar":"وَطَعَامُكُمْ","en_gloss":"and your food","transliteration":"waṭaʿāmukum","verse_key":"5:5"},{"pos":12,"ar":"حِلٌّۭ","en_gloss":"(is) lawful","transliteration":"ḥillun","verse_key":"5:5"},{"pos":13,"ar":"لَّهُمْ ۖ","en_gloss":"for them","transliteration":"lahum","verse_key":"5:5"},{"pos":14,"ar":"وَٱلْمُحْصَنَـٰتُ","en_gloss":"And the chaste women","transliteration":"wal-muḥ'ṣanātu","verse_key":"5:5"},{"pos":15,"ar":"مِنَ","en_gloss":"from","tra