ا ٱلْهُدَىٰٓ ءَامَنَّا بِهِۦ ۖ فَمَن يُؤْمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخْسًا وَلَا رَهَقًا","en_translation_id":85,"en":"When we heard the guidance we came to believe: whoever believes in his Lord need fear no loss nor injustice.","words":[{"pos":1,"ar":"وَأَنَّا","en_gloss":"And that [we]","transliteration":"wa-annā","verse_key":"72:13"},{"pos":2,"ar":"لَمَّا","en_gloss":"when","transliteration":"lammā","verse_key":"72:13"},{"pos":3,"ar":"سَمِعْنَا","en_gloss":"we heard","transliteration":"samiʿ'nā","verse_key":"72:13"},{"pos":4,"ar":"ٱلْهُدَىٰٓ","en_gloss":"the Guidance","transliteration":"l-hudā","verse_key":"72:13"},{"pos":5,"ar":"ءَامَنَّا","en_gloss":"we believed","transliteration":"āmannā","verse_key":"72:13"},{"pos":6,"ar":"بِهِۦ ۖ","en_gloss":"in it","transliteration":"bihi","verse_key":"72:13"},{"pos":7,"ar":"فَمَن","en_gloss":"And whoever","transliteration":"faman","verse_key":"72:13"},{"pos":8,"ar":"يُؤْمِنۢ","en_gloss":"believes","transliteration":"yu'min","verse_key":"72:13"},{"pos":9,"ar":"بِرَبِّهِۦ","en_gloss":"in his Lord","transliteration":"birabbihi","verse_key":"72:13"},{"pos":10,"ar":"فَلَا","en_gloss":"then not","transliteration":"falā","verse_key":"72:13"},{"pos":11,"ar":"يَخَافُ","en_gloss":"he will fear","transliteration":"yakhāfu","verse_key":"72:13"},{"pos":12,"ar":"بَخْسًۭا","en_gloss":"any loss","transliteration":"bakhsan","verse_key":"72:13"},{"pos":13,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"72:13"},{"pos":14,"ar":"رَهَقًۭا","en_gloss":"any burden","transliteration":"rahaqan","verse_key":"72:13"},{"pos":15,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"72:13"}]}]}