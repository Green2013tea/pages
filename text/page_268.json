{"page":268,"verses":[{"verse_key":"16:7","surah":16,"ayah":7,"ar_uthmani":"وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ بَلَدٍ لَّمْ تَكُونُوا۟ بَـٰلِغِيهِ إِلَّا بِشِقِّ ٱلْأَنفُسِ ۚ إِنَّ رَبَّكُمْ لَرَءُوفٌ رَّحِيمٌ","en_translation_id":85,"en":"They carry your loads to lands you yourselves could not reach without great hardship––truly your Lord is kind and merciful––","words":[{"pos":1,"ar":"وَتَحْمِلُ","en_gloss":"And they carry","transliteration":"wataḥmilu","verse_key":"16:7"},{"pos":2,"ar":"أَثْقَالَكُمْ","en_gloss":"your loads","transliteration":"athqālakum","verse_key":"16:7"},{"pos":3,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"16:7"},{"pos":4,"ar":"بَلَدٍۢ","en_gloss":"a land","transliteration":"baladin","verse_key":"16:7"},{"pos":5,"ar":"لَّمْ","en_gloss":"not","transliteration":"lam","verse_key":"16:7"},{"pos":6,"ar":"تَكُونُوا۟","en_gloss":"you could","transliteration":"takūnū","verse_key":"16:7"},{"pos":7,"ar":"بَـٰلِغِيهِ","en_gloss":"reach it","transliteration":"bālighīhi","verse_key":"16:7"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"16:7"},{"pos":9,"ar":"بِشِقِّ","en_gloss":"with great trouble","transliteration":"bishiqqi","verse_key":"16:7"},{"pos":10,"ar":"ٱلْأَنفُسِ ۚ","en_gloss":"(to) yourselves","transliteration":"l-anfusi","verse_key":"16:7"},{"pos":11,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"16:7"},{"pos":12,"ar":"رَبَّكُمْ","en_gloss":"your Lord","transliteration":"rabbakum","verse_key":"16:7"},{"pos":13,"ar":"لَرَءُوفٌۭ","en_gloss":"surely is Most Kind","transliteration":"laraūfun","verse_key":"16:7"},{"pos":14,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"16:7"},{"pos":15,"ar":"٧","en_gloss":"(7)","transliteration":"","verse_key":"16:7"}]},{"verse_key":"16:8","surah":16,"ayah":8,"ar_uthmani":"وَٱلْخَيْلَ وَٱلْبِغَالَ وَٱلْحَمِيرَ لِتَرْكَبُوهَا وَزِينَةً ۚ وَيَخْلُقُ مَا لَا تَعْلَمُونَ","en_translation_id":85,"en":"horses, mules, and donkeys for you to ride and use for show, and other things you know nothing about.","words":[{"pos":1,"ar":"وَٱلْخَيْلَ","en_gloss":"And horses","transliteration":"wal-khayla","verse_key":"16:8"},{"pos":2,"ar":"وَٱلْبِغَالَ","en_gloss":"and mules","transliteration":"wal-bighāla","verse_key":"16:8"},{"pos":3,"ar":"وَٱلْحَمِيرَ","en_gloss":"and donkeys","transliteration":"wal-ḥamīra","verse_key":"16:8"},{"pos":4,"ar":"لِتَرْكَبُوهَا","en_gloss":"for you to ride them","transliteration":"litarkabūhā","verse_key":"16:8"},{"pos":5,"ar":"وَزِينَةًۭ ۚ","en_gloss":"and (as) adornment","transliteration":"wazīnatan","verse_key":"16:8"},{"pos":6,"ar":"وَيَخْلُقُ","en_gloss":"And He creates","transliteration":"wayakhluqu","verse_key":"16:8"},{"pos":7,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"16:8"},{"pos":8,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"16:8"},{"pos":9,"ar":"تَعْلَمُونَ","en_gloss":"you know","transliteration":"taʿlamūna","verse_key":"16:8"},{"pos":10,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"16:8"}]},{"verse_key":"16:9","surah":16,"ayah":9,"ar_uthmani":"وَعَلَى ٱللَّهِ قَصْدُ ٱلسَّبِيلِ وَمِنْهَا جَآئِرٌ ۚ وَلَوْ شَآءَ لَهَدَىٰكُمْ أَجْمَعِينَ","en_translation_id":85,"en":"God points out the right path, for some paths lead the wrong way: if He wished, He could guide you all.","words":[{"pos":1,"ar":"وَعَلَى","en_gloss":"And upon","transliteration":"waʿalā","verse_key":"16:9"},{"pos":2,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"16:9"},{"pos":3,"ar":"قَصْدُ","en_gloss":"(is) the direction","transliteration":"qaṣdu","verse_key":"16:9"},{"pos":4,"ar":"ٱلسَّبِيلِ","en_gloss":"(of) the way","transliteration":"l-sabīli","verse_key":"16:9"},{"pos":5,"ar":"وَمِنْهَا","en_gloss":"and among them","transliteration":"wamin'hā","verse_key":"16:9"},{"pos":6,"ar":"جَآئِرٌۭ ۚ","en_gloss":"(are) crooked","transliteration":"jāirun","verse_key":"16:9"},{"pos":7,"ar":"وَلَوْ","en_gloss":"And if","transliteration":"walaw","verse_key":"16:9"},{"pos":8,"ar":"شَآءَ","en_gloss":"He willed","transliteration":"shāa","verse_key":"16:9"},{"pos":9,"ar":"لَهَدَىٰكُمْ","en_gloss":"surely He would have guided you","transliteration":"lahadākum","verse_key":"16:9"},{"pos":10,"ar":"أَجْمَعِينَ","en_gloss":"all","transliteration":"ajmaʿīna","verse_key":"16:9"},{"pos":11,"ar":"٩","en_gloss":"(9)","transliteration":"","verse_key":"16:9"}]},{"verse_key":"16:10","surah":16,"ayah":10,"ar_uthmani":"هُوَ ٱلَّذِىٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً ۖ لَّكُم مِّنْهُ شَرَابٌ وَمِنْهُ شَجَرٌ فِيهِ تُسِيمُونَ","en_translation_id":85,"en":"It is He who sends down water for you from the sky, from which comes a drink for you, and the shrubs that you feed to your animals.","words":[{"pos":1,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"16:10"},{"pos":2,"ar":"ٱلَّذِىٓ","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"16:10"},{"pos":3,"ar":"أَنزَلَ","en_gloss":"sends down","transliteration":"anzala","verse_key":"16:10"},{"pos":4,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"16:10"},{"pos":5,"ar":"ٱلسَّمَآءِ","en_gloss":"the sky","transliteration":"l-samāi","verse_key":"16:10"},{"pos":6,"ar":"مَآءًۭ ۖ","en_gloss":"water","transliteration":"māan","verse_key":"16:10"},{"pos":7,"ar":"لَّكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"16:10"},{"pos":8,"ar":"مِّنْهُ","en_gloss":"of it","transliteration":"min'hu","verse_key":"16:10"},{"pos":9,"ar":"شَرَابٌۭ","en_gloss":"(is) drink","transliteration":"sharābun","verse_key":"16:10"},{"pos":10,"ar":"وَمِنْهُ","en_gloss":"and from it","transliteration":"wamin'hu","verse_key":"16:10"},{"pos":11,"ar":"شَجَرٌۭ","en_gloss":"(grows) vegetation","transliteration":"shajarun","verse_key":"16:10"},{"pos":12,"ar":"فِيهِ","en_gloss":"in which","transliteration":"fīhi","verse_key":"16:10"},{"pos":13,"ar":"تُسِيمُونَ","en_gloss":"you pasture your cattle","transliteration":"tusīmūna","verse_key":"16:10"},{"pos":14,"ar":"١٠","en_gloss":"(10)","transliteration":"","verse_key":"16:10"}]},{"verse_key":"16:11","surah":16,"ayah":11,"ar_uthmani":"يُنۢبِتُ لَكُم بِهِ ٱلزَّرْعَ وَٱلزَّيْتُونَ وَٱلنَّخِيلَ وَٱلْأَعْنَـٰبَ وَمِن كُلِّ ٱلثَّمَرَٰتِ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً لِّقَوْمٍ يَتَفَكَّرُونَ","en_translation_id":85,"en":"With it He grows for you grain, olives, palms, vines, and all kinds of other crops. There truly is a sign in this for those who reflect.","words":[{"pos":1,"ar":"يُنۢبِتُ","en_gloss":"He causes to grow","transliteration":"yunbitu","verse_key":"16:11"},{"pos":2,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"16:11"},{"pos":3,"ar":"بِهِ","en_gloss":"with it","transliteration":"bihi","verse_key":"16:11"},{"pos":4,"ar":"ٱلزَّرْعَ","en_gloss":"the crops","transliteration":"l-zarʿa","verse_key":"16:11"},{"pos":5,"ar":"وَٱلزَّيْتُونَ","en_gloss":"and the olives","transliteration":"wal-zaytūna","verse_key":"16:11"},{"pos":6,"ar":"وَٱلنَّخِيلَ","en_gloss":"and the date-palms","transliteration":"wal-nakhīla","verse_key":"16:11"},{"pos":7,"ar":"وَٱلْأَعْنَـٰبَ","en_gloss":"and the grapes","transliteration":"wal-aʿnāba","verse_key":"16:11"},{"pos":8,"ar":"وَمِن","en_gloss":"and of","transliteration":"wamin","verse_key":"16:11"},{"pos":9,"ar":"كُلِّ","en_gloss":"every kind","transliteration":"kulli","verse_key":"16:11"},{"pos":10,"ar":"ٱلثَّمَرَٰتِ ۗ","en_gloss":"(of) fruits","transliteration":"l-thamarāti","verse_key":"16:11"},{"pos":11,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"16:11"},{"pos":12,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"16:11"},{"pos":13,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"16:11"},{"pos":14,"ar":"لَـَٔايَةًۭ","en_gloss":"surely (is) a sign","transliteration":"laāyatan","verse_key":"16:11"},{"pos":15,"ar":"لِّقَوْمٍۢ","en_gloss":"for a people","transliteration":"liqawmin","verse_key":"16:11"},{"pos":16,"ar":"يَتَفَكَّرُونَ","en_gloss":"who reflect","transliteration":"yatafakkarūna","verse_key":"16:11"},{"pos":17,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"16:11"}]},{"verse_key":"16:12","surah":16,"ayah":12,"ar_uthmani":"وَسَخَّرَ لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ وَٱلنُّجُومُ مُسَخَّرَٰتٌۢ بِأَمْرِهِۦٓ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَعْقِلُونَ","en_translation_id":85,"en":"By His command He has made the night and day, the sun, moon, and stars all of benefit to you. There truly are signs in this for those who use their reason.","words":[{"pos":1,"ar":"وَسَخَّرَ","en_gloss":"And He has subjected","transliteration":"wasakhara","verse_key":"16:12"},{"pos":2,"ar":"لَكُمُ","en_gloss":"for you","transliteration":"lakumu","verse_key":"16:12"},{"pos":3,"ar":"ٱلَّيْلَ","en_gloss":"the night","transliteration":"al-layla","verse_key":"16:12"},{"pos":4,"ar":"وَٱلنَّهَارَ","en_gloss":"and the day","transliteration":"wal-nahāra","verse_key":"16:12"},{"pos":5,"ar":"وَٱلشَّمْسَ","en_gloss":"and the sun","transliteration":"wal-shamsa","verse_key":"16:12"},{"pos":6,"ar":"وَٱلْقَمَرَ ۖ","en_gloss":"and the moon","transliteration":"wal-qamara","verse_key":"16:12"},{"pos":7,"ar":"وَٱلنُّجُومُ","en_gloss":"and the stars","transliteration":"wal-nujūmu","verse_key":"16:12"},{"pos":8,"ar":"مُسَخَّرَٰتٌۢ","en_gloss":"(are) subjected","transliteration":"musakharātun","verse_key":"16:12"},{"pos":9,"ar":"بِأَمْرِهِۦٓ ۗ","en_gloss":"by His command","transliteration":"bi-amrihi","verse_key":"16:12"},{"pos":10,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"16:12"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"16:12"},{"pos":12,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"16:12"},{"pos":13,"ar":"لَـَٔايَـٰتٍۢ","en_gloss":"surely (are) signs","transliteration":"laāyātin","verse_key":"16:12"},{"pos":14,"ar":"لِّقَوْمٍۢ","en_gloss":"for a people","transliteration":"liqawmin","verse_key":"16:12"},{"pos":15,"ar":"يَعْقِلُونَ","en_gloss":"who use reason","transliteration":"yaʿqilūna","verse_key":"16:12"},{"pos":16,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"16:12"}]},{"verse_key":"16:13","surah":16,"ayah":13,"ar_uthmani":"وَمَا ذَرَأَ لَكُمْ فِى ٱلْأَرْضِ مُخْتَلِفًا أَلْوَٰنُهُۥٓ ۗ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً لِّقَوْمٍ يَذَّكَّرُونَ","en_translation_id":85,"en":"He has made of benefit to you the many-coloured things He has multiplied on the earth. There truly are signs in this for those who take it to heart.","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And whatever","transliteration":"wamā","verse_key":"16:13"},{"pos":2,"ar":"ذَرَأَ","en_gloss":"He multiplied","transliteration":"dhara-a","verse_key":"16:13"},{"pos":3,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"16:13"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"16:13"},{"pos":5,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"16:13"},{"pos":6,"ar":"مُخْتَلِفًا","en_gloss":"(of) varying","transliteration":"mukh'talifan","verse_key":"16:13"},{"pos":7,"ar":"أَلْوَٰنُهُۥٓ ۗ","en_gloss":"colors","transliteration":"alwānuhu","verse_key":"16:13"},{"pos":8,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"16:13"},{"pos":9,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"16:13"},{"pos":10,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"16:13"},{"pos":11,"ar":"لَـَٔايَةًۭ","en_gloss":"surely (is) a sign","transliteration":"laāyatan","verse_key":"16:13"},{"pos":12,"ar":"لِّقَوْمٍۢ","en_gloss":"for a people","transliteration":"liqawmin","verse_key":"16:13"},{"pos":13,"ar":"يَذَّكَّرُونَ","en_gloss":"who remember","transliteration":"yadhakkarūna","verse_key":"16:13"},{"pos":14,"ar":"١٣","en_gloss":"(13)","transliteration":"","verse_key":"16:13"}]},{"verse_key":"16:14","surah":16,"ayah":14,"ar_uthmani":"وَهُوَ ٱلَّذِى سَخَّرَ ٱلْبَحْرَ لِتَأْكُلُوا۟ مِنْهُ لَحْمًا طَرِيًّا وَتَسْتَخْرِجُوا۟ مِنْهُ حِلْيَةً تَلْبَسُونَهَا وَتَرَى ٱلْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ","en_translation_id":85,"en":"It is He who made the sea of benefit to you: you eat fresh fish from it and bring out jewellery to wear; you see the ships cutting through its waves so that you may go in search of His bounty and give thanks.","words":[{"pos":1,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"16:14"},{"pos":2,"ar":"ٱلَّذِى","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"16:14"},{"pos":3,"ar":"سَخَّرَ","en_gloss":"subjected","transliteration":"sakhara","verse_key":"16:14"},{"pos":4,"ar":"ٱلْبَحْرَ","en_gloss":"the sea","transliteration":"l-baḥra","verse_key":"16:14"},{"pos":5,"ar":"لِتَأْكُلُوا۟","en_gloss":"for you to eat","transliteration":"litakulū","verse_key":"16:14"},{"pos":6,"ar":"مِنْهُ","en_gloss":"from it","transliteration":"min'hu","verse_key":"16:14"},{"pos":7,"ar":"لَحْمًۭا","en_gloss":"meat","transliteration":"laḥman","verse_key":"16:14"},{"pos":8,"ar":"طَرِيًّۭا","en_gloss":"fresh","transliteration":"ṭariyyan","verse_key":"16:14"},{"pos":9,"ar":"وَتَسْتَخْرِجُوا۟","en_gloss":"and that you bring forth","transliteration":"watastakhrijū","verse_key":"16:14"},{"pos":10,"ar":"مِنْهُ","en_gloss":"from it","transliteration":"min'hu","verse_key":"16:14"},{"pos":11,"ar":"حِلْيَةًۭ","en_gloss":"ornaments","transliteration":"ḥil'yatan","verse_key":"16:14"},{"pos":12,"ar":"تَلْبَسُونَهَا","en_gloss":"(that) you wear them","transliteration":"talbasūnahā","verse_key":"16:14"},{"pos":13,"ar":"وَتَرَى","en_gloss":"And you see","transliteration":"watarā","verse_key":"16:14"},{"pos":14,"ar":"ٱلْفُلْكَ","en_gloss":"the ships","transliteration":"l-ful'ka","verse_key":"16:14"},{"pos":15,"ar":"مَوَاخِرَ","en_gloss":"ploughing","transliteration":"mawākhira","verse_key":"16:14"},{"pos":16,"ar":"فِيهِ","en_gloss":"through it","transliteration":"fīhi","verse_key":"16:14"},{"pos":17,"ar":"وَلِتَبْتَغُوا۟","en_gloss":"and that you may seek","transliteration":"walitabtaghū","verse_key":"16:14"},{"pos":18,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"16:14"},{"pos":19,"ar":"فَضْلِهِۦ","en_gloss":"His Bounty","transliteration":"faḍlihi","verse_key":"16:14"},{"pos":20,"ar":"وَلَعَلَّكُمْ","en_gloss":"and that you may","transliteration":"walaʿallakum","verse_key":"16:14"},{"pos":21,"ar":"تَشْكُرُونَ","en_gloss":"(be) grateful","transliteration":"tashkurūna","verse_key":"16:14"},{"pos":22,"ar":"١٤","en_gloss":"(14)","transliteration":"","verse_key":"16:14"}]}]}