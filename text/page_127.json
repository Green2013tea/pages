,{"pos":4,"ar":"يَـٰعِيسَى","en_gloss":"O Isa","transliteration":"yāʿīsā","verse_key":"5:116"},{"pos":5,"ar":"ٱبْنَ","en_gloss":"son","transliteration":"ib'na","verse_key":"5:116"},{"pos":6,"ar":"مَرْيَمَ","en_gloss":"(of) Maryam","transliteration":"maryama","verse_key":"5:116"},{"pos":7,"ar":"ءَأَنتَ","en_gloss":"Did you","transliteration":"a-anta","verse_key":"5:116"},{"pos":8,"ar":"قُلْتَ","en_gloss":"say","transliteration":"qul'ta","verse_key":"5:116"},{"pos":9,"ar":"لِلنَّاسِ","en_gloss":"to the people","transliteration":"lilnnāsi","verse_key":"5:116"},{"pos":10,"ar":"ٱتَّخِذُونِى","en_gloss":"Take me","transliteration":"ittakhidhūnī","verse_key":"5:116"},{"pos":11,"ar":"وَأُمِّىَ","en_gloss":"and my mother","transliteration":"wa-ummiya","verse_key":"5:116"},{"pos":12,"ar":"إِلَـٰهَيْنِ","en_gloss":"(as) two gods","transliteration":"ilāhayni","verse_key":"5:116"},{"pos":13,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"5:116"},{"pos":14,"ar":"دُونِ","en_gloss":"besides","transliteration":"dūni","verse_key":"5:116"},{"pos":15,"ar":"ٱللَّهِ ۖ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"5:116"},{"pos":16,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"5:116"},{"pos":17,"ar":"سُبْحَـٰنَكَ","en_gloss":"Glory be to You","transliteration":"sub'ḥānaka","verse_key":"5:116"},{"pos":18,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"5:116"},{"pos":19,"ar":"يَكُونُ","en_gloss":"was","transliteration":"yakūnu","verse_key":"5:116"},{"pos":20,"ar":"لِىٓ","en_gloss":"for me","transliteration":"lī","verse_key":"5:116"},{"pos":21,"ar":"أَنْ","en_gloss":"that","transliteration":"an","verse_key":"5:116"},{"pos":22,"ar":"أَقُولَ","en_gloss":"I say","transliteration":"aqūla","verse_key":"5:116"},{"pos":23,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"5:116"},{"pos":24,"ar":"لَيْسَ","en_gloss":"not","transliteration":"laysa","verse_key":"5:116"},{"pos":25,"ar":"لِى","en_gloss":"I","translite