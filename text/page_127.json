{"page":127,"verses":[{"verse_key":"5:114","surah":5,"ayah":114,"ar_uthmani":"قَالَ عِيسَى ٱبْنُ مَرْيَمَ ٱللَّهُمَّ رَبَّنَآ أَنزِلْ عَلَيْنَا مَآئِدَةً مِّنَ ٱلسَّمَآءِ تَكُونُ لَنَا عِيدًا لِّأَوَّلِنَا وَءَاخِرِنَا وَءَايَةً مِّنكَ ۖ وَٱرْزُقْنَا وَأَنتَ خَيْرُ ٱلرَّٰزِقِينَ","en_translation_id":85,"en":"Jesus, son of Mary, said, ‘Lord, send down to us a feast from heaven so that we can have a festival- the first and last of us- and a sign from You. Provide for us: You are the best provider.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"Said","transliteration":"qāla","verse_key":"5:114"},{"pos":2,"ar":"عِيسَى","en_gloss":"Isa","transliteration":"ʿīsā","verse_key":"5:114"},{"pos":3,"ar":"ٱبْنُ","en_gloss":"son","transliteration":"ub'nu","verse_key":"5:114"},{"pos":4,"ar":"مَرْيَمَ","en_gloss":"(of) Maryam","transliteration":"maryama","verse_key":"5:114"},{"pos":5,"ar":"ٱللَّهُمَّ","en_gloss":"O Allah","transliteration":"l-lahuma","verse_key":"5:114"},{"pos":6,"ar":"رَبَّنَآ","en_gloss":"our Lord","transliteration":"rabbanā","verse_key":"5:114"},{"pos":7,"ar":"أَنزِلْ","en_gloss":"send down","transliteration":"anzil","verse_key":"5:114"},{"pos":8,"ar":"عَلَيْنَا","en_gloss":"to us","transliteration":"ʿalaynā","verse_key":"5:114"},{"pos":9,"ar":"مَآئِدَةًۭ","en_gloss":"a table spread","transliteration":"māidatan","verse_key":"5:114"},{"pos":10,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"5:114"},{"pos":11,"ar":"ٱلسَّمَآءِ","en_gloss":"the heaven","transliteration":"l-samāi","verse_key":"5:114"},{"pos":12,"ar":"تَكُونُ","en_gloss":"to be","transliteration":"takūnu","verse_key":"5:114"},{"pos":13,"ar":"لَنَا","en_gloss":"for us","transliteration":"lanā","verse_key":"5:114"},{"pos":14,"ar":"عِيدًۭا","en_gloss":"a festival","transliteration":"ʿīdan","verse_key":"5:114"},{"pos":15,"ar":"لِّأَوَّلِنَا","en_gloss":"for first of us","transliteration":"li-awwalinā","verse_key":"5:114"},{"pos":16,"ar":"وَءَاخِرِنَا","en_gloss":"and last of us","transliteration":"waākhirinā","verse_key":"5:114"},{"pos":17,"ar":"وَءَايَةًۭ","en_gloss":"and a sign","transliteration":"waāyatan","verse_key":"5:114"},{"pos":18,"ar":"مِّنكَ ۖ","en_gloss":"from You","transliteration":"minka","verse_key":"5:114"},{"pos":19,"ar":"وَٱرْزُقْنَا","en_gloss":"And provide us","transliteration":"wa-ur'zuq'nā","verse_key":"5:114"},{"pos":20,"ar":"وَأَنتَ","en_gloss":"and You","transliteration":"wa-anta","verse_key":"5:114"},{"pos":21,"ar":"خَيْرُ","en_gloss":"(are) best","transliteration":"khayru","verse_key":"5:114"},{"pos":22,"ar":"ٱلرَّٰزِقِينَ","en_gloss":"(of) the providers","transliteration":"l-rāziqīna","verse_key":"5:114"},{"pos":23,"ar":"١١٤","en_gloss":"(114)","transliteration":"","verse_key":"5:114"}]},{"verse_key":"5:115","surah":5,"ayah":115,"ar_uthmani":"قَالَ ٱللَّهُ إِنِّى مُنَزِّلُهَا عَلَيْكُمْ ۖ فَمَن يَكْفُرْ بَعْدُ مِنكُمْ فَإِنِّىٓ أُعَذِّبُهُۥ عَذَابًا لَّآ أُعَذِّبُهُۥٓ أَحَدًا مِّنَ ٱلْعَـٰلَمِينَ","en_translation_id":85,"en":"God said, ‘I will send it down to you, but anyone who disbelieves after this will be punished with a punishment that I will not inflict on anyone else in the world.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"Said","transliteration":"qāla","verse_key":"5:115"},{"pos":2,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"5:115"},{"pos":3,"ar":"إِنِّى","en_gloss":"Indeed I","transliteration":"innī","verse_key":"5:115"},{"pos":4,"ar":"مُنَزِّلُهَا","en_gloss":"(will) send it down","transliteration":"munazziluhā","verse_key":"5:115"},{"pos":5,"ar":"عَلَيْكُمْ ۖ","en_gloss":"to you","transliteration":"ʿalaykum","verse_key":"5:115"},{"pos":6,"ar":"فَمَن","en_gloss":"then whoever","transliteration":"faman","verse_key":"5:115"},{"pos":7,"ar":"يَكْفُرْ","en_gloss":"disbelieves","transliteration":"yakfur","verse_key":"5:115"},{"pos":8,"ar":"بَعْدُ","en_gloss":"after (that)","transliteration":"baʿdu","verse_key":"5:115"},{"pos":9,"ar":"مِنكُمْ","en_gloss":"among you","transliterat