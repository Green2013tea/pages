َمَرْتَنِى بِهِۦٓ أَنِ ٱعْبُدُوا۟ ٱللَّهَ رَبِّى وَرَبَّكُمْ ۚ وَكُنتُ عَلَيْهِمْ شَهِيدًا مَّا دُمْتُ فِيهِمْ ۖ فَلَمَّا تَوَفَّيْتَنِى كُنتَ أَنتَ ٱلرَّقِيبَ عَلَيْهِمْ ۚ وَأَنتَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","en_translation_id":85,"en":"I told them only what You commanded me to: “Worship God, my Lord and your Lord.” I was a witness over them during my time among them. Ever since You took my soul, You alone have been the watcher over them: You are witness to all things","words":[{"pos":1,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"5:117"},{"pos":2,"ar":"قُلْتُ","en_gloss":"I said","transliteration":"qul'tu","verse_key":"5:117"},{"pos":3,"ar":"لَهُمْ","en_gloss":"to them","transliteration":"lahum","verse_key":"5:117"},{"pos":4,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"5:117"},{"pos":5,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"5:117"},{"pos":6,"ar":"أَمَرْتَنِى","en_gloss":"You commanded me","transliteration":"amartanī","verse_key":"5:117"},{"pos":7,"ar":"بِهِۦٓ","en_gloss":"[with it]","transliteration":"bihi","verse_key":"5:117"},{"pos":8,"ar":"أَنِ","en_gloss":"that","transliteration":"ani","verse_key":"5:117"},{"pos":9,"ar":"ٱعْبُدُوا۟","en_gloss":"You worship","transliteration":"uʿ'budū","verse_key":"5:117"},{"pos":10,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"5:117"},{"pos":11,"ar":"رَبِّى","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"5:117"},{"pos":12,"ar":"وَرَبَّكُمْ ۚ","en_gloss":"and your Lord","transliteration":"warabbakum","verse_key":"5:117"},{"pos":13,"ar":"وَكُنتُ","en_gloss":"And I was","transliteration":"wakuntu","verse_key":"5:117"},{"pos":14,"ar":"عَلَيْهِمْ","en_gloss":"over them","transliteration":"ʿalayhim","verse_key":"5:117"},{"pos":15,"ar":"شَهِيدًۭا","en_gloss":"a witness","transliteration":"shahīdan","verse_key":"5:117"},{"pos":16,"ar":"مَّا","en_gloss":"that","transliteration":"mā","verse_key":"5:117"},{"pos":17,"ar":"دُم