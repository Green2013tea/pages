_key":"21:112"},{"pos":3,"ar":"ٱحْكُم","en_gloss":"judge","transliteration":"uḥ'kum","verse_key":"21:112"},{"pos":4,"ar":"بِٱلْحَقِّ ۗ","en_gloss":"in truth","transliteration":"bil-ḥaqi","verse_key":"21:112"},{"pos":5,"ar":"وَرَبُّنَا","en_gloss":"And our Lord","transliteration":"warabbunā","verse_key":"21:112"},{"pos":6,"ar":"ٱلرَّحْمَـٰنُ","en_gloss":"(is) the Most Gracious","transliteration":"l-raḥmānu","verse_key":"21:112"},{"pos":7,"ar":"ٱلْمُسْتَعَانُ","en_gloss":"the One Whose help is sought","transliteration":"l-mus'taʿānu","verse_key":"21:112"},{"pos":8,"ar":"عَلَىٰ","en_gloss":"against","transliteration":"ʿalā","verse_key":"21:112"},{"pos":9,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"21:112"},{"pos":10,"ar":"تَصِفُونَ","en_gloss":"you attribute","transliteration":"taṣifūna","verse_key":"21:112"},{"pos":11,"ar":"١١٢","en_gloss":"(112)","transliteration":"","verse_key":"21:112"}]}]}