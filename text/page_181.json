akūna","verse_key":"8:39"},{"pos":5,"ar":"فِتْنَةٌۭ","en_gloss":"oppression","transliteration":"fit'natun","verse_key":"8:39"},{"pos":6,"ar":"وَيَكُونَ","en_gloss":"and is","transliteration":"wayakūna","verse_key":"8:39"},{"pos":7,"ar":"ٱلدِّينُ","en_gloss":"the religion","transliteration":"l-dīnu","verse_key":"8:39"},{"pos":8,"ar":"كُلُّهُۥ","en_gloss":"all of it","transliteration":"kulluhu","verse_key":"8:39"},{"pos":9,"ar":"لِلَّهِ ۚ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"8:39"},{"pos":10,"ar":"فَإِنِ","en_gloss":"But if","transliteration":"fa-ini","verse_key":"8:39"},{"pos":11,"ar":"ٱنتَهَوْا۟","en_gloss":"they cease","transliteration":"intahaw","verse_key":"8:39"},{"pos":12,"ar":"فَإِنَّ","en_gloss":"then indeed","transliteration":"fa-inna","verse_key":"8:39"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:39"},{"pos":14,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"8:39"},{"pos":15,"ar":"يَعْمَلُونَ","en_gloss":"they do","transliteration":"yaʿmalūna","verse_key":"8:39"},{"pos":16,"ar":"بَصِيرٌۭ","en_gloss":"(is) All-Seer","transliteration":"baṣīrun","verse_key":"8:39"},{"pos":17,"ar":"٣٩","en_gloss":"(39)","transliteration":"","verse_key":"8:39"}]},{"verse_key":"8:40","surah":8,"ayah":40,"ar_uthmani":"وَإِن تَوَلَّوْا۟ فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَوْلَىٰكُمْ ۚ نِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ","en_translation_id":85,"en":"but if they pay no heed, be sure that God is your protector, the best protector and the best helper.","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"8:40"},{"pos":2,"ar":"تَوَلَّوْا۟","en_gloss":"they turn away","transliteration":"tawallaw","verse_key":"8:40"},{"pos":3,"ar":"فَٱعْلَمُوٓا۟","en_gloss":"then know","transliteration":"fa-iʿ'lamū","verse_key":"8:40"},{"pos":4,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"8:40"},{"pos":5,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:40"},{"pos":6,"ar":"مَوْلَىٰكُمْ ۚ","en_gloss":"(is) your Protector","transliteration":"mawlākum","verse_key":"8:40"},{"pos":7,"ar":"نِعْمَ","en_gloss":"Excellent","transliteration":"niʿ'ma","verse_key":"8:40"},{"pos":8,"ar":"ٱلْمَوْلَىٰ","en_gloss":"(is) the Protector","transliteration":"l-mawlā","verse_key":"8:40"},{"pos":9,"ar":"وَنِعْمَ","en_gloss":"and Excellent","transliteration":"waniʿ'ma","verse_key":"8:40"},{"pos":10,"ar":"ٱلنَّصِيرُ","en_gloss":"(is) the Helper","transliteration":"l-naṣīru","verse_key":"8:40"},{"pos":11,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"8:40"}]}]}