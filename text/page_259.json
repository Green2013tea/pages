":30,"ar_uthmani":"وَجَعَلُوا۟ لِلَّهِ أَندَادًا لِّيُضِلُّوا۟ عَن سَبِيلِهِۦ ۗ قُلْ تَمَتَّعُوا۟ فَإِنَّ مَصِيرَكُمْ إِلَى ٱلنَّارِ","en_translation_id":85,"en":"They set up [false deities] as God’s equals to lead people astray from His path. Say, ‘Take your pleasure now, for your destination is the Fire.’","words":[{"pos":1,"ar":"وَجَعَلُوا۟","en_gloss":"And they set up","transliteration":"wajaʿalū","verse_key":"14:30"},{"pos":2,"ar":"لِلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"14:30"},{"pos":3,"ar":"أَندَادًۭا","en_gloss":"equals","transliteration":"andādan","verse_key":"14:30"},{"pos":4,"ar":"لِّيُضِلُّوا۟","en_gloss":"so that they mislead","transliteration":"liyuḍillū","verse_key":"14:30"},{"pos":5,"ar":"عَن","en_gloss":"from","transliteration":"ʿan","verse_key":"14:30"},{"pos":6,"ar":"سَبِيلِهِۦ ۗ","en_gloss":"His Path","transliteration":"sabīlihi","verse_key":"14:30"},{"pos":7,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"14:30"},{"pos":8,"ar":"تَمَتَّعُوا۟","en_gloss":"Enjoy","transliteration":"tamattaʿū","verse_key":"14:30"},{"pos":9,"ar":"فَإِنَّ","en_gloss":"but indeed","transliteration":"fa-inna","verse_key":"14:30"},{"pos":10,"ar":"مَصِيرَكُمْ","en_gloss":"your destination","transliteration":"maṣīrakum","verse_key":"14:30"},{"pos":11,"ar":"إِلَى","en_gloss":"(is) to","transliteration":"ilā","verse_key":"14:30"},{"pos":12,"ar":"ٱلنَّارِ","en_gloss":"the Fire","transliteration":"l-nāri","verse_key":"14:30"},{"pos":13,"ar":"٣٠","en_gloss":"(30)","transliteration":"","verse_key":"14:30"}]},{"verse_key":"14:31","surah":14,"ayah":31,"ar_uthmani":"قُل لِّعِبَادِىَ ٱلَّذِينَ ءَامَنُوا۟ يُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُنفِقُوا۟ مِمَّا رَزَقْنَـٰهُمْ سِرًّا وَعَلَانِيَةً مِّن قَبْلِ أَن يَأْتِىَ يَوْمٌ لَّا بَيْعٌ فِيهِ وَلَا خِلَـٰلٌ","en_translation_id":85,"en":"Tell My servants who have believed to keep up the prayer and give, secretly and in public, out of what We have provided them, before a Day comes when there will