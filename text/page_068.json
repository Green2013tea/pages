of the Hereafter, We will give him some of them: We will reward the grateful.","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"3:145"},{"pos":2,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"3:145"},{"pos":3,"ar":"لِنَفْسٍ","en_gloss":"for a soul","transliteration":"linafsin","verse_key":"3:145"},{"pos":4,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"3:145"},{"pos":5,"ar":"تَمُوتَ","en_gloss":"he dies","transliteration":"tamūta","verse_key":"3:145"},{"pos":6,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"3:145"},{"pos":7,"ar":"بِإِذْنِ","en_gloss":"by (the) permission","transliteration":"bi-idh'ni","verse_key":"3:145"},{"pos":8,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"3:145"},{"pos":9,"ar":"كِتَـٰبًۭا","en_gloss":"(at a) decree","transliteration":"kitāban","verse_key":"3:145"},{"pos":10,"ar":"مُّؤَجَّلًۭا ۗ","en_gloss":"determined","transliteration":"mu-ajjalan","verse_key":"3:145"},{"pos":11,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"3:145"},{"pos":12,"ar":"يُرِدْ","en_gloss":"desires","transliteration":"yurid","verse_key":"3:145"},{"pos":13,"ar":"ثَوَابَ","en_gloss":"reward","transliteration":"thawāba","verse_key":"3:145"},{"pos":14,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world ","transliteration":"l-dun'yā","verse_key":"3:145"},{"pos":15,"ar":"نُؤْتِهِۦ","en_gloss":"We will give him","transliteration":"nu'tihi","verse_key":"3:145"},{"pos":16,"ar":"مِنْهَا","en_gloss":"thereof","transliteration":"min'hā","verse_key":"3:145"},{"pos":17,"ar":"وَمَن","en_gloss":"and whoever","transliteration":"waman","verse_key":"3:145"},{"pos":18,"ar":"يُرِدْ","en_gloss":"desires","transliteration":"yurid","verse_key":"3:145"},{"pos":19,"ar":"ثَوَابَ","en_gloss":"reward","transliteration":"thawāba","verse_key":"3:145"},{"pos":20,"ar":"ٱلْـَٔاخِرَةِ","en_gloss":"(of) the Hereafter","transliteration":"l-ākhirat