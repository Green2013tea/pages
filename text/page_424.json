d not be blamed: God is most forgiving, most merciful.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O Prophet","transliteration":"yāayyuhā","verse_key":"33:50"},{"pos":2,"ar":"ٱلنَّبِىُّ","en_gloss":"O Prophet","transliteration":"l-nabiyu","verse_key":"33:50"},{"pos":3,"ar":"إِنَّآ","en_gloss":"Indeed, We","transliteration":"innā","verse_key":"33:50"},{"pos":4,"ar":"أَحْلَلْنَا","en_gloss":"[We] have made lawful","transliteration":"aḥlalnā","verse_key":"33:50"},{"pos":5,"ar":"لَكَ","en_gloss":"to you","transliteration":"laka","verse_key":"33:50"},{"pos":6,"ar":"أَزْوَٰجَكَ","en_gloss":"your wives","transliteration":"azwājaka","verse_key":"33:50"},{"pos":7,"ar":"ٱلَّـٰتِىٓ","en_gloss":"(to) whom","transliteration":"allātī","verse_key":"33:50"},{"pos":8,"ar":"ءَاتَيْتَ","en_gloss":"you have given","transliteration":"ātayta","verse_key":"33:50"},{"pos":9,"ar":"أُجُورَهُنَّ","en_gloss":"their bridal money","transliteration":"ujūrahunna","verse_key":"33:50"},{"pos":10,"ar":"وَمَا","en_gloss":"and whom","transliteration":"wamā","verse_key":"33:50"},{"pos":11,"ar":"مَلَكَتْ","en_gloss":"you rightfully possess","transliteration":"malakat","verse_key":"33:50"},{"pos":12,"ar":"يَمِينُكَ","en_gloss":"you rightfully possess","transliteration":"yamīnuka","verse_key":"33:50"},{"pos":13,"ar":"مِمَّآ","en_gloss":"from those (whom)","transliteration":"mimmā","verse_key":"33:50"},{"pos":14,"ar":"أَفَآءَ","en_gloss":"Allah has given","transliteration":"afāa","verse_key":"33:50"},{"pos":15,"ar":"ٱللَّهُ","en_gloss":"Allah has given","transliteration":"l-lahu","verse_key":"33:50"},{"pos":16,"ar":"عَلَيْكَ","en_gloss":"to you","transliteration":"ʿalayka","verse_key":"33:50"},{"pos":17,"ar":"وَبَنَاتِ","en_gloss":"and (the) daughters","transliteration":"wabanāti","verse_key":"33:50"},{"pos":18,"ar":"عَمِّكَ","en_gloss":"(of) your paternal uncles","transliteration":"ʿammika","verse_key":"33:50"},{"pos":19,"ar":"وَبَنَاتِ","en_gloss":"and (the) daughters","transliteration":"wabanā