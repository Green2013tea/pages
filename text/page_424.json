n":"l-lahi","verse_key":"33:47"},{"pos":7,"ar":"فَضْلًۭا","en_gloss":"a Bounty","transliteration":"faḍlan","verse_key":"33:47"},{"pos":8,"ar":"كَبِيرًۭا","en_gloss":"great","transliteration":"kabīran","verse_key":"33:47"},{"pos":9,"ar":"٤٧","en_gloss":"(47)","transliteration":"","verse_key":"33:47"}]},{"verse_key":"33:48","surah":33,"ayah":48,"ar_uthmani":"وَلَا تُطِعِ ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ وَدَعْ أَذَىٰهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا","en_translation_id":85,"en":"Do not give in to the disbelievers and the hypocrites: ignore the harm they cause you and put your trust in God. God is enough to trust.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"33:48"},{"pos":2,"ar":"تُطِعِ","en_gloss":"obey","transliteration":"tuṭiʿi","verse_key":"33:48"},{"pos":3,"ar":"ٱلْكَـٰفِرِينَ","en_gloss":"the disbelievers","transliteration":"l-kāfirīna","verse_key":"33:48"},{"pos":4,"ar":"وَٱلْمُنَـٰفِقِينَ","en_gloss":"and the hypocrites","transliteration":"wal-munāfiqīna","verse_key":"33:48"},{"pos":5,"ar":"وَدَعْ","en_gloss":"and disregard","transliteration":"wadaʿ","verse_key":"33:48"},{"pos":6,"ar":"أَذَىٰهُمْ","en_gloss":"their harm","transliteration":"adhāhum","verse_key":"33:48"},{"pos":7,"ar":"وَتَوَكَّلْ","en_gloss":"and put your trust","transliteration":"watawakkal","verse_key":"33:48"},{"pos":8,"ar":"عَلَى","en_gloss":"in","transliteration":"ʿalā","verse_key":"33:48"},{"pos":9,"ar":"ٱللَّهِ ۚ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"33:48"},{"pos":10,"ar":"وَكَفَىٰ","en_gloss":"And sufficient is Allah","transliteration":"wakafā","verse_key":"33:48"},{"pos":11,"ar":"بِٱللَّهِ","en_gloss":"And sufficient is Allah","transliteration":"bil-lahi","verse_key":"33:48"},{"pos":12,"ar":"وَكِيلًۭا","en_gloss":"(as) a Trustee","transliteration":"wakīlan","verse_key":"33:48"},{"pos":13,"ar":"٤٨","en_gloss":"(48)","transliteration":"","verse_key":"33:48"}]},{"verse_key":"33:49","surah":33,"ayah":49,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نَكَحْتُمُ ٱلْمُؤْمِنَـٰتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِن قَبْلِ أَن تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَا ۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا","en_translation_id":85,"en":"Believers, you have no right to expect a waiting period when you marry believing women and then divorce them before you have touched them: make provision for them and release them in an honourable way.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you who believe","transliteration":"yāayyuhā","verse_key":"33:49"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"O you who believe","transliteration":"alladhīna","verse_key":"33:49"},{"pos":3,"ar":"ءَامَنُوٓا۟","en_gloss":"O you who believe","transliteration":"āmanū","verse_key":"33:49"},{"pos":4,"ar":"إِذَا","en_gloss":"When","transliteration":"idhā","verse_key":"33:49"},{"pos":5,"ar":"نَكَحْتُمُ","en_gloss":"you marry","transliteration":"nakaḥtumu","verse_key":"33:49"},{"pos":6,"ar":"ٱلْمُؤْمِنَـٰتِ","en_gloss":"believing women","transliteration":"l-mu'mināti","verse_key":"33:49"},{"pos":7,"ar":"ثُمَّ","en_gloss":"and then","transliteration":"thumma","verse_key":"33:49"},{"pos":8,"ar":"طَلَّقْتُمُوهُنَّ","en_gloss":"divorce them","transliteration":"ṭallaqtumūhunna","verse_key":"33:49"},{"pos":9,"ar":"مِن","en_gloss":"before","transliteration":"min","verse_key":"33:49"},{"pos":10,"ar":"قَبْلِ","en_gloss":"before","transliteration":"qabli","verse_key":"33:49"},{"pos":11,"ar":"أَن","en_gloss":"[that]","transliteration":"an","verse_key":"33:49"},{"pos":12,"ar":"تَمَسُّوهُنَّ","en_gloss":"you have touched them","transliteration":"tamassūhunna","verse_key":"33:49"},{"pos":13,"ar":"فَمَا","en_gloss":"then not","transliteration":"famā","verse_key":"33:49"},{"pos":14,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"33:49"},{"pos":15,"ar":"عَلَيْهِنَّ","en_gloss":"on them","transliteration":"ʿalayhinna","verse_key":"33:49"},