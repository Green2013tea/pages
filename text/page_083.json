{"page":83,"verses":[{"verse_key":"4:27","surah":4,"ayah":27,"ar_uthmani":"وَٱللَّهُ يُرِيدُ أَن يَتُوبَ عَلَيْكُمْ وَيُرِيدُ ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ أَن تَمِيلُوا۟ مَيْلًا عَظِيمًا","en_translation_id":85,"en":"He wishes to turn towards you, but those who follow their lusts want you to go far astray.","words":[{"pos":1,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"4:27"},{"pos":2,"ar":"يُرِيدُ","en_gloss":"wishes","transliteration":"yurīdu","verse_key":"4:27"},{"pos":3,"ar":"أَن","en_gloss":"to","transliteration":"an","verse_key":"4:27"},{"pos":4,"ar":"يَتُوبَ","en_gloss":"accept repentance","transliteration":"yatūba","verse_key":"4:27"},{"pos":5,"ar":"عَلَيْكُمْ","en_gloss":"from you","transliteration":"ʿalaykum","verse_key":"4:27"},{"pos":6,"ar":"وَيُرِيدُ","en_gloss":"but wish","transliteration":"wayurīdu","verse_key":"4:27"},{"pos":7,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"4:27"},{"pos":8,"ar":"يَتَّبِعُونَ","en_gloss":"follow","transliteration":"yattabiʿūna","verse_key":"4:27"},{"pos":9,"ar":"ٱلشَّهَوَٰتِ","en_gloss":"the passions","transliteration":"l-shahawāti","verse_key":"4:27"},{"pos":10,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"4:27"},{"pos":11,"ar":"تَمِيلُوا۟","en_gloss":"you deviate ","transliteration":"tamīlū","verse_key":"4:27"},{"pos":12,"ar":"مَيْلًا","en_gloss":"(into) a deviation","transliteration":"maylan","verse_key":"4:27"},{"pos":13,"ar":"عَظِيمًۭا","en_gloss":"great","transliteration":"ʿaẓīman","verse_key":"4:27"},{"pos":14,"ar":"٢٧","en_gloss":"(27)","transliteration":"","verse_key":"4:27"}]},{"verse_key":"4:28","surah":4,"ayah":28,"ar_uthmani":"يُرِيدُ ٱللَّهُ أَن يُخَفِّفَ عَنكُمْ ۚ وَخُلِقَ ٱلْإِنسَـٰنُ ضَعِيفًا","en_translation_id":85,"en":"God wishes to lighten your burden; man was created weak.","words":[{"pos":1,"ar":"يُرِيدُ","en_gloss":"Wishes","transliteration":"yurīdu","verse_key":"4:28"},{"pos":2,"ar":"ٱللَّهُ","en_