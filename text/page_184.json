, to frighten off God’s enemies and yours, and warn others unknown to you but known to God. Whatever you give in God’s cause will be repaid to you in full, and you will not be wronged.","words":[{"pos":1,"ar":"وَأَعِدُّوا۟","en_gloss":"And prepare","transliteration":"wa-aʿiddū","verse_key":"8:60"},{"pos":2,"ar":"لَهُم","en_gloss":"for them","transliteration":"lahum","verse_key":"8:60"},{"pos":3,"ar":"مَّا","en_gloss":"whatever","transliteration":"mā","verse_key":"8:60"},{"pos":4,"ar":"ٱسْتَطَعْتُم","en_gloss":"you able (to)","transliteration":"is'taṭaʿtum","verse_key":"8:60"},{"pos":5,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"8:60"},{"pos":6,"ar":"قُوَّةٍۢ","en_gloss":"force","transliteration":"quwwatin","verse_key":"8:60"},{"pos":7,"ar":"وَمِن","en_gloss":"and of","transliteration":"wamin","verse_key":"8:60"},{"pos":8,"ar":"رِّبَاطِ","en_gloss":"tethered","transliteration":"ribāṭi","verse_key":"8:60"},{"pos":9,"ar":"ٱلْخَيْلِ","en_gloss":"horses","transliteration":"l-khayli","verse_key":"8:60"},{"pos":10,"ar":"تُرْهِبُونَ","en_gloss":"(to) terrify","transliteration":"tur'hibūna","verse_key":"8:60"},{"pos":11,"ar":"بِهِۦ","en_gloss":"therewith","transliteration":"bihi","verse_key":"8:60"},{"pos":12,"ar":"عَدُوَّ","en_gloss":"(the) enemy","transliteration":"ʿaduwwa","verse_key":"8:60"},{"pos":13,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"8:60"},{"pos":14,"ar":"وَعَدُوَّكُمْ","en_gloss":"and your enemy","transliteration":"waʿaduwwakum","verse_key":"8:60"},{"pos":15,"ar":"وَءَاخَرِينَ","en_gloss":"and others","transliteration":"waākharīna","verse_key":"8:60"},{"pos":16,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"8:60"},{"pos":17,"ar":"دُونِهِمْ","en_gloss":"besides them","transliteration":"dūnihim","verse_key":"8:60"},{"pos":18,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"8:60"},{"pos":19,"ar":"تَعْلَمُونَهُمُ","en_gloss":"(do) you know them","transliteration":"taʿlamūna