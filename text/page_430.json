ًى ظَـٰهِرَةً وَقَدَّرْنَا فِيهَا ٱلسَّيْرَ ۖ سِيرُوا۟ فِيهَا لَيَالِىَ وَأَيَّامًا ءَامِنِينَ","en_translation_id":85,"en":"Also, We had placed, between them and the towns We had blessed, other towns within sight of one another to which they could travel easily- ‘ Travel safely in this land by night and by day’-","words":[{"pos":1,"ar":"وَجَعَلْنَا","en_gloss":"And We made","transliteration":"wajaʿalnā","verse_key":"34:18"},{"pos":2,"ar":"بَيْنَهُمْ","en_gloss":"between them","transliteration":"baynahum","verse_key":"34:18"},{"pos":3,"ar":"وَبَيْنَ","en_gloss":"and between","transliteration":"wabayna","verse_key":"34:18"},{"pos":4,"ar":"ٱلْقُرَى","en_gloss":"the towns","transliteration":"l-qurā","verse_key":"34:18"},{"pos":5,"ar":"ٱلَّتِى","en_gloss":"which","transliteration":"allatī","verse_key":"34:18"},{"pos":6,"ar":"بَـٰرَكْنَا","en_gloss":"We had blessed","transliteration":"bāraknā","verse_key":"34:18"},{"pos":7,"ar":"فِيهَا","en_gloss":"in it","transliteration":"fīhā","verse_key":"34:18"},{"pos":8,"ar":"قُرًۭى","en_gloss":"towns","transliteration":"quran","verse_key":"34:18"},{"pos":9,"ar":"ظَـٰهِرَةًۭ","en_gloss":"visible","transliteration":"ẓāhiratan","verse_key":"34:18"},{"pos":10,"ar":"وَقَدَّرْنَا","en_gloss":"And We determined","transliteration":"waqaddarnā","verse_key":"34:18"},{"pos":11,"ar":"فِيهَا","en_gloss":"between them","transliteration":"fīhā","verse_key":"34:18"},{"pos":12,"ar":"ٱلسَّيْرَ ۖ","en_gloss":"the journey","transliteration":"l-sayra","verse_key":"34:18"},{"pos":13,"ar":"سِيرُوا۟","en_gloss":"Travel","transliteration":"sīrū","verse_key":"34:18"},{"pos":14,"ar":"فِيهَا","en_gloss":"between them","transliteration":"fīhā","verse_key":"34:18"},{"pos":15,"ar":"لَيَالِىَ","en_gloss":"(by) night","transliteration":"layāliya","verse_key":"34:18"},{"pos":16,"ar":"وَأَيَّامًا","en_gloss":"and (by) day","transliteration":"wa-ayyāman","verse_key":"34:18"},{"pos":17,"ar":"ءَامِنِينَ","en_gloss":"safely","transliteration":"āminīna","verse_key":"34: