لِكَ لَـَٔايَـٰتٍ ۖ أَفَلَا يَسْمَعُونَ","en_translation_id":85,"en":"Is it not a lesson for them [to see] how many generations We destroyed before them, in whose homes they now walk? There truly are signs in this- do they not hear?","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Does it not","transliteration":"awalam","verse_key":"32:26"},{"pos":2,"ar":"يَهْدِ","en_gloss":"guide","transliteration":"yahdi","verse_key":"32:26"},{"pos":3,"ar":"لَهُمْ","en_gloss":"[for] them","transliteration":"lahum","verse_key":"32:26"},{"pos":4,"ar":"كَمْ","en_gloss":"(that) how many","transliteration":"kam","verse_key":"32:26"},{"pos":5,"ar":"أَهْلَكْنَا","en_gloss":"We have destroyed","transliteration":"ahlaknā","verse_key":"32:26"},{"pos":6,"ar":"مِن","en_gloss":"before them","transliteration":"min","verse_key":"32:26"},{"pos":7,"ar":"قَبْلِهِم","en_gloss":"before them","transliteration":"qablihim","verse_key":"32:26"},{"pos":8,"ar":"مِّنَ","en_gloss":"of","transliteration":"mina","verse_key":"32:26"},{"pos":9,"ar":"ٱلْقُرُونِ","en_gloss":"the generations","transliteration":"l-qurūni","verse_key":"32:26"},{"pos":10,"ar":"يَمْشُونَ","en_gloss":"they walk about","transliteration":"yamshūna","verse_key":"32:26"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"32:26"},{"pos":12,"ar":"مَسَـٰكِنِهِمْ ۚ","en_gloss":"their dwellings","transliteration":"masākinihim","verse_key":"32:26"},{"pos":13,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"32:26"},{"pos":14,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"32:26"},{"pos":15,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"32:26"},{"pos":16,"ar":"لَـَٔايَـٰتٍ ۖ","en_gloss":"surely, are Signs","transliteration":"laāyātin","verse_key":"32:26"},{"pos":17,"ar":"أَفَلَا","en_gloss":"Then do not","transliteration":"afalā","verse_key":"32:26"},{"pos":18,"ar":"يَسْمَعُونَ","en_gloss":"they hear","transliteration":"yasmaʿūna","verse_key":"32:26"},{"pos":19,"ar":"٢٦","en_gloss":"(26)","transliteration":"","verse_key":"32:26"}]},{"verse_key":"32:27","surah":32,"ayah":27,"ar_uthmani":"أَوَلَمْ يَرَوْا۟ أَنَّا نَسُوقُ ٱلْمَآءَ إِلَى ٱلْأَرْضِ ٱلْجُرُزِ فَنُخْرِجُ بِهِۦ زَرْعًا تَأْكُلُ مِنْهُ أَنْعَـٰمُهُمْ وَأَنفُسُهُمْ ۖ أَفَلَا يُبْصِرُونَ","en_translation_id":85,"en":"Do they not consider how We drive rain to the barren land, and with it produce vegetation from which their cattle and they themselves eat? Do they not see?","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Do not","transliteration":"awalam","verse_key":"32:27"},{"pos":2,"ar":"يَرَوْا۟","en_gloss":"they see","transliteration":"yaraw","verse_key":"32:27"},{"pos":3,"ar":"أَنَّا","en_gloss":"that We","transliteration":"annā","verse_key":"32:27"},{"pos":4,"ar":"نَسُوقُ","en_gloss":"drive","transliteration":"nasūqu","verse_key":"32:27"},{"pos":5,"ar":"ٱلْمَآءَ","en_gloss":"water","transliteration":"l-māa","verse_key":"32:27"},{"pos":6,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"32:27"},{"pos":7,"ar":"ٱلْأَرْضِ","en_gloss":"the land","transliteration":"l-arḍi","verse_key":"32:27"},{"pos":8,"ar":"ٱلْجُرُزِ","en_gloss":"[the] barren","transliteration":"l-juruzi","verse_key":"32:27"},{"pos":9,"ar":"فَنُخْرِجُ","en_gloss":"then We bring forth","transliteration":"fanukh'riju","verse_key":"32:27"},{"pos":10,"ar":"بِهِۦ","en_gloss":"thereby","transliteration":"bihi","verse_key":"32:27"},{"pos":11,"ar":"زَرْعًۭا","en_gloss":"crops","transliteration":"zarʿan","verse_key":"32:27"},{"pos":12,"ar":"تَأْكُلُ","en_gloss":"eat","transliteration":"takulu","verse_key":"32:27"},{"pos":13,"ar":"مِنْهُ","en_gloss":"from it","transliteration":"min'hu","verse_key":"32:27"},{"pos":14,"ar":"أَنْعَـٰمُهُمْ","en_gloss":"their cattle","transliteration":"anʿāmuhum","verse_key":"32:27"},{"pos":15,"ar":"وَأَنفُسُهُمْ ۖ","en_gloss":"and they themselves","transliteration":"wa-anfusuhum","verse_key":"32:27"},{"pos":16,"ar":"أَفَلَا","en_gloss":"Then do not","transliteration":"