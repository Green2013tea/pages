ُمَّ يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُۥ عَلَى ٱللَّهِ ۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا","en_translation_id":85,"en":"Anyone who migrates for God’s cause will find many a refuge and great plenty in the earth, and if anyone leaves home as a migrant towards God and His Messenger and is then overtaken by death, his reward from God is sure. God is most forgiving and most merciful.","words":[{"pos":1,"ar":"۞ وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"4:100"},{"pos":2,"ar":"يُهَاجِرْ","en_gloss":"emigrates","transliteration":"yuhājir","verse_key":"4:100"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"4:100"},{"pos":4,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"4:100"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"4:100"},{"pos":6,"ar":"يَجِدْ","en_gloss":"will find","transliteration":"yajid","verse_key":"4:100"},{"pos":7,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"4:100"},{"pos":8,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"4:100"},{"pos":9,"ar":"مُرَٰغَمًۭا","en_gloss":"place(s) of refuge ","transliteration":"murāghaman","verse_key":"4:100"},{"pos":10,"ar":"كَثِيرًۭا","en_gloss":"many","transliteration":"kathīran","verse_key":"4:100"},{"pos":11,"ar":"وَسَعَةًۭ ۚ","en_gloss":"and abundance","transliteration":"wasaʿatan","verse_key":"4:100"},{"pos":12,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"4:100"},{"pos":13,"ar":"يَخْرُجْ","en_gloss":"leaves","transliteration":"yakhruj","verse_key":"4:100"},{"pos":14,"ar":"مِنۢ","en_gloss":"from","transliteration":"min","verse_key":"4:100"},{"pos":15,"ar":"بَيْتِهِۦ","en_gloss":"his home","transliteration":"baytihi","verse_key":"4:100"},{"pos":16,"ar":"مُهَاجِرًا","en_gloss":"(as) an emigrant","transliteration":"muhājiran","verse_key":"4:100"},{"pos":17,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","v