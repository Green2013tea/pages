{"page":275,"verses":[{"verse_key":"16:73","surah":16,"ayah":73,"ar_uthmani":"وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمْلِكُ لَهُمْ رِزْقًا مِّنَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ شَيْـًٔا وَلَا يَسْتَطِيعُونَ","en_translation_id":85,"en":"Those they worship beside God have no power to provide anything for them from the heavens or the earth: they can do nothing.","words":[{"pos":1,"ar":"وَيَعْبُدُونَ","en_gloss":"And they worship","transliteration":"wayaʿbudūna","verse_key":"16:73"},{"pos":2,"ar":"مِن","en_gloss":"other than","transliteration":"min","verse_key":"16:73"},{"pos":3,"ar":"دُونِ","en_gloss":"other than","transliteration":"dūni","verse_key":"16:73"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"16:73"},{"pos":5,"ar":"مَا","en_gloss":"which","transliteration":"mā","verse_key":"16:73"},{"pos":6,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"16:73"},{"pos":7,"ar":"يَمْلِكُ","en_gloss":"possesses","transliteration":"yamliku","verse_key":"16:73"},{"pos":8,"ar":"لَهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"16:73"},{"pos":9,"ar":"رِزْقًۭا","en_gloss":"any provision","transliteration":"riz'qan","verse_key":"16:73"},{"pos":10,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"16:73"},{"pos":11,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"the heavens","transliteration":"l-samāwāti","verse_key":"16:73"},{"pos":12,"ar":"وَٱلْأَرْضِ","en_gloss":"and the earth","transliteration":"wal-arḍi","verse_key":"16:73"},{"pos":13,"ar":"شَيْـًۭٔا","en_gloss":"[anything]","transliteration":"shayan","verse_key":"16:73"},{"pos":14,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"16:73"},{"pos":15,"ar":"يَسْتَطِيعُونَ","en_gloss":"they are able","transliteration":"yastaṭīʿūna","verse_key":"16:73"},{"pos":16,"ar":"٧٣","en_gloss":"(73)","transliteration":"","verse_key":"16:73"}]},{"verse_key":"16:74","surah":16,"ayah":74,"ar_uthmani":"فَلَا تَضْرِبُوا۟ لِلَّهِ ٱلْأَمْثَالَ ۚ إِنَّ ٱلل