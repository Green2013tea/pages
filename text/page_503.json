ونَ هَـٰذَآ إِفْكٌ قَدِيمٌ","en_translation_id":85,"en":"Those who disbelieve say of the believers, ‘If there were any good in this Quran, they would not have believed in it before we did,’and, since they refuse to be guided by it, they say, ‘This is an ancient fabrication.’","words":[{"pos":1,"ar":"وَقَالَ","en_gloss":"And say","transliteration":"waqāla","verse_key":"46:11"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"46:11"},{"pos":3,"ar":"كَفَرُوا۟","en_gloss":"disbelieve","transliteration":"kafarū","verse_key":"46:11"},{"pos":4,"ar":"لِلَّذِينَ","en_gloss":"of those who","transliteration":"lilladhīna","verse_key":"46:11"},{"pos":5,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"46:11"},{"pos":6,"ar":"لَوْ","en_gloss":"If","transliteration":"law","verse_key":"46:11"},{"pos":7,"ar":"كَانَ","en_gloss":"it had been","transliteration":"kāna","verse_key":"46:11"},{"pos":8,"ar":"خَيْرًۭا","en_gloss":"good","transliteration":"khayran","verse_key":"46:11"},{"pos":9,"ar":"مَّا","en_gloss":"not","transliteration":"mā","verse_key":"46:11"},{"pos":10,"ar":"سَبَقُونَآ","en_gloss":"they (would) have preceded us","transliteration":"sabaqūnā","verse_key":"46:11"},{"pos":11,"ar":"إِلَيْهِ ۚ","en_gloss":"to it","transliteration":"ilayhi","verse_key":"46:11"},{"pos":12,"ar":"وَإِذْ","en_gloss":"And when","transliteration":"wa-idh","verse_key":"46:11"},{"pos":13,"ar":"لَمْ","en_gloss":"not","transliteration":"lam","verse_key":"46:11"},{"pos":14,"ar":"يَهْتَدُوا۟","en_gloss":"they (are) guided","transliteration":"yahtadū","verse_key":"46:11"},{"pos":15,"ar":"بِهِۦ","en_gloss":"by it","transliteration":"bihi","verse_key":"46:11"},{"pos":16,"ar":"فَسَيَقُولُونَ","en_gloss":"they say","transliteration":"fasayaqūlūna","verse_key":"46:11"},{"pos":17,"ar":"هَـٰذَآ","en_gloss":"This","transliteration":"hādhā","verse_key":"46:11"},{"pos":18,"ar":"إِفْكٌۭ","en_gloss":"(is) a lie","transliteration":"if'kun","verse