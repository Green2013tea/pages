":"qul","verse_key":"46:8"},{"pos":5,"ar":"إِنِ","en_gloss":"If","transliteration":"ini","verse_key":"46:8"},{"pos":6,"ar":"ٱفْتَرَيْتُهُۥ","en_gloss":"I have invented it","transliteration":"if'taraytuhu","verse_key":"46:8"},{"pos":7,"ar":"فَلَا","en_gloss":"then not","transliteration":"falā","verse_key":"46:8"},{"pos":8,"ar":"تَمْلِكُونَ","en_gloss":"you have power","transliteration":"tamlikūna","verse_key":"46:8"},{"pos":9,"ar":"لِى","en_gloss":"for me","transliteration":"lī","verse_key":"46:8"},{"pos":10,"ar":"مِنَ","en_gloss":"against","transliteration":"mina","verse_key":"46:8"},{"pos":11,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"46:8"},{"pos":12,"ar":"شَيْـًٔا ۖ","en_gloss":"anything","transliteration":"shayan","verse_key":"46:8"},{"pos":13,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"46:8"},{"pos":14,"ar":"أَعْلَمُ","en_gloss":"knows best","transliteration":"aʿlamu","verse_key":"46:8"},{"pos":15,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"46:8"},{"pos":16,"ar":"تُفِيضُونَ","en_gloss":"you utter","transliteration":"tufīḍūna","verse_key":"46:8"},{"pos":17,"ar":"فِيهِ ۖ","en_gloss":"concerning it","transliteration":"fīhi","verse_key":"46:8"},{"pos":18,"ar":"كَفَىٰ","en_gloss":"Sufficient is He","transliteration":"kafā","verse_key":"46:8"},{"pos":19,"ar":"بِهِۦ","en_gloss":"Sufficient is He","transliteration":"bihi","verse_key":"46:8"},{"pos":20,"ar":"شَهِيدًۢا","en_gloss":"(as) a Witness","transliteration":"shahīdan","verse_key":"46:8"},{"pos":21,"ar":"بَيْنِى","en_gloss":"between me","transliteration":"baynī","verse_key":"46:8"},{"pos":22,"ar":"وَبَيْنَكُمْ ۖ","en_gloss":"and between you","transliteration":"wabaynakum","verse_key":"46:8"},{"pos":23,"ar":"وَهُوَ","en_gloss":"and He","transliteration":"wahuwa","verse_key":"46:8"},{"pos":24,"ar":"ٱلْغَفُورُ","en_gloss":"(is) the Oft-Forgiving","transliteration":"l-ghafūru","verse_key":"46:8"},{"pos":25,"ar":"ٱلرَّحِيمُ","en_gloss":"th