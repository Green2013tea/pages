ِنَّا حُمِّلْنَآ أَوْزَارًا مِّن زِينَةِ ٱلْقَوْمِ فَقَذَفْنَـٰهَا فَكَذَٰلِكَ أَلْقَى ٱلسَّامِرِىُّ","en_translation_id":85,"en":"They said, ‘We did not break our word to you deliberately. We were burdened with the weight of people’s jewellery, so we threw it [into the fire], and the Samiri did the same,’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"20:87"},{"pos":2,"ar":"مَآ","en_gloss":"Not","transliteration":"mā","verse_key":"20:87"},{"pos":3,"ar":"أَخْلَفْنَا","en_gloss":"we broke","transliteration":"akhlafnā","verse_key":"20:87"},{"pos":4,"ar":"مَوْعِدَكَ","en_gloss":"promise to you","transliteration":"mawʿidaka","verse_key":"20:87"},{"pos":5,"ar":"بِمَلْكِنَا","en_gloss":"by our will","transliteration":"bimalkinā","verse_key":"20:87"},{"pos":6,"ar":"وَلَـٰكِنَّا","en_gloss":"but we","transliteration":"walākinnā","verse_key":"20:87"},{"pos":7,"ar":"حُمِّلْنَآ","en_gloss":"[we] were made to carry","transliteration":"ḥummil'nā","verse_key":"20:87"},{"pos":8,"ar":"أَوْزَارًۭا","en_gloss":"burdens","transliteration":"awzāran","verse_key":"20:87"},{"pos":9,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"20:87"},{"pos":10,"ar":"زِينَةِ","en_gloss":"ornaments","transliteration":"zīnati","verse_key":"20:87"},{"pos":11,"ar":"ٱلْقَوْمِ","en_gloss":"(of) the people","transliteration":"l-qawmi","verse_key":"20:87"},{"pos":12,"ar":"فَقَذَفْنَـٰهَا","en_gloss":"so we threw them","transliteration":"faqadhafnāhā","verse_key":"20:87"},{"pos":13,"ar":"فَكَذَٰلِكَ","en_gloss":"and thus","transliteration":"fakadhālika","verse_key":"20:87"},{"pos":14,"ar":"أَلْقَى","en_gloss":"threw","transliteration":"alqā","verse_key":"20:87"},{"pos":15,"ar":"ٱلسَّامِرِىُّ","en_gloss":"the Samiri","transliteration":"l-sāmiriyu","verse_key":"20:87"},{"pos":16,"ar":"٨٧","en_gloss":"(87)","transliteration":"","verse_key":"20:87"}]}]}