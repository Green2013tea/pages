key":"22:29"}]},{"verse_key":"22:30","surah":22,"ayah":30,"ar_uthmani":"ذَٰلِكَ وَمَن يُعَظِّمْ حُرُمَـٰتِ ٱللَّهِ فَهُوَ خَيْرٌ لَّهُۥ عِندَ رَبِّهِۦ ۗ وَأُحِلَّتْ لَكُمُ ٱلْأَنْعَـٰمُ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْ ۖ فَٱجْتَنِبُوا۟ ٱلرِّجْسَ مِنَ ٱلْأَوْثَـٰنِ وَٱجْتَنِبُوا۟ قَوْلَ ٱلزُّورِ","en_translation_id":85,"en":"All this [is ordained by God]: anyone who honours the sacred ordinances of God will have good rewards from his Lord. Livestock have been made lawful to you, except for what has been explicitly forbidden. Shun the filth of idolatrous beliefs and practices and shun false utterances.","words":[{"pos":1,"ar":"ذَٰلِكَ","en_gloss":"That","transliteration":"dhālika","verse_key":"22:30"},{"pos":2,"ar":"وَمَن","en_gloss":"and whoever","transliteration":"waman","verse_key":"22:30"},{"pos":3,"ar":"يُعَظِّمْ","en_gloss":"honors","transliteration":"yuʿaẓẓim","verse_key":"22:30"},{"pos":4,"ar":"حُرُمَـٰتِ","en_gloss":"(the) sacred rites","transliteration":"ḥurumāti","verse_key":"22:30"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"22:30"},{"pos":6,"ar":"فَهُوَ","en_gloss":"then it","transliteration":"fahuwa","verse_key":"22:30"},{"pos":7,"ar":"خَيْرٌۭ","en_gloss":"(is) best","transliteration":"khayrun","verse_key":"22:30"},{"pos":8,"ar":"لَّهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"22:30"},{"pos":9,"ar":"عِندَ","en_gloss":"near","transliteration":"ʿinda","verse_key":"22:30"},{"pos":10,"ar":"رَبِّهِۦ ۗ","en_gloss":"his Lord","transliteration":"rabbihi","verse_key":"22:30"},{"pos":11,"ar":"وَأُحِلَّتْ","en_gloss":"And are made lawful","transliteration":"wa-uḥillat","verse_key":"22:30"},{"pos":12,"ar":"لَكُمُ","en_gloss":"to you","transliteration":"lakumu","verse_key":"22:30"},{"pos":13,"ar":"ٱلْأَنْعَـٰمُ","en_gloss":"the cattle","transliteration":"l-anʿāmu","verse_key":"22:30"},{"pos":14,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"22:30"},{"pos":15,"ar":"مَا","en_gloss":"