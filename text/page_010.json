63"},{"pos":7,"ar":"خُذُوا۟","en_gloss":"Hold","transliteration":"khudhū","verse_key":"2:63"},{"pos":8,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"2:63"},{"pos":9,"ar":"ءَاتَيْنَـٰكُم","en_gloss":"We have given you","transliteration":"ātaynākum","verse_key":"2:63"},{"pos":10,"ar":"بِقُوَّةٍۢ","en_gloss":"with strength","transliteration":"biquwwatin","verse_key":"2:63"},{"pos":11,"ar":"وَٱذْكُرُوا۟","en_gloss":"and remember","transliteration":"wa-udh'kurū","verse_key":"2:63"},{"pos":12,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"2:63"},{"pos":13,"ar":"فِيهِ","en_gloss":"(is) in it","transliteration":"fīhi","verse_key":"2:63"},{"pos":14,"ar":"لَعَلَّكُمْ","en_gloss":"perhaps you","transliteration":"laʿallakum","verse_key":"2:63"},{"pos":15,"ar":"تَتَّقُونَ","en_gloss":"(would become) righteous","transliteration":"tattaqūna","verse_key":"2:63"},{"pos":16,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"2:63"}]},{"verse_key":"2:64","surah":2,"ayah":64,"ar_uthmani":"ثُمَّ تَوَلَّيْتُم مِّنۢ بَعْدِ ذَٰلِكَ ۖ فَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ لَكُنتُم مِّنَ ٱلْخَـٰسِرِينَ","en_translation_id":85,"en":"Even after that you turned away. Had it not been for God’s favour and mercy on you, you would certainly have been lost.","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"2:64"},{"pos":2,"ar":"تَوَلَّيْتُم","en_gloss":"you turned away","transliteration":"tawallaytum","verse_key":"2:64"},{"pos":3,"ar":"مِّنۢ","en_gloss":"from","transliteration":"min","verse_key":"2:64"},{"pos":4,"ar":"بَعْدِ","en_gloss":"after","transliteration":"baʿdi","verse_key":"2:64"},{"pos":5,"ar":"ذَٰلِكَ ۖ","en_gloss":"that","transliteration":"dhālika","verse_key":"2:64"},{"pos":6,"ar":"فَلَوْلَا","en_gloss":"So if not","transliteration":"falawlā","verse_key":"2:64"},{"pos":7,"ar":"فَضْلُ","en_gloss":"(for the) Grace","transliteration":"faḍlu","verse_key":"2:64"},{"pos":8,"ar":"ٱللَّهِ","en_gl