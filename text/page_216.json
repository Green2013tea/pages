10:66"},{"pos":25,"ar":"يَخْرُصُونَ","en_gloss":"guess","transliteration":"yakhruṣūna","verse_key":"10:66"},{"pos":26,"ar":"٦٦","en_gloss":"(66)","transliteration":"","verse_key":"10:66"}]},{"verse_key":"10:67","surah":10,"ayah":67,"ar_uthmani":"هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَسْمَعُونَ","en_translation_id":85,"en":"It is He who made the night so that you can rest in it and the daylight so that you can see- there truly are signs in this for those who hear.","words":[{"pos":1,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"10:67"},{"pos":2,"ar":"ٱلَّذِى","en_gloss":"(is) the One Who","transliteration":"alladhī","verse_key":"10:67"},{"pos":3,"ar":"جَعَلَ","en_gloss":"made","transliteration":"jaʿala","verse_key":"10:67"},{"pos":4,"ar":"لَكُمُ","en_gloss":"for you","transliteration":"lakumu","verse_key":"10:67"},{"pos":5,"ar":"ٱلَّيْلَ","en_gloss":"the night","transliteration":"al-layla","verse_key":"10:67"},{"pos":6,"ar":"لِتَسْكُنُوا۟","en_gloss":"that you may rest","transliteration":"litaskunū","verse_key":"10:67"},{"pos":7,"ar":"فِيهِ","en_gloss":"in it","transliteration":"fīhi","verse_key":"10:67"},{"pos":8,"ar":"وَٱلنَّهَارَ","en_gloss":"and the day","transliteration":"wal-nahāra","verse_key":"10:67"},{"pos":9,"ar":"مُبْصِرًا ۚ","en_gloss":"giving visibility","transliteration":"mub'ṣiran","verse_key":"10:67"},{"pos":10,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"10:67"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:67"},{"pos":12,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"10:67"},{"pos":13,"ar":"لَـَٔايَـٰتٍۢ","en_gloss":"surely (are) Signs","transliteration":"laāyātin","verse_key":"10:67"},{"pos":14,"ar":"لِّقَوْمٍۢ","en_gloss":"for a people","transliteration":"liqawmin","verse_key":"10:67"},{"pos":15,"ar":"يَسْمَعُونَ","en_gloss":"(who) listen","transliteration":"yasm