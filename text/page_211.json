l that is right. People! Your outrageous behaviour only works against yourselves. Take your little enjoyment in this present life; in the end you will return to Us and We shall confront you with everything you have done.","words":[{"pos":1,"ar":"فَلَمَّآ","en_gloss":"But when","transliteration":"falammā","verse_key":"10:23"},{"pos":2,"ar":"أَنجَىٰهُمْ","en_gloss":"He saved them","transliteration":"anjāhum","verse_key":"10:23"},{"pos":3,"ar":"إِذَا","en_gloss":"behold","transliteration":"idhā","verse_key":"10:23"},{"pos":4,"ar":"هُمْ","en_gloss":"They","transliteration":"hum","verse_key":"10:23"},{"pos":5,"ar":"يَبْغُونَ","en_gloss":"rebel","transliteration":"yabghūna","verse_key":"10:23"},{"pos":6,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"10:23"},{"pos":7,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"10:23"},{"pos":8,"ar":"بِغَيْرِ","en_gloss":"without","transliteration":"bighayri","verse_key":"10:23"},{"pos":9,"ar":"ٱلْحَقِّ ۗ","en_gloss":"[the] right","transliteration":"l-ḥaqi","verse_key":"10:23"},{"pos":10,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O mankind","transliteration":"yāayyuhā","verse_key":"10:23"},{"pos":11,"ar":"ٱلنَّاسُ","en_gloss":"O mankind","transliteration":"l-nāsu","verse_key":"10:23"},{"pos":12,"ar":"إِنَّمَا","en_gloss":"Only","transliteration":"innamā","verse_key":"10:23"},{"pos":13,"ar":"بَغْيُكُمْ","en_gloss":"your rebellion","transliteration":"baghyukum","verse_key":"10:23"},{"pos":14,"ar":"عَلَىٰٓ","en_gloss":"(is) against","transliteration":"ʿalā","verse_key":"10:23"},{"pos":15,"ar":"أَنفُسِكُم ۖ","en_gloss":"yourselves","transliteration":"anfusikum","verse_key":"10:23"},{"pos":16,"ar":"مَّتَـٰعَ","en_gloss":"(the) enjoyment","transliteration":"matāʿa","verse_key":"10:23"},{"pos":17,"ar":"ٱلْحَيَوٰةِ","en_gloss":"(of) the life","transliteration":"l-ḥayati","verse_key":"10:23"},{"pos":18,"ar":"ٱلدُّنْيَا ۖ","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"10:23"},{"pos":1