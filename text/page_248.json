:85,"en":"Are they so sure that an overwhelming punishment from God will not fall on them, or that the Last Hour will not come upon them suddenly when they least expect it?","words":[{"pos":1,"ar":"أَفَأَمِنُوٓا۟","en_gloss":"Do they then feel secure","transliteration":"afa-aminū","verse_key":"12:107"},{"pos":2,"ar":"أَن","en_gloss":"(against) that","transliteration":"an","verse_key":"12:107"},{"pos":3,"ar":"تَأْتِيَهُمْ","en_gloss":"comes to them","transliteration":"tatiyahum","verse_key":"12:107"},{"pos":4,"ar":"غَـٰشِيَةٌۭ","en_gloss":"an overwhelming","transliteration":"ghāshiyatun","verse_key":"12:107"},{"pos":5,"ar":"مِّنْ","en_gloss":"[of]","transliteration":"min","verse_key":"12:107"},{"pos":6,"ar":"عَذَابِ","en_gloss":"punishment","transliteration":"ʿadhābi","verse_key":"12:107"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"12:107"},{"pos":8,"ar":"أَوْ","en_gloss":"or","transliteration":"aw","verse_key":"12:107"},{"pos":9,"ar":"تَأْتِيَهُمُ","en_gloss":"comes to them","transliteration":"tatiyahumu","verse_key":"12:107"},{"pos":10,"ar":"ٱلسَّاعَةُ","en_gloss":"the Hour","transliteration":"l-sāʿatu","verse_key":"12:107"},{"pos":11,"ar":"بَغْتَةًۭ","en_gloss":"suddenly","transliteration":"baghtatan","verse_key":"12:107"},{"pos":12,"ar":"وَهُمْ","en_gloss":"while they","transliteration":"wahum","verse_key":"12:107"},{"pos":13,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"12:107"},{"pos":14,"ar":"يَشْعُرُونَ","en_gloss":"perceive","transliteration":"yashʿurūna","verse_key":"12:107"},{"pos":15,"ar":"١٠٧","en_gloss":"(107)","transliteration":"","verse_key":"12:107"}]},{"verse_key":"12:108","surah":12,"ayah":108,"ar_uthmani":"قُلْ هَـٰذِهِۦ سَبِيلِىٓ أَدْعُوٓا۟ إِلَى ٱللَّهِ ۚ عَلَىٰ بَصِيرَةٍ أَنَا۠ وَمَنِ ٱتَّبَعَنِى ۖ وَسُبْحَـٰنَ ٱللَّهِ وَمَآ أَنَا۠ مِنَ ٱلْمُشْرِكِينَ","en_translation_id":85,"en":"Say, ‘This is my way: based on clear evidence, I, and all who follow me, call [people] to God- glory be to God!- I do not join others with Him.’","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"12:108"},{"pos":2,"ar":"هَـٰذِهِۦ","en_gloss":"This","transliteration":"hādhihi","verse_key":"12:108"},{"pos":3,"ar":"سَبِيلِىٓ","en_gloss":"(is) my way","transliteration":"sabīlī","verse_key":"12:108"},{"pos":4,"ar":"أَدْعُوٓا۟","en_gloss":"I invite","transliteration":"adʿū","verse_key":"12:108"},{"pos":5,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"12:108"},{"pos":6,"ar":"ٱللَّهِ ۚ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"12:108"},{"pos":7,"ar":"عَلَىٰ","en_gloss":"with","transliteration":"ʿalā","verse_key":"12:108"},{"pos":8,"ar":"بَصِيرَةٍ","en_gloss":"insight","transliteration":"baṣīratin","verse_key":"12:108"},{"pos":9,"ar":"أَنَا۠","en_gloss":"I","transliteration":"anā","verse_key":"12:108"},{"pos":10,"ar":"وَمَنِ","en_gloss":"and whoever","transliteration":"wamani","verse_key":"12:108"},{"pos":11,"ar":"ٱتَّبَعَنِى ۖ","en_gloss":"follows me","transliteration":"ittabaʿanī","verse_key":"12:108"},{"pos":12,"ar":"وَسُبْحَـٰنَ","en_gloss":"And Glory be","transliteration":"wasub'ḥāna","verse_key":"12:108"},{"pos":13,"ar":"ٱللَّهِ","en_gloss":"(to) Allah","transliteration":"l-lahi","verse_key":"12:108"},{"pos":14,"ar":"وَمَآ","en_gloss":"and not","transliteration":"wamā","verse_key":"12:108"},{"pos":15,"ar":"أَنَا۠","en_gloss":"I am","transliteration":"anā","verse_key":"12:108"},{"pos":16,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"12:108"},{"pos":17,"ar":"ٱلْمُشْرِكِينَ","en_gloss":"the polytheists","transliteration":"l-mush'rikīna","verse_key":"12:108"},{"pos":18,"ar":"١٠٨","en_gloss":"(108)","transliteration":"","verse_key":"12:108"}]},{"verse_key":"12:109","surah":12,"ayah":109,"ar_uthmani":"وَمَآ أَرْسَلْنَا مِن قَبْلِكَ إِلَّا رِجَالًا نُّوحِىٓ إِلَيْهِم مِّنْ أَهْلِ ٱلْقُرَىٰٓ ۗ أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ ۗ وَلَدَارُ ٱلْـَٔاخِرَةِ خَيْرٌ لِّلَّذِينَ ٱتَّقَوْا۟ ۗ أَفَلَا تَعْقِلُونَ","en_translation_id":85,"en":"All the messengers We sent before you [Muhammad] were men to whom We made revelations, men chosen from the people of their towns. Have the [disbelievers] not travelled through the land and seen the end of those who went before them? For those who are mindful of God, the Home in the Hereafter is better. Do you [people] not use your reason?","words":[{"pos":1,"ar":"وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"12:109"},{"pos":2,"ar":"أَرْسَلْنَا","en_gloss":"We sent","transliteration":"arsalnā","verse_key":"12:109"},{"pos":3,"ar":"مِن","en_gloss":"before you","transliteration":"min","verse_key":"12:109"},{"pos":4,"ar":"قَبْلِكَ","en_gloss":"before you","transliteration":"qablika","verse_key":"12:109"},{"pos":5,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"12:109"},{"pos":6,"ar":"رِجَالًۭا","en_gloss":"men","transliteration":"rijālan","verse_key":"12:109"},{"pos":7,"ar":"نُّوحِىٓ","en_gloss":"We revealed","transliteration":"nūḥī","verse_key":"12:109"},{"pos":8,"ar":"إِلَيْهِم","en_gloss":"to them","transliteration":"ilayhim","verse_key":"12:109"},{"pos":9,"ar":"مِّنْ","en_gloss":"from (among)","transliteration":"min","verse_key":"12:109"},{"pos":10,"ar":"أَهْلِ","en_gloss":"(the) people","transliteration":"ahli","verse_key":"12:109"},{"pos":11,"ar":"ٱلْقُرَىٰٓ ۗ","en_gloss":"(of) the townships","transliteration":"l-qurā","verse_key":"12:109"},{"pos":12,"ar":"أَفَلَمْ","en_gloss":"So have not","transliteration":"afalam","verse_key":"12:109"},{"pos":13,"ar":"يَسِيرُوا۟","en_gloss":"they traveled","transliteration":"yasīrū","verse_key":"12:109"},{"pos":14,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"12:109"},{"pos":15,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"12:109"},{"pos":16,"ar":"فَيَنظُرُوا۟","en_gloss":"and seen","transliteration":"fayanẓurū","verse_key":"12:109"},{"pos":17,"ar":"كَيْفَ","en_gloss":"how","transliteration":"kayfa","verse_key":"12:109"},{"pos":18,"ar":"كَانَ","en_gloss":"was","transliteration":"kāna","verse_key":"12:109"},{"pos":19,"ar":"عَـٰقِبَةُ","en_gloss":"(the) end","transliteration":"ʿāqibatu","verse_key":"12:109"},{"pos":20,"ar":"ٱلَّذِينَ","en_gloss":"(of) those who","transliteration":"alladhīna","verse_key":"12:109"},{"pos":21,"ar":"مِن","en_gloss":"(were) before them","transliteration":"min","verse_key":"12:109"},{"pos":22,"ar":"قَبْلِهِمْ ۗ","en_gloss":"(were) before them","transliteration":"qablihim","verse_key":"12:109"},{"pos":23,"ar":"وَلَدَارُ","en_gloss":"And surely the home","transliteration":"waladāru","verse_key":"12:109"},{"pos":24,"ar":"ٱلْـَٔاخِرَةِ","en_gloss":"(of) the Hereafter","transliteration":"l-ākhirati","verse_key":"12:109"},{"pos":25,"ar":"خَيْرٌۭ","en_gloss":"(is) best","transliteration":"khayrun","verse_key":"12:109"},{"pos":26,"ar":"لِّلَّذِينَ","en_gloss":"for those who","transliteration":"lilladhīna","verse_key":"12:109"},{"pos":27,"ar":"ٱتَّقَوْا۟ ۗ","en_gloss":"fear Allah","transliteration":"ittaqaw","verse_key":"12:109"},{"pos":28,"ar":"أَفَلَا","en_gloss":"Then will not","transliteration":"afalā","verse_key":"12:109"},{"pos":29,"ar":"تَعْقِلُونَ","en_gloss":"you use reason","transliteration":"taʿqilūna","verse_key":"12:109"},{"pos":30,"ar":"١٠٩","en_gloss":"(109)","transliteration":"","verse_key":"12:109"}]},{"verse_key":"12:110","surah":12,"ayah":110,"ar_uthmani":"حَتَّىٰٓ إِذَا ٱسْتَيْـَٔسَ ٱلرُّسُلُ وَظَنُّوٓا۟ أَنَّهُمْ قَدْ كُذِبُوا۟ جَآءَهُمْ نَصْرُنَا فَنُجِّىَ مَن نَّشَآءُ ۖ وَلَا يُرَدُّ بَأْسُنَا عَنِ ٱلْقَوْمِ ٱلْمُجْرِمِينَ","en_translation_id":85,"en":"When the messengers lost all hope and realized that they had been dismissed as liars, Our help came to them: We saved whoever We pleased, but Our punishment will not be turned away from guilty people.","words":[{"pos":1,"ar":"حَتَّىٰٓ","en_gloss":"Until","transliteration":"ḥattā","verse_key":"12:110"},{"pos":2,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"12:110"},{"pos":3,"ar":"ٱسْتَيْـَٔسَ","en_gloss":"gave up hope","transliteration":"is'tayasa","verse_key":"12:110"},{"pos":4,"ar":"ٱلرُّسُلُ","en_gloss":"the Messengers","transliteration":"l-rusulu","verse_key":"12:110"},{"pos":5,"ar":"وَظَنُّوٓا۟","en_gloss":"and thought","transliteration":"waẓannū","verse_key":"12:110"},{"pos":6,"ar":"أَنَّهُمْ","en_gloss":"that they","transliteration":"annahum","verse_key":"12:110"},{"pos":7,"ar":"قَدْ","en_gloss":"certainly","transliteration":"qad","verse_key":"12:110"},{"pos":8,"ar":"كُذِبُوا۟","en_gloss":"were denied","transliteration":"kudhibū","verse_key":"12:110"},{"pos":9,"ar":"جَآءَهُمْ","en_gloss":"then came to them","transliteration":"jāahum","verse_key":"12:110"},{"pos":10,"ar":"نَصْرُنَا","en_gloss":"Our help","transliteration":"naṣrunā","verse_key":"12:110"},{"pos":11,"ar":"فَنُجِّىَ","en_gloss":"and was saved","transliteration":"fanujjiya","verse_key":"12:110"},{"pos":12,"ar":"مَن","en_gloss":"whom","transliteration":"man","verse_key":"12:110"},{"pos":13,"ar":"نَّشَآءُ ۖ","en_gloss":"We willed","transliteration":"nashāu","verse_key":"12:110"},{"pos":14,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"12:110"},{"pos":15,"ar":"يُرَدُّ","en_gloss":"(can) be repelled","transliteration":"yuraddu","verse_key":"12:110"},{"pos":16,"ar":"بَأْسُنَا","en_gloss":"Our punishment","transliteration":"basunā","verse_key":"12:110"},{"pos":17,"ar":"عَنِ","en_gloss":"from","transliteration":"ʿani","verse_key":"12:110"},{"pos":18,"ar":"ٱلْقَوْمِ","en_gloss":"the people","transliteration":"l-qawmi","verse_key":"12:110"},{"pos":19,"ar":"ٱلْمُجْرِمِينَ","en_gloss":"(who are) criminals","transliteration":"l-muj'rimīna","verse_key":"12:110"},{"pos":20,"ar":"١١٠","en_gloss":"(110)","transliteration":"","verse_key":"12:110"}]},{"verse_key":"12:111","surah":12,"ayah":111,"ar_uthmani":"لَقَدْ كَانَ فِى قَصَصِهِمْ عِبْرَةٌ لِّأُو۟لِى ٱلْأَلْبَـٰبِ ۗ مَا كَانَ حَدِيثًا يُفْتَرَىٰ وَلَـٰكِن تَصْدِيقَ ٱلَّذِى بَيْنَ يَدَيْهِ وَتَفْصِيلَ كُلِّ شَىْءٍ وَهُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ","en_translation_id":85,"en":"There is a lesson in the stories of such people for those who understand. This revelation is no fabrication: it is a confirmation of the truth of what was sent before it; an explanation of everything; a guide and a blessing for those who believe.","words":[{"pos":1,"ar":"لَقَدْ","en_gloss":"Verily","transliteration":"laqad","verse_key":"12:111"},{"pos":2,"ar":"كَانَ","en_gloss":"(there) is","transliteration":"kāna","verse_key":"12:111"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"12:111"},{"pos":4,"ar":"قَصَصِهِمْ","en_gloss":"their stories","transliteration":"qaṣaṣihim","verse_key":"12:111"},{"pos":5,"ar":"عِبْرَةٌۭ","en_gloss":"a lesson","transliteration":"ʿib'ratun","verse_key":"12:111"},{"pos":6,"ar":"لِّأُو۟لِى","en_gloss":"for men","transliteration":"li-ulī","verse_key":"12:111"},{"pos":7,"ar":"ٱلْأَلْبَـٰبِ ۗ","en_gloss":"(of) understanding","transliteration":"l-albābi","verse_key":"12:111"},{"pos":8,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"12:111"},{"pos":9,"ar":"كَانَ","en_gloss":"(it) is","transliteration":"kāna","verse_key":"12:111"},{"pos":10,"ar":"حَدِيثًۭا","en_gloss":"a narration","transliteration":"ḥadīthan","verse_key":"12:111"},{"pos":11,"ar":"يُفْتَرَىٰ","en_gloss":"invented","transliteration":"yuf'tarā","verse_key":"12:111"},{"pos":12,"ar":"وَلَـٰكِن","en_gloss":"but","transliteration":"walākin","verse_key":"12:111"},{"pos":13,"ar":"تَصْدِيقَ","en_gloss":"a confirmation","transliteration":"taṣdīqa","verse_key":"12:111"},{"pos":14,"ar":"ٱلَّذِى","en_gloss":"(of that) which","transliteration":"alladhī","verse_key":"12:111"},{"pos":15,"ar":"بَيْنَ","en_gloss":"(was) before it","transliteration":"bayna","verse_key":"12:111"},{"pos":16,"ar":"يَدَيْهِ","en_gloss":"(was) before it","transliteration":"yadayhi","verse_key":"1