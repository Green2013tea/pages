خِرَةِ مِن نَّصِيبٍ","en_translation_id":85,"en":"If anyone desires a harvest in the life to come, We shall increase it for him; if anyone desires a harvest in this world, We shall give him a share of it, but in the Hereafter he will have no share.","words":[{"pos":1,"ar":"مَن","en_gloss":"Whoever","transliteration":"man","verse_key":"42:20"},{"pos":2,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"42:20"},{"pos":3,"ar":"يُرِيدُ","en_gloss":"desiring","transliteration":"yurīdu","verse_key":"42:20"},{"pos":4,"ar":"حَرْثَ","en_gloss":"(the) harvest","transliteration":"ḥartha","verse_key":"42:20"},{"pos":5,"ar":"ٱلْـَٔاخِرَةِ","en_gloss":"(of) the Hereafter ","transliteration":"l-ākhirati","verse_key":"42:20"},{"pos":6,"ar":"نَزِدْ","en_gloss":"We increase","transliteration":"nazid","verse_key":"42:20"},{"pos":7,"ar":"لَهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"42:20"},{"pos":8,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"42:20"},{"pos":9,"ar":"حَرْثِهِۦ ۖ","en_gloss":"his harvest","transliteration":"ḥarthihi","verse_key":"42:20"},{"pos":10,"ar":"وَمَن","en_gloss":"And whoever","transliteration":"waman","verse_key":"42:20"},{"pos":11,"ar":"كَانَ","en_gloss":"is","transliteration":"kāna","verse_key":"42:20"},{"pos":12,"ar":"يُرِيدُ","en_gloss":"desiring","transliteration":"yurīdu","verse_key":"42:20"},{"pos":13,"ar":"حَرْثَ","en_gloss":"(the) harvest","transliteration":"ḥartha","verse_key":"42:20"},{"pos":14,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"42:20"},{"pos":15,"ar":"نُؤْتِهِۦ","en_gloss":"We give him","transliteration":"nu'tihi","verse_key":"42:20"},{"pos":16,"ar":"مِنْهَا","en_gloss":"of it","transliteration":"min'hā","verse_key":"42:20"},{"pos":17,"ar":"وَمَا","en_gloss":"but not","transliteration":"wamā","verse_key":"42:20"},{"pos":18,"ar":"لَهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"42:20"},{"pos":19,"ar":"فِى","en_gloss":"in","transl