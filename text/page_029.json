ٰلَكُم بَيْنَكُم بِٱلْبَـٰطِلِ وَتُدْلُوا۟ بِهَآ إِلَى ٱلْحُكَّامِ لِتَأْكُلُوا۟ فَرِيقًا مِّنْ أَمْوَٰلِ ٱلنَّاسِ بِٱلْإِثْمِ وَأَنتُمْ تَعْلَمُونَ","en_translation_id":85,"en":"Do not consume your property wrongfully, nor use it to bribe judges, intending sinfully and knowingly to consume parts of other people’s property.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"2:188"},{"pos":2,"ar":"تَأْكُلُوٓا۟","en_gloss":"eat","transliteration":"takulū","verse_key":"2:188"},{"pos":3,"ar":"أَمْوَٰلَكُم","en_gloss":"your properties","transliteration":"amwālakum","verse_key":"2:188"},{"pos":4,"ar":"بَيْنَكُم","en_gloss":"among yourselves","transliteration":"baynakum","verse_key":"2:188"},{"pos":5,"ar":"بِٱلْبَـٰطِلِ","en_gloss":"wrongfully","transliteration":"bil-bāṭili","verse_key":"2:188"},{"pos":6,"ar":"وَتُدْلُوا۟","en_gloss":"and present","transliteration":"watud'lū","verse_key":"2:188"},{"pos":7,"ar":"بِهَآ","en_gloss":"[with] it","transliteration":"bihā","verse_key":"2:188"},{"pos":8,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"2:188"},{"pos":9,"ar":"ٱلْحُكَّامِ","en_gloss":"the authorities","transliteration":"l-ḥukāmi","verse_key":"2:188"},{"pos":10,"ar":"لِتَأْكُلُوا۟","en_gloss":"so that you may eat","transliteration":"litakulū","verse_key":"2:188"},{"pos":11,"ar":"فَرِيقًۭا","en_gloss":"a portion","transliteration":"farīqan","verse_key":"2:188"},{"pos":12,"ar":"مِّنْ","en_gloss":"from","transliteration":"min","verse_key":"2:188"},{"pos":13,"ar":"أَمْوَٰلِ","en_gloss":"(the) wealth","transliteration":"amwāli","verse_key":"2:188"},{"pos":14,"ar":"ٱلنَّاسِ","en_gloss":"(of) the people","transliteration":"l-nāsi","verse_key":"2:188"},{"pos":15,"ar":"بِٱلْإِثْمِ","en_gloss":"sinfully","transliteration":"bil-ith'mi","verse_key":"2:188"},{"pos":16,"ar":"وَأَنتُمْ","en_gloss":"while you","transliteration":"wa-antum","verse_key":"2:188"},{"pos":17,"ar":"تَعْلَمُونَ","en_gloss":"know","transliteration":"taʿlamūna","verse_key":"2:188"},{"pos":18,"ar":"١٨٨","en_gloss":"(188)","transliteration":"","verse_key":"2:188"}]},{"verse_key":"2:189","surah":2,"ayah":189,"ar_uthmani":"۞ يَسْـَٔلُونَكَ عَنِ ٱلْأَهِلَّةِ ۖ قُلْ هِىَ مَوَٰقِيتُ لِلنَّاسِ وَٱلْحَجِّ ۗ وَلَيْسَ ٱلْبِرُّ بِأَن تَأْتُوا۟ ٱلْبُيُوتَ مِن ظُهُورِهَا وَلَـٰكِنَّ ٱلْبِرَّ مَنِ ٱتَّقَىٰ ۗ وَأْتُوا۟ ٱلْبُيُوتَ مِنْ أَبْوَٰبِهَا ۚ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ","en_translation_id":85,"en":"They ask you [Prophet] about crescent moons. Say, ‘They show the times appointed for people, and for the pilgrimage.’ Goodness does not consist of entering houses by the back [door]; the truly good person is the one who is mindful of God. So enter your houses by their [main] doors and be mindful of God so that you may prosper.","words":[{"pos":1,"ar":"۞ يَسْـَٔلُونَكَ","en_gloss":"They ask you","transliteration":"yasalūnaka","verse_key":"2:189"},{"pos":2,"ar":"عَنِ","en_gloss":"about","transliteration":"ʿani","verse_key":"2:189"},{"pos":3,"ar":"ٱلْأَهِلَّةِ ۖ","en_gloss":"the new moons","transliteration":"l-ahilati","verse_key":"2:189"},{"pos":4,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"2:189"},{"pos":5,"ar":"هِىَ","en_gloss":"They","transliteration":"hiya","verse_key":"2:189"},{"pos":6,"ar":"مَوَٰقِيتُ","en_gloss":"(are) indicators of periods","transliteration":"mawāqītu","verse_key":"2:189"},{"pos":7,"ar":"لِلنَّاسِ","en_gloss":"for the people","transliteration":"lilnnāsi","verse_key":"2:189"},{"pos":8,"ar":"وَٱلْحَجِّ ۗ","en_gloss":"and (for) the Hajj","transliteration":"wal-ḥaji","verse_key":"2:189"},{"pos":9,"ar":"وَلَيْسَ","en_gloss":"And it is not","transliteration":"walaysa","verse_key":"2:189"},{"pos":10,"ar":"ٱلْبِرُّ","en_gloss":"[the] righteousness","transliteration":"l-biru","verse_key":"2:189"},{"pos":11,"ar":"بِأَن","en_gloss":"that","transliteration":"bi-an","verse_key":"2:189"},{"pos":12,"ar":"تَأْتُوا۟","en_gloss":"you come","transliteration":"tatū","verse_key":"2:1