":34,"ayah":35,"ar_uthmani":"وَقَالُوا۟ نَحْنُ أَكْثَرُ أَمْوَٰلًا وَأَوْلَـٰدًا وَمَا نَحْنُ بِمُعَذَّبِينَ","en_translation_id":85,"en":"They would say, ‘We have greater wealth and more children than you, and we shall not be punished.’","words":[{"pos":1,"ar":"وَقَالُوا۟","en_gloss":"And they say","transliteration":"waqālū","verse_key":"34:35"},{"pos":2,"ar":"نَحْنُ","en_gloss":"We","transliteration":"naḥnu","verse_key":"34:35"},{"pos":3,"ar":"أَكْثَرُ","en_gloss":"(have) more","transliteration":"aktharu","verse_key":"34:35"},{"pos":4,"ar":"أَمْوَٰلًۭا","en_gloss":"wealth","transliteration":"amwālan","verse_key":"34:35"},{"pos":5,"ar":"وَأَوْلَـٰدًۭا","en_gloss":"and children","transliteration":"wa-awlādan","verse_key":"34:35"},{"pos":6,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"34:35"},{"pos":7,"ar":"نَحْنُ","en_gloss":"we","transliteration":"naḥnu","verse_key":"34:35"},{"pos":8,"ar":"بِمُعَذَّبِينَ","en_gloss":"will be punished","transliteration":"bimuʿadhabīna","verse_key":"34:35"},{"pos":9,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"34:35"}]},{"verse_key":"34:36","surah":34,"ayah":36,"ar_uthmani":"قُلْ إِنَّ رَبِّى يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ وَيَقْدِرُ وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ","en_translation_id":85,"en":"Say [Prophet], ‘My Lord gives in abundance to whoever He will and sparingly to whoever He will, though most people do not understand.","words":[{"pos":1,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"34:36"},{"pos":2,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"34:36"},{"pos":3,"ar":"رَبِّى","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"34:36"},{"pos":4,"ar":"يَبْسُطُ","en_gloss":"extends","transliteration":"yabsuṭu","verse_key":"34:36"},{"pos":5,"ar":"ٱلرِّزْقَ","en_gloss":"the provision","transliteration":"l-riz'qa","verse_key":"34:36"},{"pos":6,"ar":"لِمَن","en_gloss":"for whom","transliteration":"liman","verse_key":"34:36"},{"pos":7,"ar":"يَشَآءُ","en_gloss":"He wills","transliteration":"yashāu","verse_key":"34:36"},{"pos":8,"ar":"وَيَقْدِرُ","en_gloss":"and restricts","transliteration":"wayaqdiru","verse_key":"34:36"},{"pos":9,"ar":"وَلَـٰكِنَّ","en_gloss":"but","transliteration":"walākinna","verse_key":"34:36"},{"pos":10,"ar":"أَكْثَرَ","en_gloss":"most","transliteration":"akthara","verse_key":"34:36"},{"pos":11,"ar":"ٱلنَّاسِ","en_gloss":"[the] people","transliteration":"l-nāsi","verse_key":"34:36"},{"pos":12,"ar":"لَا","en_gloss":"(do) not","transliteration":"lā","verse_key":"34:36"},{"pos":13,"ar":"يَعْلَمُونَ","en_gloss":"know","transliteration":"yaʿlamūna","verse_key":"34:36"},{"pos":14,"ar":"٣٦","en_gloss":"(36)","transliteration":"","verse_key":"34:36"}]},{"verse_key":"34:37","surah":34,"ayah":37,"ar_uthmani":"وَمَآ أَمْوَٰلُكُمْ وَلَآ أَوْلَـٰدُكُم بِٱلَّتِى تُقَرِّبُكُمْ عِندَنَا زُلْفَىٰٓ إِلَّا مَنْ ءَامَنَ وَعَمِلَ صَـٰلِحًا فَأُو۟لَـٰٓئِكَ لَهُمْ جَزَآءُ ٱلضِّعْفِ بِمَا عَمِلُوا۟ وَهُمْ فِى ٱلْغُرُفَـٰتِ ءَامِنُونَ","en_translation_id":85,"en":"Neither wealth nor children will bring you nearer to Us, but those who believe and do good deeds will have multiple rewards for what they have done, and will live safely in the lofty dwellings of Paradise,","words":[{"pos":1,"ar":"وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"34:37"},{"pos":2,"ar":"أَمْوَٰلُكُمْ","en_gloss":"your wealth","transliteration":"amwālukum","verse_key":"34:37"},{"pos":3,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"34:37"},{"pos":4,"ar":"أَوْلَـٰدُكُم","en_gloss":"your children","transliteration":"awlādukum","verse_key":"34:37"},{"pos":5,"ar":"بِٱلَّتِى","en_gloss":"[that]","transliteration":"bi-allatī","verse_key":"34:37"},{"pos":6,"ar":"تُقَرِّبُكُمْ","en_gloss":"will bring you close","transliteration":"tuqarribukum","verse_key":"34:37"},{"pos":7,"ar":"عِندَنَا","en_gloss":"to Us","transliteration":"ʿindanā","verse_key":"34:37"},{"pos":8,"ar":"زُلْف