{"page":444,"verses":[{"verse_key":"36:55","surah":36,"ayah":55,"ar_uthmani":"إِنَّ أَصْحَـٰبَ ٱلْجَنَّةِ ٱلْيَوْمَ فِى شُغُلٍ فَـٰكِهُونَ","en_translation_id":85,"en":"The people of Paradise today are happily occupied-","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"36:55"},{"pos":2,"ar":"أَصْحَـٰبَ","en_gloss":"(the) companions","transliteration":"aṣḥāba","verse_key":"36:55"},{"pos":3,"ar":"ٱلْجَنَّةِ","en_gloss":"(of) Paradise","transliteration":"l-janati","verse_key":"36:55"},{"pos":4,"ar":"ٱلْيَوْمَ","en_gloss":"this Day","transliteration":"l-yawma","verse_key":"36:55"},{"pos":5,"ar":"فِى","en_gloss":"[in]","transliteration":"fī","verse_key":"36:55"},{"pos":6,"ar":"شُغُلٍۢ","en_gloss":"will be occupied","transliteration":"shughulin","verse_key":"36:55"},{"pos":7,"ar":"فَـٰكِهُونَ","en_gloss":"(in) amusement","transliteration":"fākihūna","verse_key":"36:55"},{"pos":8,"ar":"٥٥","en_gloss":"(55)","transliteration":"","verse_key":"36:55"}]},{"verse_key":"36:56","surah":36,"ayah":56,"ar_uthmani":"هُمْ وَأَزْوَٰجُهُمْ فِى ظِلَـٰلٍ عَلَى ٱلْأَرَآئِكِ مُتَّكِـُٔونَ","en_translation_id":85,"en":"they and their spouses- seated on couches in the shade.","words":[{"pos":1,"ar":"هُمْ","en_gloss":"They","transliteration":"hum","verse_key":"36:56"},{"pos":2,"ar":"وَأَزْوَٰجُهُمْ","en_gloss":"and their spouses","transliteration":"wa-azwājuhum","verse_key":"36:56"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"36:56"},{"pos":4,"ar":"ظِلَـٰلٍ","en_gloss":"shades","transliteration":"ẓilālin","verse_key":"36:56"},{"pos":5,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"36:56"},{"pos":6,"ar":"ٱلْأَرَآئِكِ","en_gloss":"[the] couches","transliteration":"l-arāiki","verse_key":"36:56"},{"pos":7,"ar":"مُتَّكِـُٔونَ","en_gloss":"reclining","transliteration":"muttakiūna","verse_key":"36:56"},{"pos":8,"ar":"٥٦","en_gloss":"(56)","transliteration":"","verse_key":"36:56"}]},{"verse_key":"36:57","surah":3