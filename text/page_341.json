s":[{"pos":1,"ar":"وَجَـٰهِدُوا۟","en_gloss":"And strive","transliteration":"wajāhidū","verse_key":"22:78"},{"pos":2,"ar":"فِى","en_gloss":"for","transliteration":"fī","verse_key":"22:78"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"22:78"},{"pos":4,"ar":"حَقَّ","en_gloss":"(with the) striving due (to) Him","transliteration":"ḥaqqa","verse_key":"22:78"},{"pos":5,"ar":"جِهَادِهِۦ ۚ","en_gloss":"(with the) striving due (to) Him","transliteration":"jihādihi","verse_key":"22:78"},{"pos":6,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"22:78"},{"pos":7,"ar":"ٱجْتَبَىٰكُمْ","en_gloss":"(has) chosen you","transliteration":"ij'tabākum","verse_key":"22:78"},{"pos":8,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"22:78"},{"pos":9,"ar":"جَعَلَ","en_gloss":"placed","transliteration":"jaʿala","verse_key":"22:78"},{"pos":10,"ar":"عَلَيْكُمْ","en_gloss":"upon you","transliteration":"ʿalaykum","verse_key":"22:78"},{"pos":11,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"22:78"},{"pos":12,"ar":"ٱلدِّينِ","en_gloss":"the religion","transliteration":"l-dīni","verse_key":"22:78"},{"pos":13,"ar":"مِنْ","en_gloss":"any","transliteration":"min","verse_key":"22:78"},{"pos":14,"ar":"حَرَجٍۢ ۚ","en_gloss":"difficulty","transliteration":"ḥarajin","verse_key":"22:78"},{"pos":15,"ar":"مِّلَّةَ","en_gloss":"(The) religion","transliteration":"millata","verse_key":"22:78"},{"pos":16,"ar":"أَبِيكُمْ","en_gloss":"(of) your father","transliteration":"abīkum","verse_key":"22:78"},{"pos":17,"ar":"إِبْرَٰهِيمَ ۚ","en_gloss":"Ibrahim","transliteration":"ib'rāhīma","verse_key":"22:78"},{"pos":18,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"22:78"},{"pos":19,"ar":"سَمَّىٰكُمُ","en_gloss":"named you","transliteration":"sammākumu","verse_key":"22:78"},{"pos":20,"ar":"ٱلْمُسْلِمِينَ","en_gloss":"Muslims","transliteration":"l-mus'limīna","verse_key":"22:78"},{"pos":21,"ar":"مِن","en_gloss":"before","transliteration":"min","verse_key":"22:78"},{"pos":22,"ar":"قَبْلُ","en_gloss":"before","transliteration":"qablu","verse_key":"22:78"},{"pos":23,"ar":"وَفِى","en_gloss":"and in","transliteration":"wafī","verse_key":"22:78"},{"pos":24,"ar":"هَـٰذَا","en_gloss":"this","transliteration":"hādhā","verse_key":"22:78"},{"pos":25,"ar":"لِيَكُونَ","en_gloss":"that may be","transliteration":"liyakūna","verse_key":"22:78"},{"pos":26,"ar":"ٱلرَّسُولُ","en_gloss":"the Messenger","transliteration":"l-rasūlu","verse_key":"22:78"},{"pos":27,"ar":"شَهِيدًا","en_gloss":"a witness","transliteration":"shahīdan","verse_key":"22:78"},{"pos":28,"ar":"عَلَيْكُمْ","en_gloss":"over you","transliteration":"ʿalaykum","verse_key":"22:78"},{"pos":29,"ar":"وَتَكُونُوا۟","en_gloss":"and you may be","transliteration":"watakūnū","verse_key":"22:78"},{"pos":30,"ar":"شُهَدَآءَ","en_gloss":"witnesses","transliteration":"shuhadāa","verse_key":"22:78"},{"pos":31,"ar":"عَلَى","en_gloss":"on","transliteration":"ʿalā","verse_key":"22:78"},{"pos":32,"ar":"ٱلنَّاسِ ۚ","en_gloss":"the mankind","transliteration":"l-nāsi","verse_key":"22:78"},{"pos":33,"ar":"فَأَقِيمُوا۟","en_gloss":"So establish","transliteration":"fa-aqīmū","verse_key":"22:78"},{"pos":34,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"22:78"},{"pos":35,"ar":"وَءَاتُوا۟","en_gloss":"and give","transliteration":"waātū","verse_key":"22:78"},{"pos":36,"ar":"ٱلزَّكَوٰةَ","en_gloss":"zakah","transliteration":"l-zakata","verse_key":"22:78"},{"pos":37,"ar":"وَٱعْتَصِمُوا۟","en_gloss":"and hold fast","transliteration":"wa-iʿ'taṣimū","verse_key":"22:78"},{"pos":38,"ar":"بِٱللَّهِ","en_gloss":"to Allah","transliteration":"bil-lahi","verse_key":"22:78"},{"pos":39,"ar":"هُوَ","en_gloss":"He","transliteration":"huwa","verse_key":"22:78"},{"pos":40,"ar":"مَوْلَىٰكُمْ ۖ","en_gloss":"(is) your Protector ","transliteration":"mawlākum","verse_key":"22:78"},{"pos":41,"ar":"فَنِعْمَ","en_gloss":"so an Excellent","trans