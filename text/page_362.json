"},{"pos":6,"ar":"عَلَيْهِ","en_gloss":"to him","transliteration":"ʿalayhi","verse_key":"25:32"},{"pos":7,"ar":"ٱلْقُرْءَانُ","en_gloss":"the Quran","transliteration":"l-qur'ānu","verse_key":"25:32"},{"pos":8,"ar":"جُمْلَةًۭ","en_gloss":"all at once","transliteration":"jum'latan","verse_key":"25:32"},{"pos":9,"ar":"وَٰحِدَةًۭ ۚ","en_gloss":"all at once","transliteration":"wāḥidatan","verse_key":"25:32"},{"pos":10,"ar":"كَذَٰلِكَ","en_gloss":"Thus","transliteration":"kadhālika","verse_key":"25:32"},{"pos":11,"ar":"لِنُثَبِّتَ","en_gloss":"that We may strengthen","transliteration":"linuthabbita","verse_key":"25:32"},{"pos":12,"ar":"بِهِۦ","en_gloss":"thereby","transliteration":"bihi","verse_key":"25:32"},{"pos":13,"ar":"فُؤَادَكَ ۖ","en_gloss":"your heart","transliteration":"fuādaka","verse_key":"25:32"},{"pos":14,"ar":"وَرَتَّلْنَـٰهُ","en_gloss":"and We have recited it","transliteration":"warattalnāhu","verse_key":"25:32"},{"pos":15,"ar":"تَرْتِيلًۭا","en_gloss":"(with distinct) recitation","transliteration":"tartīlan","verse_key":"25:32"},{"pos":16,"ar":"٣٢","en_gloss":"(32)","transliteration":"","verse_key":"25:32"}]}]}