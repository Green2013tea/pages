ۖ وَإِن تُصِبْهُمْ سَيِّئَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ ٱلْإِنسَـٰنَ كَفُورٌ","en_translation_id":85,"en":"If they still turn away [remember that], We have not sent you [Prophet] to be their guardian: your only duty is to deliver the message. When We give man a taste of Our mercy, he rejoices in it, but if some harm befalls him on account of what he has done with his own hands, then he is ungrateful.","words":[{"pos":1,"ar":"فَإِنْ","en_gloss":"Then if","transliteration":"fa-in","verse_key":"42:48"},{"pos":2,"ar":"أَعْرَضُوا۟","en_gloss":"they turn away","transliteration":"aʿraḍū","verse_key":"42:48"},{"pos":3,"ar":"فَمَآ","en_gloss":"then not","transliteration":"famā","verse_key":"42:48"},{"pos":4,"ar":"أَرْسَلْنَـٰكَ","en_gloss":"We have sent you","transliteration":"arsalnāka","verse_key":"42:48"},{"pos":5,"ar":"عَلَيْهِمْ","en_gloss":"over them","transliteration":"ʿalayhim","verse_key":"42:48"},{"pos":6,"ar":"حَفِيظًا ۖ","en_gloss":"(as) a guardian","transliteration":"ḥafīẓan","verse_key":"42:48"},{"pos":7,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"42:48"},{"pos":8,"ar":"عَلَيْكَ","en_gloss":"(is) on you","transliteration":"ʿalayka","verse_key":"42:48"},{"pos":9,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"42:48"},{"pos":10,"ar":"ٱلْبَلَـٰغُ ۗ","en_gloss":"the conveyance","transliteration":"l-balāghu","verse_key":"42:48"},{"pos":11,"ar":"وَإِنَّآ","en_gloss":"And indeed","transliteration":"wa-innā","verse_key":"42:48"},{"pos":12,"ar":"إِذَآ","en_gloss":"when","transliteration":"idhā","verse_key":"42:48"},{"pos":13,"ar":"أَذَقْنَا","en_gloss":"We cause to taste","transliteration":"adhaqnā","verse_key":"42:48"},{"pos":14,"ar":"ٱلْإِنسَـٰنَ","en_gloss":"[the] man","transliteration":"l-insāna","verse_key":"42:48"},{"pos":15,"ar":"مِنَّا","en_gloss":"from Us","transliteration":"minnā","verse_key":"42:48"},{"pos":16,"ar":"رَحْمَةًۭ","en_gloss":"Mercy","transliteration":"raḥmatan","verse_key":"42:48"},{"pos":