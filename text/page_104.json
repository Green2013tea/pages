":"4:167"},{"pos":11,"ar":"بَعِيدًا","en_gloss":"far away","transliteration":"baʿīdan","verse_key":"4:167"},{"pos":12,"ar":"١٦٧","en_gloss":"(167)","transliteration":"","verse_key":"4:167"}]},{"verse_key":"4:168","surah":4,"ayah":168,"ar_uthmani":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ وَظَلَمُوا۟ لَمْ يَكُنِ ٱللَّهُ لِيَغْفِرَ لَهُمْ وَلَا لِيَهْدِيَهُمْ طَرِيقًا","en_translation_id":85,"en":"God will not forgive those who have disbelieved and do evil, nor will He guide them to any path","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"4:168"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"4:168"},{"pos":3,"ar":"كَفَرُوا۟","en_gloss":"disbelieved","transliteration":"kafarū","verse_key":"4:168"},{"pos":4,"ar":"وَظَلَمُوا۟","en_gloss":"and did wrong","transliteration":"waẓalamū","verse_key":"4:168"},{"pos":5,"ar":"لَمْ","en_gloss":"not","transliteration":"lam","verse_key":"4:168"},{"pos":6,"ar":"يَكُنِ","en_gloss":"will","transliteration":"yakuni","verse_key":"4:168"},{"pos":7,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"4:168"},{"pos":8,"ar":"لِيَغْفِرَ","en_gloss":"[to] forgive","transliteration":"liyaghfira","verse_key":"4:168"},{"pos":9,"ar":"لَهُمْ","en_gloss":"them","transliteration":"lahum","verse_key":"4:168"},{"pos":10,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"4:168"},{"pos":11,"ar":"لِيَهْدِيَهُمْ","en_gloss":"He will guide them","transliteration":"liyahdiyahum","verse_key":"4:168"},{"pos":12,"ar":"طَرِيقًا","en_gloss":"(to) a way","transliteration":"ṭarīqan","verse_key":"4:168"},{"pos":13,"ar":"١٦٨","en_gloss":"(168)","transliteration":"","verse_key":"4:168"}]},{"verse_key":"4:169","surah":4,"ayah":169,"ar_uthmani":"إِلَّا طَرِيقَ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ أَبَدًا ۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا","en_translation_id":85,"en":"except that of Hell, where they will remain for ever- this is easy for God.","words":[{"pos