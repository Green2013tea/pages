ation":"min","verse_key":"4:164"},{"pos":6,"ar":"قَبْلُ","en_gloss":"before","transliteration":"qablu","verse_key":"4:164"},{"pos":7,"ar":"وَرُسُلًۭا","en_gloss":"and Messengers","transliteration":"warusulan","verse_key":"4:164"},{"pos":8,"ar":"لَّمْ","en_gloss":"not","transliteration":"lam","verse_key":"4:164"},{"pos":9,"ar":"نَقْصُصْهُمْ","en_gloss":"We (have) mentioned them","transliteration":"naqṣuṣ'hum","verse_key":"4:164"},{"pos":10,"ar":"عَلَيْكَ ۚ","en_gloss":"to you","transliteration":"ʿalayka","verse_key":"4:164"},{"pos":11,"ar":"وَكَلَّمَ","en_gloss":"And spoke","transliteration":"wakallama","verse_key":"4:164"},{"pos":12,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"4:164"},{"pos":13,"ar":"مُوسَىٰ","en_gloss":"(to) Musa","transliteration":"mūsā","verse_key":"4:164"},{"pos":14,"ar":"تَكْلِيمًۭا","en_gloss":"(in a) conversation","transliteration":"taklīman","verse_key":"4:164"},{"pos":15,"ar":"١٦٤","en_gloss":"(164)","transliteration":"","verse_key":"4:164"}]},{"verse_key":"4:165","surah":4,"ayah":165,"ar_uthmani":"رُّسُلًا مُّبَشِّرِينَ وَمُنذِرِينَ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَى ٱللَّهِ حُجَّةٌۢ بَعْدَ ٱلرُّسُلِ ۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا","en_translation_id":85,"en":"They were messengers bearing good news and warning, so that mankind would have no excuse before God, once the messengers had been sent: God is almighty and all wise.","words":[{"pos":1,"ar":"رُّسُلًۭا","en_gloss":"Messengers","transliteration":"rusulan","verse_key":"4:165"},{"pos":2,"ar":"مُّبَشِّرِينَ","en_gloss":"bearers of glad tidings","transliteration":"mubashirīna","verse_key":"4:165"},{"pos":3,"ar":"وَمُنذِرِينَ","en_gloss":"and warners","transliteration":"wamundhirīna","verse_key":"4:165"},{"pos":4,"ar":"لِئَلَّا","en_gloss":"so that not","transliteration":"li-allā","verse_key":"4:165"},{"pos":5,"ar":"يَكُونَ","en_gloss":"there is","transliteration":"yakūna","verse_key":"4:165"},{"pos":6,"ar":"لِلنَّاسِ","en_gloss":"for mankind","transliteratio