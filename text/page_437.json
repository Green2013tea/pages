{"page":437,"verses":[{"verse_key":"35:19","surah":35,"ayah":19,"ar_uthmani":"وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ","en_translation_id":85,"en":"The blind and the seeing are not alike,","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"35:19"},{"pos":2,"ar":"يَسْتَوِى","en_gloss":"equal","transliteration":"yastawī","verse_key":"35:19"},{"pos":3,"ar":"ٱلْأَعْمَىٰ","en_gloss":"(are) the blind","transliteration":"l-aʿmā","verse_key":"35:19"},{"pos":4,"ar":"وَٱلْبَصِيرُ","en_gloss":"and the seeing","transliteration":"wal-baṣīru","verse_key":"35:19"},{"pos":5,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"35:19"}]},{"verse_key":"35:20","surah":35,"ayah":20,"ar_uthmani":"وَلَا ٱلظُّلُمَـٰتُ وَلَا ٱلنُّورُ","en_translation_id":85,"en":"nor are darkness and light;","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"35:20"},{"pos":2,"ar":"ٱلظُّلُمَـٰتُ","en_gloss":"the darkness[es]","transliteration":"l-ẓulumātu","verse_key":"35:20"},{"pos":3,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"35:20"},{"pos":4,"ar":"ٱلنُّورُ","en_gloss":"[the] light","transliteration":"l-nūru","verse_key":"35:20"},{"pos":5,"ar":"٢٠","en_gloss":"(20)","transliteration":"","verse_key":"35:20"}]},{"verse_key":"35:21","surah":35,"ayah":21,"ar_uthmani":"وَلَا ٱلظِّلُّ وَلَا ٱلْحَرُورُ","en_translation_id":85,"en":"shade and heat are not alike,","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And not","transliteration":"walā","verse_key":"35:21"},{"pos":2,"ar":"ٱلظِّلُّ","en_gloss":"the shade","transliteration":"l-ẓilu","verse_key":"35:21"},{"pos":3,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"35:21"},{"pos":4,"ar":"ٱلْحَرُورُ","en_gloss":"the heat","transliteration":"l-ḥarūru","verse_key":"35:21"},{"pos":5,"ar":"٢١","en_gloss":"(21)","transliteration":"","verse_key":"35:21"}]},{"verse_key":"35:22","surah":35,"ayah":22,"ar_uthmani":"وَمَا يَسْتَوِى ٱلْأَحْيَآ