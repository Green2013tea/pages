:110"},{"pos":11,"ar":"رَّبِّكَ","en_gloss":"your Lord","transliteration":"rabbika","verse_key":"11:110"},{"pos":12,"ar":"لَقُضِىَ","en_gloss":"surely would have been judged","transliteration":"laquḍiya","verse_key":"11:110"},{"pos":13,"ar":"بَيْنَهُمْ ۚ","en_gloss":"between them","transliteration":"baynahum","verse_key":"11:110"},{"pos":14,"ar":"وَإِنَّهُمْ","en_gloss":"And indeed, they","transliteration":"wa-innahum","verse_key":"11:110"},{"pos":15,"ar":"لَفِى","en_gloss":"surely (are) in","transliteration":"lafī","verse_key":"11:110"},{"pos":16,"ar":"شَكٍّۢ","en_gloss":"doubt","transliteration":"shakkin","verse_key":"11:110"},{"pos":17,"ar":"مِّنْهُ","en_gloss":"concerning it","transliteration":"min'hu","verse_key":"11:110"},{"pos":18,"ar":"مُرِيبٍۢ","en_gloss":"suspicious","transliteration":"murībin","verse_key":"11:110"},{"pos":19,"ar":"١١٠","en_gloss":"(110)","transliteration":"","verse_key":"11:110"}]},{"verse_key":"11:111","surah":11,"ayah":111,"ar_uthmani":"وَإِنَّ كُلًّا لَّمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَـٰلَهُمْ ۚ إِنَّهُۥ بِمَا يَعْمَلُونَ خَبِيرٌ","en_translation_id":85,"en":"Your Lord will give everyone full due for whatever they have done: He is aware of everything they do.","words":[{"pos":1,"ar":"وَإِنَّ","en_gloss":"And indeed","transliteration":"wa-inna","verse_key":"11:111"},{"pos":2,"ar":"كُلًّۭا","en_gloss":"to each [when]","transliteration":"kullan","verse_key":"11:111"},{"pos":3,"ar":"لَّمَّا","en_gloss":"to each [when]","transliteration":"lammā","verse_key":"11:111"},{"pos":4,"ar":"لَيُوَفِّيَنَّهُمْ","en_gloss":"surely will pay them in full","transliteration":"layuwaffiyannahum","verse_key":"11:111"},{"pos":5,"ar":"رَبُّكَ","en_gloss":"your Lord","transliteration":"rabbuka","verse_key":"11:111"},{"pos":6,"ar":"أَعْمَـٰلَهُمْ ۚ","en_gloss":"their deeds","transliteration":"aʿmālahum","verse_key":"11:111"},{"pos":7,"ar":"إِنَّهُۥ","en_gloss":"Indeed, He","transliteration":"innahu","verse_key":"11:111"},{"pos":8,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"11:111"},{"pos":9,"ar":"يَعْمَلُونَ","en_gloss":"they do","transliteration":"yaʿmalūna","verse_key":"11:111"},{"pos":10,"ar":"خَبِيرٌۭ","en_gloss":"(is) All-Aware","transliteration":"khabīrun","verse_key":"11:111"},{"pos":11,"ar":"١١١","en_gloss":"(111)","transliteration":"","verse_key":"11:111"}]},{"verse_key":"11:112","surah":11,"ayah":112,"ar_uthmani":"فَٱسْتَقِمْ كَمَآ أُمِرْتَ وَمَن تَابَ مَعَكَ وَلَا تَطْغَوْا۟ ۚ إِنَّهُۥ بِمَا تَعْمَلُونَ بَصِيرٌ","en_translation_id":85,"en":"So keep to the right course as you have been commanded, together with those who have turned to God with you. Do not overstep the limits, for He sees everything you do.","words":[{"pos":1,"ar":"فَٱسْتَقِمْ","en_gloss":"So stand firm","transliteration":"fa-is'taqim","verse_key":"11:112"},{"pos":2,"ar":"كَمَآ","en_gloss":"as","transliteration":"kamā","verse_key":"11:112"},{"pos":3,"ar":"أُمِرْتَ","en_gloss":"you are commanded","transliteration":"umir'ta","verse_key":"11:112"},{"pos":4,"ar":"وَمَن","en_gloss":"and (those) who","transliteration":"waman","verse_key":"11:112"},{"pos":5,"ar":"تَابَ","en_gloss":"turn (in repentance)","transliteration":"tāba","verse_key":"11:112"},{"pos":6,"ar":"مَعَكَ","en_gloss":"with you","transliteration":"maʿaka","verse_key":"11:112"},{"pos":7,"ar":"وَلَا","en_gloss":"and (do) not","transliteration":"walā","verse_key":"11:112"},{"pos":8,"ar":"تَطْغَوْا۟ ۚ","en_gloss":"transgress","transliteration":"taṭghaw","verse_key":"11:112"},{"pos":9,"ar":"إِنَّهُۥ","en_gloss":"Indeed, He","transliteration":"innahu","verse_key":"11:112"},{"pos":10,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"11:112"},{"pos":11,"ar":"تَعْمَلُونَ","en_gloss":"you do","transliteration":"taʿmalūna","verse_key":"11:112"},{"pos":12,"ar":"بَصِيرٌۭ","en_gloss":"(is) All-Seer","transliteration":"baṣīrun","verse_key":"11:112"},{"pos":13,"ar":"١١٢","en_gloss":"(112)","transliteration":"","verse_key":"11:112"}]},{"verse_key":"11:113","surah":11,"ayah":113,"ar_uthmani":"وَلَا تَرْكَنُوٓا۟ إِلَى ٱلَّذِينَ ظَلَمُوا۟ فَتَمَسَّكُمُ ٱلنَّارُ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِنْ أَوْلِيَآءَ ثُمَّ لَا تُنصَرُونَ","en_translation_id":85,"en":"Do not rely on those who do evil, or the Fire may touch you, and then you will have no one to protect you from God, nor will you be helped.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"11:113"},{"pos":2,"ar":"تَرْكَنُوٓا۟","en_gloss":"incline","transliteration":"tarkanū","verse_key":"11:113"},{"pos":3,"ar":"إِلَى","en_gloss":"to","transliteration":"ilā","verse_key":"11:113"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"11:113"},{"pos":5,"ar":"ظَلَمُوا۟","en_gloss":"do wrong","transliteration":"ẓalamū","verse_key":"11:113"},{"pos":6,"ar":"فَتَمَسَّكُمُ","en_gloss":"lest touches you","transliteration":"fatamassakumu","verse_key":"11:113"},{"pos":7,"ar":"ٱلنَّارُ","en_gloss":"the Fire","transliteration":"l-nāru","verse_key":"11:113"},{"pos":8,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"11:113"},{"pos":9,"ar":"لَكُم","en_gloss":"(is) for you","transliteration":"lakum","verse_key":"11:113"},{"pos":10,"ar":"مِّن","en_gloss":"besides Allah","transliteration":"min","verse_key":"11:113"},{"pos":11,"ar":"دُونِ","en_gloss":"besides Allah","transliteration":"dūni","verse_key":"11:113"},{"pos":12,"ar":"ٱللَّهِ","en_gloss":"besides Allah","transliteration":"l-lahi","verse_key":"11:113"},{"pos":13,"ar":"مِنْ","en_gloss":"any","transliteration":"min","verse_key":"11:113"},{"pos":14,"ar":"أَوْلِيَآءَ","en_gloss":"protectors","transliteration":"awliyāa","verse_key":"11:113"},{"pos":15,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"11:113"},{"pos":16,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"11:113"},{"pos":17,"ar":"تُنصَرُونَ","en_gloss":"you will be helped","transliteration":"tunṣarūna","verse_key":"11:113"},{"pos":18,"ar":"١١٣","en_gloss":"(113)","transliteration":"","verse_key":"11:113"}]},{"verse_key":"11:114","surah":11,"ayah":114,"ar_uthmani":"وَأَقِمِ ٱلصَّلَوٰةَ طَرَفَىِ ٱلنَّهَارِ وَزُلَفًا مِّنَ ٱلَّيْلِ ۚ إِنَّ ٱلْحَسَنَـٰتِ يُذْهِبْنَ ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ ذِكْرَىٰ لِلذَّٰكِرِينَ","en_translation_id":85,"en":"[Prophet], keep up the prayer at both ends of the day, and during parts of the night, for good things drive bad away- this is a reminder for those who are aware.","words":[{"pos":1,"ar":"وَأَقِمِ","en_gloss":"And establish","transliteration":"wa-aqimi","verse_key":"11:114"},{"pos":2,"ar":"ٱلصَّلَوٰةَ","en_gloss":"the prayer","transliteration":"l-ṣalata","verse_key":"11:114"},{"pos":3,"ar":"طَرَفَىِ","en_gloss":"(at the) two ends","transliteration":"ṭarafayi","verse_key":"11:114"},{"pos":4,"ar":"ٱلنَّهَارِ","en_gloss":"(of) the day","transliteration":"l-nahāri","verse_key":"11:114"},{"pos":5,"ar":"وَزُلَفًۭا","en_gloss":"and (at) the approach","transliteration":"wazulafan","verse_key":"11:114"},{"pos":6,"ar":"مِّنَ","en_gloss":"of","transliteration":"mina","verse_key":"11:114"},{"pos":7,"ar":"ٱلَّيْلِ ۚ","en_gloss":"the night","transliteration":"al-layli","verse_key":"11:114"},{"pos":8,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"11:114"},{"pos":9,"ar":"ٱلْحَسَنَـٰتِ","en_gloss":"the good deeds","transliteration":"l-ḥasanāti","verse_key":"11:114"},{"pos":10,"ar":"يُذْهِبْنَ","en_gloss":"remove","transliteration":"yudh'hib'na","verse_key":"11:114"},{"pos":11,"ar":"ٱلسَّيِّـَٔاتِ ۚ","en_gloss":"the evil deeds","transliteration":"l-sayiāti","verse_key":"11:114"},{"pos":12,"ar":"ذَٰلِكَ","en_gloss":"That","transliteration":"dhālika","verse_key":"11:114"},{"pos":13,"ar":"ذِكْرَىٰ","en_gloss":"(is) a reminder","transliteration":"dhik'rā","verse_key":"11:114"},{"pos":14,"ar":"لِلذَّٰكِرِينَ","en_gloss":"for those who remember","transliteration":"lildhākirīna","verse_key":"11:114"},{"pos":15,"ar":"١١٤","en_gloss":"(114)","transliteration":"","verse_key":"11:114"}]},{"verse_key":"11:115","surah":11,"ayah":115,"ar_uthmani":"وَٱصْبِرْ فَإِنَّ ٱللَّهَ لَا يُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ","en_translation_id":85,"en":"Be steadfast: God does not let the rewards of those who do good go to waste.","words":[{"pos":1,"ar":"وَٱصْبِرْ","en_gloss":"And be patient","transliteration":"wa-iṣ'bir","verse_key":"11:115"},{"pos":2,"ar":"فَإِنَّ","en_gloss":"for indeed","transliteration":"fa-inna","verse_key":"11:115"},{"pos":3,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"11:115"},{"pos":4,"ar":"لَا","en_gloss":"(does) not","transliteration":"lā","verse_key":"11:115"},{"pos":5,"ar":"يُضِيعُ","en_gloss":"let go waste","transliteration":"yuḍīʿu","verse_key":"11:115"},{"pos":6,"ar":"أَجْرَ","en_gloss":"(the) reward","transliteration":"ajra","verse_key":"11:115"},{"pos":7,"ar":"ٱلْمُحْسِنِينَ","en_gloss":"(of) the good-doers","transliteration":"l-muḥ'sinīna","verse_key":"11:115"},{"pos":8,"ar":"١١٥","en_gloss":"(115)","transliteration":"","verse_key":"11:115"}]},{"verse_key":"11:116","surah":11,"ayah":116,"ar_uthmani":"فَلَوْلَا كَانَ مِنَ ٱلْقُرُونِ مِن قَبْلِكُمْ أُو۟لُوا۟ بَقِيَّةٍ يَنْهَوْنَ عَنِ ٱلْفَسَادِ فِى ٱلْأَرْضِ إِلَّا قَلِيلًا مِّمَّنْ أَنجَيْنَا مِنْهُمْ ۗ وَٱتَّبَعَ ٱلَّذِينَ ظَلَمُوا۟ مَآ أُتْرِفُوا۟ فِيهِ وَكَانُوا۟ مُجْرِمِينَ","en_translation_id":85,"en":"If only there had been, among the generations before your time, people with a rem-nant of good sense, to forbid corruption on the earth! We saved only a few of them, while the unjust pursued the enjoyment of plenty, and persisted in sin.","words":[{"pos":1,"ar":"فَلَوْلَا","en_gloss":"So why not","transliteration":"falawlā","verse_key":"11:116"},{"pos":2,"ar":"كَانَ","en_gloss":"had been","transliteration":"kāna","verse_key":"11:116"},{"pos":3,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"11:116"},{"pos":4,"ar":"ٱلْقُرُونِ","en_gloss":"the generations","transliteration":"l-qurūni","verse_key":"11:116"},{"pos":5,"ar":"مِن","en_gloss":"before you","transliteration":"min","verse_key":"11:116"},{"pos":6,"ar":"قَبْلِكُمْ","en_gloss":"before you","transliteration":"qablikum","verse_key":"11:116"},{"pos":7,"ar":"أُو۟لُوا۟","en_gloss":"those possessing a remnant","transliteration":"ulū","verse_key":"11:116"},{"pos":8,"ar":"بَقِيَّةٍۢ","en_gloss":"those possessing a remnant","transliteration":"baqiyyatin","verse_key":"11:116"},{"pos":9,"ar":"يَنْهَوْنَ","en_gloss":"forbidding","transliteration":"yanhawna","verse_key":"11:116"},{"pos":10,"ar":"عَنِ","en_gloss":"from","transliteration":"ʿani","verse_key":"11:116"},{"pos":11,"ar":"ٱلْفَسَادِ","en_gloss":"the corruption","transliteration":"l-fasādi","verse_key":"11:116"},{"pos":12,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"11:116"},{"pos":13,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"11:116"},{"pos":14,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"11:116"},{"pos":15,"ar":"قَلِيلًۭا","en_gloss":"a few","transliteration":"qalīlan","verse_key":"11:116"},{"pos":16,"ar":"مِّمَّنْ","en_gloss":"of those","transliteration":"mimman","verse_key":"11:116"},{"pos":17,"ar":"أَنجَيْنَا","en_gloss":"We saved","transliteration":"anjaynā","verse_key":"11:116"},{"pos":18,"ar":"مِنْهُمْ ۗ","en_gloss":"among them","transliteration":"min'hum","verse_key":"11:116"},{"pos":19,"ar":"وَٱتَّبَعَ","en_gloss":"But followed","transliteration":"wa-ittabaʿa","verse_key":"11:116"},{"pos":20,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"11:116"},{"pos":21,"ar":"ظَلَمُوا۟","en_gloss":"did wrong","transliteration":"ẓalamū","verse_key":"11:116"},{"pos":22,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"11:116"},{"pos":23,"ar":"أُتْرِفُوا۟","en_gloss":"luxury they were given","transliteration":"ut'rifū","verse_key":"11:116"},{"pos":24,"ar":"فِيهِ","en_gloss":"therein","transliteration":"fīhi","verse_key":"11:116"},{"pos":25,"ar":"وَكَانُوا۟","en_gloss":"and they were","transliteration":"wakānū","verse_key":"11:116"},{"pos":26,"ar":"مُجْرِمِينَ","en_gloss":"criminals","transliteration":"muj'rimīna","verse_key":"11:116"},{"pos":27,"ar":"١١٦","en_gloss":"(116)","transliteration":"","verse_key":"11:116"}]},{"verse_key":"11:117","surah":11,"ayah":117,"ar_uthmani":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ ٱلْقُرَىٰ بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ","en_translation_id":85,"en":"Your Lord would not destroy any town without cause if its people were acting righteously.","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"11:117"},{"pos":2,"ar":"كَانَ","en_gloss":"would","transliteration":"kāna","verse_key":"11:117"},{"pos":3,"ar":"رَبُّكَ","en_gloss":"your Lord","transliteration":"rabbuka","verse_key":"11:117"},{"pos":4,"ar":"لِيُهْلِكَ","en_gloss":"destroy","transliteration":"liyuh'lika","verse_key":"11:117"},{"pos":5,"ar":"ٱلْقُرَىٰ","en_gloss":"the cities","transliteration":"l-qurā","verse_key":"11:117"},{"pos":6,"ar":"بِظُلْمٍۢ","en_gloss":"unjustly","transliteration":"biẓul'min","verse_key":"11:117"},{"pos":7,"ar":"وَأَهْلُهَا","en_gloss":"while its people","transliteration":"wa-ahluhā","verse_key":"11:117"},{"pos":8,"ar":"مُصْلِحُونَ","en_gloss":"(were) reformers","transliteration":"muṣ'liḥūna","verse_key":"11:117"},{"pos":9,"ar":"١١٧","en_gloss":"(117)","transliteration":"","verse_key":"11:117"}]}]}