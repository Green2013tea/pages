َةٌ وَرِزْقٌ كَرِيمٌ","en_translation_id":85,"en":"Those who believed and emigrated, and struggled for God’s cause, and those who gave refuge and help- they are the true believers and they will have forgiveness and generous provision.","words":[{"pos":1,"ar":"وَٱلَّذِينَ","en_gloss":"And those who","transliteration":"wa-alladhīna","verse_key":"8:74"},{"pos":2,"ar":"ءَامَنُوا۟","en_gloss":"believed","transliteration":"āmanū","verse_key":"8:74"},{"pos":3,"ar":"وَهَاجَرُوا۟","en_gloss":"and emigrated","transliteration":"wahājarū","verse_key":"8:74"},{"pos":4,"ar":"وَجَـٰهَدُوا۟","en_gloss":"and strove hard","transliteration":"wajāhadū","verse_key":"8:74"},{"pos":5,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"8:74"},{"pos":6,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"8:74"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"8:74"},{"pos":8,"ar":"وَٱلَّذِينَ","en_gloss":"and those who","transliteration":"wa-alladhīna","verse_key":"8:74"},{"pos":9,"ar":"ءَاوَوا۟","en_gloss":"gave shelter","transliteration":"āwaw","verse_key":"8:74"},{"pos":10,"ar":"وَّنَصَرُوٓا۟","en_gloss":"and helped","transliteration":"wanaṣarū","verse_key":"8:74"},{"pos":11,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"those ","transliteration":"ulāika","verse_key":"8:74"},{"pos":12,"ar":"هُمُ","en_gloss":"they (are)","transliteration":"humu","verse_key":"8:74"},{"pos":13,"ar":"ٱلْمُؤْمِنُونَ","en_gloss":"the believers","transliteration":"l-mu'minūna","verse_key":"8:74"},{"pos":14,"ar":"حَقًّۭا ۚ","en_gloss":"(in) truth","transliteration":"ḥaqqan","verse_key":"8:74"},{"pos":15,"ar":"لَّهُم","en_gloss":"For them","transliteration":"lahum","verse_key":"8:74"},{"pos":16,"ar":"مَّغْفِرَةٌۭ","en_gloss":"(is) forgiveness","transliteration":"maghfiratun","verse_key":"8:74"},{"pos":17,"ar":"وَرِزْقٌۭ","en_gloss":"and a provision","transliteration":"wariz'qun","verse_key":"8:74"},{"pos":18,"ar":"كَرِيمٌۭ","en_gloss":"noble","translite