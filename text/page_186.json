hard","transliteration":"wajāhadū","verse_key":"8:72"},{"pos":6,"ar":"بِأَمْوَٰلِهِمْ","en_gloss":"with their wealth","transliteration":"bi-amwālihim","verse_key":"8:72"},{"pos":7,"ar":"وَأَنفُسِهِمْ","en_gloss":"and their lives","transliteration":"wa-anfusihim","verse_key":"8:72"},{"pos":8,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"8:72"},{"pos":9,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"8:72"},{"pos":10,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"8:72"},{"pos":11,"ar":"وَٱلَّذِينَ","en_gloss":"and those who","transliteration":"wa-alladhīna","verse_key":"8:72"},{"pos":12,"ar":"ءَاوَوا۟","en_gloss":"gave shelter","transliteration":"āwaw","verse_key":"8:72"},{"pos":13,"ar":"وَّنَصَرُوٓا۟","en_gloss":"and helped","transliteration":"wanaṣarū","verse_key":"8:72"},{"pos":14,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"those ","transliteration":"ulāika","verse_key":"8:72"},{"pos":15,"ar":"بَعْضُهُمْ","en_gloss":"some of them","transliteration":"baʿḍuhum","verse_key":"8:72"},{"pos":16,"ar":"أَوْلِيَآءُ","en_gloss":"(are) allies","transliteration":"awliyāu","verse_key":"8:72"},{"pos":17,"ar":"بَعْضٍۢ ۚ","en_gloss":"(of) another","transliteration":"baʿḍin","verse_key":"8:72"},{"pos":18,"ar":"وَٱلَّذِينَ","en_gloss":"But those who","transliteration":"wa-alladhīna","verse_key":"8:72"},{"pos":19,"ar":"ءَامَنُوا۟","en_gloss":"believed","transliteration":"āmanū","verse_key":"8:72"},{"pos":20,"ar":"وَلَمْ","en_gloss":"and (did) not","transliteration":"walam","verse_key":"8:72"},{"pos":21,"ar":"يُهَاجِرُوا۟","en_gloss":"emigrate","transliteration":"yuhājirū","verse_key":"8:72"},{"pos":22,"ar":"مَا","en_gloss":"(it is) not","transliteration":"mā","verse_key":"8:72"},{"pos":23,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"8:72"},{"pos":24,"ar":"مِّن","en_gloss":"(of)","transliteration":"min","verse_key":"8:72"},{"pos":25,"ar":"وَلَـٰيَتِهِم","en_gloss":"their protection","trans