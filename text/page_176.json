206"},{"pos":5,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"7:206"},{"pos":6,"ar":"يَسْتَكْبِرُونَ","en_gloss":"(do) they turn away in pride","transliteration":"yastakbirūna","verse_key":"7:206"},{"pos":7,"ar":"عَنْ","en_gloss":"from","transliteration":"ʿan","verse_key":"7:206"},{"pos":8,"ar":"عِبَادَتِهِۦ","en_gloss":"His worship","transliteration":"ʿibādatihi","verse_key":"7:206"},{"pos":9,"ar":"وَيُسَبِّحُونَهُۥ","en_gloss":"And they glorify Him","transliteration":"wayusabbiḥūnahu","verse_key":"7:206"},{"pos":10,"ar":"وَلَهُۥ","en_gloss":"and to Him","transliteration":"walahu","verse_key":"7:206"},{"pos":11,"ar":"يَسْجُدُونَ ۩","en_gloss":"they prostrate","transliteration":"yasjudūna","verse_key":"7:206"},{"pos":12,"ar":"٢٠٦","en_gloss":"(206)","transliteration":"","verse_key":"7:206"}]}]}