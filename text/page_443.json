":"وَيَقُولُونَ","en_gloss":"And they say","transliteration":"wayaqūlūna","verse_key":"36:48"},{"pos":2,"ar":"مَتَىٰ","en_gloss":"When (is)","transliteration":"matā","verse_key":"36:48"},{"pos":3,"ar":"هَـٰذَا","en_gloss":"this","transliteration":"hādhā","verse_key":"36:48"},{"pos":4,"ar":"ٱلْوَعْدُ","en_gloss":"promise","transliteration":"l-waʿdu","verse_key":"36:48"},{"pos":5,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"36:48"},{"pos":6,"ar":"كُنتُمْ","en_gloss":"you are","transliteration":"kuntum","verse_key":"36:48"},{"pos":7,"ar":"صَـٰدِقِينَ","en_gloss":"truthful","transliteration":"ṣādiqīna","verse_key":"36:48"},{"pos":8,"ar":"٤٨","en_gloss":"(48)","transliteration":"","verse_key":"36:48"}]},{"verse_key":"36:49","surah":36,"ayah":49,"ar_uthmani":"مَا يَنظُرُونَ إِلَّا صَيْحَةً وَٰحِدَةً تَأْخُذُهُمْ وَهُمْ يَخِصِّمُونَ","en_translation_id":85,"en":"But all they are waiting for is a single blast that will overtake them while they are still arguing with each other.","words":[{"pos":1,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"36:49"},{"pos":2,"ar":"يَنظُرُونَ","en_gloss":"they await","transliteration":"yanẓurūna","verse_key":"36:49"},{"pos":3,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"36:49"},{"pos":4,"ar":"صَيْحَةًۭ","en_gloss":"a shout","transliteration":"ṣayḥatan","verse_key":"36:49"},{"pos":5,"ar":"وَٰحِدَةًۭ","en_gloss":"one","transliteration":"wāḥidatan","verse_key":"36:49"},{"pos":6,"ar":"تَأْخُذُهُمْ","en_gloss":"it will seize them","transliteration":"takhudhuhum","verse_key":"36:49"},{"pos":7,"ar":"وَهُمْ","en_gloss":"while they","transliteration":"wahum","verse_key":"36:49"},{"pos":8,"ar":"يَخِصِّمُونَ","en_gloss":"are disputing","transliteration":"yakhiṣṣimūna","verse_key":"36:49"},{"pos":9,"ar":"٤٩","en_gloss":"(49)","transliteration":"","verse_key":"36:49"}]},{"verse_key":"36:50","surah":36,"ayah":50,"ar_uthmani":"فَلَا يَسْتَطِيعُونَ تَوْصِيَةً وَلَآ إِلَىٰٓ أَهْلِهِمْ يَرْجِعُونَ","en_translation_id":85,"en":"They will have no time to make bequests, nor will they have the chance to return to their own people.","words":[{"pos":1,"ar":"فَلَا","en_gloss":"Then not","transliteration":"falā","verse_key":"36:50"},{"pos":2,"ar":"يَسْتَطِيعُونَ","en_gloss":"they will be able","transliteration":"yastaṭīʿūna","verse_key":"36:50"},{"pos":3,"ar":"تَوْصِيَةًۭ","en_gloss":"(to) make a will","transliteration":"tawṣiyatan","verse_key":"36:50"},{"pos":4,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"36:50"},{"pos":5,"ar":"إِلَىٰٓ","en_gloss":"to","transliteration":"ilā","verse_key":"36:50"},{"pos":6,"ar":"أَهْلِهِمْ","en_gloss":"their people","transliteration":"ahlihim","verse_key":"36:50"},{"pos":7,"ar":"يَرْجِعُونَ","en_gloss":"they (can) return","transliteration":"yarjiʿūna","verse_key":"36:50"},{"pos":8,"ar":"٥٠","en_gloss":"(50)","transliteration":"","verse_key":"36:50"}]},{"verse_key":"36:51","surah":36,"ayah":51,"ar_uthmani":"وَنُفِخَ فِى ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلْأَجْدَاثِ إِلَىٰ رَبِّهِمْ يَنسِلُونَ","en_translation_id":85,"en":"The Trumpet will be sounded and- lo and behold!- they will rush out to their Lord from their graves.","words":[{"pos":1,"ar":"وَنُفِخَ","en_gloss":"And will be blown","transliteration":"wanufikha","verse_key":"36:51"},{"pos":2,"ar":"فِى","en_gloss":"[in]","transliteration":"fī","verse_key":"36:51"},{"pos":3,"ar":"ٱلصُّورِ","en_gloss":"the trumpet","transliteration":"l-ṣūri","verse_key":"36:51"},{"pos":4,"ar":"فَإِذَا","en_gloss":"and behold","transliteration":"fa-idhā","verse_key":"36:51"},{"pos":5,"ar":"هُم","en_gloss":"They","transliteration":"hum","verse_key":"36:51"},{"pos":6,"ar":"مِّنَ","en_gloss":"from","transliteration":"mina","verse_key":"36:51"},{"pos":7,"ar":"ٱلْأَجْدَاثِ","en_gloss":"the graves","transliteration":"l-ajdāthi","verse_key":"36:51"},{"pos":8,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"36:51"},{"pos":9,"ar":"رَبِّهِمْ","en_gloss":"their Lord","transliteration":"rabbihim","verse_key":"36:51"},{"pos":10,"ar":"يَنسِلُونَ","en_gloss":"[they] will hasten","transliteration":"yansilūna","verse_key":"36:51"},{"pos":11,"ar":"٥١","en_gloss":"(51)","transliteration":"","verse_key":"36:51"}]},{"verse_key":"36:52","surah":36,"ayah":52,"ar_uthmani":"قَالُوا۟ يَـٰوَيْلَنَا مَنۢ بَعَثَنَا مِن مَّرْقَدِنَا ۜ ۗ هَـٰذَا مَا وَعَدَ ٱلرَّحْمَـٰنُ وَصَدَقَ ٱلْمُرْسَلُونَ","en_translation_id":85,"en":"They will say, ‘Alas for us! Who has resurrected us from our resting places?’ [They will be told], ‘This is what the Lord of Mercy promised, and the messengers told the truth.’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They [will] say","transliteration":"qālū","verse_key":"36:52"},{"pos":2,"ar":"يَـٰوَيْلَنَا","en_gloss":"O woe to us","transliteration":"yāwaylanā","verse_key":"36:52"},{"pos":3,"ar":"مَنۢ","en_gloss":"Who","transliteration":"man","verse_key":"36:52"},{"pos":4,"ar":"بَعَثَنَا","en_gloss":"has raised us","transliteration":"baʿathanā","verse_key":"36:52"},{"pos":5,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"36:52"},{"pos":6,"ar":"مَّرْقَدِنَا ۜ ۗ","en_gloss":"our sleeping place","transliteration":"marqadinā","verse_key":"36:52"},{"pos":7,"ar":"هَـٰذَا","en_gloss":"This (is)","transliteration":"hādhā","verse_key":"36:52"},{"pos":8,"ar":"مَا","en_gloss":"What","transliteration":"mā","verse_key":"36:52"},{"pos":9,"ar":"وَعَدَ","en_gloss":"(had) promised","transliteration":"waʿada","verse_key":"36:52"},{"pos":10,"ar":"ٱلرَّحْمَـٰنُ","en_gloss":"the Most Gracious","transliteration":"l-raḥmānu","verse_key":"36:52"},{"pos":11,"ar":"وَصَدَقَ","en_gloss":"and told (the) truth","transliteration":"waṣadaqa","verse_key":"36:52"},{"pos":12,"ar":"ٱلْمُرْسَلُونَ","en_gloss":"the Messengers","transliteration":"l-mur'salūna","verse_key":"36:52"},{"pos":13,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"36:52"}]},{"verse_key":"36:53","surah":36,"ayah":53,"ar_uthmani":"إِن كَانَتْ إِلَّا صَيْحَةً وَٰحِدَةً فَإِذَا هُمْ جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ","en_translation_id":85,"en":"It was just one single blast and then- lo and behold!- they were all brought before Us.","words":[{"pos":1,"ar":"إِن","en_gloss":"Not","transliteration":"in","verse_key":"36:53"},{"pos":2,"ar":"كَانَتْ","en_gloss":"it will be","transliteration":"kānat","verse_key":"36:53"},{"pos":3,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"36:53"},{"pos":4,"ar":"صَيْحَةًۭ","en_gloss":"a shout","transliteration":"ṣayḥatan","verse_key":"36:53"},{"pos":5,"ar":"وَٰحِدَةًۭ","en_gloss":"single","transliteration":"wāḥidatan","verse_key":"36:53"},{"pos":6,"ar":"فَإِذَا","en_gloss":"so behold","transliteration":"fa-idhā","verse_key":"36:53"},{"pos":7,"ar":"هُمْ","en_gloss":"They","transliteration":"hum","verse_key":"36:53"},{"pos":8,"ar":"جَمِيعٌۭ","en_gloss":"all","transliteration":"jamīʿun","verse_key":"36:53"},{"pos":9,"ar":"لَّدَيْنَا","en_gloss":"before Us","transliteration":"ladaynā","verse_key":"36:53"},{"pos":10,"ar":"مُحْضَرُونَ","en_gloss":"(will be) brought","transliteration":"muḥ'ḍarūna","verse_key":"36:53"},{"pos":11,"ar":"٥٣","en_gloss":"(53)","transliteration":"","verse_key":"36:53"}]},{"verse_key":"36:54","surah":36,"ayah":54,"ar_uthmani":"فَٱلْيَوْمَ لَا تُظْلَمُ نَفْسٌ شَيْـًٔا وَلَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","en_translation_id":85,"en":"‘Today, no soul will be wronged in the least: you will only be repaid for your deeds.","words":[{"pos":1,"ar":"فَٱلْيَوْمَ","en_gloss":"So this Day","transliteration":"fal-yawma","verse_key":"36:54"},{"pos":2,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"36:54"},{"pos":3,"ar":"تُظْلَمُ","en_gloss":"will be wronged","transliteration":"tuẓ'lamu","verse_key":"36:54"},{"pos":4,"ar":"نَفْسٌۭ","en_gloss":"a soul","transliteration":"nafsun","verse_key":"36:54"},{"pos":5,"ar":"شَيْـًۭٔا","en_gloss":"(in) anything","transliteration":"shayan","verse_key":"36:54"},{"pos":6,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"36:54"},{"pos":7,"ar":"تُجْزَوْنَ","en_gloss":"you will be recompensed","transliteration":"tuj'zawna","verse_key":"36:54"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"36:54"},{"pos":9,"ar":"مَا","en_gloss":"(for) what","transliteration":"mā","verse_key":"36:54"},{"pos":10,"ar":"كُنتُمْ","en_gloss":"you used (to)","transliteration":"kuntum","verse_key":"36:54"},{"pos":11,"ar":"تَعْمَلُونَ","en_gloss":"do","transliteration":"taʿmalūna","verse_key":"36:54"},{"pos":12,"ar":"٥٤","en_gloss":"(54)","transliteration":"","verse_key":"36:54"}]}]}