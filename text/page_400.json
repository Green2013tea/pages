ُ","en_gloss":"to them","transliteration":"lahumu","verse_key":"29:38"},{"pos":10,"ar":"ٱلشَّيْطَـٰنُ","en_gloss":"the Shaitaan","transliteration":"l-shayṭānu","verse_key":"29:38"},{"pos":11,"ar":"أَعْمَـٰلَهُمْ","en_gloss":"their deeds","transliteration":"aʿmālahum","verse_key":"29:38"},{"pos":12,"ar":"فَصَدَّهُمْ","en_gloss":"and averted them","transliteration":"faṣaddahum","verse_key":"29:38"},{"pos":13,"ar":"عَنِ","en_gloss":"from","transliteration":"ʿani","verse_key":"29:38"},{"pos":14,"ar":"ٱلسَّبِيلِ","en_gloss":"the Way","transliteration":"l-sabīli","verse_key":"29:38"},{"pos":15,"ar":"وَكَانُوا۟","en_gloss":"though they were","transliteration":"wakānū","verse_key":"29:38"},{"pos":16,"ar":"مُسْتَبْصِرِينَ","en_gloss":"endowed with insight","transliteration":"mus'tabṣirīna","verse_key":"29:38"},{"pos":17,"ar":"٣٨","en_gloss":"(38)","transliteration":"","verse_key":"29:38"}]}]}