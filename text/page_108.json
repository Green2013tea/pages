mpartially: do not let hatred of others lead you away from justice, but adhere to justice, for that is closer to awareness of God. Be mindful of God: God is well aware of all that you do.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"5:8"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"5:8"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"5:8"},{"pos":4,"ar":"كُونُوا۟","en_gloss":"Be","transliteration":"kūnū","verse_key":"5:8"},{"pos":5,"ar":"قَوَّٰمِينَ","en_gloss":"steadfast","transliteration":"qawwāmīna","verse_key":"5:8"},{"pos":6,"ar":"لِلَّهِ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"5:8"},{"pos":7,"ar":"شُهَدَآءَ","en_gloss":"(as) witnesses","transliteration":"shuhadāa","verse_key":"5:8"},{"pos":8,"ar":"بِٱلْقِسْطِ ۖ","en_gloss":"in justice","transliteration":"bil-qis'ṭi","verse_key":"5:8"},{"pos":9,"ar":"وَلَا","en_gloss":"and let not","transliteration":"walā","verse_key":"5:8"},{"pos":10,"ar":"يَجْرِمَنَّكُمْ","en_gloss":"prevent you","transliteration":"yajrimannakum","verse_key":"5:8"},{"pos":11,"ar":"شَنَـَٔانُ","en_gloss":"hatred","transliteration":"shanaānu","verse_key":"5:8"},{"pos":12,"ar":"قَوْمٍ","en_gloss":"(of) a people","transliteration":"qawmin","verse_key":"5:8"},{"pos":13,"ar":"عَلَىٰٓ","en_gloss":"[upon]","transliteration":"ʿalā","verse_key":"5:8"},{"pos":14,"ar":"أَلَّا","en_gloss":"that not","transliteration":"allā","verse_key":"5:8"},{"pos":15,"ar":"تَعْدِلُوا۟ ۚ","en_gloss":"you do justice","transliteration":"taʿdilū","verse_key":"5:8"},{"pos":16,"ar":"ٱعْدِلُوا۟","en_gloss":"Be just","transliteration":"iʿ'dilū","verse_key":"5:8"},{"pos":17,"ar":"هُوَ","en_gloss":"it","transliteration":"huwa","verse_key":"5:8"},{"pos":18,"ar":"أَقْرَبُ","en_gloss":"(is) nearer","transliteration":"aqrabu","verse_key":"5:8"},{"pos":19,"ar":"لِلتَّقْوَىٰ ۖ","en_gloss":"to [the] piety","transliteration":"