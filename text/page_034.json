y":"2:218","surah":2,"ayah":218,"ar_uthmani":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَاجَرُوا۟ وَجَـٰهَدُوا۟ فِى سَبِيلِ ٱللَّهِ أُو۟لَـٰٓئِكَ يَرْجُونَ رَحْمَتَ ٱللَّهِ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","en_translation_id":85,"en":"But those who have believed, migrated, and striven for God’s cause, it is they who can look forward to God’s mercy: God is most forgiving and merciful.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"2:218"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"2:218"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believed","transliteration":"āmanū","verse_key":"2:218"},{"pos":4,"ar":"وَٱلَّذِينَ","en_gloss":"and those who","transliteration":"wa-alladhīna","verse_key":"2:218"},{"pos":5,"ar":"هَاجَرُوا۟","en_gloss":"emigrated","transliteration":"hājarū","verse_key":"2:218"},{"pos":6,"ar":"وَجَـٰهَدُوا۟","en_gloss":"and strove","transliteration":"wajāhadū","verse_key":"2:218"},{"pos":7,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"2:218"},{"pos":8,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"2:218"},{"pos":9,"ar":"ٱللَّهِ","en_gloss":"(of) Allah ","transliteration":"l-lahi","verse_key":"2:218"},{"pos":10,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"those","transliteration":"ulāika","verse_key":"2:218"},{"pos":11,"ar":"يَرْجُونَ","en_gloss":"they hope","transliteration":"yarjūna","verse_key":"2:218"},{"pos":12,"ar":"رَحْمَتَ","en_gloss":"(for) Mercy","transliteration":"raḥmata","verse_key":"2:218"},{"pos":13,"ar":"ٱللَّهِ ۚ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"2:218"},{"pos":14,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"2:218"},{"pos":15,"ar":"غَفُورٌۭ","en_gloss":"(is) Oft-Forgiving","transliteration":"ghafūrun","verse_key":"2:218"},{"pos":16,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"2:218"},{"pos":17,"ar":"٢١٨","en_gloss":"(218)","transliteration":"","verse_key":"2:218"}]},{"verse_key":"2:219","surah":2,"ayah":219,"ar_uthmani":"۞ يَسْـَٔلُونَكَ عَنِ ٱلْخَمْرِ وَٱلْمَيْسِرِ ۖ قُلْ فِيهِمَآ إِثْمٌ كَبِيرٌ وَمَنَـٰفِعُ لِلنَّاسِ وَإِثْمُهُمَآ أَكْبَرُ مِن نَّفْعِهِمَا ۗ وَيَسْـَٔلُونَكَ مَاذَا يُنفِقُونَ قُلِ ٱلْعَفْوَ ۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْـَٔايَـٰتِ لَعَلَّكُمْ تَتَفَكَّرُونَ","en_translation_id":85,"en":"They ask you [Prophet] about intoxicants and gambling: say, ‘There is great sin in both, and some benefit for people: the sin is greater than the benefit.’ They ask you what they should give: say, ‘Give what you can spare.’ In this way, God makes His messages clear to you, so that you may reflect","words":[{"pos":1,"ar":"۞ يَسْـَٔلُونَكَ","en_gloss":"They ask you","transliteration":"yasalūnaka","verse_key":"2:219"},{"pos":2,"ar":"عَنِ","en_gloss":"about","transliteration":"ʿani","verse_key":"2:219"},{"pos":3,"ar":"ٱلْخَمْرِ","en_gloss":"[the] intoxicants","transliteration":"l-khamri","verse_key":"2:219"},{"pos":4,"ar":"وَٱلْمَيْسِرِ ۖ","en_gloss":"and [the] games of chance","transliteration":"wal-maysiri","verse_key":"2:219"},{"pos":5,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"2:219"},{"pos":6,"ar":"فِيهِمَآ","en_gloss":"In both of them","transliteration":"fīhimā","verse_key":"2:219"},{"pos":7,"ar":"إِثْمٌۭ","en_gloss":"(is) a sin","transliteration":"ith'mun","verse_key":"2:219"},{"pos":8,"ar":"كَبِيرٌۭ","en_gloss":"great","transliteration":"kabīrun","verse_key":"2:219"},{"pos":9,"ar":"وَمَنَـٰفِعُ","en_gloss":"and (some) benefits","transliteration":"wamanāfiʿu","verse_key":"2:219"},{"pos":10,"ar":"لِلنَّاسِ","en_gloss":"for [the] people","transliteration":"lilnnāsi","verse_key":"2:219"},{"pos":11,"ar":"وَإِثْمُهُمَآ","en_gloss":"But sin of both of them","transliteration":"wa-ith'muhumā","verse_key":"2:219"},{"pos":12,"ar":"أَكْبَرُ","en_gloss":"(is) greater","transliteration":"akbaru","verse_key":"2:219"},{"pos":13,"ar":"مِن","en_gloss":"th