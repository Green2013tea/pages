)","transliteration":"","verse_key":"17:35"}]},{"verse_key":"17:36","surah":17,"ayah":36,"ar_uthmani":"وَلَا تَقْفُ مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ ۚ إِنَّ ٱلسَّمْعَ وَٱلْبَصَرَ وَٱلْفُؤَادَ كُلُّ أُو۟لَـٰٓئِكَ كَانَ عَنْهُ مَسْـُٔولًا","en_translation_id":85,"en":"Do not follow blindly what you do not know to be true: ears, eyes, and heart, you will be questioned about all these.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"17:36"},{"pos":2,"ar":"تَقْفُ","en_gloss":"pursue","transliteration":"taqfu","verse_key":"17:36"},{"pos":3,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"17:36"},{"pos":4,"ar":"لَيْسَ","en_gloss":"not","transliteration":"laysa","verse_key":"17:36"},{"pos":5,"ar":"لَكَ","en_gloss":"you have","transliteration":"laka","verse_key":"17:36"},{"pos":6,"ar":"بِهِۦ","en_gloss":"of it","transliteration":"bihi","verse_key":"17:36"},{"pos":7,"ar":"عِلْمٌ ۚ","en_gloss":"any knowledge","transliteration":"ʿil'mun","verse_key":"17:36"},{"pos":8,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"17:36"},{"pos":9,"ar":"ٱلسَّمْعَ","en_gloss":"the hearing","transliteration":"l-samʿa","verse_key":"17:36"},{"pos":10,"ar":"وَٱلْبَصَرَ","en_gloss":"and the sight","transliteration":"wal-baṣara","verse_key":"17:36"},{"pos":11,"ar":"وَٱلْفُؤَادَ","en_gloss":"and the heart","transliteration":"wal-fuāda","verse_key":"17:36"},{"pos":12,"ar":"كُلُّ","en_gloss":"all","transliteration":"kullu","verse_key":"17:36"},{"pos":13,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"those","transliteration":"ulāika","verse_key":"17:36"},{"pos":14,"ar":"كَانَ","en_gloss":"will be","transliteration":"kāna","verse_key":"17:36"},{"pos":15,"ar":"عَنْهُ","en_gloss":"[about it]","transliteration":"ʿanhu","verse_key":"17:36"},{"pos":16,"ar":"مَسْـُٔولًۭا","en_gloss":"questioned","transliteration":"masūlan","verse_key":"17:36"},{"pos":17,"ar":"٣٦","en_gloss":"(36)","transliteration":"","verse_key":"17:36"}]},{"verse_key":"17:37","surah":17,"ayah":37,"ar_uthmani":"وَلَا تَمْشِ فِى ٱلْأَرْضِ مَرَحًا ۖ إِنَّكَ لَن تَخْرِقَ ٱلْأَرْضَ وَلَن تَبْلُغَ ٱلْجِبَالَ طُولًا","en_translation_id":85,"en":"Do not strut arrogantly about the earth: you cannot break it open, nor match the mountains in height.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"17:37"},{"pos":2,"ar":"تَمْشِ","en_gloss":"walk","transliteration":"tamshi","verse_key":"17:37"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"17:37"},{"pos":4,"ar":"ٱلْأَرْضِ","en_gloss":"the earth","transliteration":"l-arḍi","verse_key":"17:37"},{"pos":5,"ar":"مَرَحًا ۖ","en_gloss":"(with) insolence","transliteration":"maraḥan","verse_key":"17:37"},{"pos":6,"ar":"إِنَّكَ","en_gloss":"Indeed, you","transliteration":"innaka","verse_key":"17:37"},{"pos":7,"ar":"لَن","en_gloss":"will never","transliteration":"lan","verse_key":"17:37"},{"pos":8,"ar":"تَخْرِقَ","en_gloss":"tear","transliteration":"takhriqa","verse_key":"17:37"},{"pos":9,"ar":"ٱلْأَرْضَ","en_gloss":"the earth","transliteration":"l-arḍa","verse_key":"17:37"},{"pos":10,"ar":"وَلَن","en_gloss":"and will never","transliteration":"walan","verse_key":"17:37"},{"pos":11,"ar":"تَبْلُغَ","en_gloss":"reach","transliteration":"tablugha","verse_key":"17:37"},{"pos":12,"ar":"ٱلْجِبَالَ","en_gloss":"the mountains","transliteration":"l-jibāla","verse_key":"17:37"},{"pos":13,"ar":"طُولًۭا","en_gloss":"(in) height","transliteration":"ṭūlan","verse_key":"17:37"},{"pos":14,"ar":"٣٧","en_gloss":"(37)","transliteration":"","verse_key":"17:37"}]},{"verse_key":"17:38","surah":17,"ayah":38,"ar_uthmani":"كُلُّ ذَٰلِكَ كَانَ سَيِّئُهُۥ عِندَ رَبِّكَ مَكْرُوهًا","en_translation_id":85,"en":"The evil of all these actions is hateful to your Lord.","words":[{"pos":1,"ar":"كُلُّ","en_gloss":"All","transliteration":"kullu","verse_key":"17:38"},{"pos":2,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhālika","verse_key":"17:38"},{"pos":3,"ar":"كَان