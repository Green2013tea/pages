surah":28,"ayah":70,"ar_uthmani":"وَهُوَ ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْحَمْدُ فِى ٱلْأُولَىٰ وَٱلْـَٔاخِرَةِ ۖ وَلَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ","en_translation_id":85,"en":"He is God; there is no god but Him; all praise belongs to Him in this world and the next; His is the Judgement; and to Him you shall be returned.","words":[{"pos":1,"ar":"وَهُوَ","en_gloss":"And He","transliteration":"wahuwa","verse_key":"28:70"},{"pos":2,"ar":"ٱللَّهُ","en_gloss":"(is) Allah","transliteration":"l-lahu","verse_key":"28:70"},{"pos":3,"ar":"لَآ","en_gloss":"(there is) no","transliteration":"lā","verse_key":"28:70"},{"pos":4,"ar":"إِلَـٰهَ","en_gloss":"god","transliteration":"ilāha","verse_key":"28:70"},{"pos":5,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"28:70"},{"pos":6,"ar":"هُوَ ۖ","en_gloss":"He","transliteration":"huwa","verse_key":"28:70"},{"pos":7,"ar":"لَهُ","en_gloss":"To Him","transliteration":"lahu","verse_key":"28:70"},{"pos":8,"ar":"ٱلْحَمْدُ","en_gloss":"(are due) all praises","transliteration":"l-ḥamdu","verse_key":"28:70"},{"pos":9,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"28:70"},{"pos":10,"ar":"ٱلْأُولَىٰ","en_gloss":"the first","transliteration":"l-ūlā","verse_key":"28:70"},{"pos":11,"ar":"وَٱلْـَٔاخِرَةِ ۖ","en_gloss":"and the last","transliteration":"wal-ākhirati","verse_key":"28:70"},{"pos":12,"ar":"وَلَهُ","en_gloss":"And for Him","transliteration":"walahu","verse_key":"28:70"},{"pos":13,"ar":"ٱلْحُكْمُ","en_gloss":"(is) the Decision","transliteration":"l-ḥuk'mu","verse_key":"28:70"},{"pos":14,"ar":"وَإِلَيْهِ","en_gloss":"and to Him","transliteration":"wa-ilayhi","verse_key":"28:70"},{"pos":15,"ar":"تُرْجَعُونَ","en_gloss":"you will be returned","transliteration":"tur'jaʿūna","verse_key":"28:70"},{"pos":16,"ar":"٧٠","en_gloss":"(70)","transliteration":"","verse_key":"28:70"}]}]}