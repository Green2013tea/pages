,"transliteration":"ʿinda","verse_key":"61:3"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"61:3"},{"pos":5,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"61:3"},{"pos":6,"ar":"تَقُولُوا۟","en_gloss":"you say","transliteration":"taqūlū","verse_key":"61:3"},{"pos":7,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"61:3"},{"pos":8,"ar":"لَا","en_gloss":"not","transliteration":"lā","verse_key":"61:3"},{"pos":9,"ar":"تَفْعَلُونَ","en_gloss":"you do","transliteration":"tafʿalūna","verse_key":"61:3"},{"pos":10,"ar":"٣","en_gloss":"(3)","transliteration":"","verse_key":"61:3"}]},{"verse_key":"61:4","surah":61,"ayah":4,"ar_uthmani":"إِنَّ ٱللَّهَ يُحِبُّ ٱلَّذِينَ يُقَـٰتِلُونَ فِى سَبِيلِهِۦ صَفًّا كَأَنَّهُم بُنْيَـٰنٌ مَّرْصُوصٌ","en_translation_id":85,"en":"God truly loves those who fight in solid lines for His cause, like a well-compacted wall.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"61:4"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"61:4"},{"pos":3,"ar":"يُحِبُّ","en_gloss":"loves","transliteration":"yuḥibbu","verse_key":"61:4"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"61:4"},{"pos":5,"ar":"يُقَـٰتِلُونَ","en_gloss":"fight","transliteration":"yuqātilūna","verse_key":"61:4"},{"pos":6,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"61:4"},{"pos":7,"ar":"سَبِيلِهِۦ","en_gloss":"His Way","transliteration":"sabīlihi","verse_key":"61:4"},{"pos":8,"ar":"صَفًّۭا","en_gloss":"(in) a row","transliteration":"ṣaffan","verse_key":"61:4"},{"pos":9,"ar":"كَأَنَّهُم","en_gloss":"as if they","transliteration":"ka-annahum","verse_key":"61:4"},{"pos":10,"ar":"بُنْيَـٰنٌۭ","en_gloss":"(were) a structure","transliteration":"bun'yānun","verse_key":"61:4"},{"pos":11,"ar":"مَّرْصُوصٌۭ","en_gloss":"joined firmly","transliteration":"marṣūṣun","verse_key":"61:4"},{"pos":1