{"page":551,"verses":[{"verse_key":"60:12","surah":60,"ayah":12,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا جَآءَكَ ٱلْمُؤْمِنَـٰتُ يُبَايِعْنَكَ عَلَىٰٓ أَن لَّا يُشْرِكْنَ بِٱللَّهِ شَيْـًٔا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ وَلَا يَقْتُلْنَ أَوْلَـٰدَهُنَّ وَلَا يَأْتِينَ بِبُهْتَـٰنٍ يَفْتَرِينَهُۥ بَيْنَ أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ فِى مَعْرُوفٍ ۙ فَبَايِعْهُنَّ وَٱسْتَغْفِرْ لَهُنَّ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ","en_translation_id":85,"en":"Prophet, when believing women come and pledge to you that they will not ascribe any partner to God, nor steal, nor commit adultery, nor kill their children, nor lie about who has fathered their children, nor disobey you in any righteous thing, then you should accept their pledge of allegiance and pray to God to forgive them: God is most forgiving and merciful.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O","transliteration":"yāayyuhā","verse_key":"60:12"},{"pos":2,"ar":"ٱلنَّبِىُّ","en_gloss":"Prophet","transliteration":"l-nabiyu","verse_key":"60:12"},{"pos":3,"ar":"إِذَا","en_gloss":"When","transliteration":"idhā","verse_key":"60:12"},{"pos":4,"ar":"جَآءَكَ","en_gloss":"come to you","transliteration":"jāaka","verse_key":"60:12"},{"pos":5,"ar":"ٱلْمُؤْمِنَـٰتُ","en_gloss":"the believing women","transliteration":"l-mu'minātu","verse_key":"60:12"},{"pos":6,"ar":"يُبَايِعْنَكَ","en_gloss":"pledging to you","transliteration":"yubāyiʿ'naka","verse_key":"60:12"},{"pos":7,"ar":"عَلَىٰٓ","en_gloss":"[on]","transliteration":"ʿalā","verse_key":"60:12"},{"pos":8,"ar":"أَن","en_gloss":"that","transliteration":"an","verse_key":"60:12"},{"pos":9,"ar":"لَّا","en_gloss":"not","transliteration":"lā","verse_key":"60:12"},{"pos":10,"ar":"يُشْرِكْنَ","en_gloss":"they will associate","transliteration":"yush'rik'na","verse_key":"60:12"},{"pos":11,"ar":"بِٱللَّهِ","en_gloss":"with Allah","transliteration":"bil-lahi","verse_key":"60:12"},{"pos":12,"ar":"شَيْـًۭٔا","en_gloss":"anything","transliteration":"shayan","verse_key":"60:12"},{"pos":13,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"60:12"},{"pos":14,"ar":"يَسْرِقْنَ","en_gloss":"they will steal","transliteration":"yasriq'na","verse_key":"60:12"},{"pos":15,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"60:12"},{"pos":16,"ar":"يَزْنِينَ","en_gloss":"they will commit adultery","transliteration":"yaznīna","verse_key":"60:12"},{"pos":17,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"60:12"},{"pos":18,"ar":"يَقْتُلْنَ","en_gloss":"they will kill","transliteration":"yaqtul'na","verse_key":"60:12"},{"pos":19,"ar":"أَوْلَـٰدَهُنَّ","en_gloss":"their children","transliteration":"awlādahunna","verse_key":"60:12"},{"pos":20,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"60:12"},{"pos":21,"ar":"يَأْتِينَ","en_gloss":"they bring","transliteration":"yatīna","verse_key":"60:12"},{"pos":22,"ar":"بِبُهْتَـٰنٍۢ","en_gloss":"slander","transliteration":"bibuh'tānin","verse_key":"60:12"},{"pos":23,"ar":"يَفْتَرِينَهُۥ","en_gloss":"they invent it","transliteration":"yaftarīnahu","verse_key":"60:12"},{"pos":24,"ar":"بَيْنَ","en_gloss":"between","transliteration":"bayna","verse_key":"60:12"},{"pos":25,"ar":"أَيْدِيهِنَّ","en_gloss":"their hands","transliteration":"aydīhinna","verse_key":"60:12"},{"pos":26,"ar":"وَأَرْجُلِهِنَّ","en_gloss":"and their feet","transliteration":"wa-arjulihinna","verse_key":"60:12"},{"pos":27,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"60:12"},{"pos":28,"ar":"يَعْصِينَكَ","en_gloss":"they will disobey you","transliteration":"yaʿṣīnaka","verse_key":"60:12"},{"pos":29,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"60:12"},{"pos":30,"ar":"مَعْرُوفٍۢ ۙ","en_gloss":"(the) right","transliteration":"maʿrūfin","verse_key":"60:12"},{"pos":31,"ar":"فَبَايِعْهُنَّ","en_gloss":"then accept their pledge","transliteration":"fabāyiʿ'hunna","verse_key":"60:12"},{"pos":32,"ar":"وَٱسْ