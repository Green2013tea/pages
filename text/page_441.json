ٱلْمُبِينُ","en_gloss":"clear","transliteration":"l-mubīnu","verse_key":"36:17"},{"pos":6,"ar":"١٧","en_gloss":"(17)","transliteration":"","verse_key":"36:17"}]},{"verse_key":"36:18","surah":36,"ayah":18,"ar_uthmani":"قَالُوٓا۟ إِنَّا تَطَيَّرْنَا بِكُمْ ۖ لَئِن لَّمْ تَنتَهُوا۟ لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ أَلِيمٌ","en_translation_id":85,"en":"but they answered, ‘We think you are an evil omen. If you do not stop, we shall stone you, and inflict a painful torment on you.’","words":[{"pos":1,"ar":"قَالُوٓا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"36:18"},{"pos":2,"ar":"إِنَّا","en_gloss":"Indeed, we","transliteration":"innā","verse_key":"36:18"},{"pos":3,"ar":"تَطَيَّرْنَا","en_gloss":"[we] see an evil omen","transliteration":"taṭayyarnā","verse_key":"36:18"},{"pos":4,"ar":"بِكُمْ ۖ","en_gloss":"from you","transliteration":"bikum","verse_key":"36:18"},{"pos":5,"ar":"لَئِن","en_gloss":"If","transliteration":"la-in","verse_key":"36:18"},{"pos":6,"ar":"لَّمْ","en_gloss":"not","transliteration":"lam","verse_key":"36:18"},{"pos":7,"ar":"تَنتَهُوا۟","en_gloss":"you desist","transliteration":"tantahū","verse_key":"36:18"},{"pos":8,"ar":"لَنَرْجُمَنَّكُمْ","en_gloss":"surely, we will stone you","transliteration":"lanarjumannakum","verse_key":"36:18"},{"pos":9,"ar":"وَلَيَمَسَّنَّكُم","en_gloss":"and surely will touch you","transliteration":"walayamassannakum","verse_key":"36:18"},{"pos":10,"ar":"مِّنَّا","en_gloss":"from us","transliteration":"minnā","verse_key":"36:18"},{"pos":11,"ar":"عَذَابٌ","en_gloss":"a punishment","transliteration":"ʿadhābun","verse_key":"36:18"},{"pos":12,"ar":"أَلِيمٌۭ","en_gloss":"painful","transliteration":"alīmun","verse_key":"36:18"},{"pos":13,"ar":"١٨","en_gloss":"(18)","transliteration":"","verse_key":"36:18"}]},{"verse_key":"36:19","surah":36,"ayah":19,"ar_uthmani":"قَالُوا۟ طَـٰٓئِرُكُم مَّعَكُمْ ۚ أَئِن ذُكِّرْتُم ۚ بَلْ أَنتُمْ قَوْمٌ مُّسْرِفُونَ","en_translation_id":85,"en":"The messengers said, ‘The evil omen is within yourselves. Why do you take it as an evil omen when you are reminded of the Truth? You are going too far!’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"36:19"},{"pos":2,"ar":"طَـٰٓئِرُكُم","en_gloss":"Your evil omen","transliteration":"ṭāirukum","verse_key":"36:19"},{"pos":3,"ar":"مَّعَكُمْ ۚ","en_gloss":"(be) with you","transliteration":"maʿakum","verse_key":"36:19"},{"pos":4,"ar":"أَئِن","en_gloss":"Is it because","transliteration":"a-in","verse_key":"36:19"},{"pos":5,"ar":"ذُكِّرْتُم ۚ","en_gloss":"you are admonished","transliteration":"dhukkir'tum","verse_key":"36:19"},{"pos":6,"ar":"بَلْ","en_gloss":"Nay","transliteration":"bal","verse_key":"36:19"},{"pos":7,"ar":"أَنتُمْ","en_gloss":"you","transliteration":"antum","verse_key":"36:19"},{"pos":8,"ar":"قَوْمٌۭ","en_gloss":"(are) a people","transliteration":"qawmun","verse_key":"36:19"},{"pos":9,"ar":"مُّسْرِفُونَ","en_gloss":"transgressing","transliteration":"mus'rifūna","verse_key":"36:19"},{"pos":10,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"36:19"}]},{"verse_key":"36:20","surah":36,"ayah":20,"ar_uthmani":"وَجَآءَ مِنْ أَقْصَا ٱلْمَدِينَةِ رَجُلٌ يَسْعَىٰ قَالَ يَـٰقَوْمِ ٱتَّبِعُوا۟ ٱلْمُرْسَلِينَ","en_translation_id":85,"en":"Then, from the furthest part of the city, a man came running. He said, ‘My people, follow the messengers.","words":[{"pos":1,"ar":"وَجَآءَ","en_gloss":"And came","transliteration":"wajāa","verse_key":"36:20"},{"pos":2,"ar":"مِنْ","en_gloss":"from","transliteration":"min","verse_key":"36:20"},{"pos":3,"ar":"أَقْصَا","en_gloss":"(the) farthest end","transliteration":"aqṣā","verse_key":"36:20"},{"pos":4,"ar":"ٱلْمَدِينَةِ","en_gloss":"(of) the city","transliteration":"l-madīnati","verse_key":"36:20"},{"pos":5,"ar":"رَجُلٌۭ","en_gloss":"a man","transliteration":"rajulun","verse_key":"36:20"},{"pos":6,"ar":"يَسْعَىٰ","en_gloss":"running","transliteration":"yasʿā","verse_key":"36:20"},{"pos":7,"