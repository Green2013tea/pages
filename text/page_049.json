all return!’-","words":[{"pos":1,"ar":"ءَامَنَ","en_gloss":"Believed","transliteration":"āmana","verse_key":"2:285"},{"pos":2,"ar":"ٱلرَّسُولُ","en_gloss":"the Messenger","transliteration":"l-rasūlu","verse_key":"2:285"},{"pos":3,"ar":"بِمَآ","en_gloss":"in what","transliteration":"bimā","verse_key":"2:285"},{"pos":4,"ar":"أُنزِلَ","en_gloss":"was revealed","transliteration":"unzila","verse_key":"2:285"},{"pos":5,"ar":"إِلَيْهِ","en_gloss":"to him","transliteration":"ilayhi","verse_key":"2:285"},{"pos":6,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"2:285"},{"pos":7,"ar":"رَّبِّهِۦ","en_gloss":"his Lord","transliteration":"rabbihi","verse_key":"2:285"},{"pos":8,"ar":"وَٱلْمُؤْمِنُونَ ۚ","en_gloss":"and the believers","transliteration":"wal-mu'minūna","verse_key":"2:285"},{"pos":9,"ar":"كُلٌّ","en_gloss":"All","transliteration":"kullun","verse_key":"2:285"},{"pos":10,"ar":"ءَامَنَ","en_gloss":"believed","transliteration":"āmana","verse_key":"2:285"},{"pos":11,"ar":"بِٱللَّهِ","en_gloss":"in Allah","transliteration":"bil-lahi","verse_key":"2:285"},{"pos":12,"ar":"وَمَلَـٰٓئِكَتِهِۦ","en_gloss":"and His Angels","transliteration":"wamalāikatihi","verse_key":"2:285"},{"pos":13,"ar":"وَكُتُبِهِۦ","en_gloss":"and His Books","transliteration":"wakutubihi","verse_key":"2:285"},{"pos":14,"ar":"وَرُسُلِهِۦ","en_gloss":"and His Messengers","transliteration":"warusulihi","verse_key":"2:285"},{"pos":15,"ar":"لَا","en_gloss":"Not","transliteration":"lā","verse_key":"2:285"},{"pos":16,"ar":"نُفَرِّقُ","en_gloss":"we make distinction","transliteration":"nufarriqu","verse_key":"2:285"},{"pos":17,"ar":"بَيْنَ","en_gloss":"between","transliteration":"bayna","verse_key":"2:285"},{"pos":18,"ar":"أَحَدٍۢ","en_gloss":"any","transliteration":"aḥadin","verse_key":"2:285"},{"pos":19,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"2:285"},{"pos":20,"ar":"رُّسُلِهِۦ ۚ","en_gloss":"His messengers","transliteration":"rusulihi","verse_key":"2:285"},{"pos":21,"