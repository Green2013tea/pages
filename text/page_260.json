":"وَإِسْحَـٰقَ ۚ","en_gloss":"and Isaac","transliteration":"wa-is'ḥāqa","verse_key":"14:39"},{"pos":10,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"14:39"},{"pos":11,"ar":"رَبِّى","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"14:39"},{"pos":12,"ar":"لَسَمِيعُ","en_gloss":"(is) All-Hearer","transliteration":"lasamīʿu","verse_key":"14:39"},{"pos":13,"ar":"ٱلدُّعَآءِ","en_gloss":"(of) the prayer","transliteration":"l-duʿāi","verse_key":"14:39"},{"pos":14,"ar":"٣٩","en_gloss":"(39)","transliteration":"","verse_key":"14:39"}]},{"verse_key":"14:40","surah":14,"ayah":40,"ar_uthmani":"رَبِّ ٱجْعَلْنِى مُقِيمَ ٱلصَّلَوٰةِ وَمِن ذُرِّيَّتِى ۚ رَبَّنَا وَتَقَبَّلْ دُعَآءِ","en_translation_id":85,"en":"Lord, grant that I and my offspring may keep up the prayer. Our Lord, accept my request.","words":[{"pos":1,"ar":"رَبِّ","en_gloss":"My Lord","transliteration":"rabbi","verse_key":"14:40"},{"pos":2,"ar":"ٱجْعَلْنِى","en_gloss":"Make me","transliteration":"ij'ʿalnī","verse_key":"14:40"},{"pos":3,"ar":"مُقِيمَ","en_gloss":"an establisher","transliteration":"muqīma","verse_key":"14:40"},{"pos":4,"ar":"ٱلصَّلَوٰةِ","en_gloss":"(of) the prayer","transliteration":"l-ṣalati","verse_key":"14:40"},{"pos":5,"ar":"وَمِن","en_gloss":"and from","transliteration":"wamin","verse_key":"14:40"},{"pos":6,"ar":"ذُرِّيَّتِى ۚ","en_gloss":"my offsprings","transliteration":"dhurriyyatī","verse_key":"14:40"},{"pos":7,"ar":"رَبَّنَا","en_gloss":"Our Lord","transliteration":"rabbanā","verse_key":"14:40"},{"pos":8,"ar":"وَتَقَبَّلْ","en_gloss":"and accept","transliteration":"wataqabbal","verse_key":"14:40"},{"pos":9,"ar":"دُعَآءِ","en_gloss":"my prayer","transliteration":"duʿāi","verse_key":"14:40"},{"pos":10,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"14:40"}]},{"verse_key":"14:41","surah":14,"ayah":41,"ar_uthmani":"رَبَّنَا ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ ٱلْحِسَابُ","en_translation_id":85,"en":"Our Lord, forgive me, my parents, and the believers on the Day of Reckoning.’","words":[{"pos":1,"ar":"رَبَّنَا","en_gloss":"Our Lord","transliteration":"rabbanā","verse_key":"14:41"},{"pos":2,"ar":"ٱغْفِرْ","en_gloss":"Forgive","transliteration":"igh'fir","verse_key":"14:41"},{"pos":3,"ar":"لِى","en_gloss":"me","transliteration":"lī","verse_key":"14:41"},{"pos":4,"ar":"وَلِوَٰلِدَىَّ","en_gloss":"and my parents","transliteration":"waliwālidayya","verse_key":"14:41"},{"pos":5,"ar":"وَلِلْمُؤْمِنِينَ","en_gloss":"and the believers","transliteration":"walil'mu'minīna","verse_key":"14:41"},{"pos":6,"ar":"يَوْمَ","en_gloss":"(on) the Day","transliteration":"yawma","verse_key":"14:41"},{"pos":7,"ar":"يَقُومُ","en_gloss":"will (be) established","transliteration":"yaqūmu","verse_key":"14:41"},{"pos":8,"ar":"ٱلْحِسَابُ","en_gloss":"the account","transliteration":"l-ḥisābu","verse_key":"14:41"},{"pos":9,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"14:41"}]},{"verse_key":"14:42","surah":14,"ayah":42,"ar_uthmani":"وَلَا تَحْسَبَنَّ ٱللَّهَ غَـٰفِلًا عَمَّا يَعْمَلُ ٱلظَّـٰلِمُونَ ۚ إِنَّمَا يُؤَخِّرُهُمْ لِيَوْمٍ تَشْخَصُ فِيهِ ٱلْأَبْصَـٰرُ","en_translation_id":85,"en":"Do not think [Prophet] that God is unaware of what the disbelievers do: He only gives them respite until a Day when their eyes will stare in terror.","words":[{"pos":1,"ar":"وَلَا","en_gloss":"And (do) not","transliteration":"walā","verse_key":"14:42"},{"pos":2,"ar":"تَحْسَبَنَّ","en_gloss":"think","transliteration":"taḥsabanna","verse_key":"14:42"},{"pos":3,"ar":"ٱللَّهَ","en_gloss":"(that) Allah","transliteration":"l-laha","verse_key":"14:42"},{"pos":4,"ar":"غَـٰفِلًا","en_gloss":"(is) unaware","transliteration":"ghāfilan","verse_key":"14:42"},{"pos":5,"ar":"عَمَّا","en_gloss":"of what","transliteration":"ʿammā","verse_key":"14:42"},{"pos":6,"ar":"يَعْمَلُ","en_gloss":"do","transliteration":"yaʿmalu","verse_key":"14:42"},{"pos":7,"ar":"ٱلظَّـٰلِمُونَ ۚ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimūna