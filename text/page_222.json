ْ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","en_translation_id":85,"en":"If We defer their punishment for a determined time, they are sure to say, ‘What is holding it back?’ But on the Day it comes upon them, nothing will divert it from them; what they mocked will be all around them.","words":[{"pos":1,"ar":"وَلَئِنْ","en_gloss":"And if","transliteration":"wala-in","verse_key":"11:8"},{"pos":2,"ar":"أَخَّرْنَا","en_gloss":"We delay","transliteration":"akharnā","verse_key":"11:8"},{"pos":3,"ar":"عَنْهُمُ","en_gloss":"from them","transliteration":"ʿanhumu","verse_key":"11:8"},{"pos":4,"ar":"ٱلْعَذَابَ","en_gloss":"the punishment","transliteration":"l-ʿadhāba","verse_key":"11:8"},{"pos":5,"ar":"إِلَىٰٓ","en_gloss":"for","transliteration":"ilā","verse_key":"11:8"},{"pos":6,"ar":"أُمَّةٍۢ","en_gloss":"a time","transliteration":"ummatin","verse_key":"11:8"},{"pos":7,"ar":"مَّعْدُودَةٍۢ","en_gloss":"determined","transliteration":"maʿdūdatin","verse_key":"11:8"},{"pos":8,"ar":"لَّيَقُولُنَّ","en_gloss":"they will surely say","transliteration":"layaqūlunna","verse_key":"11:8"},{"pos":9,"ar":"مَا","en_gloss":"What","transliteration":"mā","verse_key":"11:8"},{"pos":10,"ar":"يَحْبِسُهُۥٓ ۗ","en_gloss":"detains it","transliteration":"yaḥbisuhu","verse_key":"11:8"},{"pos":11,"ar":"أَلَا","en_gloss":"No doubt","transliteration":"alā","verse_key":"11:8"},{"pos":12,"ar":"يَوْمَ","en_gloss":"(On) the Day","transliteration":"yawma","verse_key":"11:8"},{"pos":13,"ar":"يَأْتِيهِمْ","en_gloss":"it comes to them","transliteration":"yatīhim","verse_key":"11:8"},{"pos":14,"ar":"لَيْسَ","en_gloss":"not","transliteration":"laysa","verse_key":"11:8"},{"pos":15,"ar":"مَصْرُوفًا","en_gloss":"(will be) averted","transliteration":"maṣrūfan","verse_key":"11:8"},{"pos":16,"ar":"عَنْهُمْ","en_gloss":"from them","transliteration":"ʿanhum","verse_key":"11:8"},{"pos":17,"ar":"وَحَاقَ","en_gloss":"and will surround","transliteration":"waḥāqa","verse_key":"11:8"},{"pos":18,"ar":"بِهِم","en_gloss"