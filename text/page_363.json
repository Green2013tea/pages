rse_key":"25:37"},{"pos":5,"ar":"ٱلرُّسُلَ","en_gloss":"the Messengers","transliteration":"l-rusula","verse_key":"25:37"},{"pos":6,"ar":"أَغْرَقْنَـٰهُمْ","en_gloss":"We drowned them","transliteration":"aghraqnāhum","verse_key":"25:37"},{"pos":7,"ar":"وَجَعَلْنَـٰهُمْ","en_gloss":"and We made them","transliteration":"wajaʿalnāhum","verse_key":"25:37"},{"pos":8,"ar":"لِلنَّاسِ","en_gloss":"for mankind","transliteration":"lilnnāsi","verse_key":"25:37"},{"pos":9,"ar":"ءَايَةًۭ ۖ","en_gloss":"a sign","transliteration":"āyatan","verse_key":"25:37"},{"pos":10,"ar":"وَأَعْتَدْنَا","en_gloss":"And We have prepared","transliteration":"wa-aʿtadnā","verse_key":"25:37"},{"pos":11,"ar":"لِلظَّـٰلِمِينَ","en_gloss":"for the wrongdoers","transliteration":"lilẓẓālimīna","verse_key":"25:37"},{"pos":12,"ar":"عَذَابًا","en_gloss":"a punishment","transliteration":"ʿadhāban","verse_key":"25:37"},{"pos":13,"ar":"أَلِيمًۭا","en_gloss":"painful","transliteration":"alīman","verse_key":"25:37"},{"pos":14,"ar":"٣٧","en_gloss":"(37)","transliteration":"","verse_key":"25:37"}]},{"verse_key":"25:38","surah":25,"ayah":38,"ar_uthmani":"وَعَادًا وَثَمُودَا۟ وَأَصْحَـٰبَ ٱلرَّسِّ وَقُرُونًۢا بَيْنَ ذَٰلِكَ كَثِيرًا","en_translation_id":85,"en":"as We did for the people of Ad, Thamud, and al-Rass, and many generations in between.","words":[{"pos":1,"ar":"وَعَادًۭا","en_gloss":"And Ad","transliteration":"waʿādan","verse_key":"25:38"},{"pos":2,"ar":"وَثَمُودَا۟","en_gloss":"and Thamud","transliteration":"wathamūdā","verse_key":"25:38"},{"pos":3,"ar":"وَأَصْحَـٰبَ","en_gloss":"and (the) dwellers","transliteration":"wa-aṣḥāba","verse_key":"25:38"},{"pos":4,"ar":"ٱلرَّسِّ","en_gloss":"(of) Ar-rass","transliteration":"l-rasi","verse_key":"25:38"},{"pos":5,"ar":"وَقُرُونًۢا","en_gloss":"and generations","transliteration":"waqurūnan","verse_key":"25:38"},{"pos":6,"ar":"بَيْنَ","en_gloss":"between","transliteration":"bayna","verse_key":"25:38"},{"pos":7,"ar":"ذَٰلِكَ","en_gloss":"that","transliteration":"dhāl