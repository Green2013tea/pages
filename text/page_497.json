{"page":497,"verses":[{"verse_key":"44:19","surah":44,"ayah":19,"ar_uthmani":"وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍ مُّبِينٍ","en_translation_id":85,"en":"Do not consider yourselves to be above God! I come to you with clear authority.","words":[{"pos":1,"ar":"وَأَن","en_gloss":"And that","transliteration":"wa-an","verse_key":"44:19"},{"pos":2,"ar":"لَّا","en_gloss":"(do) not","transliteration":"lā","verse_key":"44:19"},{"pos":3,"ar":"تَعْلُوا۟","en_gloss":"exalt yourselves","transliteration":"taʿlū","verse_key":"44:19"},{"pos":4,"ar":"عَلَى","en_gloss":"against","transliteration":"ʿalā","verse_key":"44:19"},{"pos":5,"ar":"ٱللَّهِ ۖ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"44:19"},{"pos":6,"ar":"إِنِّىٓ","en_gloss":"Indeed, I","transliteration":"innī","verse_key":"44:19"},{"pos":7,"ar":"ءَاتِيكُم","en_gloss":"[I] have come to you","transliteration":"ātīkum","verse_key":"44:19"},{"pos":8,"ar":"بِسُلْطَـٰنٍۢ","en_gloss":"with an authority","transliteration":"bisul'ṭānin","verse_key":"44:19"},{"pos":9,"ar":"مُّبِينٍۢ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"44:19"},{"pos":10,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"44:19"}]},{"verse_key":"44:20","surah":44,"ayah":20,"ar_uthmani":"وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ","en_translation_id":85,"en":"I seek refuge in my Lord and yours against your insults!","words":[{"pos":1,"ar":"وَإِنِّى","en_gloss":"And indeed, I","transliteration":"wa-innī","verse_key":"44:20"},{"pos":2,"ar":"عُذْتُ","en_gloss":"[I] seek refuge","transliteration":"ʿudh'tu","verse_key":"44:20"},{"pos":3,"ar":"بِرَبِّى","en_gloss":"with my Lord","transliteration":"birabbī","verse_key":"44:20"},{"pos":4,"ar":"وَرَبِّكُمْ","en_gloss":"and your Lord","transliteration":"warabbikum","verse_key":"44:20"},{"pos":5,"ar":"أَن","en_gloss":"lest","transliteration":"an","verse_key":"44:20"},{"pos":6,"ar":"تَرْجُمُونِ","en_gloss":"you stone me","transliteration":"t