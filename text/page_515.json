 Taurah","transliteration":"l-tawrāti","verse_key":"48:29"},{"pos":29,"ar":"وَمَثَلُهُمْ","en_gloss":"And their similitude","transliteration":"wamathaluhum","verse_key":"48:29"},{"pos":30,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"48:29"},{"pos":31,"ar":"ٱلْإِنجِيلِ","en_gloss":"the Injeel","transliteration":"l-injīli","verse_key":"48:29"},{"pos":32,"ar":"كَزَرْعٍ","en_gloss":"(is) like a seed","transliteration":"kazarʿin","verse_key":"48:29"},{"pos":33,"ar":"أَخْرَجَ","en_gloss":"(which) sends forth","transliteration":"akhraja","verse_key":"48:29"},{"pos":34,"ar":"شَطْـَٔهُۥ","en_gloss":"its shoot","transliteration":"shaṭahu","verse_key":"48:29"},{"pos":35,"ar":"فَـَٔازَرَهُۥ","en_gloss":"then strengthens it","transliteration":"faāzarahu","verse_key":"48:29"},{"pos":36,"ar":"فَٱسْتَغْلَظَ","en_gloss":"then it becomes thick","transliteration":"fa-is'taghlaẓa","verse_key":"48:29"},{"pos":37,"ar":"فَٱسْتَوَىٰ","en_gloss":"and it stands","transliteration":"fa-is'tawā","verse_key":"48:29"},{"pos":38,"ar":"عَلَىٰ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"48:29"},{"pos":39,"ar":"سُوقِهِۦ","en_gloss":"its stem","transliteration":"sūqihi","verse_key":"48:29"},{"pos":40,"ar":"يُعْجِبُ","en_gloss":"delighting","transliteration":"yuʿ'jibu","verse_key":"48:29"},{"pos":41,"ar":"ٱلزُّرَّاعَ","en_gloss":"the sowers","transliteration":"l-zurāʿa","verse_key":"48:29"},{"pos":42,"ar":"لِيَغِيظَ","en_gloss":"that He (may) enrage","transliteration":"liyaghīẓa","verse_key":"48:29"},{"pos":43,"ar":"بِهِمُ","en_gloss":"by them","transliteration":"bihimu","verse_key":"48:29"},{"pos":44,"ar":"ٱلْكُفَّارَ ۗ","en_gloss":"the disbelievers","transliteration":"l-kufāra","verse_key":"48:29"},{"pos":45,"ar":"وَعَدَ","en_gloss":"Allah has promised","transliteration":"waʿada","verse_key":"48:29"},{"pos":46,"ar":"ٱللَّهُ","en_gloss":"Allah has promised","transliteration":"l-lahu","verse_key":"48:29"},{"pos":47,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration"