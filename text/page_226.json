,{"pos":10,"ar":"لَغَفُورٌۭ","en_gloss":"(is) certainly Oft-Forgiving","transliteration":"laghafūrun","verse_key":"11:41"},{"pos":11,"ar":"رَّحِيمٌۭ","en_gloss":"Most Merciful","transliteration":"raḥīmun","verse_key":"11:41"},{"pos":12,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"11:41"}]},{"verse_key":"11:42","surah":11,"ayah":42,"ar_uthmani":"وَهِىَ تَجْرِى بِهِمْ فِى مَوْجٍ كَٱلْجِبَالِ وَنَادَىٰ نُوحٌ ٱبْنَهُۥ وَكَانَ فِى مَعْزِلٍ يَـٰبُنَىَّ ٱرْكَب مَّعَنَا وَلَا تَكُن مَّعَ ٱلْكَـٰفِرِينَ","en_translation_id":85,"en":"It sailed with them on waves like mountains, and Noah called out to his son, who stayed behind, ‘Come aboard with us, my son, do not stay with the disbelievers.’","words":[{"pos":1,"ar":"وَهِىَ","en_gloss":"And it","transliteration":"wahiya","verse_key":"11:42"},{"pos":2,"ar":"تَجْرِى","en_gloss":"sailed","transliteration":"tajrī","verse_key":"11:42"},{"pos":3,"ar":"بِهِمْ","en_gloss":"with them","transliteration":"bihim","verse_key":"11:42"},{"pos":4,"ar":"فِى","en_gloss":"on","transliteration":"fī","verse_key":"11:42"},{"pos":5,"ar":"مَوْجٍۢ","en_gloss":"the waves","transliteration":"mawjin","verse_key":"11:42"},{"pos":6,"ar":"كَٱلْجِبَالِ","en_gloss":"like mountains","transliteration":"kal-jibāli","verse_key":"11:42"},{"pos":7,"ar":"وَنَادَىٰ","en_gloss":"and Nuh called out","transliteration":"wanādā","verse_key":"11:42"},{"pos":8,"ar":"نُوحٌ","en_gloss":"and Nuh called out","transliteration":"nūḥun","verse_key":"11:42"},{"pos":9,"ar":"ٱبْنَهُۥ","en_gloss":"(to) his son","transliteration":"ib'nahu","verse_key":"11:42"},{"pos":10,"ar":"وَكَانَ","en_gloss":"and he was","transliteration":"wakāna","verse_key":"11:42"},{"pos":11,"ar":"فِى","en_gloss":"[in]","transliteration":"fī","verse_key":"11:42"},{"pos":12,"ar":"مَعْزِلٍۢ","en_gloss":"apart","transliteration":"maʿzilin","verse_key":"11:42"},{"pos":13,"ar":"يَـٰبُنَىَّ","en_gloss":"O my son","transliteration":"yābunayya","verse_key":"11:42"},{"pos":14,"ar":"ٱرْكَب","en_gloss":"E