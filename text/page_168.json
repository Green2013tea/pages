{"page":168,"verses":[{"verse_key":"7:144","surah":7,"ayah":144,"ar_uthmani":"قَالَ يَـٰمُوسَىٰٓ إِنِّى ٱصْطَفَيْتُكَ عَلَى ٱلنَّاسِ بِرِسَـٰلَـٰتِى وَبِكَلَـٰمِى فَخُذْ مَآ ءَاتَيْتُكَ وَكُن مِّنَ ٱلشَّـٰكِرِينَ","en_translation_id":85,"en":"He said, ‘Moses, I have raised you above other people by [giving you] My messages and speaking to you: hold on to what I have given you; be one of those who give thanks.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"7:144"},{"pos":2,"ar":"يَـٰمُوسَىٰٓ","en_gloss":"O Musa","transliteration":"yāmūsā","verse_key":"7:144"},{"pos":3,"ar":"إِنِّى","en_gloss":"Indeed, I","transliteration":"innī","verse_key":"7:144"},{"pos":4,"ar":"ٱصْطَفَيْتُكَ","en_gloss":"have chosen you","transliteration":"iṣ'ṭafaytuka","verse_key":"7:144"},{"pos":5,"ar":"عَلَى","en_gloss":"over","transliteration":"ʿalā","verse_key":"7:144"},{"pos":6,"ar":"ٱلنَّاسِ","en_gloss":"the people","transliteration":"l-nāsi","verse_key":"7:144"},{"pos":7,"ar":"بِرِسَـٰلَـٰتِى","en_gloss":"with My Messages","transliteration":"birisālātī","verse_key":"7:144"},{"pos":8,"ar":"وَبِكَلَـٰمِى","en_gloss":"and with My words","transliteration":"wabikalāmī","verse_key":"7:144"},{"pos":9,"ar":"فَخُذْ","en_gloss":"So take","transliteration":"fakhudh","verse_key":"7:144"},{"pos":10,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"7:144"},{"pos":11,"ar":"ءَاتَيْتُكَ","en_gloss":"I have given you","transliteration":"ātaytuka","verse_key":"7:144"},{"pos":12,"ar":"وَكُن","en_gloss":"and be","transliteration":"wakun","verse_key":"7:144"},{"pos":13,"ar":"مِّنَ","en_gloss":"among","transliteration":"mina","verse_key":"7:144"},{"pos":14,"ar":"ٱلشَّـٰكِرِينَ","en_gloss":"the grateful","transliteration":"l-shākirīna","verse_key":"7:144"},{"pos":15,"ar":"١٤٤","en_gloss":"(144)","transliteration":"","verse_key":"7:144"}]},{"verse_key":"7:145","surah":7,"ayah":145,"ar_uthmani":"وَكَتَبْنَا لَهُۥ فِى ٱلْأَلْوَاحِ مِن كُلِّ شَىْءٍ مَّوْعِ