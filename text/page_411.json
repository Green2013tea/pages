 No, the disbelievers are clearly astray.","words":[{"pos":1,"ar":"هَـٰذَا","en_gloss":"This","transliteration":"hādhā","verse_key":"31:11"},{"pos":2,"ar":"خَلْقُ","en_gloss":"(is the) creation","transliteration":"khalqu","verse_key":"31:11"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"31:11"},{"pos":4,"ar":"فَأَرُونِى","en_gloss":"So show Me","transliteration":"fa-arūnī","verse_key":"31:11"},{"pos":5,"ar":"مَاذَا","en_gloss":"what","transliteration":"mādhā","verse_key":"31:11"},{"pos":6,"ar":"خَلَقَ","en_gloss":"have created","transliteration":"khalaqa","verse_key":"31:11"},{"pos":7,"ar":"ٱلَّذِينَ","en_gloss":"those","transliteration":"alladhīna","verse_key":"31:11"},{"pos":8,"ar":"مِن","en_gloss":"besides Him","transliteration":"min","verse_key":"31:11"},{"pos":9,"ar":"دُونِهِۦ ۚ","en_gloss":"besides Him","transliteration":"dūnihi","verse_key":"31:11"},{"pos":10,"ar":"بَلِ","en_gloss":"Nay","transliteration":"bali","verse_key":"31:11"},{"pos":11,"ar":"ٱلظَّـٰلِمُونَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimūna","verse_key":"31:11"},{"pos":12,"ar":"فِى","en_gloss":"(are) in","transliteration":"fī","verse_key":"31:11"},{"pos":13,"ar":"ضَلَـٰلٍۢ","en_gloss":"error","transliteration":"ḍalālin","verse_key":"31:11"},{"pos":14,"ar":"مُّبِينٍۢ","en_gloss":"clear","transliteration":"mubīnin","verse_key":"31:11"},{"pos":15,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"31:11"}]}]}