n":"biʿadhābin","verse_key":"31:7"},{"pos":16,"ar":"أَلِيمٍ","en_gloss":"painful","transliteration":"alīmin","verse_key":"31:7"},{"pos":17,"ar":"٧","en_gloss":"(7)","transliteration":"","verse_key":"31:7"}]},{"verse_key":"31:8","surah":31,"ayah":8,"ar_uthmani":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتُ ٱلنَّعِيمِ","en_translation_id":85,"en":"But for those who believe and do righteous deeds, there will be Gardens of bliss","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"31:8"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"31:8"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"31:8"},{"pos":4,"ar":"وَعَمِلُوا۟","en_gloss":"and do","transliteration":"waʿamilū","verse_key":"31:8"},{"pos":5,"ar":"ٱلصَّـٰلِحَـٰتِ","en_gloss":"righteous deeds","transliteration":"l-ṣāliḥāti","verse_key":"31:8"},{"pos":6,"ar":"لَهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"31:8"},{"pos":7,"ar":"جَنَّـٰتُ","en_gloss":"(are) Gardens","transliteration":"jannātu","verse_key":"31:8"},{"pos":8,"ar":"ٱلنَّعِيمِ","en_gloss":"(of) Delight","transliteration":"l-naʿīmi","verse_key":"31:8"},{"pos":9,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"31:8"}]},{"verse_key":"31:9","surah":31,"ayah":9,"ar_uthmani":"خَـٰلِدِينَ فِيهَا ۖ وَعْدَ ٱللَّهِ حَقًّا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","en_translation_id":85,"en":"where they will stay: that is God’s true promise, and He is the Almighty, the All Wise.","words":[{"pos":1,"ar":"خَـٰلِدِينَ","en_gloss":"(To) abide forever","transliteration":"khālidīna","verse_key":"31:9"},{"pos":2,"ar":"فِيهَا ۖ","en_gloss":"in it","transliteration":"fīhā","verse_key":"31:9"},{"pos":3,"ar":"وَعْدَ","en_gloss":"(The) Promise of Allah","transliteration":"waʿda","verse_key":"31:9"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"(The) Promise of Allah","transliteration":"l-lahi","verse_key":"31:9"},{"pos"