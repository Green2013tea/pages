هِ بِغَيْرِ عِلْمٍ وَيَتَّخِذَهَا هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌ مُّهِينٌ","en_translation_id":85,"en":"But there is the sort of person who pays for distracting tales, intending, without any knowledge, to lead others from God’s way, and to hold it up to ridicule. There will be humiliating torment for him!","words":[{"pos":1,"ar":"وَمِنَ","en_gloss":"And of","transliteration":"wamina","verse_key":"31:6"},{"pos":2,"ar":"ٱلنَّاسِ","en_gloss":"the mankind","transliteration":"l-nāsi","verse_key":"31:6"},{"pos":3,"ar":"مَن","en_gloss":"(is he) who","transliteration":"man","verse_key":"31:6"},{"pos":4,"ar":"يَشْتَرِى","en_gloss":"purchases","transliteration":"yashtarī","verse_key":"31:6"},{"pos":5,"ar":"لَهْوَ","en_gloss":"idle tales","transliteration":"lahwa","verse_key":"31:6"},{"pos":6,"ar":"ٱلْحَدِيثِ","en_gloss":"idle tales","transliteration":"l-ḥadīthi","verse_key":"31:6"},{"pos":7,"ar":"لِيُضِلَّ","en_gloss":"to mislead","transliteration":"liyuḍilla","verse_key":"31:6"},{"pos":8,"ar":"عَن","en_gloss":"from","transliteration":"ʿan","verse_key":"31:6"},{"pos":9,"ar":"سَبِيلِ","en_gloss":"(the) path","transliteration":"sabīli","verse_key":"31:6"},{"pos":10,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"31:6"},{"pos":11,"ar":"بِغَيْرِ","en_gloss":"without","transliteration":"bighayri","verse_key":"31:6"},{"pos":12,"ar":"عِلْمٍۢ","en_gloss":"knowledge","transliteration":"ʿil'min","verse_key":"31:6"},{"pos":13,"ar":"وَيَتَّخِذَهَا","en_gloss":"and takes it","transliteration":"wayattakhidhahā","verse_key":"31:6"},{"pos":14,"ar":"هُزُوًا ۚ","en_gloss":"(in) ridicule","transliteration":"huzuwan","verse_key":"31:6"},{"pos":15,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those","transliteration":"ulāika","verse_key":"31:6"},{"pos":16,"ar":"لَهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"31:6"},{"pos":17,"ar":"عَذَابٌۭ","en_gloss":"(is) a punishment","transliteration":"ʿadhābun","verse_key":"31:6"},{"pos":18,"ar":"مُّهِينٌۭ","en_