:4,"ayah":174,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلنَّاسُ قَدْ جَآءَكُم بُرْهَـٰنٌ مِّن رَّبِّكُمْ وَأَنزَلْنَآ إِلَيْكُمْ نُورًا مُّبِينًا","en_translation_id":85,"en":"People, convincing proof has come to you from your Lord and We have sent a clear light down to you.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O","transliteration":"yāayyuhā","verse_key":"4:174"},{"pos":2,"ar":"ٱلنَّاسُ","en_gloss":"mankind","transliteration":"l-nāsu","verse_key":"4:174"},{"pos":3,"ar":"قَدْ","en_gloss":"Surely","transliteration":"qad","verse_key":"4:174"},{"pos":4,"ar":"جَآءَكُم","en_gloss":"has come to you","transliteration":"jāakum","verse_key":"4:174"},{"pos":5,"ar":"بُرْهَـٰنٌۭ","en_gloss":"a convincing proof","transliteration":"bur'hānun","verse_key":"4:174"},{"pos":6,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"4:174"},{"pos":7,"ar":"رَّبِّكُمْ","en_gloss":"your Lord","transliteration":"rabbikum","verse_key":"4:174"},{"pos":8,"ar":"وَأَنزَلْنَآ","en_gloss":"and We (have) sent down","transliteration":"wa-anzalnā","verse_key":"4:174"},{"pos":9,"ar":"إِلَيْكُمْ","en_gloss":"to you","transliteration":"ilaykum","verse_key":"4:174"},{"pos":10,"ar":"نُورًۭا","en_gloss":"a light","transliteration":"nūran","verse_key":"4:174"},{"pos":11,"ar":"مُّبِينًۭا","en_gloss":"clear","transliteration":"mubīnan","verse_key":"4:174"},{"pos":12,"ar":"١٧٤","en_gloss":"(174)","transliteration":"","verse_key":"4:174"}]},{"verse_key":"4:175","surah":4,"ayah":175,"ar_uthmani":"فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَٱعْتَصَمُوا۟ بِهِۦ فَسَيُدْخِلُهُمْ فِى رَحْمَةٍ مِّنْهُ وَفَضْلٍ وَيَهْدِيهِمْ إِلَيْهِ صِرَٰطًا مُّسْتَقِيمًا","en_translation_id":85,"en":"God will admit those who believe in Him and hold fast to Him into His mercy and favour; He will guide them towards Him on a straight path.","words":[{"pos":1,"ar":"فَأَمَّا","en_gloss":"So as for","transliteration":"fa-ammā","verse_key":"4:175"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna"