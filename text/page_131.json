35"},{"pos":25,"ar":"فَلَا","en_gloss":"So (do) not","transliteration":"falā","verse_key":"6:35"},{"pos":26,"ar":"تَكُونَنَّ","en_gloss":"be","transliteration":"takūnanna","verse_key":"6:35"},{"pos":27,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"6:35"},{"pos":28,"ar":"ٱلْجَـٰهِلِينَ","en_gloss":"the ignorant","transliteration":"l-jāhilīna","verse_key":"6:35"},{"pos":29,"ar":"٣٥","en_gloss":"(35)","transliteration":"","verse_key":"6:35"}]}]}