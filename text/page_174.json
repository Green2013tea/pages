َوَلَمْ يَنظُرُوا۟ فِى مَلَكُوتِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا خَلَقَ ٱللَّهُ مِن شَىْءٍ وَأَنْ عَسَىٰٓ أَن يَكُونَ قَدِ ٱقْتَرَبَ أَجَلُهُمْ ۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","en_translation_id":85,"en":"Have they not contemplated the realm of the heavens and earth and all that God created, and that the end of their time might be near? What [other revelation] will they believe in if they do not believe in this?","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Do not","transliteration":"awalam","verse_key":"7:185"},{"pos":2,"ar":"يَنظُرُوا۟","en_gloss":"they look","transliteration":"yanẓurū","verse_key":"7:185"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"7:185"},{"pos":4,"ar":"مَلَكُوتِ","en_gloss":"(the) dominion","transliteration":"malakūti","verse_key":"7:185"},{"pos":5,"ar":"ٱلسَّمَـٰوَٰتِ","en_gloss":"(of) the heavens","transliteration":"l-samāwāti","verse_key":"7:185"},{"pos":6,"ar":"وَٱلْأَرْضِ","en_gloss":"and the earth","transliteration":"wal-arḍi","verse_key":"7:185"},{"pos":7,"ar":"وَمَا","en_gloss":"and what","transliteration":"wamā","verse_key":"7:185"},{"pos":8,"ar":"خَلَقَ","en_gloss":"has (been) created","transliteration":"khalaqa","verse_key":"7:185"},{"pos":9,"ar":"ٱللَّهُ","en_gloss":"(by) Allah","transliteration":"l-lahu","verse_key":"7:185"},{"pos":10,"ar":"مِن","en_gloss":"of","transliteration":"min","verse_key":"7:185"},{"pos":11,"ar":"شَىْءٍۢ","en_gloss":"(every)thing","transliteration":"shayin","verse_key":"7:185"},{"pos":12,"ar":"وَأَنْ","en_gloss":"and that","transliteration":"wa-an","verse_key":"7:185"},{"pos":13,"ar":"عَسَىٰٓ","en_gloss":"perhaps","transliteration":"ʿasā","verse_key":"7:185"},{"pos":14,"ar":"أَن","en_gloss":"[that]","transliteration":"an","verse_key":"7:185"},{"pos":15,"ar":"يَكُونَ","en_gloss":"has","transliteration":"yakūna","verse_key":"7:185"},{"pos":16,"ar":"قَدِ","en_gloss":"verily","transliteration":"qadi","verse_key":"7:185"},{"pos":17,"ar":"ٱقْتَرَبَ","en_gloss":"come near ","transliteration":"iq'taraba","verse_key":"7:185"},{"pos":18,"ar":"أَجَلُهُمْ ۖ","en_gloss":"their term","transliteration":"ajaluhum","verse_key":"7:185"},{"pos":19,"ar":"فَبِأَىِّ","en_gloss":"So in what","transliteration":"fabi-ayyi","verse_key":"7:185"},{"pos":20,"ar":"حَدِيثٍۭ","en_gloss":"statement","transliteration":"ḥadīthin","verse_key":"7:185"},{"pos":21,"ar":"بَعْدَهُۥ","en_gloss":"after this","transliteration":"baʿdahu","verse_key":"7:185"},{"pos":22,"ar":"يُؤْمِنُونَ","en_gloss":"will they believe","transliteration":"yu'minūna","verse_key":"7:185"},{"pos":23,"ar":"١٨٥","en_gloss":"(185)","transliteration":"","verse_key":"7:185"}]},{"verse_key":"7:186","surah":7,"ayah":186,"ar_uthmani":"مَن يُضْلِلِ ٱللَّهُ فَلَا هَادِىَ لَهُۥ ۚ وَيَذَرُهُمْ فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ","en_translation_id":85,"en":"No one can guide those God allows to stray: He leaves them blundering about in their insolence.","words":[{"pos":1,"ar":"مَن","en_gloss":"Whoever","transliteration":"man","verse_key":"7:186"},{"pos":2,"ar":"يُضْلِلِ","en_gloss":"(is) let go astray","transliteration":"yuḍ'lili","verse_key":"7:186"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"(by) Allah","transliteration":"l-lahu","verse_key":"7:186"},{"pos":4,"ar":"فَلَا","en_gloss":"then (there is) no","transliteration":"falā","verse_key":"7:186"},{"pos":5,"ar":"هَادِىَ","en_gloss":"guide","transliteration":"hādiya","verse_key":"7:186"},{"pos":6,"ar":"لَهُۥ ۚ","en_gloss":"for him","transliteration":"lahu","verse_key":"7:186"},{"pos":7,"ar":"وَيَذَرُهُمْ","en_gloss":"And He leaves them","transliteration":"wayadharuhum","verse_key":"7:186"},{"pos":8,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"7:186"},{"pos":9,"ar":"طُغْيَـٰنِهِمْ","en_gloss":"their transgression","transliteration":"ṭugh'yānihim","verse_key":"7:186"},{"pos":10,"ar":"يَعْمَهُونَ","en_gloss":"wandering blindly","transliteration":"yaʿmahūna","verse_key":"7:186"},{"pos":11,"ar":"١٨٦","en_gloss":"(186)","transliteration":"","verse_key":"7:186"}]},{"verse_key":"7:187","surah":7,"ayah":187,"ar_uthmani":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا ۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ رَبِّى ۖ لَا يُجَلِّيهَا لِوَقْتِهَآ إِلَّا هُوَ ۚ ثَقُلَتْ فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ لَا تَأْتِيكُمْ إِلَّا بَغْتَةً ۗ يَسْـَٔلُونَكَ كَأَنَّكَ حَفِىٌّ عَنْهَا ۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ ٱللَّهِ وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ","en_translation_id":85,"en":"They ask you [Prophet] about the Hour, ‘When will it happen?’ Say, ‘My Lord alone has knowledge of it: He alone will reveal when its time will come, a time that is momentous in both the heavens and earth. All too suddenly it will come upon you.’ They ask you about it as if you were eager [to find out]. Say, ‘God alone has knowledge of [when it will come], though most people do not realize it.’","words":[{"pos":1,"ar":"يَسْـَٔلُونَكَ","en_gloss":"They ask you","transliteration":"yasalūnaka","verse_key":"7:187"},{"pos":2,"ar":"عَنِ","en_gloss":"about","transliteration":"ʿani","verse_key":"7:187"},{"pos":3,"ar":"ٱلسَّاعَةِ","en_gloss":"the Hour","transliteration":"l-sāʿati","verse_key":"7:187"},{"pos":4,"ar":"أَيَّانَ","en_gloss":"when will be","transliteration":"ayyāna","verse_key":"7:187"},{"pos":5,"ar":"مُرْسَىٰهَا ۖ","en_gloss":"its appointed time","transliteration":"mur'sāhā","verse_key":"7:187"},{"pos":6,"ar":"قُلْ","en_gloss":"Say","transliteration":"qul","verse_key":"7:187"},{"pos":7,"ar":"إِنَّمَا","en_gloss":"Only","transliteration":"innamā","verse_key":"7:187"},{"pos":8,"ar":"عِلْمُهَا","en_gloss":"its knowledge","transliteration":"ʿil'muhā","verse_key":"7:187"},{"pos":9,"ar":"عِندَ","en_gloss":"(is) with","transliteration":"ʿinda","verse_key":"7:187"},{"pos":10,"ar":"رَبِّى ۖ","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"7:187"},{"pos":11,"ar":"لَا","en_gloss":"no (one)","transliteration":"lā","verse_key":"7:187"},{"pos":12,"ar":"يُجَلِّيهَا","en_gloss":"can reveal [it]","transliteration":"yujallīhā","verse_key":"