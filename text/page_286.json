verse_key":"17:42"},{"pos":6,"ar":"كَمَا","en_gloss":"as","transliteration":"kamā","verse_key":"17:42"},{"pos":7,"ar":"يَقُولُونَ","en_gloss":"they say","transliteration":"yaqūlūna","verse_key":"17:42"},{"pos":8,"ar":"إِذًۭا","en_gloss":"then","transliteration":"idhan","verse_key":"17:42"},{"pos":9,"ar":"لَّٱبْتَغَوْا۟","en_gloss":"surely they (would) have sought","transliteration":"la-ib'taghaw","verse_key":"17:42"},{"pos":10,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"17:42"},{"pos":11,"ar":"ذِى","en_gloss":"(the) Owner","transliteration":"dhī","verse_key":"17:42"},{"pos":12,"ar":"ٱلْعَرْشِ","en_gloss":"(of) the Throne","transliteration":"l-ʿarshi","verse_key":"17:42"},{"pos":13,"ar":"سَبِيلًۭا","en_gloss":"a way","transliteration":"sabīlan","verse_key":"17:42"},{"pos":14,"ar":"٤٢","en_gloss":"(42)","transliteration":"","verse_key":"17:42"}]},{"verse_key":"17:43","surah":17,"ayah":43,"ar_uthmani":"سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا يَقُولُونَ عُلُوًّا كَبِيرًا","en_translation_id":85,"en":"Glory to Him! He is far above what they say!","words":[{"pos":1,"ar":"سُبْحَـٰنَهُۥ","en_gloss":"Glorified is He","transliteration":"sub'ḥānahu","verse_key":"17:43"},{"pos":2,"ar":"وَتَعَـٰلَىٰ","en_gloss":"and Exalted is He","transliteration":"wataʿālā","verse_key":"17:43"},{"pos":3,"ar":"عَمَّا","en_gloss":"above what","transliteration":"ʿammā","verse_key":"17:43"},{"pos":4,"ar":"يَقُولُونَ","en_gloss":"they say","transliteration":"yaqūlūna","verse_key":"17:43"},{"pos":5,"ar":"عُلُوًّۭا","en_gloss":"(by) height","transliteration":"ʿuluwwan","verse_key":"17:43"},{"pos":6,"ar":"كَبِيرًۭا","en_gloss":"great","transliteration":"kabīran","verse_key":"17:43"},{"pos":7,"ar":"٤٣","en_gloss":"(43)","transliteration":"","verse_key":"17:43"}]},{"verse_key":"17:44","surah":17,"ayah":44,"ar_uthmani":"تُسَبِّحُ لَهُ ٱلسَّمَـٰوَٰتُ ٱلسَّبْعُ وَٱلْأَرْضُ وَمَن فِيهِنَّ ۚ وَإِن مِّن شَىْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِۦ وَلَـٰكِن لَّا تَفْقَهُونَ تَسْبِيحَهُمْ ۗ إِنَّهُۥ كَانَ حَلِيمًا غَفُورًا","en_translation_id":85,"en":"The seven heavens and the earth and everyone in them glorify Him. There is not a single thing that does not celebrate His praise, though you do not understand their praise: He is most forbearing, most forgiving.","words":[{"pos":1,"ar":"تُسَبِّحُ","en_gloss":"Glorify","transliteration":"tusabbiḥu","verse_key":"17:44"},{"pos":2,"ar":"لَهُ","en_gloss":"[to] Him","transliteration":"lahu","verse_key":"17:44"},{"pos":3,"ar":"ٱلسَّمَـٰوَٰتُ","en_gloss":"the seven heavens","transliteration":"l-samāwātu","verse_key":"17:44"},{"pos":4,"ar":"ٱلسَّبْعُ","en_gloss":"the seven heavens","transliteration":"l-sabʿu","verse_key":"17:44"},{"pos":5,"ar":"وَٱلْأَرْضُ","en_gloss":"and the earth","transliteration":"wal-arḍu","verse_key":"17:44"},{"pos":6,"ar":"وَمَن","en_gloss":"and whatever","transliteration":"waman","verse_key":"17:44"},{"pos":7,"ar":"فِيهِنَّ ۚ","en_gloss":"(is) in them","transliteration":"fīhinna","verse_key":"17:44"},{"pos":8,"ar":"وَإِن","en_gloss":"And (there is) not","transliteration":"wa-in","verse_key":"17:44"},{"pos":9,"ar":"مِّن","en_gloss":"any","transliteration":"min","verse_key":"17:44"},{"pos":10,"ar":"شَىْءٍ","en_gloss":"thing","transliteration":"shayin","verse_key":"17:44"},{"pos":11,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"17:44"},{"pos":12,"ar":"يُسَبِّحُ","en_gloss":"glorifies","transliteration":"yusabbiḥu","verse_key":"17:44"},{"pos":13,"ar":"بِحَمْدِهِۦ","en_gloss":"His Praise","transliteration":"biḥamdihi","verse_key":"17:44"},{"pos":14,"ar":"وَلَـٰكِن","en_gloss":"but","transliteration":"walākin","verse_key":"17:44"},{"pos":15,"ar":"لَّا","en_gloss":"not","transliteration":"lā","verse_key":"17:44"},{"pos":16,"ar":"تَفْقَهُونَ","en_gloss":"you understand","transliteration":"tafqahūna","verse_key":"17:44"},{"pos":17,"ar":"تَسْبِيحَهُمْ ۗ","en_gloss":"their glorification","transliteration":"tasbīḥahum","verse_key":"17:44"},{"pos":18,"ar":"إِنَّهُۥ","en_gloss":"Indeed,