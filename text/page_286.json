]},{"verse_key":"17:49","surah":17,"ayah":49,"ar_uthmani":"وَقَالُوٓا۟ أَءِذَا كُنَّا عِظَـٰمًا وَرُفَـٰتًا أَءِنَّا لَمَبْعُوثُونَ خَلْقًا جَدِيدًا","en_translation_id":85,"en":"They also say, ‘What? When we are turned to bones and dust, shall we really be raised up in a new act of creation?’","words":[{"pos":1,"ar":"وَقَالُوٓا۟","en_gloss":"And they say","transliteration":"waqālū","verse_key":"17:49"},{"pos":2,"ar":"أَءِذَا","en_gloss":"Is it when","transliteration":"a-idhā","verse_key":"17:49"},{"pos":3,"ar":"كُنَّا","en_gloss":"we are","transliteration":"kunnā","verse_key":"17:49"},{"pos":4,"ar":"عِظَـٰمًۭا","en_gloss":"bones","transliteration":"ʿiẓāman","verse_key":"17:49"},{"pos":5,"ar":"وَرُفَـٰتًا","en_gloss":"and crumbled particles","transliteration":"warufātan","verse_key":"17:49"},{"pos":6,"ar":"أَءِنَّا","en_gloss":"will we","transliteration":"a-innā","verse_key":"17:49"},{"pos":7,"ar":"لَمَبْعُوثُونَ","en_gloss":"surely (be) resurrected","transliteration":"lamabʿūthūna","verse_key":"17:49"},{"pos":8,"ar":"خَلْقًۭا","en_gloss":"(as) a creation","transliteration":"khalqan","verse_key":"17:49"},{"pos":9,"ar":"جَدِيدًۭا","en_gloss":"new","transliteration":"jadīdan","verse_key":"17:49"},{"pos":10,"ar":"٤٩","en_gloss":"(49)","transliteration":"","verse_key":"17:49"}]}]}