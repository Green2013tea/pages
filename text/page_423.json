ation":"wa-idh","verse_key":"33:37"},{"pos":2,"ar":"تَقُولُ","en_gloss":"you said","transliteration":"taqūlu","verse_key":"33:37"},{"pos":3,"ar":"لِلَّذِىٓ","en_gloss":"to the one","transliteration":"lilladhī","verse_key":"33:37"},{"pos":4,"ar":"أَنْعَمَ","en_gloss":"Allah bestowed favor","transliteration":"anʿama","verse_key":"33:37"},{"pos":5,"ar":"ٱللَّهُ","en_gloss":"Allah bestowed favor","transliteration":"l-lahu","verse_key":"33:37"},{"pos":6,"ar":"عَلَيْهِ","en_gloss":"on him","transliteration":"ʿalayhi","verse_key":"33:37"},{"pos":7,"ar":"وَأَنْعَمْتَ","en_gloss":"and you bestowed favor","transliteration":"wa-anʿamta","verse_key":"33:37"},{"pos":8,"ar":"عَلَيْهِ","en_gloss":"on him","transliteration":"ʿalayhi","verse_key":"33:37"},{"pos":9,"ar":"أَمْسِكْ","en_gloss":"Keep","transliteration":"amsik","verse_key":"33:37"},{"pos":10,"ar":"عَلَيْكَ","en_gloss":"to yourself","transliteration":"ʿalayka","verse_key":"33:37"},{"pos":11,"ar":"زَوْجَكَ","en_gloss":"your wife","transliteration":"zawjaka","verse_key":"33:37"},{"pos":12,"ar":"وَٱتَّقِ","en_gloss":"and fear","transliteration":"wa-ittaqi","verse_key":"33:37"},{"pos":13,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"33:37"},{"pos":14,"ar":"وَتُخْفِى","en_gloss":"But you concealed","transliteration":"watukh'fī","verse_key":"33:37"},{"pos":15,"ar":"فِى","en_gloss":"within","transliteration":"fī","verse_key":"33:37"},{"pos":16,"ar":"نَفْسِكَ","en_gloss":"yourself","transliteration":"nafsika","verse_key":"33:37"},{"pos":17,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"33:37"},{"pos":18,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"33:37"},{"pos":19,"ar":"مُبْدِيهِ","en_gloss":"(was to) disclose","transliteration":"mub'dīhi","verse_key":"33:37"},{"pos":20,"ar":"وَتَخْشَى","en_gloss":"And you fear","transliteration":"watakhshā","verse_key":"33:37"},{"pos":21,"ar":"ٱلنَّاسَ","en_gloss":"the people","transliteration":"l-nāsa","verse_key":"33:3