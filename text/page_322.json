{"page":322,"verses":[{"verse_key":"21:1","surah":21,"ayah":1,"ar_uthmani":" ٱقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِى غَفْلَةٍ مُّعْرِضُونَ","en_translation_id":85,"en":"Ever closer to people draws their reckoning, while they turn away, heedless.","words":[{"pos":1,"ar":"ٱقْتَرَبَ","en_gloss":"(Has) approached","transliteration":"iq'taraba","verse_key":"21:1"},{"pos":2,"ar":"لِلنَّاسِ","en_gloss":"for [the] mankind","transliteration":"lilnnāsi","verse_key":"21:1"},{"pos":3,"ar":"حِسَابُهُمْ","en_gloss":"their account","transliteration":"ḥisābuhum","verse_key":"21:1"},{"pos":4,"ar":"وَهُمْ","en_gloss":"while they","transliteration":"wahum","verse_key":"21:1"},{"pos":5,"ar":"فِى","en_gloss":"(are) in","transliteration":"fī","verse_key":"21:1"},{"pos":6,"ar":"غَفْلَةٍۢ","en_gloss":"heedlessness","transliteration":"ghaflatin","verse_key":"21:1"},{"pos":7,"ar":"مُّعْرِضُونَ","en_gloss":"turning away","transliteration":"muʿ'riḍūna","verse_key":"21:1"},{"pos":8,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"21:1"}]},{"verse_key":"21:2","surah":21,"ayah":2,"ar_uthmani":"مَا يَأْتِيهِم مِّن ذِكْرٍ مِّن رَّبِّهِم مُّحْدَثٍ إِلَّا ٱسْتَمَعُوهُ وَهُمْ يَلْعَبُونَ","en_translation_id":85,"en":"Whenever any fresh revelation comes to them from their Lord, they listen to it playfully","words":[{"pos":1,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"21:2"},{"pos":2,"ar":"يَأْتِيهِم","en_gloss":"comes to them","transliteration":"yatīhim","verse_key":"21:2"},{"pos":3,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"21:2"},{"pos":4,"ar":"ذِكْرٍۢ","en_gloss":"a Reminder","transliteration":"dhik'rin","verse_key":"21:2"},{"pos":5,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"21:2"},{"pos":6,"ar":"رَّبِّهِم","en_gloss":"their Lord","transliteration":"rabbihim","verse_key":"21:2"},{"pos":7,"ar":"مُّحْدَثٍ","en_gloss":"anew","transliteration":"muḥ'dathin","verse_key":"21:2"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","trans