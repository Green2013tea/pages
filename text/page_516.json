ِكُمْ وَكَرَّهَ إِلَيْكُمُ ٱلْكُفْرَ وَٱلْفُسُوقَ وَٱلْعِصْيَانَ ۚ أُو۟لَـٰٓئِكَ هُمُ ٱلرَّٰشِدُونَ","en_translation_id":85,"en":"and be aware that it is God’s Messenger who is among you: in many matters you would certainly suffer if he were to follow your wishes. God has endeared faith to you and made it beautiful to your hearts; He has made disbelief, mischief, and disobedience hateful to you. It is people like this who are rightly guided","words":[{"pos":1,"ar":"وَٱعْلَمُوٓا۟","en_gloss":"And know","transliteration":"wa-iʿ'lamū","verse_key":"49:7"},{"pos":2,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"49:7"},{"pos":3,"ar":"فِيكُمْ","en_gloss":"among you","transliteration":"fīkum","verse_key":"49:7"},{"pos":4,"ar":"رَسُولَ","en_gloss":"(is the) Messenger of Allah","transliteration":"rasūla","verse_key":"49:7"},{"pos":5,"ar":"ٱللَّهِ ۚ","en_gloss":"(is the) Messenger of Allah","transliteration":"l-lahi","verse_key":"49:7"},{"pos":6,"ar":"لَوْ","en_gloss":"If","transliteration":"law","verse_key":"49:7"},{"pos":7,"ar":"يُطِيعُكُمْ","en_gloss":"he were to obey you","transliteration":"yuṭīʿukum","verse_key":"49:7"},{"pos":8,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"49:7"},{"pos":9,"ar":"كَثِيرٍۢ","en_gloss":"much","transliteration":"kathīrin","verse_key":"49:7"},{"pos":10,"ar":"مِّنَ","en_gloss":"of","transliteration":"mina","verse_key":"49:7"},{"pos":11,"ar":"ٱلْأَمْرِ","en_gloss":"the matter","transliteration":"l-amri","verse_key":"49:7"},{"pos":12,"ar":"لَعَنِتُّمْ","en_gloss":"surely you would be in difficulty","transliteration":"laʿanittum","verse_key":"49:7"},{"pos":13,"ar":"وَلَـٰكِنَّ","en_gloss":"but","transliteration":"walākinna","verse_key":"49:7"},{"pos":14,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"49:7"},{"pos":15,"ar":"حَبَّبَ","en_gloss":"has endeared","transliteration":"ḥabbaba","verse_key":"49:7"},{"pos":16,"ar":"إِلَيْكُمُ","en_gloss":"to you","transliteration":"ilaykumu","verse_key":"49:7"},{"pos":17,"ar":"ٱلْإِيمَـٰنَ","en_gloss":"the Faith","transliteration":"l-īmāna","verse_key":"49:7"},{"pos":18,"ar":"وَزَيَّنَهُۥ","en_gloss":"and has made it pleasing","transliteration":"wazayyanahu","verse_key":"49:7"},{"pos":19,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"49:7"},{"pos":20,"ar":"قُلُوبِكُمْ","en_gloss":"your hearts","transliteration":"qulūbikum","verse_key":"49:7"},{"pos":21,"ar":"وَكَرَّهَ","en_gloss":"and has made hateful","transliteration":"wakarraha","verse_key":"49:7"},{"pos":22,"ar":"إِلَيْكُمُ","en_gloss":"to you","transliteration":"ilaykumu","verse_key":"49:7"},{"pos":23,"ar":"ٱلْكُفْرَ","en_gloss":"disbelief","transliteration":"l-kuf'ra","verse_key":"49:7"},{"pos":24,"ar":"وَٱلْفُسُوقَ","en_gloss":"and defiance","transliteration":"wal-fusūqa","verse_key":"49:7"},{"pos":25,"ar":"وَٱلْعِصْيَانَ ۚ","en_gloss":"and disobedience","transliteration":"wal-ʿiṣ'yāna","verse_key":"49:7"},{"pos":26,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"Those","transliteration":"ulāika","verse_key":"49:7"},{"pos":27,"ar":"هُمُ","en_gloss":"(are) they ","transliteration":"humu","verse_key":"49:7"},{"pos":28,"ar":"ٱلرَّٰشِدُونَ","en_gloss":"the guided ones","transliteration":"l-rāshidūna","verse_key":"49:7"},{"pos":29,"ar":"٧","en_gloss":"(7)","transliteration":"","verse_key":"49:7"}]},{"verse_key":"49:8","surah":49,"ayah":8,"ar_uthmani":"فَضْلًا مِّنَ ٱللَّهِ وَنِعْمَةً ۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ","en_translation_id":85,"en":"through God’s favour and blessing: God is all knowing and all wise.","words":[{"pos":1,"ar":"فَضْلًۭا","en_gloss":"A Bounty","transliteration":"faḍlan","verse_key":"49:8"},{"pos":2,"ar":"مِّنَ","en_gloss":"from Allah","transliteration":"mina","verse_key":"49:8"},{"pos":3,"ar":"ٱللَّهِ","en_gloss":"from Allah","transliteration":"l-lahi","verse_key":"49:8"},{"pos":4,"ar":"وَنِعْمَةًۭ ۚ","en_gloss":"and favor","transliteration":"waniʿ'matan","verse_key":"49:8"},{"pos":5,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"49:8"},{"pos":6,"ar":"عَلِيمٌ","en_gloss":"(is) All-Knower","transliteration":"ʿalīmun","verse_key":"49:8"},{"pos":7,"ar":"حَكِيمٌۭ","en_gloss":"All-Wise","transliteration":"ḥakīmun","verse_key":"49:8"},{"pos":8,"ar":"٨","en_gloss":"(8)","transliteration":"","verse_key":"49:8"}]},{"verse_key":"49:9","surah":49,"ayah":9,"ar_uthmani":"وَإِن طَآئِفَتَانِ مِنَ ٱلْمُؤْمِنِينَ ٱقْتَتَلُوا۟ فَأَصْلِحُوا۟ بَيْنَهُمَا ۖ فَإِنۢ بَغَتْ إِحْدَىٰهُمَا عَلَى ٱلْأُخْرَىٰ فَقَـٰتِلُوا۟ ٱلَّتِى تَبْغِى حَتَّىٰ تَفِىٓءَ إِلَىٰٓ أَمْرِ ٱللَّهِ ۚ فَإِن فَآءَتْ فَأَصْلِحُوا۟ بَيْنَهُمَا بِٱلْعَدْلِ وَأَقْسِطُوٓا۟ ۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ","en_translation_id":85,"en":"If two groups of the believers fight, you [believers] should try to reconcile them; if one of them is [clearly] oppressing the other, fight the oppressors until they submit to God’s command, then make a just and even-handed reconciliation between the two of them: God loves those who are even-handed.","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"49:9"},{"pos":2,"ar":"طَآئِفَتَانِ","en_gloss":"two parties","transliteration":"ṭāifatāni","verse_key":"49:9"},{"pos":3,"ar":"مِنَ","en_gloss":"among","transliteration":"mina","verse_key":"49:9"},{"pos":4,"ar":"ٱلْمُؤْمِنِينَ","en_gloss":"the believers","transliteration":"l-mu'minīna","verse_key":"49:9"},{"pos":5,"ar":"ٱقْتَتَلُوا۟","en_gloss":"fight","transliteration":"iq'tatalū","verse_key":"49:9"},{"pos":6,"ar":"فَأَصْلِحُوا۟","en_gloss":"then make peace","transliteration":"fa-aṣliḥū","verse_key":"49:9"},{"pos":7,"ar":"بَيْنَهُمَا ۖ","en_gloss":"between both of them","transliteration":"baynahumā","verse_key":"49:9"},{"pos":8,"ar":"فَإِنۢ","en_gloss":"But if","transliteration":"fa-in","verse_key":"49:9"},{"pos":9,"ar":"بَغَتْ","en_gloss":"oppresses","transliteration":"baghat","verse_key":"49:9"},{"pos":10,"ar":"إِحْدَىٰهُمَا","en_gloss":"one of them","transliteration":"iḥ'dāhumā","verse_ke