15:65","surah":15,"ayah":65,"ar_uthmani":"فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ","en_translation_id":85,"en":"so leave in the dead of the night with your household, and walk behind them. Let none of you look back. Go where you are commanded.’","words":[{"pos":1,"ar":"فَأَسْرِ","en_gloss":"So travel","transliteration":"fa-asri","verse_key":"15:65"},{"pos":2,"ar":"بِأَهْلِكَ","en_gloss":"with your family","transliteration":"bi-ahlika","verse_key":"15:65"},{"pos":3,"ar":"بِقِطْعٍۢ","en_gloss":"in a portion","transliteration":"biqiṭ'ʿin","verse_key":"15:65"},{"pos":4,"ar":"مِّنَ","en_gloss":"of","transliteration":"mina","verse_key":"15:65"},{"pos":5,"ar":"ٱلَّيْلِ","en_gloss":"the night","transliteration":"al-layli","verse_key":"15:65"},{"pos":6,"ar":"وَٱتَّبِعْ","en_gloss":"and follow","transliteration":"wa-ittabiʿ","verse_key":"15:65"},{"pos":7,"ar":"أَدْبَـٰرَهُمْ","en_gloss":"their backs","transliteration":"adbārahum","verse_key":"15:65"},{"pos":8,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"15:65"},{"pos":9,"ar":"يَلْتَفِتْ","en_gloss":"let look back","transliteration":"yaltafit","verse_key":"15:65"},{"pos":10,"ar":"مِنكُمْ","en_gloss":"among you","transliteration":"minkum","verse_key":"15:65"},{"pos":11,"ar":"أَحَدٌۭ","en_gloss":"anyone","transliteration":"aḥadun","verse_key":"15:65"},{"pos":12,"ar":"وَٱمْضُوا۟","en_gloss":"and go on","transliteration":"wa-im'ḍū","verse_key":"15:65"},{"pos":13,"ar":"حَيْثُ","en_gloss":"where","transliteration":"ḥaythu","verse_key":"15:65"},{"pos":14,"ar":"تُؤْمَرُونَ","en_gloss":"you are ordered","transliteration":"tu'marūna","verse_key":"15:65"},{"pos":15,"ar":"٦٥","en_gloss":"(65)","transliteration":"","verse_key":"15:65"}]},{"verse_key":"15:66","surah":15,"ayah":66,"ar_uthmani":"وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌ مُّصْبِحِينَ","en_translation_id":85,"en":"We made thi