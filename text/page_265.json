{"page":265,"verses":[{"verse_key":"15:52","surah":15,"ayah":52,"ar_uthmani":"إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا قَالَ إِنَّا مِنكُمْ وَجِلُونَ","en_translation_id":85,"en":"when they came to him and said, ‘Peace,’ he said, ‘We are afraid of you.’","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"15:52"},{"pos":2,"ar":"دَخَلُوا۟","en_gloss":"they entered","transliteration":"dakhalū","verse_key":"15:52"},{"pos":3,"ar":"عَلَيْهِ","en_gloss":"upon him","transliteration":"ʿalayhi","verse_key":"15:52"},{"pos":4,"ar":"فَقَالُوا۟","en_gloss":"and said","transliteration":"faqālū","verse_key":"15:52"},{"pos":5,"ar":"سَلَـٰمًۭا","en_gloss":"Peace","transliteration":"salāman","verse_key":"15:52"},{"pos":6,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"15:52"},{"pos":7,"ar":"إِنَّا","en_gloss":"Indeed, we","transliteration":"innā","verse_key":"15:52"},{"pos":8,"ar":"مِنكُمْ","en_gloss":"(are) of you","transliteration":"minkum","verse_key":"15:52"},{"pos":9,"ar":"وَجِلُونَ","en_gloss":"afraid","transliteration":"wajilūna","verse_key":"15:52"},{"pos":10,"ar":"٥٢","en_gloss":"(52)","transliteration":"","verse_key":"15:52"}]},{"verse_key":"15:53","surah":15,"ayah":53,"ar_uthmani":"قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ عَلِيمٍ","en_translation_id":85,"en":"‘Do not be afraid,’ they said, ‘We bring you good news of a son who will have great knowledge.’","words":[{"pos":1,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"15:53"},{"pos":2,"ar":"لَا","en_gloss":"(Do) not","transliteration":"lā","verse_key":"15:53"},{"pos":3,"ar":"تَوْجَلْ","en_gloss":"be afraid","transliteration":"tawjal","verse_key":"15:53"},{"pos":4,"ar":"إِنَّا","en_gloss":"indeed, we","transliteration":"innā","verse_key":"15:53"},{"pos":5,"ar":"نُبَشِّرُكَ","en_gloss":"[we] bring glad tidings to you","transliteration":"nubashiruka","verse_key":"15:53"},{"pos":6,"ar":"بِغُلَـٰمٍ","en_gloss":"of a boy","trans