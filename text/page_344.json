s":5,"ar":"كَذَّبُونِ","en_gloss":"they deny me","transliteration":"kadhabūni","verse_key":"23:39"},{"pos":6,"ar":"٣٩","en_gloss":"(39)","transliteration":"","verse_key":"23:39"}]},{"verse_key":"23:40","surah":23,"ayah":40,"ar_uthmani":"قَالَ عَمَّا قَلِيلٍ لَّيُصْبِحُنَّ نَـٰدِمِينَ","en_translation_id":85,"en":"and so God said, ‘Soon they will be filled with regret.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"23:40"},{"pos":2,"ar":"عَمَّا","en_gloss":"After a little while","transliteration":"ʿammā","verse_key":"23:40"},{"pos":3,"ar":"قَلِيلٍۢ","en_gloss":"After a little while","transliteration":"qalīlin","verse_key":"23:40"},{"pos":4,"ar":"لَّيُصْبِحُنَّ","en_gloss":"surely they will become","transliteration":"layuṣ'biḥunna","verse_key":"23:40"},{"pos":5,"ar":"نَـٰدِمِينَ","en_gloss":"regretful","transliteration":"nādimīna","verse_key":"23:40"},{"pos":6,"ar":"٤٠","en_gloss":"(40)","transliteration":"","verse_key":"23:40"}]},{"verse_key":"23:41","surah":23,"ayah":41,"ar_uthmani":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ بِٱلْحَقِّ فَجَعَلْنَـٰهُمْ غُثَآءً ۚ فَبُعْدًا لِّلْقَوْمِ ٱلظَّـٰلِمِينَ","en_translation_id":85,"en":"The blast justly struck them and We swept them away like scum. Away with the evildoers!","words":[{"pos":1,"ar":"فَأَخَذَتْهُمُ","en_gloss":"So seized them","transliteration":"fa-akhadhathumu","verse_key":"23:41"},{"pos":2,"ar":"ٱلصَّيْحَةُ","en_gloss":"the awful cry","transliteration":"l-ṣayḥatu","verse_key":"23:41"},{"pos":3,"ar":"بِٱلْحَقِّ","en_gloss":"in truth","transliteration":"bil-ḥaqi","verse_key":"23:41"},{"pos":4,"ar":"فَجَعَلْنَـٰهُمْ","en_gloss":"and We made them","transliteration":"fajaʿalnāhum","verse_key":"23:41"},{"pos":5,"ar":"غُثَآءًۭ ۚ","en_gloss":"(as) rubbish of dead leaves","transliteration":"ghuthāan","verse_key":"23:41"},{"pos":6,"ar":"فَبُعْدًۭا","en_gloss":"So away","transliteration":"fabuʿ'dan","verse_key":"23:41"},{"pos":7,"ar":"لِّلْقَوْمِ","en_gloss":"with the people ","transliteration":"lil'qawmi","verse_key":"23:41"},{"pos":8,"ar":"ٱلظَّـٰلِمِينَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimīna","verse_key":"23:41"},{"pos":9,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"23:41"}]},{"verse_key":"23:42","surah":23,"ayah":42,"ar_uthmani":"ثُمَّ أَنشَأْنَا مِنۢ بَعْدِهِمْ قُرُونًا ءَاخَرِينَ","en_translation_id":85,"en":"We raised other generations after them-","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"23:42"},{"pos":2,"ar":"أَنشَأْنَا","en_gloss":"We produced","transliteration":"anshanā","verse_key":"23:42"},{"pos":3,"ar":"مِنۢ","en_gloss":"after them","transliteration":"min","verse_key":"23:42"},{"pos":4,"ar":"بَعْدِهِمْ","en_gloss":"after them","transliteration":"baʿdihim","verse_key":"23:42"},{"pos":5,"ar":"قُرُونًا","en_gloss":"a generation","transliteration":"qurūnan","verse_key":"23:42"},{"pos":6,"ar":"ءَاخَرِينَ","en_gloss":"another","transliteration":"ākharīna","verse_key":"23:42"},{"pos":7,"ar":"٤٢","en_gloss":"(42)","transliteration":"","verse_key":"23:42"}]}]}