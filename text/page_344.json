on":"","verse_key":"23:35"}]},{"verse_key":"23:36","surah":23,"ayah":36,"ar_uthmani":"۞ هَيْهَاتَ هَيْهَاتَ لِمَا تُوعَدُونَ","en_translation_id":85,"en":"What you are promised is very farfetched.","words":[{"pos":1,"ar":"۞ هَيْهَاتَ","en_gloss":"Far-(fetched)","transliteration":"hayhāta","verse_key":"23:36"},{"pos":2,"ar":"هَيْهَاتَ","en_gloss":"far-(fetched)","transliteration":"hayhāta","verse_key":"23:36"},{"pos":3,"ar":"لِمَا","en_gloss":"is what","transliteration":"limā","verse_key":"23:36"},{"pos":4,"ar":"تُوعَدُونَ","en_gloss":"you are promised","transliteration":"tūʿadūna","verse_key":"23:36"},{"pos":5,"ar":"٣٦","en_gloss":"(36)","transliteration":"","verse_key":"23:36"}]},{"verse_key":"23:37","surah":23,"ayah":37,"ar_uthmani":"إِنْ هِىَ إِلَّا حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ وَنَحْيَا وَمَا نَحْنُ بِمَبْعُوثِينَ","en_translation_id":85,"en":"There is only the life of this world: we die, we live, but we will never be resurrected.","words":[{"pos":1,"ar":"إِنْ","en_gloss":"Not","transliteration":"in","verse_key":"23:37"},{"pos":2,"ar":"هِىَ","en_gloss":"it","transliteration":"hiya","verse_key":"23:37"},{"pos":3,"ar":"إِلَّا","en_gloss":"(is) but","transliteration":"illā","verse_key":"23:37"},{"pos":4,"ar":"حَيَاتُنَا","en_gloss":"our life","transliteration":"ḥayātunā","verse_key":"23:37"},{"pos":5,"ar":"ٱلدُّنْيَا","en_gloss":"(of) the world","transliteration":"l-dun'yā","verse_key":"23:37"},{"pos":6,"ar":"نَمُوتُ","en_gloss":"we die","transliteration":"namūtu","verse_key":"23:37"},{"pos":7,"ar":"وَنَحْيَا","en_gloss":"and we live","transliteration":"wanaḥyā","verse_key":"23:37"},{"pos":8,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"23:37"},{"pos":9,"ar":"نَحْنُ","en_gloss":"we","transliteration":"naḥnu","verse_key":"23:37"},{"pos":10,"ar":"بِمَبْعُوثِينَ","en_gloss":"(will be) resurrected","transliteration":"bimabʿūthīna","verse_key":"23:37"},{"pos":11,"ar":"٣٧","en_gloss":"(37)","transliteration":"","verse_key":"23:37"}]},{"verse_ke