:10,"ar":"ٱلْأَمْرِ ۚ","en_gloss":"the matter","transliteration":"l-amri","verse_key":"22:67"},{"pos":11,"ar":"وَٱدْعُ","en_gloss":"but invite (them)","transliteration":"wa-ud'ʿu","verse_key":"22:67"},{"pos":12,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"22:67"},{"pos":13,"ar":"رَبِّكَ ۖ","en_gloss":"your Lord","transliteration":"rabbika","verse_key":"22:67"},{"pos":14,"ar":"إِنَّكَ","en_gloss":"Indeed, you","transliteration":"innaka","verse_key":"22:67"},{"pos":15,"ar":"لَعَلَىٰ","en_gloss":"(are) surely on","transliteration":"laʿalā","verse_key":"22:67"},{"pos":16,"ar":"هُدًۭى","en_gloss":"guidance","transliteration":"hudan","verse_key":"22:67"},{"pos":17,"ar":"مُّسْتَقِيمٍۢ","en_gloss":"straight","transliteration":"mus'taqīmin","verse_key":"22:67"},{"pos":18,"ar":"٦٧","en_gloss":"(67)","transliteration":"","verse_key":"22:67"}]},{"verse_key":"22:68","surah":22,"ayah":68,"ar_uthmani":"وَإِن جَـٰدَلُوكَ فَقُلِ ٱللَّهُ أَعْلَمُ بِمَا تَعْمَلُونَ","en_translation_id":85,"en":"and if they argue with you, say, ‘God is well aware of what you are doing.’","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And if","transliteration":"wa-in","verse_key":"22:68"},{"pos":2,"ar":"جَـٰدَلُوكَ","en_gloss":"they argue (with) you","transliteration":"jādalūka","verse_key":"22:68"},{"pos":3,"ar":"فَقُلِ","en_gloss":"then say","transliteration":"faquli","verse_key":"22:68"},{"pos":4,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"22:68"},{"pos":5,"ar":"أَعْلَمُ","en_gloss":"(is) most knowing","transliteration":"aʿlamu","verse_key":"22:68"},{"pos":6,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"22:68"},{"pos":7,"ar":"تَعْمَلُونَ","en_gloss":"you do","transliteration":"taʿmalūna","verse_key":"22:68"},{"pos":8,"ar":"٦٨","en_gloss":"(68)","transliteration":"","verse_key":"22:68"}]},{"verse_key":"22:69","surah":22,"ayah":69,"ar_uthmani":"ٱللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ ٱلْقِيَـٰمَةِ فِيمَا كُنتُمْ فِيهِ تَخْتَلِفُونَ","