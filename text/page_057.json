لَّذِينَ كَفَرُوا۟ فَأُعَذِّبُهُمْ عَذَابًا شَدِيدًا فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ وَمَا لَهُم مِّن نَّـٰصِرِينَ","en_translation_id":85,"en":"I will make the disbelievers suffer severely in this world and the next; no one will help them.’","words":[{"pos":1,"ar":"فَأَمَّا","en_gloss":"Then as for","transliteration":"fa-ammā","verse_key":"3:56"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"3:56"},{"pos":3,"ar":"كَفَرُوا۟","en_gloss":"disbelieve[d]","transliteration":"kafarū","verse_key":"3:56"},{"pos":4,"ar":"فَأُعَذِّبُهُمْ","en_gloss":"then I will punish them","transliteration":"fa-uʿadhibuhum","verse_key":"3:56"},{"pos":5,"ar":"عَذَابًۭا","en_gloss":"(with) a punishment","transliteration":"ʿadhāban","verse_key":"3:56"},{"pos":6,"ar":"شَدِيدًۭا","en_gloss":"severe","transliteration":"shadīdan","verse_key":"3:56"},{"pos":7,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"3:56"},{"pos":8,"ar":"ٱلدُّنْيَا","en_gloss":"the world","transliteration":"l-dun'yā","verse_key":"3:56"},{"pos":9,"ar":"وَٱلْـَٔاخِرَةِ","en_gloss":"and (in) the Hereafter","transliteration":"wal-ākhirati","verse_key":"3:56"},{"pos":10,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"3:56"},{"pos":11,"ar":"لَهُم","en_gloss":"for them","transliteration":"lahum","verse_key":"3:56"},{"pos":12,"ar":"مِّن","en_gloss":"any","transliteration":"min","verse_key":"3:56"},{"pos":13,"ar":"نَّـٰصِرِينَ","en_gloss":"helpers","transliteration":"nāṣirīna","verse_key":"3:56"},{"pos":14,"ar":"٥٦","en_gloss":"(56)","transliteration":"","verse_key":"3:56"}]},{"verse_key":"3:57","surah":3,"ayah":57,"ar_uthmani":"وَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَيُوَفِّيهِمْ أُجُورَهُمْ ۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّـٰلِمِينَ","en_translation_id":85,"en":"God will pay those who believe and do good deeds their reward in full; God does not love evildoers.","words":[{"pos":1,"ar":"وَأَمَّا","en_gloss":"And as for","transliteration":"wa-ammā","verse_key":"3:57"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"3:57"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe[d]","transliteration":"āmanū","verse_key":"3:57"},{"pos":4,"ar":"وَعَمِلُوا۟","en_gloss":"and did","transliteration":"waʿamilū","verse_key":"3:57"},{"pos":5,"ar":"ٱلصَّـٰلِحَـٰتِ","en_gloss":"[the] righteous deeds","transliteration":"l-ṣāliḥāti","verse_key":"3:57"},{"pos":6,"ar":"فَيُوَفِّيهِمْ","en_gloss":"then He will grant them in full","transliteration":"fayuwaffīhim","verse_key":"3:57"},{"pos":7,"ar":"أُجُورَهُمْ ۗ","en_gloss":"their reward","transliteration":"ujūrahum","verse_key":"3:57"},{"pos":8,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"3:57"},{"pos":9,"ar":"لَا","en_gloss":"(does) not","transliteration":"lā","verse_key":"3:57"},{"pos":10,"ar":"يُحِبُّ","en_gloss":"love","transliteration":"yuḥibbu","verse_key":"3:57"},{"pos":11,"ar":"ٱلظَّـٰلِمِينَ","en_gloss":"the wrongdoers","transliteration":"l-ẓālimīna","verse_key":"3:57"},{"pos":12,"ar":"٥٧","en_gloss":"(57)","transliteration":"","verse_key":"3:57"}]},{"verse_key":"3:58","surah":3,"ayah":58,"ar_uthmani":"ذَٰلِكَ نَتْلُوهُ عَلَيْكَ مِنَ ٱلْـَٔايَـٰتِ وَٱلذِّكْرِ ٱلْحَكِيمِ","en_translation_id":85,"en":"We relate to you [Muhammad] this revelation, a decisive statement.","words":[{"pos":1,"ar":"ذَٰلِكَ","en_gloss":"That","transliteration":"dhālika","verse_key":"3:58"},{"pos":2,"ar":"نَتْلُوهُ","en_gloss":"(is what) We recite [it]","transliteration":"natlūhu","verse_key":"3:58"},{"pos":3,"ar":"عَلَيْكَ","en_gloss":"to you","transliteration":"ʿalayka","verse_key":"3:58"},{"pos":4,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"3:58"},{"pos":5,"ar":"ٱلْـَٔايَـٰتِ","en_gloss":"the Verses","transliteration":"l-āyāti","verse_key":"3:58"},{"pos":6,"ar":"وَٱلذِّكْرِ","en_gloss":"and the Reminder ","transliteration":"wal-dhik'ri","verse_key":"3:58"},{"pos":7,"ar":"ٱلْحَكِيمِ","en_gloss":"[the] Wise","transliteration":"l-ḥakīmi","verse_key":"3:58"},{"pos":8,"ar":"٥٨","en_gloss":"(58)","transliteration":"","verse_key":"3:58"}]},{"verse_key":"3:59","surah":3,"ayah":59,"ar_uthmani":"إِنَّ مَثَلَ عِيسَىٰ عِندَ ٱللَّهِ كَمَثَلِ ءَادَمَ ۖ خَلَقَهُۥ مِن تُرَابٍ ثُمَّ قَالَ لَهُۥ كُن فَيَكُونُ","en_translation_id":85,"en":"In God’s eyes Jesus is just like Adam: He created him from dust, said to him, ‘Be’, and he was.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"3:59"},{"pos":2,"ar":"مَثَلَ","en_gloss":"(the) likeness","transliteration":"mathala","verse_key":"3:59"},{"pos":3,"ar":"عِيسَىٰ","en_gloss":"(of) Isa","transliteration":"ʿīsā","verse_key":"3:59"},{"pos":4,"ar":"عِندَ","en_gloss":"near","transliteration":"ʿinda","verse_key":"3:59"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"3:59"},{"pos":6,"ar":"كَمَثَلِ","en_gloss":"(is) like (the) likeness","transliteration":"kamathali","verse_key":"3:59"},{"pos":7,"ar":"ءَادَمَ ۖ","en_gloss":"(of) Adam","transliteration":"ādama","verse_key":"3:59"},{"pos":8,"ar":"خَلَقَهُۥ","en_gloss":"He created him","transliteration":"khalaqahu","verse_key":"3:59"},{"pos":9,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"3:59"},{"pos":10,"ar":"تُرَابٍۢ","en_gloss":"dust","transliteration":"turābin","verse_key":"3:59"},{"pos":11,"ar":"ثُمَّ","en_gloss":"then","transliteration":"thumma","verse_key":"3:59"},{"pos":12,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"3:59"},{"pos":13,"ar":"لَهُۥ","en_gloss":"to him","transliteration":"lahu","verse_key":"3:59"},{"pos":14,"ar":"كُن","en_gloss":"Be","transliteration":"kun","verse_key":"3:59"},{"pos":15,"ar":"فَيَكُونُ","en_gloss":"and he was","transliteration":"fayakūnu","verse_key":"3:59"},{"pos":16,"ar":"٥٩","en_gloss":"(59)","transliteration":"","verse_key":"3:59"}]},{"verse_key":"3:60","surah":3,"ayah":60,"ar_uthmani":"ٱلْحَقُّ مِن رَّبِّكَ فَلَا تَكُن م