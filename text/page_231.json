هِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ","en_translation_id":85,"en":"He answered, ‘My people, can you not see? What if I am acting on clear evidence from my Lord? He Himself has given me good provision: I do not want to do what I am forbidding you to do, I only want to put things right as far as I can. I cannot succeed without God’s help: I trust in Him, and always turn to Him.","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"11:88"},{"pos":2,"ar":"يَـٰقَوْمِ","en_gloss":"O my people","transliteration":"yāqawmi","verse_key":"11:88"},{"pos":3,"ar":"أَرَءَيْتُمْ","en_gloss":"Do you see","transliteration":"ara-aytum","verse_key":"11:88"},{"pos":4,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"11:88"},{"pos":5,"ar":"كُنتُ","en_gloss":"I am","transliteration":"kuntu","verse_key":"11:88"},{"pos":6,"ar":"عَلَىٰ","en_gloss":"on","transliteration":"ʿalā","verse_key":"11:88"},{"pos":7,"ar":"بَيِّنَةٍۢ","en_gloss":"a clear evidence","transliteration":"bayyinatin","verse_key":"11:88"},{"pos":8,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"11:88"},{"pos":9,"ar":"رَّبِّى","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"11:88"},{"pos":10,"ar":"وَرَزَقَنِى","en_gloss":"and He has provided me","transliteration":"warazaqanī","verse_key":"11:88"},{"pos":11,"ar":"مِنْهُ","en_gloss":"from Himself","transliteration":"min'hu","verse_key":"11:88"},{"pos":12,"ar":"رِزْقًا","en_gloss":"a good provision","transliteration":"riz'qan","verse_key":"11:88"},{"pos":13,"ar":"حَسَنًۭا ۚ","en_gloss":"a good provision","transliteration":"ḥasanan","verse_key":"11:88"},{"pos":14,"ar":"وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"11:88"},{"pos":15,"ar":"أُرِيدُ","en_gloss":"I intend","transliteration":"urīdu","verse_key":"11:88"},{"pos":16,"ar":"أَنْ","en_gloss":"that","transliteration":"an","verse_key":"11:88"},{"pos":17,"ar":"أُخَالِفَكُمْ","en_gloss":"I differ from you","transliteration":"ukhālif