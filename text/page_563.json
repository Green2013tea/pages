,"verse_key":"67:18"},{"pos":9,"ar":"١٨","en_gloss":"(18)","transliteration":"","verse_key":"67:18"}]},{"verse_key":"67:19","surah":67,"ayah":19,"ar_uthmani":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلطَّيْرِ فَوْقَهُمْ صَـٰٓفَّـٰتٍ وَيَقْبِضْنَ ۚ مَا يُمْسِكُهُنَّ إِلَّا ٱلرَّحْمَـٰنُ ۚ إِنَّهُۥ بِكُلِّ شَىْءٍۭ بَصِيرٌ","en_translation_id":85,"en":"Do they not see the birds above them spreading and closing their wings? It is only the Lord of Mercy who holds them up: He watches over everything.","words":[{"pos":1,"ar":"أَوَلَمْ","en_gloss":"Do not","transliteration":"awalam","verse_key":"67:19"},{"pos":2,"ar":"يَرَوْا۟","en_gloss":"they see","transliteration":"yaraw","verse_key":"67:19"},{"pos":3,"ar":"إِلَى","en_gloss":"[to]","transliteration":"ilā","verse_key":"67:19"},{"pos":4,"ar":"ٱلطَّيْرِ","en_gloss":"the birds","transliteration":"l-ṭayri","verse_key":"67:19"},{"pos":5,"ar":"فَوْقَهُمْ","en_gloss":"above them","transliteration":"fawqahum","verse_key":"67:19"},{"pos":6,"ar":"صَـٰٓفَّـٰتٍۢ","en_gloss":"spreading (their wings)","transliteration":"ṣāffātin","verse_key":"67:19"},{"pos":7,"ar":"وَيَقْبِضْنَ ۚ","en_gloss":"and folding","transliteration":"wayaqbiḍ'na","verse_key":"67:19"},{"pos":8,"ar":"مَا","en_gloss":"Not","transliteration":"mā","verse_key":"67:19"},{"pos":9,"ar":"يُمْسِكُهُنَّ","en_gloss":"holds them","transliteration":"yum'sikuhunna","verse_key":"67:19"},{"pos":10,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"67:19"},{"pos":11,"ar":"ٱلرَّحْمَـٰنُ ۚ","en_gloss":"the Most Gracious","transliteration":"l-raḥmānu","verse_key":"67:19"},{"pos":12,"ar":"إِنَّهُۥ","en_gloss":"Indeed, He","transliteration":"innahu","verse_key":"67:19"},{"pos":13,"ar":"بِكُلِّ","en_gloss":"(is) of every","transliteration":"bikulli","verse_key":"67:19"},{"pos":14,"ar":"شَىْءٍۭ","en_gloss":"thing","transliteration":"shayin","verse_key":"67:19"},{"pos":15,"ar":"بَصِيرٌ","en_gloss":"All-Seer","transliteration":"baṣīrun","verse_key":"67:19"},{"pos":16,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"67:19"}]},{"verse_key":"67:20","surah":67,"ayah":20,"ar_uthmani":"أَمَّنْ هَـٰذَا ٱلَّذِى هُوَ جُندٌ لَّكُمْ يَنصُرُكُم مِّن دُونِ ٱلرَّحْمَـٰنِ ۚ إِنِ ٱلْكَـٰفِرُونَ إِلَّا فِى غُرُورٍ","en_translation_id":85,"en":"What force can help you if the Lord of Mercy does not? The disbelievers are truly deluded.","words":[{"pos":1,"ar":"أَمَّنْ","en_gloss":"Who is","transliteration":"amman","verse_key":"67:20"},{"pos":2,"ar":"هَـٰذَا","en_gloss":"this","transliteration":"hādhā","verse_key":"67:20"},{"pos":3,"ar":"ٱلَّذِى","en_gloss":"the one","transliteration":"alladhī","verse_key":"67:20"},{"pos":4,"ar":"هُوَ","en_gloss":"he","transliteration":"huwa","verse_key":"67:20"},{"pos":5,"ar":"جُندٌۭ","en_gloss":"(is) an army","transliteration":"jundun","verse_key":"67:20"},{"pos":6,"ar":"لَّكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"67:20"},{"pos":7,"ar":"يَنصُرُكُم","en_gloss":"to help you","transliteration":"yanṣurukum","verse_key":"67:20"},{"pos":8,"ar":"مِّن","en_gloss":"from","transliteration":"min","verse_key":"67:20"},{"pos":9,"ar":"دُونِ","en_gloss":"besides","transliteration":"dūni","verse_key":"67:20"},{"pos":10,"ar":"ٱلرَّحْمَـٰنِ ۚ","en_gloss":"the Most Gracious","transliteration":"l-raḥmāni","verse_key":"67:20"},{"pos":11,"ar":"إِنِ","en_gloss":"Not","transliteration":"ini","verse_key":"67:20"},{"pos":12,"ar":"ٱلْكَـٰفِرُونَ","en_gloss":"(are) the disbelievers","transliteration":"l-kāfirūna","verse_key":"67:20"},{"pos":13,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"67:20"},{"pos":14,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"67:20"},{"pos":15,"ar":"غُرُورٍ","en_gloss":"delusion","transliteration":"ghurūrin","verse_key":"67:20"},{"pos":16,"ar":"٢٠","en_gloss":"(20)","transliteration":"","verse_key":"67:20"}]},{"verse_key":"67:21","surah":67,"ayah":21,"ar_uthmani":"أَمَّنْ هَـٰذَا ٱلَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُۥ ۚ بَل لَّجُّوا۟ فِى عُتُوٍّ وَنُ