ansliteration":"yāayyuhā","verse_key":"5:2"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"you (who)","transliteration":"alladhīna","verse_key":"5:2"},{"pos":3,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"5:2"},{"pos":4,"ar":"لَا","en_gloss":"(Do) not","transliteration":"lā","verse_key":"5:2"},{"pos":5,"ar":"تُحِلُّوا۟","en_gloss":"violate","transliteration":"tuḥillū","verse_key":"5:2"},{"pos":6,"ar":"شَعَـٰٓئِرَ","en_gloss":"(the) rites","transliteration":"shaʿāira","verse_key":"5:2"},{"pos":7,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"5:2"},{"pos":8,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"5:2"},{"pos":9,"ar":"ٱلشَّهْرَ","en_gloss":"the month","transliteration":"l-shahra","verse_key":"5:2"},{"pos":10,"ar":"ٱلْحَرَامَ","en_gloss":"the sacred","transliteration":"l-ḥarāma","verse_key":"5:2"},{"pos":11,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"5:2"},{"pos":12,"ar":"ٱلْهَدْىَ","en_gloss":"the sacrificial animals","transliteration":"l-hadya","verse_key":"5:2"},{"pos":13,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"5:2"},{"pos":14,"ar":"ٱلْقَلَـٰٓئِدَ","en_gloss":"the garlanded","transliteration":"l-qalāida","verse_key":"5:2"},{"pos":15,"ar":"وَلَآ","en_gloss":"and not","transliteration":"walā","verse_key":"5:2"},{"pos":16,"ar":"ءَآمِّينَ","en_gloss":"(those) coming","transliteration":"āmmīna","verse_key":"5:2"},{"pos":17,"ar":"ٱلْبَيْتَ","en_gloss":"(to) the House","transliteration":"l-bayta","verse_key":"5:2"},{"pos":18,"ar":"ٱلْحَرَامَ","en_gloss":"the Sacred","transliteration":"l-ḥarāma","verse_key":"5:2"},{"pos":19,"ar":"يَبْتَغُونَ","en_gloss":"seeking","transliteration":"yabtaghūna","verse_key":"5:2"},{"pos":20,"ar":"فَضْلًۭا","en_gloss":"Bounty","transliteration":"faḍlan","verse_key":"5:2"},{"pos":21,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"5:2"},{"pos":22,"ar":"رَّبِّهِمْ","en_gloss":"their