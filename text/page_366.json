ُو۟لَـٰٓئِكَ يُبَدِّلُ ٱللَّهُ سَيِّـَٔاتِهِمْ حَسَنَـٰتٍ ۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا","en_translation_id":85,"en":"except those who repent, believe, and do good deeds: God will change the evil deeds of such people into good ones. He is most forgiving, most merciful.","words":[{"pos":1,"ar":"إِلَّا","en_gloss":"Except","transliteration":"illā","verse_key":"25:70"},{"pos":2,"ar":"مَن","en_gloss":"(he) who","transliteration":"man","verse_key":"25:70"},{"pos":3,"ar":"تَابَ","en_gloss":"repents","transliteration":"tāba","verse_key":"25:70"},{"pos":4,"ar":"وَءَامَنَ","en_gloss":"and believes","transliteration":"waāmana","verse_key":"25:70"},{"pos":5,"ar":"وَعَمِلَ","en_gloss":"and does","transliteration":"waʿamila","verse_key":"25:70"},{"pos":6,"ar":"عَمَلًۭا","en_gloss":"righteous deeds","transliteration":"ʿamalan","verse_key":"25:70"},{"pos":7,"ar":"صَـٰلِحًۭا","en_gloss":"righteous deeds","transliteration":"ṣāliḥan","verse_key":"25:70"},{"pos":8,"ar":"فَأُو۟لَـٰٓئِكَ","en_gloss":"then (for) those","transliteration":"fa-ulāika","verse_key":"25:70"},{"pos":9,"ar":"يُبَدِّلُ","en_gloss":"Allah will replace","transliteration":"yubaddilu","verse_key":"25:70"},{"pos":10,"ar":"ٱللَّهُ","en_gloss":"Allah will replace","transliteration":"l-lahu","verse_key":"25:70"},{"pos":11,"ar":"سَيِّـَٔاتِهِمْ","en_gloss":"their evil deeds","transliteration":"sayyiātihim","verse_key":"25:70"},{"pos":12,"ar":"حَسَنَـٰتٍۢ ۗ","en_gloss":"(with) good ones","transliteration":"ḥasanātin","verse_key":"25:70"},{"pos":13,"ar":"وَكَانَ","en_gloss":"And is","transliteration":"wakāna","verse_key":"25:70"},{"pos":14,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"25:70"},{"pos":15,"ar":"غَفُورًۭا","en_gloss":"Oft-Forgiving","transliteration":"ghafūran","verse_key":"25:70"},{"pos":16,"ar":"رَّحِيمًۭا","en_gloss":"Most Merciful","transliteration":"raḥīman","verse_key":"25:70"},{"pos":17,"ar":"٧٠","en_gloss":"(70)","transliteration":"","verse_key":"25:70"}]},{"verse_key"