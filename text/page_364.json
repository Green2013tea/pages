:55","surah":25,"ayah":55,"ar_uthmani":"وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُهُمْ وَلَا يَضُرُّهُمْ ۗ وَكَانَ ٱلْكَافِرُ عَلَىٰ رَبِّهِۦ ظَهِيرًا","en_translation_id":85,"en":"Yet instead of God they worship things that can neither benefit nor harm them: the disbeliever has always turned his back on his Lord.","words":[{"pos":1,"ar":"وَيَعْبُدُونَ","en_gloss":"But they worship","transliteration":"wayaʿbudūna","verse_key":"25:55"},{"pos":2,"ar":"مِن","en_gloss":"besides Allah","transliteration":"min","verse_key":"25:55"},{"pos":3,"ar":"دُونِ","en_gloss":"besides Allah","transliteration":"dūni","verse_key":"25:55"},{"pos":4,"ar":"ٱللَّهِ","en_gloss":"besides Allah","transliteration":"l-lahi","verse_key":"25:55"},{"pos":5,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"25:55"},{"pos":6,"ar":"لَا","en_gloss":"not profits them","transliteration":"lā","verse_key":"25:55"},{"pos":7,"ar":"يَنفَعُهُمْ","en_gloss":"not profits them","transliteration":"yanfaʿuhum","verse_key":"25:55"},{"pos":8,"ar":"وَلَا","en_gloss":"and not","transliteration":"walā","verse_key":"25:55"},{"pos":9,"ar":"يَضُرُّهُمْ ۗ","en_gloss":"harms them","transliteration":"yaḍurruhum","verse_key":"25:55"},{"pos":10,"ar":"وَكَانَ","en_gloss":"and is","transliteration":"wakāna","verse_key":"25:55"},{"pos":11,"ar":"ٱلْكَافِرُ","en_gloss":"the disbeliever","transliteration":"l-kāfiru","verse_key":"25:55"},{"pos":12,"ar":"عَلَىٰ","en_gloss":"against","transliteration":"ʿalā","verse_key":"25:55"},{"pos":13,"ar":"رَبِّهِۦ","en_gloss":"his Lord","transliteration":"rabbihi","verse_key":"25:55"},{"pos":14,"ar":"ظَهِيرًۭا","en_gloss":"a helper","transliteration":"ẓahīran","verse_key":"25:55"},{"pos":15,"ar":"٥٥","en_gloss":"(55)","transliteration":"","verse_key":"25:55"}]}]}