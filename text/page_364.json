":"aktharu","verse_key":"25:50"},{"pos":7,"ar":"ٱلنَّاسِ","en_gloss":"(of) the people","transliteration":"l-nāsi","verse_key":"25:50"},{"pos":8,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"25:50"},{"pos":9,"ar":"كُفُورًۭا","en_gloss":"disbelief","transliteration":"kufūran","verse_key":"25:50"},{"pos":10,"ar":"٥٠","en_gloss":"(50)","transliteration":"","verse_key":"25:50"}]},{"verse_key":"25:51","surah":25,"ayah":51,"ar_uthmani":"وَلَوْ شِئْنَا لَبَعَثْنَا فِى كُلِّ قَرْيَةٍ نَّذِيرًا","en_translation_id":85,"en":"If it had been Our will, We would have sent a warner to every town,","words":[{"pos":1,"ar":"وَلَوْ","en_gloss":"And if","transliteration":"walaw","verse_key":"25:51"},{"pos":2,"ar":"شِئْنَا","en_gloss":"We willed","transliteration":"shi'nā","verse_key":"25:51"},{"pos":3,"ar":"لَبَعَثْنَا","en_gloss":"surely, We (would) have raised","transliteration":"labaʿathnā","verse_key":"25:51"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"25:51"},{"pos":5,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"25:51"},{"pos":6,"ar":"قَرْيَةٍۢ","en_gloss":"town","transliteration":"qaryatin","verse_key":"25:51"},{"pos":7,"ar":"نَّذِيرًۭا","en_gloss":"a warner","transliteration":"nadhīran","verse_key":"25:51"},{"pos":8,"ar":"٥١","en_gloss":"(51)","transliteration":"","verse_key":"25:51"}]},{"verse_key":"25:52","surah":25,"ayah":52,"ar_uthmani":"فَلَا تُطِعِ ٱلْكَـٰفِرِينَ وَجَـٰهِدْهُم بِهِۦ جِهَادًا كَبِيرًا","en_translation_id":85,"en":"so do not give in to the disbelievers: strive hard against them with this Quran.","words":[{"pos":1,"ar":"فَلَا","en_gloss":"So (do) not","transliteration":"falā","verse_key":"25:52"},{"pos":2,"ar":"تُطِعِ","en_gloss":"obey","transliteration":"tuṭiʿi","verse_key":"25:52"},{"pos":3,"ar":"ٱلْكَـٰفِرِينَ","en_gloss":"the disbelievers","transliteration":"l-kāfirīna","verse_key":"25:52"},{"pos":4,"ar":"وَجَـٰهِدْهُم","en_gloss":"and strive (against) them","transliteration":