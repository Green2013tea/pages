{"page":182,"verses":[{"verse_key":"8:41","surah":8,"ayah":41,"ar_uthmani":"۞ وَٱعْلَمُوٓا۟ أَنَّمَا غَنِمْتُم مِّن شَىْءٍ فَأَنَّ لِلَّهِ خُمُسَهُۥ وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ إِن كُنتُمْ ءَامَنتُم بِٱللَّهِ وَمَآ أَنزَلْنَا عَلَىٰ عَبْدِنَا يَوْمَ ٱلْفُرْقَانِ يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ ۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","en_translation_id":85,"en":"Know that one-fifth of your battle gains belongs to God and the Messenger, to close relatives and orphans, to the needy and travellers, if you believe in God and the revelation We sent down to Our servant on the day of the decision, the day when the two forces met in battle. God has power over all things.","words":[{"pos":1,"ar":"۞ وَٱعْلَمُوٓا۟","en_gloss":"And know","transliteration":"wa-iʿ'lamū","verse_key":"8:41"},{"pos":2,"ar":"أَنَّمَا","en_gloss":"that what","transliteration":"annamā","verse_key":"8:41"},{"pos":3,"ar":"غَنِمْتُم","en_gloss":"you obtain (as) spoils of war","transliteration":"ghanim'tum","verse_key":"8:41"},{"pos":4,"ar":"مِّن","en_gloss":"of","transliteration":"min","verse_key":"8:41"},{"pos":5,"ar":"شَىْءٍۢ","en_gloss":"anything","transliteration":"shayin","verse_key":"8:41"},{"pos":6,"ar":"فَأَنَّ","en_gloss":"then that","transliteration":"fa-anna","verse_key":"8:41"},{"pos":7,"ar":"لِلَّهِ","en_gloss":"for Allah","transliteration":"lillahi","verse_key":"8:41"},{"pos":8,"ar":"خُمُسَهُۥ","en_gloss":"(is) one fifth of it","transliteration":"khumusahu","verse_key":"8:41"},{"pos":9,"ar":"وَلِلرَّسُولِ","en_gloss":"and for the Messenger","transliteration":"walilrrasūli","verse_key":"8:41"},{"pos":10,"ar":"وَلِذِى","en_gloss":"and for the","transliteration":"walidhī","verse_key":"8:41"},{"pos":11,"ar":"ٱلْقُرْبَىٰ","en_gloss":"near relatives","transliteration":"l-qur'bā","verse_key":"8:41"},{"pos":12,"ar":"وَٱلْيَتَـٰمَىٰ","en_gloss":"and the orphans","transliteration":"wal-yatāmā","verse_key":"8:41"},{"pos":13,"ar":"وَٱلْمَسَـٰكِينِ","en_gloss":"and the needy","transliteration":"wal-masākīni","verse_key":"8:41"},{"pos":14,"ar":"وَٱبْنِ","en_gloss":"and the","transliteration":"wa-ib'ni","verse_key":"8:41"},{"pos":15,"ar":"ٱلسَّبِيلِ","en_gloss":"wayfarer","transliteration":"l-sabīli","verse_key":"8:41"},{"pos":16,"ar":"إِن","en_gloss":"if","transliteration":"in","verse_key":"8:41"},{"pos":17,"ar":"كُنتُمْ","en_gloss":"you","transliteration":"kuntum","verse_key":"8:41"},{"pos":18,"ar":"ءَامَنتُم","en_gloss":"believe","transliteration":"āmantum","verse_key":"8:41"},{"pos":19,"ar":"بِٱللَّهِ","en_gloss":"in Allah","transliteration":"bil-lahi","verse_key":"8:41"},{"pos":20,"ar":"وَمَآ","en_gloss":"and (in) what","transliteration":"wamā","verse_key":"8:41"},{"pos":21,"ar":"أَنزَلْنَا","en_gloss":"We sent down","transliteration":"anzalnā","verse_key":"8:41"},{"pos":22,"ar":"عَلَىٰ","en_gloss":"to","transliteration":"ʿalā","verse_key":"8:41"},{"pos":23,"ar":"عَبْدِنَا","en_gloss":"Our slave","transliteration":"ʿabdinā","verse_key":"8:41"},{"pos":24,"ar":"يَوْمَ","en_gloss":"(on the) day","transliteration":"yawma","verse_key":"8:41"},{"pos":25,"ar":"ٱلْفُرْقَانِ","en_gloss":"(of) the criterion","transliteration":"l-fur'qāni","verse_key":"8:41"},{"pos":26,"ar":"يَوْمَ","en_gloss":"(the) day","transliteration":"yawma","verse_key":"8:41"},{"pos":27,"ar":"ٱلْتَقَى","en_gloss":"(when) met","transliteration":"l-taqā","verse_key":"8:41"},{"pos":28,"ar":"ٱلْجَمْعَانِ ۗ","en_gloss":"the two forces","transliteration":"l-jamʿāni","verse_key":"8:41"},{"pos":29,"ar":"وَٱللَّهُ","en_gloss":"And Allah","transliteration":"wal-lahu","verse_key":"8:41"},{"pos":30,"ar":"عَلَىٰ","en_gloss":"(is) on","transliteration":"ʿalā","verse_key":"8:41"},{"pos":31,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"8:41"},{"pos":32,"ar":"شَىْءٍۢ","en_gloss":"thing","transliteration":"shayin","verse_key":"8:41"},{"pos":33,"ar":"قَدِيرٌ","en_gloss":"All-Powerful","transliteration":"qadīrun","verse_key":"8:41"},{"pos":34,"ar":"٤١","en_gloss":"(41)","transliteration":"","verse_key":"8:41"}]},{"verse_key":"8:42","surah":8,"ayah":42,"ar_uthmani":"إِذْ أَنتُم بِٱلْعُدْوَةِ ٱلدُّنْيَا وَهُم بِٱلْعُدْوَةِ ٱلْقُصْوَىٰ وَٱلرَّكْبُ أَسْفَلَ مِنكُمْ ۚ وَلَوْ تَوَاعَدتُّمْ لَٱخْتَلَفْتُمْ فِى ٱلْمِيعَـٰدِ ۙ وَلَـٰكِن لِّيَقْضِىَ ٱللَّهُ أَمْرًا كَانَ مَفْعُولًا لِّيَهْلِكَ مَنْ هَلَكَ عَنۢ بَيِّنَةٍ وَيَحْيَىٰ مَنْ حَىَّ عَنۢ بَيِّنَةٍ ۗ وَإِنَّ ٱللَّهَ لَسَمِيعٌ عَلِيمٌ","en_translation_id":85,"en":"Remember when you were on the near side of the valley, and they were on the far side and the caravan was below you. If you had made an appointment to fight, you would have failed to keep it [but the battle took place] so that God might bring about something already ordained, so that those who were to die might die after seeing a clear proof, and so that those who were to live might live after seeing a clear proof- God is all hearing and all seeing.","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"8:42"},{"pos":2,"ar":"أَنتُم","en_gloss":"you (were)","transliteration":"antum","verse_key":"8:42"},{"pos":3,"ar":"بِٱلْعُدْوَةِ","en_gloss":"on side of the valley","transliteration":"bil-ʿud'wati","verse_key":"8:42"},{"pos":4,"ar":"ٱلدُّنْيَا","en_gloss":"the nearer","transliteration":"l-dun'yā","verse_key":"8:42"},{"pos":5,"ar":"وَهُم","en_gloss":"and they","transliteration":"wahum","verse_key":"8:42"},{"pos":6,"ar":"بِٱلْعُدْوَةِ","en_gloss":"(were) on the side","transliteration":"bil-ʿud'wati","verse_key":"8:42"},{"pos":7,"ar":"ٱلْقُصْوَىٰ","en_gloss":"the farther","transliteration":"l-quṣ'wā","verse_key":"8:42"},{"pos":8,"ar":"وَٱلرَّكْبُ","en_gloss":"and the caravan","transliteration":"wal-rakbu","verse_key":"8:42"},{"pos":9,"ar":"أَسْفَلَ","en_gloss":"(was) lower","transliteration":"asfala","verse_key":"8:42"},{"pos":10,"ar":"مِنكُمْ ۚ","en_gloss":"than you","transliteration":"minkum","verse_key":"8:42"},{"pos":11,"ar":"وَلَوْ","en_gloss":"And if","transliteration":"walaw","verse_key":"8:42"},{"pos":12,"ar":"تَوَاعَدتُّمْ","en_gloss":"you (had) made an appointment","transliteration":"tawāʿadttum","verse_key":"8:42"},{"pos":13,"ar":"لَٱخْتَلَفْتُمْ","en_gloss":"certainly you would have failed","transliteration":"la-ikh'talaftum","verse_key":"8:42"},{"pos":14,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"8:42"},{"pos":15,"ar":"ٱلْمِيعَـٰدِ ۙ","en_gloss":"the appointment","transliteration":"l-mīʿādi","verse_key":"8:42"},{"pos":16,"ar":"وَلَـٰكِن","en_gloss":"But","transliteration":"walākin","verse_key":"8:42"},{"pos":17,"ar":"لِّيَقْضِىَ","en_gloss":"that might accomplish","transliteration":"liyaqḍiya","verse_key":"8:42"},{"pos":18,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"8:42"},{"pos":19,"ar":"أَمْرًۭا","en_gloss":"a matter","transliteration":"amran","verse_key":"8:42"},{"pos":20,"ar":"كَانَ","en_gloss":"(that) was","transliteration":"kāna","verse_key":"8:42"},{"pos":21,"ar":"مَفْعُولًۭا","en_gloss":"destined","transliteration":"mafʿūlan","verse_key":"8:42"},{"pos":22,"ar":"لِّيَهْلِكَ","en_gloss":"that (might be) destroyed","transliteration":"liyahlika","verse_key":"8:42"},{"pos":23,"ar":"مَنْ","en_gloss":"(those) who","transliteration":"man","verse_key":"8:42"},{"pos":24,"ar":"هَلَكَ","en_gloss":"(were to be) destroyed","transliteration":"halaka","verse_key":"8:42"},{"pos":25,"ar":"عَنۢ","en_gloss":"on","transliteration":"ʿan","verse_key":"8:42"},{"pos":26,"ar":"بَيِّنَةٍۢ","en_gloss":"a clear evidence","transliteration":"bayyinatin","verse_key":"8:42"},{"pos":27,"ar":"وَيَحْيَىٰ","en_gloss":"and (might) live","transliteration":"wayaḥyā","verse_key":"8:42"},{"pos":28,"ar":"مَنْ","en_gloss":"(those) who","transliteration":"man","verse_key":"8:42"},{"pos":29,"ar":"حَىَّ","en_gloss":"(were to) live","transliteration":"ḥayya","verse_key":"8:42"},{"pos":30,"ar":"عَنۢ","en_gloss":"on","transliteration":"ʿan","verse_key":"8:42"},{"pos":31,"ar":"بَيِّنَةٍۢ ۗ","en_gloss":"a clear evidence","transliteration":"bayyinatin","verse_key":"8:42"},{"pos":32,"ar":"وَإِنَّ","en_gloss":"And indeed","transliteration":"wa-inna","verse_key":"8:42"},{"pos":33,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:42"},{"pos":34,"ar":"لَسَمِيعٌ","en_gloss":"(is) All-Hearing","transliteration":"lasamīʿun","verse_key":"8:42"},{"pos":35,"ar":"عَلِيمٌ","en_gloss":"All-Knowing","transliteration":"ʿalīmun","verse_key":"8:42"},{"pos":36,"ar":"٤٢","en_gloss":"(42)","transliteration":"","verse_key":"8:42"}]},{"verse_key":"8:43","surah":8,"ayah":43,"ar_uthmani":"إِذْ يُرِيكَهُمُ ٱللَّهُ فِى مَنَامِكَ قَلِيلًا ۖ وَلَوْ أَرَىٰكَهُمْ كَثِيرًا لَّفَشِلْتُمْ وَلَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ وَلَـٰكِنَّ ٱللَّهَ سَلَّمَ ۗ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","en_translation_id":85,"en":"[Prophet], remember when God made you see them in your sleep as few: if He had shown them to you [believers] as many, you would certainly have lost heart and argued about it, but God saved you. He knows the secrets of the heart.","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"8:43"},{"pos":2,"ar":"يُرِيكَهُمُ","en_gloss":"you (where) shown them","transliteration":"yurīkahumu","verse_key":"8:43"},{"pos":3,"ar":"ٱللَّهُ","en_gloss":"(by) Allah","transliteration":"l-lahu","verse_key":"8:43"},{"pos":4,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"8:43"},{"pos":5,"ar":"مَنَامِكَ","en_gloss":"your dream","transliteration":"manāmika","verse_key":"8:43"},{"pos":6,"ar":"قَلِيلًۭا ۖ","en_gloss":"(as) few","transliteration":"qalīlan","verse_key":"8:43"},{"pos":7,"ar":"وَلَوْ","en_gloss":"and if","transliteration":"walaw","verse_key":"8:43"},{"pos":8,"ar":"أَرَىٰكَهُمْ","en_gloss":"He had shown them to you","transliteration":"arākahum","verse_key":"8:43"},{"pos":9,"ar":"كَثِيرًۭا","en_gloss":"(as) many","transliteration":"kathīran","verse_key":"8:43"},{"pos":10,"ar":"لَّفَشِلْتُمْ","en_gloss":"surely you would have lost courage","transliteration":"lafashil'tum","verse_key":"8:43"},{"pos":11,"ar":"وَلَتَنَـٰزَعْتُمْ","en_gloss":"and surely you would have disputed","transliteration":"walatanāzaʿtum","verse_key":"8:43"},{"pos":12,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"8:43"},{"pos":13,"ar":"ٱلْأَمْرِ","en_gloss":"the matter","transliteration":"l-amri","verse_key":"8:43"},{"pos":14,"ar":"وَلَـٰكِنَّ","en_gloss":"but","transliteration":"walākinna","verse_key":"8:43"},{"pos":15,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:43"},{"pos":16,"ar":"سَلَّمَ ۗ","en_gloss":"saved (you)","transliteration":"sallama","verse_key":"8:43"},{"pos":17,"ar":"إِنَّهُۥ","en_gloss":"Indeed, He","transliteration":"innahu","verse_key":"8:43"},{"pos":18,"ar":"عَلِيمٌۢ","en_gloss":"(is) All-Knower","transliteration":"ʿalīmun","verse_key":"8:43"},{"pos":19,"ar":"بِذَاتِ","en_gloss":"of what is in","transliteration":"bidhāti","verse_key":"8:43"},{"pos":20,"ar":"ٱلصُّدُورِ","en_gloss":"the breasts","transliteration":"l-ṣudūri","verse_key":"8:43"},{"pos":21,"ar":"٤٣","en_gloss":"(43)","transliteration":"","verse_key":"8:43"}]},{"verse_key":"8:44","surah":8,"ayah":44,"ar_uthmani":"وَإِذْ يُرِيكُمُوهُمْ إِذِ ٱلْتَقَيْتُمْ فِىٓ أَعْيُنِكُمْ قَلِيلًا وَيُقَلِّلُكُمْ فِىٓ أَعْيُنِهِمْ لِيَقْضِىَ ٱللَّهُ أَمْرًا كَانَ مَفْعُولًا ۗ وَإِلَى ٱللَّهِ تُرْجَعُ ٱلْأُمُورُ","en_translation_id":85,"en":"When you met He showed them to you as few, and He made you few in their eyes, so that He might bring about what has been ordained: everything goes back to God.","words":[{"pos":1,"ar":"وَإِذْ","en_gloss":"And when","transliteration":"wa-idh","verse_key":"8:44"},{"pos":2,"ar":"يُرِيكُمُوهُمْ","en_gloss":"He showed them to you","transliteration":"yurīkumūhum","verse_key":"8:44"},{"pos":3,"ar":"إِذِ","en_gloss":"when","transliteration":"idhi","verse_key":"8:44"},{"pos":4,"ar":"ٱلْتَقَيْتُمْ","en_gloss":"you met ","transliteration":"l-taqaytum","verse_key":"8:44"},{"pos":5,"ar":"فِىٓ","en_gloss":"in","transliteration":"fī","verse_key":"8:44"},{"pos":6,"ar":"أَعْيُنِكُمْ","en_gloss":"your eyes","transliteration":"aʿyunikum","verse_key":"8:44"},{"pos":7,"ar":"قَلِيلًۭا","en_gloss":"(as) few","transliteration":"qalīlan","verse_key":"8:44"},{"pos":8,"ar":"وَيُقَلِّلُكُمْ","en_gloss":"and He made you (appear) as few","transliteration":"wayuqallilukum","verse_key":"8:44"},{"pos":9,"ar":"فِىٓ","en_gloss":"in","transliteration":"fī","verse_key":"8:44"},{"pos":10,"ar":"أَعْيُنِهِمْ","en_gloss":"their eyes","transliteration":"aʿyunihim","verse_key":"8:44"},{"pos":11,"ar":"لِيَقْضِىَ","en_gloss":"that might accomplish","transliteration":"liyaqḍiya","verse_key":"8:44"},{"pos":12,"ar":"ٱللَّهُ","en_gloss":"Allah might accomplish","transliteration":"l-lahu","verse_key":"8:44"},{"pos":13,"ar":"أَمْرًۭا","en_gloss":"a matter","transliteration":"amran","verse_key":"8:44"},{"pos":14,"ar":"كَانَ","en_gloss":"(that) was","transliteration":"kāna","verse_key":"8:44"},{"pos":15,"ar":"مَفْعُولًۭا ۗ","en_gloss":"(already) destined","transliteration":"mafʿūlan","verse_key":"8:44"},{"pos":16,"ar":"وَإِلَى","en_gloss":"And to","transliteration":"wa-ilā","verse_key":"8:44"},{"pos":17,"ar":"ٱللَّهِ","en_gloss":"Allah","transliteration":"l-lahi","verse_key":"8:44"},{"pos":18,"ar":"تُرْجَعُ","en_gloss":"return","transliteration":"tur'jaʿu","verse_key":"8:44"},{"pos":19,"ar":"ٱلْأُمُورُ","en_gloss":"(all) the matters","transliteration":"l-umūru","verse_key":"8:44"},{"pos":20,"ar":"٤٤","en_gloss":"(44)","transliteration":"","verse_key":"8:44"}]},{"verse_key":"8:45","surah":8,"ayah":45,"ar_uthmani":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا لَقِيتُمْ فِئَةً فَٱثْبُتُوا۟ وَٱذْكُرُوا۟ ٱللَّهَ كَثِيرًا لَّعَلَّكُمْ تُفْلِحُونَ","en_translation_id":85,"en":"Believers, when you meet a force in battle, stand firm and keep God firmly in mind, so that you may prosper.","words":[{"pos":1,"ar":"يَـٰٓأَيُّهَا","en_gloss":"O you","transliteration":"yāayyuhā","verse_key":"8:45"},{"pos":2,"ar":"ٱلَّذِينَ","en_gloss":"who","transliteration":"alladhīna","verse_key":"8:45"},{"pos":3,"ar":"ءَامَنُوٓا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"8:45"},{"pos":4,"ar":"إِذَا","en_gloss":"When","transliteration":"idhā","verse_key":"8:45"},{"pos":5,"ar":"لَقِيتُمْ","en_gloss":"you meet","transliteration":"laqītum","verse_key":"8:45"},{"pos":6,"ar":"فِئَةًۭ","en_gloss":"a force","transliteration":"fi-atan","verse_key":"8:45"},{"pos":7,"ar":"فَٱثْبُتُوا۟","en_gloss":"then be firm","transliteration":"fa-uth'butū","verse_key":"8:45"},{"pos":8,"ar":"وَٱذْكُرُوا۟","en_gloss":"and remember","transliteration":"wa-udh'kurū","verse_key":"8:45"},{"pos":9,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"8:45"},{"pos":10,"ar":"كَثِيرًۭا","en_gloss":"much","transliteration":"kathīran","verse_key":"8:45"},{"pos":11,"ar":"لَّعَلَّكُمْ","en_gloss":"so that you may","transliteration":"laʿallakum","verse_key":"8:45"},{"pos":12,"ar":"تُفْلِحُونَ","en_gloss":"(be) successful","transliteration":"tuf'liḥūna","verse_key":"8:45"},{"pos":13,"ar":"٤٥","en_gloss":"(45)","transliteration":"","verse_key":"8:45"}]}]}