أَلْسِنَتُهُمُ ٱلْكَذِبَ أَنَّ لَهُمُ ٱلْحُسْنَىٰ ۖ لَا جَرَمَ أَنَّ لَهُمُ ٱلنَّارَ وَأَنَّهُم مُّفْرَطُونَ","en_translation_id":85,"en":"They attribute to God what they themselves dislike while their own tongues utter the lie that the best belongs to them. Without doubt it is the Fire that belongs to them: they will be given priority there!","words":[{"pos":1,"ar":"وَيَجْعَلُونَ","en_gloss":"And they assign","transliteration":"wayajʿalūna","verse_key":"16:62"},{"pos":2,"ar":"لِلَّهِ","en_gloss":"to Allah","transliteration":"lillahi","verse_key":"16:62"},{"pos":3,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"16:62"},{"pos":4,"ar":"يَكْرَهُونَ","en_gloss":"they dislike","transliteration":"yakrahūna","verse_key":"16:62"},{"pos":5,"ar":"وَتَصِفُ","en_gloss":"and assert","transliteration":"wataṣifu","verse_key":"16:62"},{"pos":6,"ar":"أَلْسِنَتُهُمُ","en_gloss":"their tongues","transliteration":"alsinatuhumu","verse_key":"16:62"},{"pos":7,"ar":"ٱلْكَذِبَ","en_gloss":"the lie","transliteration":"l-kadhiba","verse_key":"16:62"},{"pos":8,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"16:62"},{"pos":9,"ar":"لَهُمُ","en_gloss":"for them","transliteration":"lahumu","verse_key":"16:62"},{"pos":10,"ar":"ٱلْحُسْنَىٰ ۖ","en_gloss":"(is) the best","transliteration":"l-ḥus'nā","verse_key":"16:62"},{"pos":11,"ar":"لَا","en_gloss":"No","transliteration":"lā","verse_key":"16:62"},{"pos":12,"ar":"جَرَمَ","en_gloss":"doubt","transliteration":"jarama","verse_key":"16:62"},{"pos":13,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"16:62"},{"pos":14,"ar":"لَهُمُ","en_gloss":"for them","transliteration":"lahumu","verse_key":"16:62"},{"pos":15,"ar":"ٱلنَّارَ","en_gloss":"(is) the Fire","transliteration":"l-nāra","verse_key":"16:62"},{"pos":16,"ar":"وَأَنَّهُم","en_gloss":"and that they","transliteration":"wa-annahum","verse_key":"16:62"},{"pos":17,"ar":"مُّفْرَطُونَ","en_gloss":"(will) be abandoned","transliteration":"muf'raṭūna","verse_key":"16:62"},{"pos":18,"ar":"٦٢","en_gloss":"(62)","transliteration":"","verse_key":"16:62"}]},{"verse_key":"16:63","surah":16,"ayah":63,"ar_uthmani":"تَٱللَّهِ لَقَدْ أَرْسَلْنَآ إِلَىٰٓ أُمَمٍ مِّن قَبْلِكَ فَزَيَّنَ لَهُمُ ٱلشَّيْطَـٰنُ أَعْمَـٰلَهُمْ فَهُوَ وَلِيُّهُمُ ٱلْيَوْمَ وَلَهُمْ عَذَابٌ أَلِيمٌ","en_translation_id":85,"en":"By God, We have sent messengers before you [Muhammad] to other communities, but Satan made their foul deeds seem alluring to them. He is the patron of these present disbelievers too, and a painful punishment awaits them all.","words":[{"pos":1,"ar":"تَٱللَّهِ","en_gloss":"By Allah","transliteration":"tal-lahi","verse_key":"16:63"},{"pos":2,"ar":"لَقَدْ","en_gloss":"certainly","transliteration":"laqad","verse_key":"16:63"},{"pos":3,"ar":"أَرْسَلْنَآ","en_gloss":"We have sent","transliteration":"arsalnā","verse_key":"16:63"},{"pos":4,"ar":"إِلَىٰٓ","en_gloss":"to","transliteration":"ilā","verse_key":"16:63"},{"pos":5,"ar":"أُمَمٍۢ","en_gloss":"nations","transliteration":"umamin","verse_key":"16:63"},{"pos":6,"ar":"مِّن","en_gloss":"before you","transliteration":"min","verse_key":"16:63"},{"pos":7,"ar":"قَبْلِكَ","en_gloss":"before you","transliteration":"qablika","verse_key":"16:63"},{"pos":8,"ar":"فَزَيَّنَ","en_gloss":"but made fair-seeming","transliteration":"fazayyana","verse_key":"16:63"},{"pos":9,"ar":"لَهُمُ","en_gloss":"to them","transliteration":"lahumu","verse_key":"16:63"},{"pos":10,"ar":"ٱلشَّيْطَـٰنُ","en_gloss":"the Shaitaan","transliteration":"l-shayṭānu","verse_key":"16:63"},{"pos":11,"ar":"أَعْمَـٰلَهُمْ","en_gloss":"their deeds","transliteration":"aʿmālahum","verse_key":"16:63"},{"pos":12,"ar":"فَهُوَ","en_gloss":"So he","transliteration":"fahuwa","verse_key":"16:63"},{"pos":13,"ar":"وَلِيُّهُمُ","en_gloss":"(is) their ally","transliteration":"waliyyuhumu","verse_key":"16:63"},{"pos":14,"ar":"ٱلْيَوْمَ","en_gloss":"today","transliteration":"l-yawma","verse_key":"16:63"},{"pos":15,"ar":"وَلَهُمْ","en_gloss":"and for them","transliteration":"walahum","verse_key":"16:63"},{"pos":16,"ar":"عَذَابٌ","en_gloss":"(is) a punishment","transliteration":"ʿadhābun","verse_key":"16:63"},{"pos":17,"ar":"أَلِيمٌۭ","en_gloss":"painful","transliteration":"alīmun","verse_key":"16:63"},{"pos":18,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"16:63"}]},{"verse_key":"16:64","surah":16,"ayah":64,"ar_uthmani":"وَمَآ أَنزَلْنَا عَلَيْكَ ٱلْكِتَـٰبَ إِلَّا لِتُبَيِّنَ لَهُمُ ٱلَّذِى ٱخْتَلَفُوا۟ فِيهِ ۙ وَهُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ","en_translation_id":85,"en":"We have sent down the Scripture to you only to make clear to them what they differ about, and as guidance and mercy to those who believe.","words":[{"pos":1,"ar":"وَمَآ","en_gloss":"And not","transliteration":"wamā","verse_key":"16:64"},{"pos":2,"ar":"أَنزَلْنَا","en_gloss":"We revealed","transliteration":"anzalnā","verse_key":"16:64"},{"pos":3,"ar":"عَلَيْكَ","en_gloss":"to you","transliteration":"ʿalayka","verse_key":"16:64"},{"pos":4,"ar":"ٱلْكِتَـٰبَ","en_gloss":"the Book","transliteration":"l-kitāba","verse_key":"16:64"},{"pos":5,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"16:64"},{"pos":6,"ar":"لِتُبَيِّنَ","en_gloss":"that you make clear","transliteration":"litubayyina","verse_key":"16:64"},{"pos":7,"ar":"لَهُمُ","en_gloss":"to them","transliteration":"lahumu","verse_key":"16:64"},{"pos":8,"ar":"ٱلَّذِى","en_gloss":"that which","transliteration":"alladhī","verse_key":"16:64"},{"pos":9,"ar":"ٱخْتَلَفُوا۟","en_gloss":"they differed","transliteration":"ikh'talafū","verse_key":"16:64"},{"pos":10,"ar":"فِيهِ ۙ","en_gloss":"in it","transliteration":"fīhi","verse_key":"16:64"},{"pos":11,"ar":"وَهُدًۭى","en_gloss":"and (as) a guidance","transliteration":"wahudan","verse_key":"16:64"},{"pos":12,"ar":"وَرَحْمَةًۭ","en_gloss":"and mercy","transliteration":"waraḥmatan","verse_key":"16:64"},{"pos":13,"ar":"لِّقَوْمٍۢ","en_gloss":"for a people","transliteration":"liqawmin","verse_key":"16