{"page":346,"verses":[{"verse_key":"23:60","surah":23,"ayah":60,"ar_uthmani":"وَٱلَّذِينَ يُؤْتُونَ مَآ ءَاتَوا۟ وَّقُلُوبُهُمْ وَجِلَةٌ أَنَّهُمْ إِلَىٰ رَبِّهِمْ رَٰجِعُونَ","en_translation_id":85,"en":"who always give with hearts that tremble at the thought that they must return to Him,","words":[{"pos":1,"ar":"وَٱلَّذِينَ","en_gloss":"And those who","transliteration":"wa-alladhīna","verse_key":"23:60"},{"pos":2,"ar":"يُؤْتُونَ","en_gloss":"give","transliteration":"yu'tūna","verse_key":"23:60"},{"pos":3,"ar":"مَآ","en_gloss":"what","transliteration":"mā","verse_key":"23:60"},{"pos":4,"ar":"ءَاتَوا۟","en_gloss":"they give","transliteration":"ātaw","verse_key":"23:60"},{"pos":5,"ar":"وَّقُلُوبُهُمْ","en_gloss":"while their hearts","transliteration":"waqulūbuhum","verse_key":"23:60"},{"pos":6,"ar":"وَجِلَةٌ","en_gloss":"(are) fearful","transliteration":"wajilatun","verse_key":"23:60"},{"pos":7,"ar":"أَنَّهُمْ","en_gloss":"because they","transliteration":"annahum","verse_key":"23:60"},{"pos":8,"ar":"إِلَىٰ","en_gloss":"to","transliteration":"ilā","verse_key":"23:60"},{"pos":9,"ar":"رَبِّهِمْ","en_gloss":"their Lord","transliteration":"rabbihim","verse_key":"23:60"},{"pos":10,"ar":"رَٰجِعُونَ","en_gloss":"(will) return","transliteration":"rājiʿūna","verse_key":"23:60"},{"pos":11,"ar":"٦٠","en_gloss":"(60)","transliteration":"","verse_key":"23:60"}]},{"verse_key":"23:61","surah":23,"ayah":61,"ar_uthmani":"أُو۟لَـٰٓئِكَ يُسَـٰرِعُونَ فِى ٱلْخَيْرَٰتِ وَهُمْ لَهَا سَـٰبِقُونَ","en_translation_id":85,"en":"are the ones who race toward good things, and they will be the first to get them.","words":[{"pos":1,"ar":"أُو۟لَـٰٓئِكَ","en_gloss":"(It is) those","transliteration":"ulāika","verse_key":"23:61"},{"pos":2,"ar":"يُسَـٰرِعُونَ","en_gloss":"who hasten","transliteration":"yusāriʿūna","verse_key":"23:61"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"23:61"},{"pos":4,"ar":"ٱلْخَيْرَٰتِ","en_gloss":"the good (deeds)","transliteration":"l-khayrāti"