مَا لَكُم مِّنْ إِلَـٰهٍ غَيْرُهُۥ ۖ قَدْ جَآءَتْكُم بَيِّنَةٌ مِّن رَّبِّكُمْ ۖ فَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَـٰحِهَا ۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُم مُّؤْمِنِينَ","en_translation_id":85,"en":"To the people of Midian We sent their brother, Shuayb. He said, ‘My people, serve God: you have no god other than Him. A clear sign has come to you from your Lord. Give full measure and weight and do not undervalue people’s goods; do not cause corruption in the land after it has been set in order: this is better for you, if you are believers.","words":[{"pos":1,"ar":"وَإِلَىٰ","en_gloss":"And to","transliteration":"wa-ilā","verse_key":"7:85"},{"pos":2,"ar":"مَدْيَنَ","en_gloss":"Madyan","transliteration":"madyana","verse_key":"7:85"},{"pos":3,"ar":"أَخَاهُمْ","en_gloss":"his brother","transliteration":"akhāhum","verse_key":"7:85"},{"pos":4,"ar":"شُعَيْبًۭا ۗ","en_gloss":"Shuaib","transliteration":"shuʿayban","verse_key":"7:85"},{"pos":5,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"7:85"},{"pos":6,"ar":"يَـٰقَوْمِ","en_gloss":"O my people","transliteration":"yāqawmi","verse_key":"7:85"},{"pos":7,"ar":"ٱعْبُدُوا۟","en_gloss":"Worship","transliteration":"uʿ'budū","verse_key":"7:85"},{"pos":8,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"7:85"},{"pos":9,"ar":"مَا","en_gloss":"not","transliteration":"mā","verse_key":"7:85"},{"pos":10,"ar":"لَكُم","en_gloss":"for you","transliteration":"lakum","verse_key":"7:85"},{"pos":11,"ar":"مِّنْ","en_gloss":"any","transliteration":"min","verse_key":"7:85"},{"pos":12,"ar":"إِلَـٰهٍ","en_gloss":"god","transliteration":"ilāhin","verse_key":"7:85"},{"pos":13,"ar":"غَيْرُهُۥ ۖ","en_gloss":"other than Him","transliteration":"ghayruhu","verse_key":"7:85"},{"pos":14,"ar":"قَدْ","en_gloss":"Verily","transliteration":"qad","verse_key":"7:85"},{"pos":15,"ar":"جَآءَتْكُم","en_gloss":"has came to you",