{"page":596,"verses":[{"verse_key":"92:10","surah":92,"ayah":10,"ar_uthmani":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","en_translation_id":85,"en":"We shall smooth his way towards hardship","words":[{"pos":1,"ar":"فَسَنُيَسِّرُهُۥ","en_gloss":"Then We will ease him","transliteration":"fasanuyassiruhu","verse_key":"92:10"},{"pos":2,"ar":"لِلْعُسْرَىٰ","en_gloss":"towards [the] difficulty","transliteration":"lil'ʿus'rā","verse_key":"92:10"},{"pos":3,"ar":"١٠","en_gloss":"(10)","transliteration":"","verse_key":"92:10"}]},{"verse_key":"92:11","surah":92,"ayah":11,"ar_uthmani":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","en_translation_id":85,"en":"and his wealth will not help him as he falls.","words":[{"pos":1,"ar":"وَمَا","en_gloss":"And not","transliteration":"wamā","verse_key":"92:11"},{"pos":2,"ar":"يُغْنِى","en_gloss":"will avail","transliteration":"yugh'nī","verse_key":"92:11"},{"pos":3,"ar":"عَنْهُ","en_gloss":"him","transliteration":"ʿanhu","verse_key":"92:11"},{"pos":4,"ar":"مَالُهُۥٓ","en_gloss":"his wealth","transliteration":"māluhu","verse_key":"92:11"},{"pos":5,"ar":"إِذَا","en_gloss":"when","transliteration":"idhā","verse_key":"92:11"},{"pos":6,"ar":"تَرَدَّىٰٓ","en_gloss":"he falls","transliteration":"taraddā","verse_key":"92:11"},{"pos":7,"ar":"١١","en_gloss":"(11)","transliteration":"","verse_key":"92:11"}]},{"verse_key":"92:12","surah":92,"ayah":12,"ar_uthmani":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","en_translation_id":85,"en":"Our part is to provide guidance––","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"92:12"},{"pos":2,"ar":"عَلَيْنَا","en_gloss":"upon Us","transliteration":"ʿalaynā","verse_key":"92:12"},{"pos":3,"ar":"لَلْهُدَىٰ","en_gloss":"(is) the guidance","transliteration":"lalhudā","verse_key":"92:12"},{"pos":4,"ar":"١٢","en_gloss":"(12)","transliteration":"","verse_key":"92:12"}]},{"verse_key":"92:13","surah":92,"ayah":13,"ar_uthmani":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","en_translation_id":85,"en":"thi