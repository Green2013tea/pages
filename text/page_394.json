َ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ","en_translation_id":85,"en":"We shall call a witness from every community, and say, ‘Produce your evidence,’ and then they will know that truth belongs to God alone; the gods they invented will forsake them.","words":[{"pos":1,"ar":"وَنَزَعْنَا","en_gloss":"And We will draw forth","transliteration":"wanazaʿnā","verse_key":"28:75"},{"pos":2,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"28:75"},{"pos":3,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"28:75"},{"pos":4,"ar":"أُمَّةٍۢ","en_gloss":"nation","transliteration":"ummatin","verse_key":"28:75"},{"pos":5,"ar":"شَهِيدًۭا","en_gloss":"a witness","transliteration":"shahīdan","verse_key":"28:75"},{"pos":6,"ar":"فَقُلْنَا","en_gloss":"and We will say","transliteration":"faqul'nā","verse_key":"28:75"},{"pos":7,"ar":"هَاتُوا۟","en_gloss":"Bring","transliteration":"hātū","verse_key":"28:75"},{"pos":8,"ar":"بُرْهَـٰنَكُمْ","en_gloss":"your proof","transliteration":"bur'hānakum","verse_key":"28:75"},{"pos":9,"ar":"فَعَلِمُوٓا۟","en_gloss":"Then they will know","transliteration":"faʿalimū","verse_key":"28:75"},{"pos":10,"ar":"أَنَّ","en_gloss":"that","transliteration":"anna","verse_key":"28:75"},{"pos":11,"ar":"ٱلْحَقَّ","en_gloss":"the truth","transliteration":"l-ḥaqa","verse_key":"28:75"},{"pos":12,"ar":"لِلَّهِ","en_gloss":"(is) for Allah","transliteration":"lillahi","verse_key":"28:75"},{"pos":13,"ar":"وَضَلَّ","en_gloss":"and (will be) lost","transliteration":"waḍalla","verse_key":"28:75"},{"pos":14,"ar":"عَنْهُم","en_gloss":"from them","transliteration":"ʿanhum","verse_key":"28:75"},{"pos":15,"ar":"مَّا","en_gloss":"what","transliteration":"mā","verse_key":"28:75"},{"pos":16,"ar":"كَانُوا۟","en_gloss":"they used (to)","transliteration":"kānū","verse_key":"28:75"},{"pos":17,"ar":"يَفْتَرُونَ","en_gloss":"invent","transliteration":"yaftarūna","verse_key":"28:75"},{"pos":18,"ar":"٧٥","en_gloss":"(75)","transliteration":"","verse_key":"28:75"}]},{"verse_key":"28:76","surah":28,"ayah":76,"ar_uthmani":"۞ إِنَّ قَـٰرُونَ كَانَ مِن قَوْمِ مُوسَىٰ فَبَغَىٰ عَلَيْهِمْ ۖ وَءَاتَيْنَـٰهُ مِنَ ٱلْكُنُوزِ مَآ إِنَّ مَفَاتِحَهُۥ لَتَنُوٓأُ بِٱلْعُصْبَةِ أُو۟لِى ٱلْقُوَّةِ إِذْ قَالَ لَهُۥ قَوْمُهُۥ لَا تَفْرَحْ ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْفَرِحِينَ","en_translation_id":85,"en":"Qarun was one of Moses’ people, but he oppressed them. We had given him such treasures that even their keys would have weighed down a whole company of strong men. His people said to him, ‘Do not gloat, for God does not like people who gloat.","words":[{"pos":1,"ar":"۞ إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"28:76"},{"pos":2,"ar":"قَـٰرُونَ","en_gloss":"Qarun","transliteration":"qārūna","verse_key":"28:76"},{"pos":3,"ar":"كَانَ","en_gloss":"was","transliteration":"kāna","verse_key":"28:76"},{"pos":4,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"28:76"},{"pos":5,"ar":"قَوْمِ","en_gloss":"(the) people","transliteration":"qawmi","verse_key":"28:76"},{"pos":6,"ar":"مُوسَىٰ","en_gloss":"(of) Musa","transliteration":"mūsā","verse_key":"28:76"},{"pos":7,"ar":"فَبَغَىٰ","en_gloss":"but he oppressed","transliteration":"fabaghā","verse_key":"28:76"},{"pos":8,"ar":"عَلَيْهِمْ ۖ","en_gloss":"[on] them","transliteration":"ʿalayhim","verse_key":"28:76"},{"pos":9,"ar":"وَءَاتَيْنَـٰهُ","en_gloss":"And We gave him","transliteration":"waātaynāhu","verse_key":"28:76"},{"pos":10,"ar":"مِنَ","en_gloss":"of","transliteration":"mina","verse_key":"28:76"},{"pos":11,"ar":"ٱلْكُنُوزِ","en_gloss":"the treasures","transliteration":"l-kunūzi","verse_key":"28:76"},{"pos":12,"ar":"مَآ","en_gloss":"which","transliteration":"mā","verse_key":"28:76"},{"pos":13,"ar":"إِنَّ","en_gloss":"indeed","transliteration":"inna","verse_key":"28:76"},{"pos":14,"ar":"مَفَاتِحَهُۥ","en_gloss":"(the) keys of it","transliteration":"mafātiḥahu","verse_key":"28:76"},{"pos":15,"ar":"لَتَنُوٓأُ","en_gloss":"would burden","transliteration":"latanū