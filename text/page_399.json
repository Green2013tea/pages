pos":23,"ar":"ٱلصَّـٰدِقِينَ","en_gloss":"the truthful","transliteration":"l-ṣādiqīna","verse_key":"29:29"},{"pos":24,"ar":"٢٩","en_gloss":"(29)","transliteration":"","verse_key":"29:29"}]},{"verse_key":"29:30","surah":29,"ayah":30,"ar_uthmani":"قَالَ رَبِّ ٱنصُرْنِى عَلَى ٱلْقَوْمِ ٱلْمُفْسِدِينَ","en_translation_id":85,"en":"So he prayed, ‘My Lord, help me against these people who spread corruption.’","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"29:30"},{"pos":2,"ar":"رَبِّ","en_gloss":"My Lord","transliteration":"rabbi","verse_key":"29:30"},{"pos":3,"ar":"ٱنصُرْنِى","en_gloss":"Help me","transliteration":"unṣur'nī","verse_key":"29:30"},{"pos":4,"ar":"عَلَى","en_gloss":"against","transliteration":"ʿalā","verse_key":"29:30"},{"pos":5,"ar":"ٱلْقَوْمِ","en_gloss":"the people","transliteration":"l-qawmi","verse_key":"29:30"},{"pos":6,"ar":"ٱلْمُفْسِدِينَ","en_gloss":"the corrupters","transliteration":"l-muf'sidīna","verse_key":"29:30"},{"pos":7,"ar":"٣٠","en_gloss":"(30)","transliteration":"","verse_key":"29:30"}]}]}