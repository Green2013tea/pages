ation":"l-raḥmāni","verse_key":"67:3"},{"pos":11,"ar":"مِن","en_gloss":"any","transliteration":"min","verse_key":"67:3"},{"pos":12,"ar":"تَفَـٰوُتٍۢ ۖ","en_gloss":"fault","transliteration":"tafāwutin","verse_key":"67:3"},{"pos":13,"ar":"فَٱرْجِعِ","en_gloss":"So return","transliteration":"fa-ir'jiʿi","verse_key":"67:3"},{"pos":14,"ar":"ٱلْبَصَرَ","en_gloss":"the vision","transliteration":"l-baṣara","verse_key":"67:3"},{"pos":15,"ar":"هَلْ","en_gloss":"can","transliteration":"hal","verse_key":"67:3"},{"pos":16,"ar":"تَرَىٰ","en_gloss":"you see","transliteration":"tarā","verse_key":"67:3"},{"pos":17,"ar":"مِن","en_gloss":"any","transliteration":"min","verse_key":"67:3"},{"pos":18,"ar":"فُطُورٍۢ","en_gloss":"flaw","transliteration":"fuṭūrin","verse_key":"67:3"},{"pos":19,"ar":"٣","en_gloss":"(3)","transliteration":"","verse_key":"67:3"}]},{"verse_key":"67:4","surah":67,"ayah":4,"ar_uthmani":"ثُمَّ ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ","en_translation_id":85,"en":"Look again! And again! Your sight will turn back to you, weak and defeated.","words":[{"pos":1,"ar":"ثُمَّ","en_gloss":"Then","transliteration":"thumma","verse_key":"67:4"},{"pos":2,"ar":"ٱرْجِعِ","en_gloss":"return","transliteration":"ir'jiʿi","verse_key":"67:4"},{"pos":3,"ar":"ٱلْبَصَرَ","en_gloss":"the vision","transliteration":"l-baṣara","verse_key":"67:4"},{"pos":4,"ar":"كَرَّتَيْنِ","en_gloss":"twice (again)","transliteration":"karratayni","verse_key":"67:4"},{"pos":5,"ar":"يَنقَلِبْ","en_gloss":"Will return","transliteration":"yanqalib","verse_key":"67:4"},{"pos":6,"ar":"إِلَيْكَ","en_gloss":"to you","transliteration":"ilayka","verse_key":"67:4"},{"pos":7,"ar":"ٱلْبَصَرُ","en_gloss":"the vision","transliteration":"l-baṣaru","verse_key":"67:4"},{"pos":8,"ar":"خَاسِئًۭا","en_gloss":"humbled","transliteration":"khāsi-an","verse_key":"67:4"},{"pos":9,"ar":"وَهُوَ","en_gloss":"while it","transliteration":"wahuwa","verse_key":"67:4"},{"pos":10,"ar":"حَسِيرٌۭ","en_gloss":"(is) fatigued","transliteration":"ḥasīrun","verse_key":"67:4"},{"pos":11,"ar":"٤","en_gloss":"(4)","transliteration":"","verse_key":"67:4"}]},{"verse_key":"67:5","surah":67,"ayah":5,"ar_uthmani":"وَلَقَدْ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ وَجَعَلْنَـٰهَا رُجُومًا لِّلشَّيَـٰطِينِ ۖ وَأَعْتَدْنَا لَهُمْ عَذَابَ ٱلسَّعِيرِ","en_translation_id":85,"en":"We have adorned the lowest heaven with lamps and made them [missiles] for stoning devils for whom We have also prepared the torment of a blazing fire.","words":[{"pos":1,"ar":"وَلَقَدْ","en_gloss":"And certainly","transliteration":"walaqad","verse_key":"67:5"},{"pos":2,"ar":"زَيَّنَّا","en_gloss":"We have beautified","transliteration":"zayyannā","verse_key":"67:5"},{"pos":3,"ar":"ٱلسَّمَآءَ","en_gloss":"the heaven","transliteration":"l-samāa","verse_key":"67:5"},{"pos":4,"ar":"ٱلدُّنْيَا","en_gloss":"nearest","transliteration":"l-dun'yā","verse_key":"67:5"},{"pos":5,"ar":"بِمَصَـٰبِيحَ","en_gloss":"with lamps","transliteration":"bimaṣābīḥa","verse_key":"67:5"},{"pos":6,"ar":"وَجَعَلْنَـٰهَا","en_gloss":"and We have made them","transliteration":"wajaʿalnāhā","verse_key":"67:5"},{"pos":7,"ar":"رُجُومًۭا","en_gloss":"(as) missiles","transliteration":"rujūman","verse_key":"67:5"},{"pos":8,"ar":"لِّلشَّيَـٰطِينِ ۖ","en_gloss":"for the devils","transliteration":"lilshayāṭīni","verse_key":"67:5"},{"pos":9,"ar":"وَأَعْتَدْنَا","en_gloss":"and We have prepared","transliteration":"wa-aʿtadnā","verse_key":"67:5"},{"pos":10,"ar":"لَهُمْ","en_gloss":"for them","transliteration":"lahum","verse_key":"67:5"},{"pos":11,"ar":"عَذَابَ","en_gloss":"punishment","transliteration":"ʿadhāba","verse_key":"67:5"},{"pos":12,"ar":"ٱلسَّعِيرِ","en_gloss":"(of) the Blaze","transliteration":"l-saʿīri","verse_key":"67:5"},{"pos":13,"ar":"٥","en_gloss":"(5)","transliteration":"","verse_key":"67:5"}]},{"verse_key":"67:6","surah":67,"ayah":6,"ar_uthmani":"وَلِلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ عَذَابُ جَهَنَّمَ ۖ وَبِئْسَ ٱلْمَصِيرُ","e