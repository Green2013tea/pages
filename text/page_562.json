{"page":562,"verses":[{"verse_key":"67:1","surah":67,"ayah":1,"ar_uthmani":" تَبَـٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","en_translation_id":85,"en":"Exalted is He who holds all control in His hands; who has power over all things;","words":[{"pos":1,"ar":"تَبَـٰرَكَ","en_gloss":"Blessed is","transliteration":"tabāraka","verse_key":"67:1"},{"pos":2,"ar":"ٱلَّذِى","en_gloss":"He","transliteration":"alladhī","verse_key":"67:1"},{"pos":3,"ar":"بِيَدِهِ","en_gloss":"in Whose Hand","transliteration":"biyadihi","verse_key":"67:1"},{"pos":4,"ar":"ٱلْمُلْكُ","en_gloss":"(is) the Dominion","transliteration":"l-mul'ku","verse_key":"67:1"},{"pos":5,"ar":"وَهُوَ","en_gloss":"and He","transliteration":"wahuwa","verse_key":"67:1"},{"pos":6,"ar":"عَلَىٰ","en_gloss":"(is) over","transliteration":"ʿalā","verse_key":"67:1"},{"pos":7,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"67:1"},{"pos":8,"ar":"شَىْءٍۢ","en_gloss":"thing","transliteration":"shayin","verse_key":"67:1"},{"pos":9,"ar":"قَدِيرٌ","en_gloss":"All-Powerful","transliteration":"qadīrun","verse_key":"67:1"},{"pos":10,"ar":"١","en_gloss":"(1)","transliteration":"","verse_key":"67:1"}]},{"verse_key":"67:2","surah":67,"ayah":2,"ar_uthmani":"ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ","en_translation_id":85,"en":"who created death and life to test you [people] and reveal which of you does best––He is the Mighty, the Forgiving;","words":[{"pos":1,"ar":"ٱلَّذِى","en_gloss":"The One Who","transliteration":"alladhī","verse_key":"67:2"},{"pos":2,"ar":"خَلَقَ","en_gloss":"created","transliteration":"khalaqa","verse_key":"67:2"},{"pos":3,"ar":"ٱلْمَوْتَ","en_gloss":"death","transliteration":"l-mawta","verse_key":"67:2"},{"pos":4,"ar":"وَٱلْحَيَوٰةَ","en_gloss":"and life","transliteration":"wal-ḥayata","verse_key":"67:2"},{"pos":5,"ar":"لِيَبْلُوَكُمْ","en_gloss":"that He may test you","transliteration":"liyabluw