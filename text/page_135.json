_gloss":"If","transliteration":"la-in","verse_key":"6:63"},{"pos":12,"ar":"أَنجَىٰنَا","en_gloss":"He saves us","transliteration":"anjānā","verse_key":"6:63"},{"pos":13,"ar":"مِنْ","en_gloss":"from","transliteration":"min","verse_key":"6:63"},{"pos":14,"ar":"هَـٰذِهِۦ","en_gloss":"this","transliteration":"hādhihi","verse_key":"6:63"},{"pos":15,"ar":"لَنَكُونَنَّ","en_gloss":"surely we will be","transliteration":"lanakūnanna","verse_key":"6:63"},{"pos":16,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"6:63"},{"pos":17,"ar":"ٱلشَّـٰكِرِينَ","en_gloss":"the grateful ones","transliteration":"l-shākirīna","verse_key":"6:63"},{"pos":18,"ar":"٦٣","en_gloss":"(63)","transliteration":"","verse_key":"6:63"}]},{"verse_key":"6:64","surah":6,"ayah":64,"ar_uthmani":"قُلِ ٱللَّهُ يُنَجِّيكُم مِّنْهَا وَمِن كُلِّ كَرْبٍ ثُمَّ أَنتُمْ تُشْرِكُونَ","en_translation_id":85,"en":"Say, ‘God rescues you from this and every distress; yet still you worship others beside Him.’","words":[{"pos":1,"ar":"قُلِ","en_gloss":"Say","transliteration":"quli","verse_key":"6:64"},{"pos":2,"ar":"ٱللَّهُ","en_gloss":"Allah","transliteration":"l-lahu","verse_key":"6:64"},{"pos":3,"ar":"يُنَجِّيكُم","en_gloss":"saves you","transliteration":"yunajjīkum","verse_key":"6:64"},{"pos":4,"ar":"مِّنْهَا","en_gloss":"from it","transliteration":"min'hā","verse_key":"6:64"},{"pos":5,"ar":"وَمِن","en_gloss":"and from","transliteration":"wamin","verse_key":"6:64"},{"pos":6,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"6:64"},{"pos":7,"ar":"كَرْبٍۢ","en_gloss":"distress","transliteration":"karbin","verse_key":"6:64"},{"pos":8,"ar":"ثُمَّ","en_gloss":"yet","transliteration":"thumma","verse_key":"6:64"},{"pos":9,"ar":"أَنتُمْ","en_gloss":"you","transliteration":"antum","verse_key":"6:64"},{"pos":10,"ar":"تُشْرِكُونَ","en_gloss":"associate partners (with Allah)","transliteration":"tush'rikūna","verse_key":"6:64"},{"pos":11,"ar":"٦٤","en_gloss":"(64)","transliteration":"","verse_