_key":"22:14","surah":22,"ayah":14,"ar_uthmani":"إِنَّ ٱللَّهَ يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ إِنَّ ٱللَّهَ يَفْعَلُ مَا يُرِيدُ","en_translation_id":85,"en":"But God will admit those who believe and do good deeds to Gardens graced with flowing streams. God does whatever He wishes.","words":[{"pos":1,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"22:14"},{"pos":2,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"22:14"},{"pos":3,"ar":"يُدْخِلُ","en_gloss":"will admit","transliteration":"yud'khilu","verse_key":"22:14"},{"pos":4,"ar":"ٱلَّذِينَ","en_gloss":"those who","transliteration":"alladhīna","verse_key":"22:14"},{"pos":5,"ar":"ءَامَنُوا۟","en_gloss":"believe","transliteration":"āmanū","verse_key":"22:14"},{"pos":6,"ar":"وَعَمِلُوا۟","en_gloss":"and do","transliteration":"waʿamilū","verse_key":"22:14"},{"pos":7,"ar":"ٱلصَّـٰلِحَـٰتِ","en_gloss":"the righteous deeds","transliteration":"l-ṣāliḥāti","verse_key":"22:14"},{"pos":8,"ar":"جَنَّـٰتٍۢ","en_gloss":"(to) Gardens","transliteration":"jannātin","verse_key":"22:14"},{"pos":9,"ar":"تَجْرِى","en_gloss":"flow","transliteration":"tajrī","verse_key":"22:14"},{"pos":10,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"22:14"},{"pos":11,"ar":"تَحْتِهَا","en_gloss":"underneath it","transliteration":"taḥtihā","verse_key":"22:14"},{"pos":12,"ar":"ٱلْأَنْهَـٰرُ ۚ","en_gloss":"the rivers","transliteration":"l-anhāru","verse_key":"22:14"},{"pos":13,"ar":"إِنَّ","en_gloss":"Indeed","transliteration":"inna","verse_key":"22:14"},{"pos":14,"ar":"ٱللَّهَ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"22:14"},{"pos":15,"ar":"يَفْعَلُ","en_gloss":"does","transliteration":"yafʿalu","verse_key":"22:14"},{"pos":16,"ar":"مَا","en_gloss":"what","transliteration":"mā","verse_key":"22:14"},{"pos":17,"ar":"يُرِيدُ","en_gloss":"He intends","transliteration":"yurīdu","verse_key":"22:14"},{"p