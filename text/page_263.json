ation":"kulli","verse_key":"15:19"},{"pos":10,"ar":"شَىْءٍۢ","en_gloss":"thing","transliteration":"shayin","verse_key":"15:19"},{"pos":11,"ar":"مَّوْزُونٍۢ","en_gloss":"well-balanced","transliteration":"mawzūnin","verse_key":"15:19"},{"pos":12,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"15:19"}]},{"verse_key":"15:20","surah":15,"ayah":20,"ar_uthmani":"وَجَعَلْنَا لَكُمْ فِيهَا مَعَـٰيِشَ وَمَن لَّسْتُمْ لَهُۥ بِرَٰزِقِينَ","en_translation_id":85,"en":"We have provided sustenance in it for you and for all those creatures for whom you do not provide.","words":[{"pos":1,"ar":"وَجَعَلْنَا","en_gloss":"And We have made","transliteration":"wajaʿalnā","verse_key":"15:20"},{"pos":2,"ar":"لَكُمْ","en_gloss":"for you","transliteration":"lakum","verse_key":"15:20"},{"pos":3,"ar":"فِيهَا","en_gloss":"therein","transliteration":"fīhā","verse_key":"15:20"},{"pos":4,"ar":"مَعَـٰيِشَ","en_gloss":"means of living","transliteration":"maʿāyisha","verse_key":"15:20"},{"pos":5,"ar":"وَمَن","en_gloss":"and whom","transliteration":"waman","verse_key":"15:20"},{"pos":6,"ar":"لَّسْتُمْ","en_gloss":"you are not","transliteration":"lastum","verse_key":"15:20"},{"pos":7,"ar":"لَهُۥ","en_gloss":"for him","transliteration":"lahu","verse_key":"15:20"},{"pos":8,"ar":"بِرَٰزِقِينَ","en_gloss":"providers","transliteration":"birāziqīna","verse_key":"15:20"},{"pos":9,"ar":"٢٠","en_gloss":"(20)","transliteration":"","verse_key":"15:20"}]},{"verse_key":"15:21","surah":15,"ayah":21,"ar_uthmani":"وَإِن مِّن شَىْءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٍ مَّعْلُومٍ","en_translation_id":85,"en":"There is not a thing whose storehouses are not with Us. We send it down only according to a well-defined measure:","words":[{"pos":1,"ar":"وَإِن","en_gloss":"And not","transliteration":"wa-in","verse_key":"15:21"},{"pos":2,"ar":"مِّن","en_gloss":"(is) any","transliteration":"min","verse_key":"15:21"},{"pos":3,"ar":"شَىْءٍ","en_gloss":"thing","transliteration":"shayin","verse_key":"15:21"},{"pos":4,"ar":"إِلَّا","en_gloss":"but","transliteration":"illā","verse_key":"15:21"},{"pos":5,"ar":"عِندَنَا","en_gloss":"with Us","transliteration":"ʿindanā","verse_key":"15:21"},{"pos":6,"ar":"خَزَآئِنُهُۥ","en_gloss":"(are) its treasures","transliteration":"khazāinuhu","verse_key":"15:21"},{"pos":7,"ar":"وَمَا","en_gloss":"and not","transliteration":"wamā","verse_key":"15:21"},{"pos":8,"ar":"نُنَزِّلُهُۥٓ","en_gloss":"We send it down","transliteration":"nunazziluhu","verse_key":"15:21"},{"pos":9,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"15:21"},{"pos":10,"ar":"بِقَدَرٍۢ","en_gloss":"in a measure","transliteration":"biqadarin","verse_key":"15:21"},{"pos":11,"ar":"مَّعْلُومٍۢ","en_gloss":"known","transliteration":"maʿlūmin","verse_key":"15:21"},{"pos":12,"ar":"٢١","en_gloss":"(21)","transliteration":"","verse_key":"15:21"}]},{"verse_key":"15:22","surah":15,"ayah":22,"ar_uthmani":"وَأَرْسَلْنَا ٱلرِّيَـٰحَ لَوَٰقِحَ فَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءً فَأَسْقَيْنَـٰكُمُوهُ وَمَآ أَنتُمْ لَهُۥ بِخَـٰزِنِينَ","en_translation_id":85,"en":"We send the winds to fertilize, and We bring down water from the sky for you to drink- you do not control its sources.","words":[{"pos":1,"ar":"وَأَرْسَلْنَا","en_gloss":"And We have sent","transliteration":"wa-arsalnā","verse_key":"15:22"},{"pos":2,"ar":"ٱلرِّيَـٰحَ","en_gloss":"the winds","transliteration":"l-riyāḥa","verse_key":"15:22"},{"pos":3,"ar":"لَوَٰقِحَ","en_gloss":"fertilizing","transliteration":"lawāqiḥa","verse_key":"15:22"},{"pos":4,"ar":"فَأَنزَلْنَا","en_gloss":"and We sent down","transliteration":"fa-anzalnā","verse_key":"15:22"},{"pos":5,"ar":"مِنَ","en_gloss":"from","transliteration":"mina","verse_key":"15:22"},{"pos":6,"ar":"ٱلسَّمَآءِ","en_gloss":"the sky","transliteration":"l-samāi","verse_key":"15:22"},{"pos":7,"ar":"مَآءًۭ","en_gloss":"water","transliteration":"māan","verse_key":"15:22"},{"pos":8,"ar":"فَأَسْقَيْنَـٰكُمُوهُ","en_gloss":"and We gave it to you