{"page":263,"verses":[{"verse_key":"15:16","surah":15,"ayah":16,"ar_uthmani":"وَلَقَدْ جَعَلْنَا فِى ٱلسَّمَآءِ بُرُوجًا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ","en_translation_id":85,"en":"We have set constellations up in the sky and made it beautiful for all to see,","words":[{"pos":1,"ar":"وَلَقَدْ","en_gloss":"And verily","transliteration":"walaqad","verse_key":"15:16"},{"pos":2,"ar":"جَعَلْنَا","en_gloss":"We have placed","transliteration":"jaʿalnā","verse_key":"15:16"},{"pos":3,"ar":"فِى","en_gloss":"in","transliteration":"fī","verse_key":"15:16"},{"pos":4,"ar":"ٱلسَّمَآءِ","en_gloss":"the heavens","transliteration":"l-samāi","verse_key":"15:16"},{"pos":5,"ar":"بُرُوجًۭا","en_gloss":"constellations","transliteration":"burūjan","verse_key":"15:16"},{"pos":6,"ar":"وَزَيَّنَّـٰهَا","en_gloss":"and We have beautified it","transliteration":"wazayyannāhā","verse_key":"15:16"},{"pos":7,"ar":"لِلنَّـٰظِرِينَ","en_gloss":"for the observers","transliteration":"lilnnāẓirīna","verse_key":"15:16"},{"pos":8,"ar":"١٦","en_gloss":"(16)","transliteration":"","verse_key":"15:16"}]},{"verse_key":"15:17","surah":15,"ayah":17,"ar_uthmani":"وَحَفِظْنَـٰهَا مِن كُلِّ شَيْطَـٰنٍ رَّجِيمٍ","en_translation_id":85,"en":"and guarded it from every stoned satan:","words":[{"pos":1,"ar":"وَحَفِظْنَـٰهَا","en_gloss":"And We have protected it","transliteration":"waḥafiẓ'nāhā","verse_key":"15:17"},{"pos":2,"ar":"مِن","en_gloss":"from","transliteration":"min","verse_key":"15:17"},{"pos":3,"ar":"كُلِّ","en_gloss":"every","transliteration":"kulli","verse_key":"15:17"},{"pos":4,"ar":"شَيْطَـٰنٍۢ","en_gloss":"devil","transliteration":"shayṭānin","verse_key":"15:17"},{"pos":5,"ar":"رَّجِيمٍ","en_gloss":"accursed","transliteration":"rajīmin","verse_key":"15:17"},{"pos":6,"ar":"١٧","en_gloss":"(17)","transliteration":"","verse_key":"15:17"}]},{"verse_key":"15:18","surah":15,"ayah":18,"ar_uthmani":"إِلَّا مَنِ ٱسْتَرَقَ ٱلسَّمْعَ فَأَتْبَعَهُۥ شِهَابٌ مُّبِينٌ","en_translation_id":85,"en":"any eavesdropper 