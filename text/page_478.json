هِۦ كَـٰفِرُونَ","en_translation_id":85,"en":"when their messengers came to them, from all angles, saying, “Serve no one but God,” they said, “If our Lord had wished, He would have sent down angels. We do not believe in the message with which you have been sent.”","words":[{"pos":1,"ar":"إِذْ","en_gloss":"When","transliteration":"idh","verse_key":"41:14"},{"pos":2,"ar":"جَآءَتْهُمُ","en_gloss":"came to them","transliteration":"jāathumu","verse_key":"41:14"},{"pos":3,"ar":"ٱلرُّسُلُ","en_gloss":"the Messengers","transliteration":"l-rusulu","verse_key":"41:14"},{"pos":4,"ar":"مِنۢ","en_gloss":"from before them","transliteration":"min","verse_key":"41:14"},{"pos":5,"ar":"بَيْنِ","en_gloss":"from before them","transliteration":"bayni","verse_key":"41:14"},{"pos":6,"ar":"أَيْدِيهِمْ","en_gloss":"from before them","transliteration":"aydīhim","verse_key":"41:14"},{"pos":7,"ar":"وَمِنْ","en_gloss":"and from","transliteration":"wamin","verse_key":"41:14"},{"pos":8,"ar":"خَلْفِهِمْ","en_gloss":"behind them","transliteration":"khalfihim","verse_key":"41:14"},{"pos":9,"ar":"أَلَّا","en_gloss":"(saying) \"Do not","transliteration":"allā","verse_key":"41:14"},{"pos":10,"ar":"تَعْبُدُوٓا۟","en_gloss":"worship","transliteration":"taʿbudū","verse_key":"41:14"},{"pos":11,"ar":"إِلَّا","en_gloss":"except","transliteration":"illā","verse_key":"41:14"},{"pos":12,"ar":"ٱللَّهَ ۖ","en_gloss":"Allah","transliteration":"l-laha","verse_key":"41:14"},{"pos":13,"ar":"قَالُوا۟","en_gloss":"They said","transliteration":"qālū","verse_key":"41:14"},{"pos":14,"ar":"لَوْ","en_gloss":"If","transliteration":"law","verse_key":"41:14"},{"pos":15,"ar":"شَآءَ","en_gloss":"(had) willed","transliteration":"shāa","verse_key":"41:14"},{"pos":16,"ar":"رَبُّنَا","en_gloss":"our Lord","transliteration":"rabbunā","verse_key":"41:14"},{"pos":17,"ar":"لَأَنزَلَ","en_gloss":"surely, He (would have) sent down","transliteration":"la-anzala","verse_key":"41:14"},{"pos":18,"ar":"مَلَـٰٓئِكَةًۭ","en_gloss":"Angels","tr