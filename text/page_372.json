{"page":372,"verses":[{"verse_key":"26:112","surah":26,"ayah":112,"ar_uthmani":"قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ","en_translation_id":85,"en":"He said, ‘What knowledge do I have of what they used to do?","words":[{"pos":1,"ar":"قَالَ","en_gloss":"He said","transliteration":"qāla","verse_key":"26:112"},{"pos":2,"ar":"وَمَا","en_gloss":"And what","transliteration":"wamā","verse_key":"26:112"},{"pos":3,"ar":"عِلْمِى","en_gloss":"(do) I know","transliteration":"ʿil'mī","verse_key":"26:112"},{"pos":4,"ar":"بِمَا","en_gloss":"of what","transliteration":"bimā","verse_key":"26:112"},{"pos":5,"ar":"كَانُوا۟","en_gloss":"they used","transliteration":"kānū","verse_key":"26:112"},{"pos":6,"ar":"يَعْمَلُونَ","en_gloss":"(to) do","transliteration":"yaʿmalūna","verse_key":"26:112"},{"pos":7,"ar":"١١٢","en_gloss":"(112)","transliteration":"","verse_key":"26:112"}]},{"verse_key":"26:113","surah":26,"ayah":113,"ar_uthmani":"إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى ۖ لَوْ تَشْعُرُونَ","en_translation_id":85,"en":"It is for my Lord alone to bring them to account- if only you could see-","words":[{"pos":1,"ar":"إِنْ","en_gloss":"Verily","transliteration":"in","verse_key":"26:113"},{"pos":2,"ar":"حِسَابُهُمْ","en_gloss":"their account","transliteration":"ḥisābuhum","verse_key":"26:113"},{"pos":3,"ar":"إِلَّا","en_gloss":"(is) but","transliteration":"illā","verse_key":"26:113"},{"pos":4,"ar":"عَلَىٰ","en_gloss":"upon","transliteration":"ʿalā","verse_key":"26:113"},{"pos":5,"ar":"رَبِّى ۖ","en_gloss":"my Lord","transliteration":"rabbī","verse_key":"26:113"},{"pos":6,"ar":"لَوْ","en_gloss":"if","transliteration":"law","verse_key":"26:113"},{"pos":7,"ar":"تَشْعُرُونَ","en_gloss":"you perceive","transliteration":"tashʿurūna","verse_key":"26:113"},{"pos":8,"ar":"١١٣","en_gloss":"(113)","transliteration":"","verse_key":"26:113"}]},{"verse_key":"26:114","surah":26,"ayah":114,"ar_uthmani":"وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ","en_translation_id":85,"en":"I will not drive believers a