:"ٱلَّذِينَ","en_gloss":"Those who","transliteration":"alladhīna","verse_key":"11:19"},{"pos":2,"ar":"يَصُدُّونَ","en_gloss":"hinder","transliteration":"yaṣuddūna","verse_key":"11:19"},{"pos":3,"ar":"عَن","en_gloss":"from","transliteration":"ʿan","verse_key":"11:19"},{"pos":4,"ar":"سَبِيلِ","en_gloss":"(the) way","transliteration":"sabīli","verse_key":"11:19"},{"pos":5,"ar":"ٱللَّهِ","en_gloss":"(of) Allah","transliteration":"l-lahi","verse_key":"11:19"},{"pos":6,"ar":"وَيَبْغُونَهَا","en_gloss":"and seek (in) it","transliteration":"wayabghūnahā","verse_key":"11:19"},{"pos":7,"ar":"عِوَجًۭا","en_gloss":"crookedness","transliteration":"ʿiwajan","verse_key":"11:19"},{"pos":8,"ar":"وَهُم","en_gloss":"while they","transliteration":"wahum","verse_key":"11:19"},{"pos":9,"ar":"بِٱلْـَٔاخِرَةِ","en_gloss":"in the Hereafter","transliteration":"bil-ākhirati","verse_key":"11:19"},{"pos":10,"ar":"هُمْ","en_gloss":"[they]","transliteration":"hum","verse_key":"11:19"},{"pos":11,"ar":"كَـٰفِرُونَ","en_gloss":"(are) disbelievers","transliteration":"kāfirūna","verse_key":"11:19"},{"pos":12,"ar":"١٩","en_gloss":"(19)","transliteration":"","verse_key":"11:19"}]}]}